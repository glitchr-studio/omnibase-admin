{
    "name": "omnibase/admin",
    "type": "symfony-bundle",
    "description": "Administration backoffice for base-bundle: dynamic CRUD, dashboard, menus and field-based form generation",
    "keywords": [
        "symfony",
        "admin",
        "backoffice",
        "crud",
        "dashboard"
    ],
    "homepage": "https://github.com/glitchr-studio/omnibase-admin",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "autoload": {
        "psr-4": {
            "Base\\Admin\\": "./src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Base\\Admin\\": "./tests"
        }
    },
    "require": {
        "php": "^8.1",
        "symfony/config": "^6.0|^7.0|^8.0",
        "symfony/dependency-injection": "^6.0|^7.0|^8.0",
        "symfony/http-kernel": "^6.0|^7.0|^8.0",
        "symfony/form": "^6.0|^7.0|^8.0",
        "glitchr/omnibase": "3.0.*-dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "symfony/framework-bundle": "^6.0|^7.0|^8.0",
        "symfony/twig-bundle": "^6.0|^7.0|^8.0",
        "symfony/var-dumper": "^6.0|^7.0|^8.0"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "minimum-stability": "dev"
    }
}
