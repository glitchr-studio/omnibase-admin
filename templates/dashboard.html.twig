{% extends '@Admin/layout.html.twig' %}

{% block page_title %}{{ 'dashboard.title'|trans({}, 'admin') }}{% endblock %}

{% block content_header %}
<div class="admin-header dashboard-header">
    {# site identity, matching the historical dashboard: icon tile + real
       site title/slogan, not a generic "Dashboard" heading #}
    <div class="dashboard-brand-icon"><i class="fa-solid fa-house-laptop"></i></div>
    <div>
        <h1>{{ app.site.title ?? 'dashboard.title'|trans({}, 'admin') }}</h1>
        {% if app.site.slogan is defined and app.site.slogan %}<div class="dashboard-slogan">{{ app.site.slogan }}</div>{% endif %}
    </div>
</div>
{% endblock %}

{% block content %}
<p class="dashboard-welcome">{{ 'dashboard.welcome'|trans({}, 'admin') }}</p>

{% block analytics_card %}
    {% set series = analytics_daily_breakdown(14) %}
    {% set change = analytics_week_over_week_change() %}
    {% set labels = {
        pageViews: 'analytics.label.page_views'|trans({}, 'admin'),
        uniqueVisitors: 'analytics.label.unique_visitors'|trans({}, 'admin'),
        uniqueUsers: 'analytics.label.unique_users'|trans({}, 'admin'),
    } %}
    {% set colors = { pageViews: '#2563eb', uniqueVisitors: '#16a34a', uniqueUsers: '#dc2626' } %}
    <div class="card analytics-card">
        <div class="analytics-card-header">
            <h2>{{ 'dashboard.analytics_title'|trans({}, 'admin') }}</h2>
            <div class="analytics-stat-row">
                {% for key in ['pageViews', 'uniqueVisitors', 'uniqueUsers'] %}
                    <div class="analytics-stat">
                        <span class="analytics-stat-value">
                            {{ series|reduce((carry, day) => carry + day[key], 0) }}
                            {%- if change[key] is not null %}
                                <span class="analytics-stat-change {{ change[key] >= 0 ? 'is-up' : 'is-down' }}">
                                    {{ change[key] >= 0 ? '+' : '' }}{{ change[key] }}%
                                </span>
                            {% endif %}
                        </span>
                        <span class="analytics-stat-label">{{ labels[key] }}</span>
                    </div>
                {% endfor %}
            </div>
        </div>
        <div class="analytics-chart-wrap">
            <canvas data-admin-chart="{{ {
                labels: series|map(day => day.date|date('d/m')),
                datasets: ['pageViews', 'uniqueVisitors', 'uniqueUsers']|map(key => {
                    label: labels[key],
                    data: series|map(day => day[key]),
                    color: colors[key],
                }),
            }|json_encode }}"></canvas>
        </div>
    </div>
{% endblock %}

{% if widgets is defined and widgets is not empty %}
<div class="card">
    <div class="widget-grid">
        {% for group in widgets %}
            <div class="widget-group">
                {% if group.icon %}<div class="widget-icon"><i class="{{ group.icon }}"></i></div>{% endif %}
                <h2>{{ group.label|trans({}, 'admin') }}</h2>
                <ul>
                    {% for item in group.subItems %}
                        {% if item.linkUrl %}
                        <li>
                            <a href="{{ item.linkUrl }}">
                                {%- if item.crudActionName == 'new' -%}
                                    <i class="fa-solid fa-circle-plus"></i>
                                {%- elseif item.icon -%}
                                    <i class="{{ item.icon }}"></i>
                                {%- endif -%}
                                {{ item.label|trans({}, 'admin') }}
                            </a>
                        </li>
                        {% endif %}
                    {% endfor %}
                </ul>
            </div>
        {% endfor %}
    </div>
</div>
{% elseif quick_access is defined and quick_access is not empty %}
<div class="card">
    <div class="quick-access">
        {% for card in quick_access %}
            <a href="{{ card.url }}">
                {% if card.icon %}<i class="{{ card.icon }}"></i> {% endif %}{{ card.label }}
            </a>
        {% endfor %}
    </div>
</div>
{% else %}
<div class="card"><div class="empty-state">{{ 'dashboard.welcome'|trans({}, 'admin') }}</div></div>
{% endif %}
{% endblock %}
