{% extends '@Admin/layout.html.twig' %}

{% block page_title %}{{ 'dashboard.title'|trans({}, 'admin') }}{% endblock %}

{% block content_header %}
<div class="admin-header dashboard-header">
    {# site identity, matching the historical dashboard: icon tile + real
       site title/slogan, not a generic "Dashboard" heading #}
    <div class="dashboard-brand-icon"><i class="fa-solid fa-house-laptop"></i></div>
    <div>
        <h1>{{ app.site.title ?? 'dashboard.title'|trans({}, 'admin') }}</h1>
        {% if app.site.slogan is defined and app.site.slogan %}<div class="dashboard-slogan">{{ app.site.slogan }}</div>{% endif %}
        <p class="dashboard-welcome">{{ 'dashboard.welcome'|trans({}, 'admin') }}</p>
    </div>
</div>
{% endblock %}

{% block topbar_dashboard_extra %}
{% if customize_enabled is defined and customize_enabled %}
    {# Server-gated on customize_enabled (superadmin) same as before, but
       ONLY actually visible while is-customizing is toggled on (see
       layout.html.twig's own #admin-customize-done { display:none } /
       body.is-customizing #admin-customize-done { display:inline-flex }
       pattern) - a superadmin viewing the dashboard normally (not
       editing) shouldn't see either control at all, not just be unable
       to use them. #}
    <div class="admin-topbar-dashboard-extra">
        {# Columns is a per-scope setting (LayoutConfig::$columns), not a
           per-widget one - changing it live-updates --widget-columns on
           the grid below via a delegated JS handler, and is included in
           the same batched POST as everything else on "Done" (see
           saveScope() below). Presets match what was actually asked for
           ("2 3 5 10"), not a free-form input - a dashboard's column
           count isn't something that needs arbitrary precision. #}
        <label class="admin-columns-select">
            {{ 'customize.columns'|trans({}, 'admin') }}
            <span class="admin-select-wrap">
                <select data-columns-select>
                    {% for n in [2, 3, 5, 10] %}
                        <option value="{{ n }}" {{ n == dashboard_columns ? 'selected' }}>{{ n }}</option>
                    {% endfor %}
                </select>
            </span>
        </label>
        <div class="admin-icon-dropdown" data-dropdown>
            <button type="button" class="btn" aria-haspopup="true" aria-expanded="false" id="admin-add-widget-trigger">
                <i class="fa-solid fa-plus"></i> {{ 'customize.add_widget'|trans({}, 'admin') }}
            </button>
            <div class="admin-dropdown-menu" role="menu" data-widget-palette-menu></div>
        </div>
    </div>
{% endif %}
{% endblock %}

{% block content %}
{% if widgets is defined and widgets is not empty %}
{# .widget-grid is a plain grid, not a .card itself - every widget below
   supplies its OWN single .card (either analytics_card's, or the
   .widget-group class right below), so nothing is ever a card nested
   inside another card. New widget types must follow the same rule: one
   .card per grid item, never a wrapping card around the whole grid.

   --widget-columns backs grid-template-columns (see layout.html.twig's
   CSS) - a real, configurable column count instead of however many
   ~240px tracks happen to fit the viewport, so a widget's size (1..N)
   always means "N of THIS many columns", never silently more or fewer
   than what the resize control (also capped to this same number) implies. #}
<div class="widget-grid" data-sortable="dashboard" data-widget-columns="{{ dashboard_columns|default(5) }}" style="--widget-columns: {{ dashboard_columns|default(5) }}">
        {% for widget in widgets %}
            {% if widget.type == 'block' %}
                {{ include('@Admin/widget/_block.html.twig', {widget: widget, customize_enabled: customize_enabled ?? false}) }}
            {% else %}
                {# Resize was previously omitted here on the theory that a
                   fixed link list has nothing to preview at a wider size -
                   reinstated so every card can be freely sized for layout
                   purposes (e.g. to make room beside a merged composite),
                   even though the list content itself doesn't reflow. #}
                {% set mergeSubItems = [] %}
                {% for item in widget.subItems %}
                    {% if item.linkUrl %}
                        {% set mergeSubItems = mergeSubItems|merge([{label: (item.label ? item.label|trans({}, 'admin') : ''), icon: item.icon, url: item.linkUrl}]) %}
                    {% endif %}
                {% endfor %}
                <div class="widget-group card {{ widget.hidden ? 'is-hidden' }}" style="grid-column: span {{ widget.size }}" data-sortable-item data-sortable-key="{{ widget.key }}" data-widget-size="{{ widget.size }}" data-merge-def="{{ {label: (widget.label ? widget.label|trans({}, 'admin') : ''), icon: widget.icon, subItems: mergeSubItems}|json_encode|e('html_attr') }}">
                    {% if customize_enabled is defined and customize_enabled %}
                        <div class="item-controls widget-controls">
                            <button type="button" class="item-handle" data-sortable-handle title="{{ 'customize.reorder'|trans({}, 'admin') }}"><i class="fa-solid fa-grip-vertical"></i></button>
                            <button type="button" class="item-resize-handle" data-resize-handle title="{{ 'customize.resize'|trans({}, 'admin') }}"><i class="fa-solid fa-up-right-and-down-left-from-center"></i></button>
                            <button type="button" class="item-toggle" data-toggle-hidden title="{{ 'customize.toggle_visibility'|trans({}, 'admin') }}"><i class="fa-solid fa-eye{{ widget.hidden ? '-slash' }}"></i></button>
                        </div>
                    {% endif %}
                    {% if widget.icon %}<div class="widget-icon"><i class="{{ widget.icon }}"></i></div>{% endif %}
                    <h2>{{ widget.label|trans({}, 'admin') }}</h2>
                    <ul data-sortable="dashboard-items-{{ widget.key }}">
                        {% for item in widget.subItems %}
                            {% if item.linkUrl %}
                            <li>
                                <a href="{{ item.linkUrl }}">
                                    {%- if item.crudActionName == 'new' -%}
                                        <i class="fa-solid fa-circle-plus"></i>
                                    {%- elseif item.icon -%}
                                        <i class="{{ item.icon }}"></i>
                                    {%- endif -%}
                                    {{ item.label|trans({}, 'admin') }}
                                </a>
                            </li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        {% endfor %}
</div>
{% elseif quick_access is defined and quick_access is not empty %}
<div class="card">
    <div class="quick-access">
        {% for card in quick_access %}
            <a href="{{ card.url }}">
                {% if card.icon %}<i class="{{ card.icon }}"></i> {% endif %}{{ card.label }}
            </a>
        {% endfor %}
    </div>
</div>
{% else %}
<div class="card"><div class="empty-state">{{ 'dashboard.welcome'|trans({}, 'admin') }}</div></div>
{% endif %}
{% endblock %}
