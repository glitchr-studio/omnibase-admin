{% extends '@Admin/layout.html.twig' %}

{% block page_title %}{{ 'dashboard.title'|trans({}, 'admin') }}{% endblock %}

{% block content_header %}
<div class="admin-header">
    <h1>{{ 'dashboard.title'|trans({}, 'admin') }}</h1>
</div>
{% endblock %}

{% block content %}
<div class="card">
    {% if quick_access is defined and quick_access is not empty %}
        <div class="quick-access">
            {% for card in quick_access %}
                <a href="{{ card.url }}">
                    {% if card.icon %}<i class="{{ card.icon }}"></i> {% endif %}{{ card.label }}
                </a>
            {% endfor %}
        </div>
    {% else %}
        <div class="empty-state">{{ 'dashboard.welcome'|trans({}, 'admin') }}</div>
    {% endif %}
</div>
{% endblock %}
