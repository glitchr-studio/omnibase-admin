{% extends '@Admin/layout.html.twig' %}

{% block page_title %}{{ 'dashboard.title'|trans({}, 'admin') }}{% endblock %}

{% block content_header %}
<div class="admin-header dashboard-header">
    {# site identity, matching the historical dashboard: icon tile + real
       site title/slogan, not a generic "Dashboard" heading #}
    <div class="dashboard-brand-icon"><i class="fa-solid fa-house-laptop"></i></div>
    <div>
        <h1>{{ app.site.title ?? 'dashboard.title'|trans({}, 'admin') }}</h1>
        {% if app.site.slogan is defined and app.site.slogan %}<div class="dashboard-slogan">{{ app.site.slogan }}</div>{% endif %}
        <p class="dashboard-welcome">{{ 'dashboard.welcome'|trans({}, 'admin') }}</p>
    </div>
</div>
{% endblock %}

{% block content %}
{% if widgets is defined and widgets is not empty %}
{# .widget-grid is a plain grid, not a .card itself - every widget below
   supplies its OWN single .card (either analytics_card's, or the
   .widget-group class right below), so nothing is ever a card nested
   inside another card. New widget types must follow the same rule: one
   .card per grid item, never a wrapping card around the whole grid. #}
<div class="widget-grid" data-sortable="dashboard">
        {% for widget in widgets %}
            {% if widget.type == 'block' %}
                {# blockName-referenced blocks (e.g. analytics_card below)
                   render themselves inside their own .card - defined here so
                   the definition's source position is also its one render
                   point, gated on reaching this branch (matches how many
                   widget items there are: one, today) rather than always
                   rendering unconditionally at the top of the page. #}
                <div class="widget-block widget-size-{{ widget.size }} {{ widget.hidden ? 'is-hidden' }}" data-sortable-item data-sortable-key="{{ widget.key }}" data-widget-size="{{ widget.size }}">
                    {% if customize_enabled is defined and customize_enabled %}
                        <div class="item-controls widget-controls">
                            <button type="button" class="item-handle" data-sortable-handle title="{{ 'customize.reorder'|trans({}, 'admin') }}"><i class="fa-solid fa-grip-vertical"></i></button>
                            <button type="button" class="item-toggle" data-toggle-hidden title="{{ 'customize.toggle_visibility'|trans({}, 'admin') }}"><i class="fa-solid fa-eye{{ widget.hidden ? '-slash' }}"></i></button>
                        </div>
                        <button type="button" class="item-resize-handle" data-resize-handle title="{{ 'customize.resize'|trans({}, 'admin') }}"><i class="fa-solid fa-up-right-and-down-left-from-center"></i></button>
                    {% endif %}
                    {% if widget.blockName == 'analytics_card' %}
                        {% block analytics_card %}
                            {% set series = analytics_daily_breakdown(14) %}
                            {% set change = analytics_week_over_week_change() %}
                            {% set labels = {
                                pageViews: 'analytics.label.page_views'|trans({}, 'admin'),
                                uniqueVisitors: 'analytics.label.unique_visitors'|trans({}, 'admin'),
                                uniqueUsers: 'analytics.label.unique_users'|trans({}, 'admin'),
                            } %}
                            {% set colors = { pageViews: '#2563eb', uniqueVisitors: '#16a34a', uniqueUsers: '#dc2626' } %}
                            <div class="card analytics-card">
                                <div class="analytics-card-header">
                                    <h2>{{ 'dashboard.analytics_title'|trans({}, 'admin') }}</h2>
                                    <div class="analytics-stat-row">
                                        {% for key in ['pageViews', 'uniqueVisitors', 'uniqueUsers'] %}
                                            <div class="analytics-stat">
                                                <span class="analytics-stat-value">
                                                    {{ series|reduce((carry, day) => carry + day[key], 0) }}
                                                    {%- if change[key] is not null %}
                                                        <span class="analytics-stat-change {{ change[key] >= 0 ? 'is-up' : 'is-down' }}">
                                                            {{ change[key] >= 0 ? '+' : '' }}{{ change[key] }}%
                                                        </span>
                                                    {% endif %}
                                                </span>
                                                <span class="analytics-stat-label">{{ labels[key] }}</span>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                                <div class="analytics-chart-wrap">
                                    <canvas data-admin-chart="{{ {
                                        labels: series|map(day => day.date|date('d/m')),
                                        datasets: ['pageViews', 'uniqueVisitors', 'uniqueUsers']|map(key => {
                                            label: labels[key],
                                            data: series|map(day => day[key]),
                                            color: colors[key],
                                        }),
                                    }|json_encode }}"></canvas>
                                </div>
                            </div>
                        {% endblock %}
                    {% endif %}
                </div>
            {% else %}
                {# No resize handle here (unlike the block branch above): a
                   link-group card's content is a fixed list regardless of
                   how many grid columns it spans - growing it wouldn't
                   reveal anything it isn't already showing, so there's
                   nothing to preview and no reason to offer the control. #}
                <div class="widget-group card widget-size-{{ widget.size }} {{ widget.hidden ? 'is-hidden' }}" data-sortable-item data-sortable-key="{{ widget.key }}" data-widget-size="{{ widget.size }}">
                    {% if customize_enabled is defined and customize_enabled %}
                        <div class="item-controls widget-controls">
                            <button type="button" class="item-handle" data-sortable-handle title="{{ 'customize.reorder'|trans({}, 'admin') }}"><i class="fa-solid fa-grip-vertical"></i></button>
                            <button type="button" class="item-toggle" data-toggle-hidden title="{{ 'customize.toggle_visibility'|trans({}, 'admin') }}"><i class="fa-solid fa-eye{{ widget.hidden ? '-slash' }}"></i></button>
                        </div>
                    {% endif %}
                    {% if widget.icon %}<div class="widget-icon"><i class="{{ widget.icon }}"></i></div>{% endif %}
                    <h2>{{ widget.label|trans({}, 'admin') }}</h2>
                    <ul data-sortable="dashboard-items-{{ widget.key }}">
                        {% for item in widget.subItems %}
                            {% if item.linkUrl %}
                            <li>
                                <a href="{{ item.linkUrl }}">
                                    {%- if item.crudActionName == 'new' -%}
                                        <i class="fa-solid fa-circle-plus"></i>
                                    {%- elseif item.icon -%}
                                        <i class="{{ item.icon }}"></i>
                                    {%- endif -%}
                                    {{ item.label|trans({}, 'admin') }}
                                </a>
                            </li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        {% endfor %}
</div>
{% elseif quick_access is defined and quick_access is not empty %}
<div class="card">
    <div class="quick-access">
        {% for card in quick_access %}
            <a href="{{ card.url }}">
                {% if card.icon %}<i class="{{ card.icon }}"></i> {% endif %}{{ card.label }}
            </a>
        {% endfor %}
    </div>
</div>
{% else %}
<div class="card"><div class="empty-state">{{ 'dashboard.welcome'|trans({}, 'admin') }}</div></div>
{% endif %}
{% endblock %}
