<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en') }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block page_title %}Admin{% endblock %}</title>
    {# Applied before any CSS paints, not after - reading this in a normal
       body-level script would show the light theme for one frame then
       flash to dark. "auto" (the default - no explicit choice saved yet)
       intentionally sets no attribute at all: the plain
       @media(prefers-color-scheme:dark) rule below already covers it, no
       need to duplicate that logic in JS too. #}
    <script>
        (function () {
            var saved = localStorage.getItem('admin-theme');
            if (saved === 'light' || saved === 'dark') {
                document.documentElement.setAttribute('data-theme', saved);
            }
            // Same pre-paint timing as the theme choice above: the sidebar
            // collapse toggles a width change (230px -> icon rail), so
            // applying it after first paint would show a flash of the wrong
            // width for one frame instead of just the wrong color.
            if (localStorage.getItem('admin-sidebar-collapsed') === '1') {
                document.documentElement.classList.add('is-sidebar-collapsed');
            }
        })();
    </script>
    {% block head_stylesheets %}
    <style>
        :root {
            {# Tells the browser which system palette to render native
               chrome from. Without it the page is "light" as far as the UA
               is concerned no matter how dark we paint it, so form-control
               text (fieldtext/buttontext), scrollbars, autofill fills,
               date/colour pickers and select popups all stayed light-mode
               - the `color: inherit` on the control rules below fixes the
               text, but nothing in CSS can reach the rest. Must be
               re-declared in each dark block: it is a normal property, not
               a custom one, so it does not follow --admin-* automatically. #}
            color-scheme: light;
            --admin-bg: #f6f7f9; --admin-surface: #fff; --admin-border: #e3e6ea;
            --admin-text: #1f2429; --admin-muted: #6b7683; --admin-accent: #2563eb;
            --admin-aside-w: 260px;
            --admin-danger: #dc2626; --admin-success: #16a34a; --admin-warning: #d97706;
            --admin-radius: 8px;
            {# Not an admin token - base-async's own. It ships
               `.text-muted{color:var(--text-muted)!important}` but only
               DEFINES --text-muted inside a scope this admin never gets
               (base-async.scss:914, `var(--gray-500)` off the Bootstrap
               palette root). Undefined + no fallback = invalid at
               computed-value time, and because `color` inherits, every
               .text-muted element in the admin silently rendered at full
               body-text strength - the `!important` also beating our own
               `.form-text{color:var(--admin-muted)}`. Found via the file-
               size hint under image uploads reading as loud as a label
               next to production's gray, but it was never just that one
               element. Aliasing the token here fixes .text-muted admin-
               wide; it resolves per-theme since the dark blocks below
               re-declare --admin-muted on this same :root.
               !important is required, not defensive: base-async DOES
               carry its own `:root{--text-muted:var(--gray-500)}` and its
               stylesheet loads after this inline block, so at equal
               specificity document order hands it the win - and it
               resolves to nothing, since --gray-500 is equally undefined
               here (both confirmed empty via getComputedStyle live). #}
            --text-muted: var(--admin-muted) !important;
            {# Same story, second token: base-async styles the ACTIVE locale
               tab with `.form-translatable .nav-link.active{background:
               var(--sidebar-bg)!important}`, and --sidebar-bg is another
               token it never defines here. Undefined + no fallback made
               `background` invalid at computed-value time, so it fell back
               to its initial value - transparent - and the !important also
               beat our own `.nav-tabs .nav-link.active{background:
               var(--admin-surface)}`, leaving the selected tab with no fill
               at all (production paints it #f8fafc). Surface, not bg: the
               active tab should read as continuous with the pane beneath
               it. No !important needed unlike --text-muted above - nothing
               else declares --sidebar-bg on :root (verified live). #}
            --sidebar-bg: var(--admin-surface);
        }
        {# "auto" (no data-theme attribute at all) follows the OS - explicit
           data-theme="dark"/"light" (set above from a saved preference)
           always wins regardless of OS setting. #}
        @media (prefers-color-scheme: dark) {
            :root:not([data-theme="light"]) {
                color-scheme: dark;
                --admin-bg: #16181d; --admin-surface: #1e2127; --admin-border: #2c3038;
                --admin-text: #e6e8eb; --admin-muted: #8b94a1; --admin-accent: #6ea8fe;
                --admin-danger: #f87171; --admin-success: #4ade80; --admin-warning: #fbbf24;
                {# base-bundle's form-type-editor.css reads this to repaint
                   EditorJS headings, hardcoded black otherwise (invisible
                   against this dark background - reported live on an
                   article's content field). #}
                --editor-heading-color: var(--admin-text);
            }
        }
        :root[data-theme="dark"] {
            color-scheme: dark;
            --admin-bg: #16181d; --admin-surface: #1e2127; --admin-border: #2c3038;
            --admin-text: #e6e8eb; --admin-muted: #8b94a1; --admin-accent: #6ea8fe;
            --admin-danger: #f87171; --admin-success: #4ade80; --admin-warning: #fbbf24;
            --editor-heading-color: var(--admin-text);
        }
        {# Sticky at top:0 with no shadow, only a 1px border, gave the bar no
           visual weight of its own - at rest (no scroll needed, the negative
           margin already pulls it flush with the viewport edge) it read as
           part of whatever sits above the page rather than page content.
           A real shadow gives it depth/definition regardless of what's
           behind/above it. #}
        {# height, not padding - see the matching comment on .admin-aside
           .brand, which this is deliberately kept in sync with (same
           3.3rem) so both bars' bottom borders land on the same line. #}
        .admin-topbar { display: flex; align-items: center; gap: 1rem; height: 3.3rem; padding: 0 .9rem; margin: -1.5rem -2rem 1.25rem; border-bottom: 1px solid var(--admin-border);
                       position: sticky; top: 0; z-index: 15; background: var(--admin-bg); box-shadow: 0 2px 6px rgba(0,0,0,.1); }
        {# During an in-page navigation (html.loading, plus the progress
           bar's own minimum-duration window) the swapped-out topbar sits
           momentarily EMPTY over the incoming page - with its resting
           box-shadow it reads as an open dropdown panel flashing across
           the top (reported live). The border-bottom alone carries the
           separation for that brief window. #}
        html.loading .admin-topbar,
        html.progress-bar-active .admin-topbar { box-shadow: none; }
        .topbar-search { flex: 1; max-width: 420px; display: flex; align-items: center; gap: .5rem; padding: .4rem .8rem; border: 1px solid var(--admin-border);
                         border-radius: 999px; background: var(--admin-surface); color: var(--admin-muted); }
        .topbar-search i { flex: 0 0 auto; }
        .topbar-search input { flex: 1; border: 0; background: none; font: inherit; color: inherit; min-width: 0; }
        .topbar-search input:focus { outline: none; }
        .admin-topbar-icons { margin-left: auto; display: flex; align-items: center; gap: .4rem; }
        .admin-icon-dropdown { position: relative; }
        {# text-decoration:none because this class is used on BOTH <button>
           and <a> (the sidebar footer's home and exit-admin icons are
           links). Buttons carry no underline, so the omission was
           invisible on the topbar's button-only icons and showed up only
           on those two anchors - a bare underline sitting under the glyph
           (reported live). Every other anchor component in this file
           already resets it; this one was just missed. #}
        .admin-icon-btn { display: flex; align-items: center; justify-content: center; width: 2.1rem; height: 2.1rem; border-radius: 999px; border: 1px solid transparent;
            background: none; color: var(--admin-muted); cursor: pointer; font: inherit; text-decoration: none; }
        .admin-icon-btn:hover { border-color: var(--admin-border); color: var(--admin-accent); background: var(--admin-surface); }
        .admin-dropdown-menu { display: none; position: absolute; top: calc(100% + .3rem); right: 0; min-width: 150px; z-index: 20;
            background: var(--admin-surface); border: 1px solid var(--admin-border); border-radius: var(--admin-radius); box-shadow: 0 8px 24px rgba(0,0,0,.15); overflow: hidden; }
        [data-dropdown].is-open .admin-dropdown-menu { display: block; }
        .admin-dropdown-menu button, .admin-dropdown-menu a { display: flex; align-items: center; gap: .5rem; width: 100%; padding: .5rem .8rem; border: 0; background: none; text-align: left;
            color: inherit; text-decoration: none; cursor: pointer; font: inherit; font-size: .85rem; box-sizing: border-box; }
        .admin-dropdown-menu button:hover, .admin-dropdown-menu a:hover { background: var(--admin-bg); }
        .admin-dropdown-menu button.is-active, .admin-dropdown-menu a.is-active { color: var(--admin-accent); font-weight: 600; }
        .admin-dropdown-menu i { width: 1rem; text-align: center; }
        .admin-dropdown-loading { display: block; padding: .5rem .8rem; font-size: .85rem; color: var(--admin-muted); }
        .admin-locale-flag { width: 1.15rem; height: .85rem; object-fit: cover; border-radius: 2px; flex-shrink: 0; }
        {# The avatar cluster IS the "shown by default" summary (not hidden
           behind opening the dropdown) - the dropdown itself is purely the
           "expand to a full list" part. #}
        .admin-active-users-trigger { width: auto; padding: 0 .5rem 0 .3rem; border-radius: 999px; gap: .25rem; }
        .admin-active-avatars { display: flex; }
        .admin-avatar-initial { display: flex; align-items: center; justify-content: center; width: 1.6rem; height: 1.6rem; border-radius: 50%;
            background: var(--admin-accent); color: #fff; font-size: .7rem; font-weight: 700; border: 2px solid var(--admin-surface); flex-shrink: 0; }
        .admin-active-avatars .admin-avatar-initial + .admin-avatar-initial { margin-left: -.5rem; }
        .admin-active-count { font-size: .72rem; color: var(--admin-muted); font-weight: 600; }
        .admin-active-users-list { min-width: 220px; }
        .dropdown-heading { padding: .5rem .8rem .3rem; font-size: .72rem; text-transform: uppercase; letter-spacing: .04em; color: var(--admin-muted); }
        .admin-active-user-row { display: flex; align-items: center; gap: .5rem; padding: .4rem .8rem; font-size: .85rem; }
        .admin-active-user-row .admin-avatar-initial { border: 0; }
        .admin-active-user-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .admin-active-dot { width: .5rem; height: .5rem; border-radius: 50%; background: var(--admin-muted); flex-shrink: 0; }
        .admin-active-dot.is-online { background: var(--admin-success); }
        * { box-sizing: border-box; }
        body { margin: 0; font: 15px/1.5 system-ui, -apple-system, sans-serif; background: var(--admin-bg); color: var(--admin-text); }
        .admin-shell { display: flex; min-height: 100vh; }
        {# Without this, .admin-shell's flex layout stretches .admin-aside to
           match .admin-main's full content height, so on any page taller
           than the viewport (basically every dashboard/CRUD page) the whole
           sidebar - including the bottom Système/Rôles/Documentation
           sections - scrolls away with the page instead of staying put. #}
        {# No top padding here (moved to bottom-only) - it used to push the
           brand row down 1rem before it even started, while .admin-topbar
           sits flush at the very top of the viewport (sticky, top:0, no
           equivalent offset) - the single biggest contributor to the two
           bars' borders not lining up. #}
        {# 230px was tight enough that routine French labels ("Réponses aux
           commentaires", "Super administrateurs", "Paramètres du site")
           wrapped to two lines by default, before even accounting for the
           customize-mode handle/eye icons eating further into the same
           width - reads as a cramped sidebar regardless of how much room
           the surrounding page/nest panel actually has. #}
        {# z-index matters here for more than just its own stacking: .admin-
           aside has none of its own positioned descendants poking outside
           its bounds UNTIL the collapsed-rail flyout (further down) needs
           to. Without an explicit z-index on .admin-aside ITSELF, it and
           .admin-main are both "auto"-stacked siblings, resolved by plain
           DOM order - .admin-main comes second, so it paints on top
           regardless of any z-index set on something nested inside .admin-
           aside; the flyout's own z-index:30 only ever wins within THIS
           element's local stacking context, never against .admin-main's
           content sitting in a different one entirely. #}
        {# --admin-aside-w is what the fixed overlays below (flash stack,
           filter modal) centre themselves against. Without it they centre
           on the VIEWPORT, which is 130px off-centre from the content
           column the reader is actually looking at - reported live. #}
        .admin-aside { width: var(--admin-aside-w); flex-shrink: 0; display: flex; flex-direction: column; background: var(--admin-surface); border-right: 1px solid var(--admin-border); padding: 0 0 1rem;
                      position: sticky; top: 0; height: 100vh; overflow-y: auto; scroll-behavior: smooth; z-index: 20; }
        {# Fixed height (matching .admin-topbar's own, below) instead of
           content-driven padding, so the brand row's bottom border and the
           topbar's bottom border land at the exact same Y regardless of
           either one's actual content (logo vs. icon buttons are
           different sizes) - align-items:center on both handles the
           vertical centering that the removed padding used to. #}
        .admin-aside .brand { display: flex; align-items: center; gap: .6rem; height: 3.3rem; padding: 0 1.25rem; border-bottom: 1px solid var(--admin-border); }
        .admin-aside .brand-logo { width: 2.25rem; height: 2.25rem; border-radius: 6px; object-fit: cover; flex-shrink: 0; }
        .admin-aside .brand-text { display: flex; flex-direction: column; min-width: 0; }
        {# The caret sits next to the TITLE specifically, in its own row -
           it used to be a direct sibling of .brand-text out in .brand's
           own flex row, so .brand's align-items:center centered it
           against the full two-line title+username block instead of just
           the title, landing it visibly low/disconnected (found live via
           a user screenshot). This row is its own flex context, so the
           caret's vertical center always tracks the title line only,
           regardless of whether a username line exists below it at all. #}
        .admin-aside .brand-title-row { display: flex; align-items: center; gap: .35rem; min-width: 0; }
        .admin-aside .brand-title { font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; min-width: 0; }
        .admin-aside .brand-user { font-size: .8rem; color: var(--admin-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        [data-brand-title][contenteditable="true"]:focus {
            outline: 2px solid var(--admin-accent); outline-offset: 2px; border-radius: 4px;
        }
        {# Focus-only feedback meant "editable" was invisible until AFTER
           you'd already clicked in - nothing distinguished this text from
           any other while customizing, so there was no way to tell it was
           clickable at all short of trying. A lighter dashed outline (plus
           a text-input cursor) on hover gives that cue up front, same
           treatment for the sidebar's own brand title. #}
        body.is-customizing [data-analytics-title][contenteditable="true"]:hover,
        body.is-customizing [data-brand-title][contenteditable="true"]:hover,
        body.is-customizing [data-widget-text][contenteditable="true"]:hover,
        body.is-customizing [data-page-title][contenteditable="true"]:hover,
        body.is-customizing [data-page-desc][contenteditable="true"]:hover {
            outline: 1px dashed var(--admin-accent); outline-offset: 2px; border-radius: 4px; cursor: text;
        }
        [data-page-title][contenteditable="true"]:focus,
        [data-page-desc][contenteditable="true"]:focus {
            outline: 2px solid var(--admin-accent); outline-offset: 2px; border-radius: 4px;
        }
        .admin-menu { list-style: none; margin: .75rem 0 0; padding: 0; }
        {# Used to push a standalone "Tableau de bord" quick-link away from
           the sections below it (prod-style rhythm: quick link at the very
           top, sections pushed to the bottom, empty middle). That link was
           removed from App\Controller\Admin\DashboardController::
           configureMenuItems() (superseded by the sidebar footer's own
           home icon, see its own comment) - with no more standalone item
           in front of them, :first-child now means the FIRST SECTION
           itself, so the old margin-bottom:auto shoved just that one
           section to the top and every other section down to the bottom,
           opening a large empty gap in the middle of the list - fixed by
           removing that child rule entirely (see git history/git blame
           for the version that had it).

           justify-content:flex-end below is a DIFFERENT, later request:
           once the gap-in-the-middle was gone, the whole (now gapless)
           section list sat pinned to the TOP of the aside, empty space
           below it before the footer icons - asked to be pinned to the
           BOTTOM instead, empty space above. flex-direction:column makes
           this flex container's own main axis vertical, so flex-end here
           means "bottom", not "right". #}
        aside.admin-aside > ul.admin-menu:first-of-type { flex: 1; display: flex; flex-direction: column; justify-content: flex-end; }
        {# .section-group (the <li>) holds the label row and its nested
           member <ul> stacked vertically - overrides the generic
           ".admin-menu li { display:flex }" row layout below, which is
           for individual nav items, not this section-plus-members group. #}
        .admin-menu li.section-group { display: block; }
        {# No right padding here - .item-controls supplies its own right
           margin (below) so a section's icon pair and a regular item's
           icon pair land at the exact same inset regardless of which
           container (a padded .section div vs an unpadded <li>) they're
           actually sitting in. #}
        .admin-menu .section { display: flex; align-items: center; justify-content: space-between;
            padding: .9rem 0 .3rem 1.25rem; font-size: .78rem; text-transform: uppercase; letter-spacing: .04em; color: var(--admin-muted); }
        {# flex:1 so this - not the trailing item-controls - is what
           absorbs the row's leftover space; keeps icon+label pinned left
           regardless of whether item-controls is even present. #}
        .admin-menu .section-label { display: flex; align-items: center; flex: 1; min-width: 0; gap: .3rem; }
        .admin-menu .section-label i { width: 1.1rem; text-align: center; }
        .admin-menu .section-group > ul { list-style: none; margin: 0; padding: 0; }
        .admin-menu a { display: flex; align-items: center; padding: .45rem 1.25rem; color: inherit; text-decoration: none; border-left: 3px solid transparent; min-width: 0; }
        .admin-menu li:hover > a { background: var(--admin-bg); }
        .admin-menu .selected > a { border-left-color: var(--admin-accent); color: var(--admin-accent); font-weight: 600; }
        .admin-menu a i { width: 1.1rem; text-align: center; margin-right: .3rem; flex-shrink: 0; }
        {# A long French label ("Super administrateurs", "Réponses aux
           commentaires") had nothing stopping it from wrapping to a second
           line - min-width:0 above is what lets this actually shrink (a
           flex item's default min-width is its own content size, which
           blocks any child from ever truncating below that), title=""
           already carries the full text (see main_menu below) so nothing
           is lost by cutting it off visually. #}
        .admin-menu .label-text { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .admin-menu .sub a { padding-left: 2.75rem; font-size: .92rem; }
        {# Customize mode's own handle/toggle icons used to land flush
           against the label the instant it grew long enough to leave no
           space for justify-content:space-between to distribute - a fixed
           gap is a floor that holds regardless of how much (or how little)
           the label ends up needing. #}
        .admin-menu li { gap: .4rem; }
        .admin-menu li.is-hidden, .widget-group.is-hidden, .widget-block.is-hidden { display: none; }
        body.is-customizing .admin-menu li.is-hidden, body.is-customizing .widget-group.is-hidden, body.is-customizing .widget-block.is-hidden {
            display: block; opacity: .45;
        }
        {# Unlike .is-hidden (faded but still there/re-toggleable while
           customizing, see above) - deleted stays gone even mid-session,
           no faded placeholder to click back on. The node itself is still
           in the DOM either way (see the [data-remove-item] handler
           further below), just never shown; body.is-customizing isn't
           part of this selector on purpose. #}
        .widget-group.is-deleted, .widget-block.is-deleted { display: none; }
        {# Handle/toggle controls: invisible and inert outside customize
           mode (not just hidden - the drag handle must not intercept
           clicks or show a grab cursor on a normal page). #}
        #admin-customize-toggle.is-active { color: var(--admin-accent); border-color: var(--admin-accent); background: var(--admin-surface); }
        .item-controls { display: none; align-items: center; gap: .3rem; }
        body.is-customizing .item-controls { display: inline-flex; }
        {# align-items:stretch (the flex default - overriding the old
           explicit "center") + min-height together are what make a
           single-line row and a wrapped two-line row hover/highlight as
           the same consistent shape: the <a> now fills its <li>'s full
           box (so the hover background - moved to li:hover > a above -
           always covers the complete row, not just the link's own
           intrinsic content height), and every row has the same floor
           height regardless of how much text it holds. #}
        .admin-menu li { display: flex; align-items: stretch; justify-content: space-between; min-height: 2.4rem; }
        .admin-menu li a { flex: 1; }
        {# The right margin promised by the "No right padding here" comment
           on .section above - never actually written until now. .aside has
           0 right padding and .item-controls (a plain inline sibling of
           <a> here, unlike the dashboard's position:absolute
           .widget-controls reuse of this same class) carried no margin of
           its own either, so the icon row landed flush against the
           sidebar's own outer edge with no breathing room at all -
           reported live. Scoped to .admin-menu specifically (not a bare
           .item-controls rule) so this doesn't also nudge the dashboard
           widget cards' own already-tuned .widget-controls positioning. #}
        .admin-menu li .item-controls { align-self: center; margin-right: 1.25rem; }
        {# Icon glyph sized closer to its box (font-size raised from .78rem,
           box tightened from 1.6rem) - the FontAwesome glyph read as
           swimming in empty padding at the old ratio, found live. Still
           comfortably above a 24px touch target (1.5rem = 24px exactly). #}
        .item-handle, .item-toggle, .item-remove, .item-split, .item-settings, .item-background { display: flex; align-items: center; justify-content: center; width: 1.5rem; height: 1.5rem; border: 0; border-radius: 6px;
            background: none; color: var(--admin-muted); cursor: pointer; font-size: .88rem; flex-shrink: 0; }
        .item-handle:hover, .item-toggle:hover, .item-split:hover, .item-settings:hover, .item-settings.is-active, .item-background:hover, .item-background.is-active { background: var(--admin-bg); color: var(--admin-text); }
        {# Danger-tinted hover only, not a permanent color - only ad-hoc/
           palette-added widgets ever get this button (see _block.html.twig),
           and it deletes immediately with no confirmation step, so the
           hover state is the one warning a user gets before clicking. #}
        .item-remove:hover { background: var(--admin-danger); color: #fff; }
        {# ── Collapsed sidebar (icon-only rail) ──────────────────────────
           A section's label + members have nowhere to sit inline once
           collapsed, so the whole section-group pops them out as a flyout
           on hover/focus instead - .section stays as the icon-only trigger,
           its nested <ul> (already in the DOM either way, see main_menu)
           becomes that flyout's content, with a heading row (flyout-only,
           hidden in normal expanded mode) repeating the label that's no
           longer visible inline. Ungrouped top-level items get a plain
           native title="" tooltip instead - a single link never needed a
           whole flyout for one label. #}
        html.is-sidebar-collapsed { --admin-aside-w: 4.5rem; }
        html.is-sidebar-collapsed .admin-aside .brand { justify-content: center; padding-left: 0; padding-right: 0; }
        html.is-sidebar-collapsed .admin-aside .brand-text, html.is-sidebar-collapsed .admin-aside .account-caret { display: none; }
        {# .admin-menu a is display:block normally (no flex, so nothing to
           center) - only the collapsed rail needs it centered on its icon. #}
        html.is-sidebar-collapsed .admin-menu a { display: flex; align-items: center; justify-content: center; padding-left: 0; padding-right: 0; }
        html.is-sidebar-collapsed .admin-menu .section { justify-content: center; padding-left: 0; padding-right: 0; }
        {# Without this, .section-label's flex:1 (needed in expanded mode to
           keep item-controls pinned right) stretches it across the whole
           collapsed row, leaving its own content (just the icon, once
           .label-text hides) sitting at flex-start instead of centered. #}
        html.is-sidebar-collapsed .admin-menu .section-label { flex: none; justify-content: center; }
        html.is-sidebar-collapsed .admin-menu a i { margin-right: 0; }
        html.is-sidebar-collapsed .admin-menu .label-text, html.is-sidebar-collapsed .admin-menu .sub { display: none; }
        {# Collapsed, the icon is the ONLY thing identifying a row, and it was
           still rendering at the expanded size - a ~16px glyph adrift in a
           4.5rem column, hard to hit and hard to tell apart. Scale it up to
           suit the icon-only column (asked for directly).
           The reset on the flyout is required, not tidiness: the hover
           flyout lives INSIDE .admin-menu, so `.admin-menu a i` matches its
           icons too - but that panel is the expanded, labelled presentation
           and its icons must stay text-sized next to their labels. Same for
           the footer buttons: bigger glyphs need a bigger hit circle or
           they crowd the 2.1rem default. #}
        html.is-sidebar-collapsed .admin-menu a i,
        html.is-sidebar-collapsed .admin-menu .section i { font-size: 1.15rem; }
        html.is-sidebar-collapsed .section-group > ul a i { font-size: inherit; }
        html.is-sidebar-collapsed .admin-sidebar-footer .admin-icon-btn { width: 2.3rem; height: 2.3rem; }
        html.is-sidebar-collapsed .admin-sidebar-footer .admin-icon-btn i { font-size: 1.1rem; }
        {# Both halves must stay scoped to .admin-menu - .item-resize-handle
           on its own (no .admin-menu prefix) matched EVERY resize handle in
           the document, including the dashboard widget-grid's own ones
           while actively customizing it (body.is-customizing's own
           .item-resize-handle{display:flex} rule lost to this !important
           regardless of the sidebar's collapse state) - found live: drag
           handles on dashboard cards silently vanished whenever the
           sidebar happened to be collapsed (a persisted localStorage
           preference), with no visible error to explain why. #}
        html.is-sidebar-collapsed .admin-menu .item-controls, html.is-sidebar-collapsed .admin-menu .item-resize-handle { display: none !important; }
        html.is-sidebar-collapsed .admin-sidebar-stats { display: none; }
        html.is-sidebar-collapsed .section-group { position: relative; }
        {# .admin-aside is overflow-y:auto (it's the scrollable sidebar
           itself - see the scroll-reveal stats panel further down) - which
           clips ANY horizontal overflow too, flyout included, no matter how
           high its own z-index. Suspending that clip exactly while a flyout
           is open (rather than switching to position:fixed + JS-computed
           coordinates) keeps this whole feature CSS-only; losing the
           sidebar's own scrollability for the moment you're hovering a
           flyout is a non-issue in practice. #}
        html.is-sidebar-collapsed .admin-aside:has(.section-group:hover, .section-group:focus-within) { overflow: visible; }
        html.is-sidebar-collapsed .section-group > ul { display: none; }
        html.is-sidebar-collapsed .section-group:hover > ul, html.is-sidebar-collapsed .section-group:focus-within > ul {
            display: block; position: absolute; left: 100%; top: 0; min-width: 13rem; margin-left: .5rem;
            background: var(--admin-surface); border: 1px solid var(--admin-border); border-radius: var(--admin-radius);
            box-shadow: 0 8px 24px rgba(0,0,0,.15); padding: .4rem 0; z-index: 30;
        }
        {# .flyout-open-upward is set per-hover by JS (see the mouseover/
           focusin handlers) whenever a downward flyout from this section
           would run past the bottom of the viewport - anchoring from the
           trigger's own bottom edge instead keeps the whole panel on
           screen regardless of how low the section sits in the menu. #}
        html.is-sidebar-collapsed .section-group.flyout-open-upward:hover > ul,
        html.is-sidebar-collapsed .section-group.flyout-open-upward:focus-within > ul {
            top: auto; bottom: 0;
        }
        html.is-sidebar-collapsed .section-group:hover > ul .label-text,
        html.is-sidebar-collapsed .section-group:focus-within > ul .label-text { display: inline; }
        {# Higher specificity than the blanket ".admin-menu .sub { display:none }"
           above (extra .section-group > ul context) - restores the <li>'s
           correct display type. Only matters once the ancestor <ul> itself
           is shown (the :hover/:focus-within rule above), so this doesn't
           need its own hover scoping. #}
        html.is-sidebar-collapsed .section-group > ul .sub { display: list-item; }
        html.is-sidebar-collapsed .section-group > ul a, html.is-sidebar-collapsed .section-group > ul .flyout-heading { justify-content: flex-start; padding: .45rem 1rem; }
        html.is-sidebar-collapsed .section-group > ul a i { margin-right: .3rem; }
        {# ".admin-menu li" (0,0,1,1) beats a bare ".flyout-heading" (0,0,1,0)
           on specificity regardless of source order, so its display:flex
           was winning over this rule's display:none - the heading rendered
           in NORMAL expanded mode too, duplicating the section's own label
           right underneath it. Scoped through .admin-menu li to match or
           beat that specificity instead of relying on source-order luck. #}
        .admin-menu li.flyout-heading { display: none; padding: .3rem 1rem .5rem; font-size: .72rem; text-transform: uppercase; letter-spacing: .04em; color: var(--admin-muted); }
        html.is-sidebar-collapsed .section-group > ul li.flyout-heading { display: block; }
        #admin-sidebar-collapse-toggle i { transition: transform .15s; }
        html.is-sidebar-collapsed #admin-sidebar-collapse-toggle i { transform: rotate(180deg); }
        {# Drag horizontally to grow/shrink a widget's grid-column span,
           with a live ghost-outline preview (see the pointerdown/move/up
           handlers + .admin-resize-ghost below) rather than resizing the
           real widget mid-drag. A real <button> (tab-reachable, ArrowLeft/
           Right fallback - see the keydown handler). Rendered on every
           card, including a plain link-group one whose own content
           doesn't visually adapt to size - sizing is still useful there
           purely for layout purposes (e.g. leaving room beside a merged
           composite card in the same row).

           Bottom-right corner, its own floating circle - not grouped into
           the top-right .item-controls row (tried that once; a corner
           tab's visibility depends on the card's own height and how far
           you've scrolled, and it was repeatedly reported as invisible
           despite genuinely working once found). position:absolute
           anchors it to .widget-block/.widget-group's own box (both
           position:relative), not to whatever row it's DOM-nested in, so
           it stays a standalone sibling of .item-controls either way.

           No border/background/circle chrome (dropped in favor of a
           plain glyph, was a solid outlined circle before, read as a
           separate floating button glued on top of the card rather than
           part of it) - findability comes from the fixed bottom-right
           position + a hover-only background swap below, not from
           permanent chrome. Stays at the SAME position/mechanism as
           before regardless (floating, absolutely anchored to the card's
           own corner) - a previous round already tried grouping it
           elsewhere and reverted (see this comment's own note two
           paragraphs up), so only the visual weight changes here, not
           where it lives or how it's found. #}
        .item-resize-handle { display: none; width: 1.8rem; height: 1.8rem; border: 0; border-radius: 6px;
            align-items: center; justify-content: center; color: var(--admin-muted); cursor: ew-resize; touch-action: none;
            background: transparent; padding: 0; font: inherit; flex-shrink: 0;
            position: absolute; bottom: .6rem; right: .6rem; z-index: 2; transition: background .15s ease, color .15s ease; }
        body.is-customizing .item-resize-handle { display: flex; }
        {# .item-settings (analytics_card's/article_views' own gear, see
           each template's own comment) is a standalone sibling button
           like .item-resize-handle above, not a descendant of the
           generic .item-controls row (which already gates handle/toggle/
           remove via `body.is-customizing` at its OWN container level) -
           it needs this same display:none/is-customizing pair on its own
           class, or it stays visible to every viewer at all times
           (a permanent edit-only affordance leaking into the normal,
           non-customizing dashboard view). #}
        .item-settings { display: none; }
        body.is-customizing .item-settings { display: flex; }
        .item-resize-handle:hover, .item-resize-handle.is-resizing { background: var(--admin-bg); color: var(--admin-accent); }
        .item-resize-handle i { font-size: .85rem; }
        .admin-resize-ghost { position: fixed; border: 2px dashed var(--admin-accent); border-radius: var(--admin-radius);
            background: rgba(37,99,235,.08); pointer-events: none; z-index: 1000; }
        @supports (background: color-mix(in srgb, red 8%, transparent)) {
            .admin-resize-ghost { background: color-mix(in srgb, var(--admin-accent) 8%, transparent); }
        }
        .admin-resize-ghost-badge { position: absolute; top: .5rem; right: .5rem; background: var(--admin-accent); color: #fff;
            font-size: .75rem; font-weight: 600; padding: .2rem .6rem; border-radius: 999px; }
        {# Armed while dragging one dashboard card over the INNER zone of
           another (see sticky-sortable.js's mergeable/findMergeTarget) -
           dropping here fuses the two into a composite instead of
           reordering. Solid accent outline (not dashed, unlike the resize
           ghost) so it reads as "land HERE, on this exact card" rather
           than the resize ghost's "resize to roughly this size" preview. #}
        .is-merge-target { outline: 3px solid var(--admin-accent); outline-offset: -3px; background: rgba(37,99,235,.08); }
        @supports (background: color-mix(in srgb, red 8%, transparent)) {
            .is-merge-target { background: color-mix(in srgb, var(--admin-accent) 8%, transparent); }
        }
        {# merge/split both do a real server round trip (~0.7-1s on this
           dev-mode environment, measured live) - this is what makes that
           wait visibly "something is happening" instead of looking inert
           (see the pendingKeys comment in the script below for why that
           mattered: no feedback read as broken and invited a duplicate
           click/drop for the same card). A gentle pulse, not a spinner -
           the card's own content stays fully legible the whole time. #}
        .is-busy { animation: admin-busy-pulse 1s ease-in-out infinite; cursor: wait; }
        @keyframes admin-busy-pulse { 0%, 100% { opacity: 1; } 50% { opacity: .55; } }
        .item-handle { cursor: grab; touch-action: none; }
        body.is-customizing [data-sortable-item] { cursor: default; }
        .is-dragging { opacity: .85; box-shadow: 0 8px 20px rgba(0,0,0,.18); border-radius: 6px; background: var(--admin-surface); }
        .is-sortable-placeholder { border: 2px dashed var(--admin-border); border-radius: 6px; margin: .15rem 0; }
        .widget-controls { position: absolute; top: .6rem; right: .6rem; }
        .widget-group, .widget-block { position: relative; }
        #admin-customize-done { display: none; }
        body.is-customizing #admin-customize-done { display: inline-flex; }
        .admin-sidebar-footer { display: flex; align-items: center; justify-content: center; gap: .5rem; padding: .9rem 1.25rem; border-top: 1px solid var(--admin-border); flex-shrink: 0; }
        {# Collapsed rail is ~4.5rem wide - a horizontal row of up to 4
           icon buttons (home/stats/exit/collapse-toggle) doesn't fit that
           width and either overflows or crowds together. Stacked as a
           column instead, matching how the main menu itself is already
           one icon per row once collapsed. #}
        html.is-sidebar-collapsed .admin-sidebar-footer { flex-direction: column; padding: .9rem .5rem; gap: .6rem; }
        {# Hidden until explicitly toggled open (data-stats-toggle) - see the
           delegated click handler in the script below. #}
        .admin-sidebar-stats { display: none; flex-shrink: 0; padding: .9rem 1.25rem 1.1rem; border-top: 1px solid var(--admin-border); }
        .admin-sidebar-stats.is-open { display: block; }
        [data-stats-toggle][aria-expanded="true"] { color: var(--admin-accent); border-color: var(--admin-accent); background: var(--admin-surface); }
        .admin-sidebar-stats .admin-analytics { font-size: .8rem; color: var(--admin-muted); }
        .admin-sidebar-stats .analytics-window { font-size: .72rem; text-transform: uppercase; letter-spacing: .04em; margin: .5rem 0 .2rem; }
        .admin-sidebar-stats .analytics-window:first-child { margin-top: 0; }
        .admin-sidebar-stats .row { margin: .1rem 0; }
        .admin-account { position: relative; }
        .admin-aside .brand[role=button] { cursor: pointer; }
        .admin-aside .brand[role=button]:hover { background: var(--admin-bg); }
        .admin-aside .brand .account-caret { flex-shrink: 0; font-size: .75rem; color: var(--admin-muted); transition: transform .15s; }
        .admin-account.is-open .brand .account-caret { transform: rotate(180deg); }
        .admin-account .admin-dropdown-menu { left: 1.25rem; right: 1.25rem; top: calc(100% - .3rem); }
        {# left/right:1.25rem resolves against .admin-account's OWN width -
           fine at 260px, but at the collapsed rail's 4.5rem it computes to
           a near-zero box with nothing to actually constrain the menu's
           real content (account/settings/logout labels), which just
           overflowed it and bled into the main content area next to the
           sidebar. Same "pop out to the right" treatment as the section
           flyout instead of trying to fit inside the rail at all. #}
        html.is-sidebar-collapsed .admin-account .admin-dropdown-menu {
            left: 100%; right: auto; top: 0; margin-left: .5rem; min-width: 13rem;
        }
        .admin-usermenu a i { width: 1.1rem; text-align: center; }
        {# Account header leading the dropdown. Non-interactive: it identifies
           the session, the items below act on it. #}
        {# Metrics lifted from the admin being replaced, measured live rather than
           eyeballed: 48px avatar at 14px radius, 13px muted label over a 14px
           regular-weight name. Beta had a 38px/8px avatar and a 600-weight name,
           which made the block read tighter and heavier than production's. #}
        .admin-usermenu-account {
            display: flex; align-items: center; gap: .65rem; padding: .45rem .5rem; cursor: default; }
        .admin-usermenu-avatar {
            width: 48px; height: 48px; border-radius: 14px; object-fit: cover; flex-shrink: 0;
            border: 1px solid var(--admin-border); background: var(--admin-surface); }
        .admin-usermenu-avatar-empty {
            display: inline-flex; align-items: center; justify-content: center; color: var(--admin-muted); }
        .admin-usermenu-identity { display: flex; flex-direction: column; min-width: 0; gap: .1rem; }
        .admin-usermenu-label { font-size: 13px; color: var(--admin-muted); line-height: 1.25; }
        .admin-usermenu-name {
            font-size: 14px; font-weight: 400; line-height: 1.25;
            overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        {# Qualified with .admin-menu li: that rule sets display:flex and a
           min-height of 2.4rem on every item, which outranked a bare
           .admin-usermenu-divider and inflated the hairline into a 2.4rem slab
           filled with the border colour. #}
        .admin-menu li.admin-usermenu-divider {
            display: block; min-height: 0; height: 1px; padding: 0;
            margin: .3rem .5rem; background: var(--admin-border); }
        {# Desktop/tablet default: the hamburger has nothing to do (.admin-
           aside is always in-flow there, see .admin-shell's flex layout
           above) so it stays hidden outside its own @media block below,
           which is the only place that flips it to display:flex. #}
        .admin-mobile-nav-toggle { display: none; }
        {# .admin-aside was a fixed 260px with NO narrower breakpoint at all
           - the widget-grid media query further down (max-width: 720px)
           reflows the dashboard's own content but leaves the sidebar
           untouched, so on an actual phone (~390px wide) it permanently
           ate two thirds of the viewport, leaving barely 130px for
           content: form fields and labels wrapped word-by-word and inputs
           ran off-screen. Reusing the desktop icon-rail collapse (is-
           sidebar-collapsed, above) doesn't fix this on its own either -
           it's an opt-in preference toggle, not an automatic breakpoint,
           and its hover-driven submenu flyouts don't work on touch anyway.
           Off-canvas instead: hidden by a translateX until explicitly
           opened via the hamburger button now in .admin-topbar, then
           slides in as a full-height overlay above the content rather
           than sharing width with it.

           The breakpoint is 1024px, not the 720px the rest of this
           stylesheet uses, because this rule is about horizontal ROOM
           rather than about being a phone. Every iPad in portrait is
           820-1024px wide: wide enough to escape a phone breakpoint,
           nowhere near wide enough to spend 373px of it on a permanent
           sidebar. On an 820px iPad that left ~450px for a 13-column
           datagrid - two columns of it visible. #}
        @media (max-width: 1024px) {
            .admin-mobile-nav-toggle { display: flex; }
            .admin-aside { position: fixed; top: 0; left: 0; transform: translateX(-100%); transition: transform .2s ease; box-shadow: 0 0 24px rgba(0,0,0,.25); }
            html.is-mobile-nav-open .admin-aside { transform: translateX(0); }
            {# Scroll lock while the overlay is open - otherwise the page
               underneath keeps scrolling with it (most visible on iOS
               Safari's rubber-band overscroll), which reads as the
               backdrop/sidebar not really being modal at all. #}
            html.is-mobile-nav-open { overflow: hidden; }
            {# z-index 18: below .admin-aside's own 20 (must not cover the
               open sidebar) but above .admin-topbar's 15 (must dim it, or
               the search bar/icon cluster would read as still usable while
               the nav is open). display:none by default even inside this
               query - is-mobile-nav-open is the only thing that ever shows
               it, but that class can only ever be set by clicking the
               toggle button above, which itself only exists at this same
               breakpoint, so the two never disagree in practice; kept
               explicit rather than relying on that indirectly. #}
            .admin-mobile-nav-backdrop { display: none; position: fixed; inset: 0; z-index: 18; background: rgba(0,0,0,.4); }
            html.is-mobile-nav-open .admin-mobile-nav-backdrop { display: block; }
        }
        {# position:relative so the flash stack can overlay INSIDE this
           column (see .flashes): absolute against the scrollable page
           rather than fixed to the viewport, so a notification scrolls
           away with the content it belongs to instead of following the
           reader down the page. #}
        .admin-main { flex: 1; padding: 1.5rem 2rem; min-width: 0; position: relative; }
        {# sticks right under the topbar (itself sticky at top:0) so the
           title/entity-actions stay reachable while scrolling a long form
           or datagrid, matching production - top offset matches the
           topbar's own rendered height (icon buttons + vertical padding). #}
        {# No shadow of its own - .admin-topbar directly above already casts
           one, and the two sitting flush against each other doubled up
           into a visibly darker band right at the seam between them. #}
        .admin-header { display: flex; align-items: center; gap: 1rem; margin: 0 -2rem 1.25rem; padding: 1rem 2rem;
                        position: sticky; top: 3.3rem; z-index: 14; background: var(--admin-bg); }
        .admin-header h1 { margin: 0; font-size: 1.35rem; }
        {# Detail-page shape: the record's own name is the heading and the
           CRUD name drops to a small line beneath it. The name can be a
           full article title, so it wraps rather than stretching the
           sticky header - clamped to two lines, with the full text on the
           element's title attribute. #}
        .admin-header-record { font-size: 1.35rem; line-height: 1.25; overflow-wrap: anywhere;
                               display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        {# The record's id, picked out of the muted subtitle line the way
           production picks it out - the one part of that line worth
           scanning for. #}
        .admin-header-subtitle .admin-header-suffix { color: var(--admin-accent); }
        {# The page's own icon in a rounded box before the title block -
           production's system pages lead with this (reported live as
           missing on beta). .admin-header is already a gapped flex row,
           the box just slots in as the first item. #}
        .admin-header-icon { display: flex; align-items: center; justify-content: center; width: 3.4rem; height: 3.4rem; flex-shrink: 0;
                             border: 1px solid var(--admin-border); border-radius: 12px; background: var(--admin-surface); font-size: 1.4rem; }
        .admin-header-titles { min-width: 0; }
        {# Which-language-am-I-editing chip for the in-place page title
           (see system.html.twig) - customize mode only, sits right by the
           editable heading's dashed outline. cursor:help + title attr
           carry the "switch language to translate" hint. #}
        .page-locale-badges { display: none; }
        {# Its own row under the subtitle, not a tail on the end of it: as an
           inline-flex the flag strip crowded the text it followed. `flex` +
           margin-top gives it a line of its own and lets the flags wrap when
           a site has more locales than fit. #}
        body.is-customizing .page-locale-badges {
            display: flex; flex-wrap: wrap; gap: .25rem; margin: .35rem 0 0; }
        {# The icon aligns with the TITLE, not with the centre of the whole
           titles block. Once the flag row appears the block grows downward, so
           centring pushed the icon below the title it belongs to and the header
           read as misaligned. #}
        .admin-header-icon { align-self: flex-start; margin-top: .1rem; }
        .page-locale-badge { display: inline-flex; align-items: center; padding: .2rem .3rem;
                             border: 1px solid var(--admin-border); border-radius: 5px; background: var(--admin-surface); }
        {# Inactive locales are links through _switch_locale - dimmed at
           rest so the ACTIVE flag reads as "you are editing this
           language" at a glance, full-strength on hover as the "click to
           edit that one instead" affordance. #}
        a.page-locale-badge { opacity: .4; cursor: pointer; }
        a.page-locale-badge:hover { opacity: 1; border-color: var(--admin-accent); }
        .page-locale-badge.is-active { border-color: var(--admin-accent); }
        .page-locale-badge img { width: 1.15rem; height: .85rem; object-fit: cover; border-radius: 2px; display: block; }
        {# The page-icon box doubles as its own edit surface in customize
           mode (see the popover handler below) - same dashed-outline
           affordance the editable titles use. #}
        body.is-customizing [data-page-icon] { cursor: pointer; }
        body.is-customizing [data-page-icon]:hover { outline: 1px dashed var(--admin-accent); outline-offset: 2px; }
        {# position:fixed + appended to <body>, same reasoning as the
           resize ghost: immune to any ancestor's overflow/stacking. #}
        .page-icon-popover { position: fixed; z-index: 100010; display: flex; flex-direction: column; gap: .5rem; padding: .6rem;
                             background: var(--admin-surface); border: 1px solid var(--admin-border); border-radius: var(--admin-radius);
                             box-shadow: 0 8px 24px rgba(0,0,0,.15); }
        .page-icon-popover-header { display: flex; gap: .5rem; align-items: center; }
        {# The input wrapper hosts the in-field spinner + clear ✕ at its
           right edge - padding-right on the input keeps typed text from
           sliding under them. #}
        {# display:flex is what actually centres the two absolutely-positioned
           overlays (spinner, clear button). They anchor to THIS box and use
           top:50%/translateY(-50%), so they centre on the wrapper's height,
           not the input's - and with the input left inline-level the wrapper
           was ~15px taller than it (the line box adds descender space under
           an inline-block), dropping both overlays 7.5px below the input's
           real centre. Measured live; reported as the spinner looking
           offset. Flex collapses the wrapper onto the input's own height so
           the two centres coincide. #}
        .page-icon-search { position: relative; display: flex; align-items: center; }
        .page-icon-popover input { width: 15rem; padding: .35rem 3rem .35rem .5rem; border: 1px solid var(--admin-border); border-radius: 6px;
                                   font: inherit; font-size: .85rem; background: var(--admin-bg); color: inherit; }
        {# Selector is .page-icon-popover-scoped purely to WIN, not to scope:
           the spinner element also carries `fa-solid` (it is a
           fa-circle-notch), and FontAwesome ships
           `.fa-solid{display:var(--fa-display,inline-block)}` at the same
           (0,1,0) specificity as a bare `.icon-search-spinner`, loaded
           after this inline block - so document order handed FA the win and
           the spinner rendered permanently, spinning next to the clear
           button whether or not a search was in flight (reported live:
           "continuously displayed even after finish computing"). Two
           classes puts this at (0,2,0) so the default hidden state sticks;
           the .is-loading rule below is (0,3,0) and still wins over both. #}
        {# Centred by stretching top-to-bottom and flex-centring the glyph,
           NOT by top:50%+translateY(-50%) - this element carries fa-spin,
           and an ANIMATION on `transform` beats a static transform
           declaration outright, so the spin wiped out the -50% pull-back
           and left the icon sitting half its own height below centre
           (measured 7.5px low, while the identically-positioned clear
           button - no animation - centred perfectly). Stretching leaves
           `transform` free for fa-spin to own, and since the glyph ends up
           at the box's centre the rotation still reads as spinning in
           place. #}
        .page-icon-popover .icon-search-spinner { display: none; position: absolute; right: 1.9rem; top: 0; bottom: 0;
                                                  align-items: center; color: var(--admin-muted); pointer-events: none; }
        .page-icon-popover.is-loading .icon-search-spinner { display: flex; }
        .icon-search-clear { display: none; position: absolute; right: .35rem; top: 50%; transform: translateY(-50%);
                             width: 1.3rem; height: 1.3rem; padding: 0; border: 0; border-radius: 50%;
                             background: none; color: var(--admin-muted); font: inherit; line-height: 1; cursor: pointer; }
        .icon-search-clear:hover { background: var(--admin-border); color: var(--admin-text); }
        .page-icon-popover.has-term .icon-search-clear { display: flex; align-items: center; justify-content: center; }
        .page-icon-visibility { display: flex; align-items: center; gap: .4rem; padding: .35rem .5rem; border: 0; border-radius: 6px;
                                background: none; color: var(--admin-muted); font: inherit; font-size: .82rem; cursor: pointer; }
        .page-icon-visibility:hover { background: var(--admin-bg); color: var(--admin-text); }
        .page-icon-popover .page-icon-preview { width: 2.1rem; height: 2.1rem; flex-shrink: 0; display: flex; align-items: center; justify-content: center;
                                                border: 1px solid var(--admin-border); border-radius: 6px; }
        {# Fixed 8-per-row cells; the grid scrolls its own overflow (never
           the page) past ~4 rows. :empty collapses the search-in-flight /
           no-results state instead of leaving a hollow band. #}
        .page-icon-grid { display: grid; grid-template-columns: repeat(8, 2.1rem); gap: .25rem; max-height: 10rem; overflow-y: auto; }
        .page-icon-grid:empty { display: none; }
        .page-icon-cell { display: flex; align-items: center; justify-content: center; width: 2.1rem; height: 2.1rem;
                          border: 1px solid transparent; border-radius: 6px; background: none; color: inherit; font-size: 1rem; cursor: pointer; }
        .page-icon-cell:hover { border-color: var(--admin-accent); color: var(--admin-accent); background: var(--admin-bg); }
        .admin-header-subtitle { font-size: .82rem; color: var(--admin-muted); margin-top: .2rem; }
        {# The action row keeps its natural width; the TITLE gives ground. With
           both free to size themselves the heading took 551px of a 1165px
           header and squeezed the toolbar into 464px, wrapping it onto three
           lines. A long record title can ellipsize - the buttons cannot
           usefully shrink, and a toolbar that reflows every time the title gets
           longer is not a toolbar. #}
        {# The action bar is hoisted into the TOPBAR (see the script below), so it
           gets a full dedicated line at the very top instead of competing with
           the record title for the header's width. The search yields the space:
           it only needs to be large while you are typing in it. #}
        {# The search grows by flex-basis, not by a fixed input width: a fixed
           26rem pushed the icon cluster past the topbar's edge whenever the
           action bar left less room than that. Flex can only distribute space
           that exists, so the focused search now takes UP TO 26rem and stops
           where its neighbours begin - nothing overflows to hide. #}
        .admin-topbar .topbar-search { flex: 0 1 420px; min-width: 6rem; transition: flex-basis .18s ease; }
        .admin-topbar:has(.global-actions) .topbar-search { flex-basis: 13rem; }
        .admin-topbar .topbar-search:focus-within { flex-basis: 26rem; }
        .admin-topbar .topbar-search input { width: 100%; }
        .admin-topbar .global-actions {
            margin-left: auto; display: flex; align-items: center; flex-wrap: nowrap;
            {# NEVER shrinks: its buttons cannot compress, so letting the box
               shrink below its content made the buttons spill across the
               separator into the icon cluster. The search is the elastic
               element - it shrinks first (min-width below). #}
            gap: .4rem; flex: 0 0 auto;
            {# " | " between the groups: search | crud actions | user+settings.
               Drawn as hairlines on the bar itself rather than markup, so they
               exist exactly when the action bar does. #}
            padding: 0 1rem; align-self: stretch;
            border-left: 1px solid var(--admin-border);
            border-right: 1px solid var(--admin-border); }
        {# Nothing in the topbar may push the icon cluster off the end. #}
        .admin-topbar .global-actions .btn { white-space: nowrap; }
        .admin-topbar-icons { flex: 0 0 auto; }
        {# .admin-topbar-icons's own margin-left:auto (its base rule, further
           up) is what pushes it to the far right on pages with NO
           .global-actions in the topbar - but here .global-actions ALREADY
           has its own margin-left:auto to pull itself away from the search
           field. Two flex siblings each with margin-left:auto split the
           available space between BOTH auto-margins instead of pooling it
           into one gap - Filtres/Créer floating in the middle with a second
           empty gap before the icon cluster, rather than the two groups
           sitting together flush right (reported live). Cancelling it here
           leaves global-actions as the only element absorbing the leftover
           space, so everything after the search rides together as one
           right-anchored group. #}
        .admin-topbar:has(.global-actions) .admin-topbar-icons { margin-left: 0; }
        .admin-header .global-actions { margin-left: auto; display: flex; flex-wrap: wrap; justify-content: flex-end;
                                        gap: .4rem; flex: 0 0 auto; }
        .admin-header-titles { flex: 1 1 auto; min-width: 0; }
        .admin-header-record, .admin-header h1 { overflow-wrap: anywhere; }
        {# Narrow viewports: the header is a nowrap flex row, so the action
           buttons wrapped into a tall right-hand column and squeezed the title
           box down to ~26px - the heading then spilled out from under the
           buttons and read as overlapping them (seen on a 390px capture).
           Let the header itself wrap and give the actions their own full-width
           row underneath the title. #}
        {# 1024px rather than 720px, matching the off-canvas sidebar above and
           for the same reason: this is about horizontal room, not about being
           a phone. An edit page's action row (back / save / save-and-continue
           / view / prev / next) is ~750px on its own, so beside a title on an
           820px iPad it ran 44px off the side of the screen and took the whole
           page sideways with it. #}
        @media (max-width: 1024px) {
            .admin-header { flex-wrap: wrap; align-items: flex-start; }
            .admin-header-titles { flex: 1 1 auto; }
            .admin-header .global-actions {
                order: 3; width: 100%; margin-left: 0; justify-content: flex-start; }
        }
        .card { background: var(--admin-surface); border: 1px solid var(--admin-border); border-radius: var(--admin-radius); }
        {# Generic "no card chrome" toggle any dashboard widget can carry
           (see MenuItem::$background's own docblock) - .widget-group IS
           its own .card (same div, see that template's own comment) so
           strips itself directly; .widget-block is a wrapper AROUND its
           own .card (analytics-card.card/composite-card.card/...) so
           strips that child instead. welcome.html.twig only ever adds
           .card when widget.background is true in the first place (its
           own code-level default is false), so this selector simply has
           nothing to strip there most of the time - same bare, boxless
           end result either way, just reached through "no .card element"
           instead of "a .card element with its chrome stripped". #}
        .widget-group.no-card-bg, .widget-block.no-card-bg > .card {
            background: none; border-color: transparent; box-shadow: none;
        }
        {# Two button roles, one look, modelled on gandi.net's own buttons.
           A SECONDARY button is the same colour as the surface behind it -
           it reads as a link with a hit area, and does not compete with the
           one action that matters. The PRIMARY is a key cap: solid fill, a
           darker band along its bottom edge (inset 0 -3px) and a small drop
           shadow, so it looks like a physical key sitting above the page.

           Pressing it sinks the cap rather than tinting it: the bottom
           padding moves to the top and the edge disappears, which is what
           makes it feel like a key going down. That is the whole trick -
           no colour change is needed for the pressed state.

           The edge colour is derived from the fill with color-mix, so a
           variant only ever declares its own background and the two stay in
           step - including in dark mode, where a hand-picked pair drifts. #}
        {# 3px on every button, gandi's own radius - the cap used to be the only
           3px control in a sea of 6px ones, which is what made it look like a
           different component rather than the emphasised member of one family. #}
        .btn { display: inline-flex; align-items: center; justify-content: center; gap: .4rem;
               {# line-height set explicitly: an <a> inherits the body's 1.5 while
                  a <button> computes `normal` (~1.2), so two caps sitting side by
                  side rendered 36px and 42px tall. Declared at 1.2 - the compact
                  height the original button had - so every control matches it
                  whatever element it happens to be. #}
               line-height: 1.2;
               padding: .45rem .9rem; border-radius: 3px; border: 1px solid var(--admin-border);
               background: transparent; color: inherit; text-decoration: none; font-size: .9rem;
               cursor: pointer; transition: background .12s ease, border-color .12s ease, color .12s ease, box-shadow .12s ease; }
        {# Two tiers, after gandi.net's `.button--tertiary`: that button is neutral
           at rest and only tints on interaction - its face picks up a faint fill
           (#e0d9ff), a matching rim (#8566fe) and a matching key edge (#c2b3ff).

           Same mechanism here, but the tint follows the button's SEMANTIC rather
           than one fixed brand colour, so a destructive action reads red the
           moment you reach for it while sitting quiet in the layout until then.
           One custom property carries it: --btn-tone, defaulted to the accent and
           overridden per variant. Every interaction rule below is written against
           that single property, so adding a variant is one declaration, not four.

           Gandi's navbar also carries exactly ONE filled cap among six items - a
           cap only means "this is the action" while its neighbours lack one - so
           the cap is reserved for the committing action and everything else is
           neutral. #}
        .btn { --btn-tone: var(--admin-accent); }
        .btn-primary { --btn-tone: var(--admin-accent); }
        .btn-success { --btn-tone: var(--admin-success); }
        .btn-danger  { --btn-tone: var(--admin-danger); }
        .btn-warning { --btn-tone: var(--admin-warning); }

        {# Tier 2 - the default: neutral until touched. Text stays the body colour
           and only leans toward the tone on hover, so the cue is legible without
           shouting (mixing with --admin-text keeps it "faint" and keeps contrast
           in dark mode, where a raw danger red on a dark panel is harsh). #}
        .btn { background: transparent; border-color: transparent; color: inherit; box-shadow: none; }
        .btn:hover {
            border-color: transparent;
            color: color-mix(in srgb, var(--btn-tone) 72%, var(--admin-text));
            background: color-mix(in srgb, var(--btn-tone) 10%, transparent); }
        .btn:active {
            background: color-mix(in srgb, var(--btn-tone) 18%, transparent);
            color: color-mix(in srgb, var(--btn-tone) 85%, var(--admin-text));
            transform: translateY(1px); box-shadow: none; }

        {# Tier 1 - the key caps: the marked primary action ("Enregistrer" /
           "Créer", green) and the record's "Voir" link (accent, having no
           variant class). Secondary submits like "Enregistrer et continuer"
           stay flat on request - one committing key per bar. #}
        .global-actions .btn:is([data-primary-action], .action-detail),
        .admin-confirm-actions .btn-danger, .admin-confirm-actions .btn-primary,
        .modal-footer .btn-primary, .modal-footer .btn-success, .modal-footer .btn-danger {
            {# Measured off gandi's Log in at REST, which is the shape being asked
               for and the opposite of what was here: a WHITE face (#fff), a
               neutral 1px rim (#9999ac), a barely-there pale inset edge
               (#ebebf6), near-black text, and a soft blue-tinted drop shadow
               `rgba(20,20,96,.1) 0 4px 3px`. This was a saturated fill with white
               text on a dark edge - the inverse - which is why it read as loud
               and unrelated to the rest of the row.

               The semantic tone is kept, but as a *tint* rather than a fill: the
               rim and edge carry it faintly at rest and the face only takes
               colour on hover, exactly like gandi's own tertiary. #}
            --btn-edge: color-mix(in srgb, var(--btn-tone) 22%, var(--admin-surface));
            background: var(--admin-surface);
            color: color-mix(in srgb, var(--btn-tone) 42%, var(--admin-text));
            border: 1px solid color-mix(in srgb, var(--btn-tone) 32%, var(--admin-border));
            padding-bottom: calc(.45rem + 4px); transform: none;
            box-shadow: inset 0 -4px 0 0 var(--btn-edge),
                        0 4px 3px 0 color-mix(in srgb, var(--btn-tone) 14%, transparent); }
        .global-actions .btn:is([data-primary-action], .action-detail):hover,
        .admin-confirm-actions .btn-danger:hover, .admin-confirm-actions .btn-primary:hover,
        .modal-footer .btn-primary:hover, .modal-footer .btn-success:hover, .modal-footer .btn-danger:hover {
            background: color-mix(in srgb, var(--btn-tone) 14%, var(--admin-surface));
            border-color: color-mix(in srgb, var(--btn-tone) 55%, transparent);
            color: color-mix(in srgb, var(--btn-tone) 55%, var(--admin-text));
            --btn-edge: color-mix(in srgb, var(--btn-tone) 38%, var(--admin-surface));
            filter: none; }
        {# Pressed: the cap travels down onto its edge. Keeping a 1px edge (rather
           than dropping the inset outright) reads as depressed instead of gone
           flat, and darkening matters because :active is also :hover - the hover
           brightness alone made a pressed key come out lighter than a resting one. #}
        .global-actions .btn:is([data-primary-action], .action-detail):active,
        .admin-confirm-actions .btn-danger:active, .admin-confirm-actions .btn-primary:active,
        .modal-footer .btn-primary:active, .modal-footer .btn-success:active, .modal-footer .btn-danger:active {
            padding-bottom: calc(.45rem + 1px); transform: translateY(3px);
            filter: none;
            background: color-mix(in srgb, var(--btn-tone) 20%, var(--admin-surface));
            box-shadow: inset 0 -1px 0 0 var(--btn-edge),
                        0 1px 1px 0 color-mix(in srgb, var(--btn-tone) 12%, transparent); }

        .text-danger { color: var(--admin-danger); }
        {# A destructive *button* takes its danger as a tone, not as a permanent
           colour: the delete action in an edit header was a saturated red trash
           sitting among neutral controls, the single loudest thing on the page
           and louder than the submit itself. Neutral at rest, red the moment you
           reach for it - same rule as every other semantic button.

           !important is needed, reluctantly: a Bootstrap utility still reaches
           this admin as `.text-danger { color: red !important }` - note *pure*
           red, not --admin-danger - and !important outranks specificity, so the
           plain override lost. Matching it with a more specific !important is
           the only way to win without deleting their rule. #}
        .btn.text-danger { --btn-tone: var(--admin-danger); color: inherit !important; }
        {# Inside a data row the destructive action DOES carry its colour at
           rest: production paints it outright, and in a dense grid of near
           identical icon buttons "which one deletes" must not depend on
           hovering each. Only in a row - a toolbar keeps the neutral default. #}
        .datagrid td.actions .btn.text-danger {
            color: var(--admin-danger) !important; }
        .datagrid td.actions .btn.text-danger:hover {
            color: #fff !important; background: var(--admin-danger); }
        .btn.text-danger:hover {
            color: color-mix(in srgb, var(--btn-tone) 72%, var(--admin-text)) !important; }
        .btn.text-danger:active {
            color: color-mix(in srgb, var(--btn-tone) 85%, var(--admin-text)) !important; }
        {# A submit is in flight: lock the button that started it.
           transparentJS swaps the page over AJAX, so nothing about the
           button changes on its own - it stayed fully live and clickable
           while the request ran, with no sign anything was happening
           (reported live: "the button remains clickable many times and it
           isn't clear whether the click was successful").

           Driven by html.loading, which transparentJS sets for exactly the
           duration of the navigation, rather than by disabling the button in
           JS: a disabled attribute has to be un-set again, and any failure
           path that forgets leaves a permanently dead button. This state
           cannot get stuck - it disappears with the class.

           Scoped to .is-submitting - the button that was actually clicked -
           and NOT to every submit button on the page. html.loading is set for
           ANY navigation, so keyed on that alone a plain link click made
           "Enregistrer" dim and spin as though it were saving (reported
           live). The marker is added on the clicking button and cleared the
           moment loading ends. #}
        html.loading button[type="submit"].is-submitting,
        html.loading input[type="submit"].is-submitting {
            pointer-events: none; opacity: .6;
        }
        {# The spinner marks WHICH control is working - the settings form has
           its save button far from the field being edited, so dimming alone
           is easy to miss. #}
        html.loading button[type="submit"].is-submitting::after,
        html.loading input[type="submit"].is-submitting::after {
            content: ''; width: .8em; height: .8em; margin-left: .1em;
            border: 2px solid currentColor; border-right-color: transparent;
            border-radius: 50%; animation: admin-submit-spin .6s linear infinite;
        }
        @keyframes admin-submit-spin { to { transform: rotate(360deg); } }
        {# Row actions (edit/detail/goto/delete) carry only an icon, no
           label, but shared the same left/right padding as text buttons
           ("Filtrer", "Créer"...) - that padding is sized for text, so an
           icon alone sat inside a rectangle noticeably wider than tall,
           looking arbitrarily larger/smaller next to its neighbours
           depending on how much surrounding whitespace happened to render.
           Square, fixed-size buttons for icon-only actions fix that. #}
        .btn-icon { width: 2.1rem; height: 2.1rem; padding: 0; justify-content: center; flex-shrink: 0; }
        {# A datagrid can easily grow past the viewport width (many
           entities have 8-10+ index columns) - without its own scroll
           container that either overflows the whole page (fighting the
           sticky sidebar/header) or squeezes columns unreadably thin. #}
        .table-responsive { overflow-x: auto; }
        table.datagrid { width: 100%; min-width: max-content; border-collapse: collapse; }
        .datagrid th, .datagrid td { text-align: left; padding: .6rem .9rem; border-bottom: 1px solid var(--admin-border); white-space: nowrap; }
        .datagrid th a { color: inherit; text-decoration: none; }
        {# Tinted header row, like production's. Two reasons, one of them a
           correctness fix rather than taste: the sticky actions cell below
           needs an opaque background to cover the columns scrolling under
           it, and giving that to th.actions ALONE left the header showing a
           mismatched grey block over an otherwise transparent white row,
           with a hard edge slicing through the neighbouring column's label
           (seen live). Tinting the whole row makes the pinned cell
           indistinguishable from its siblings and anchors the header at the
           same time. #}
        .datagrid thead th { background: var(--admin-bg); }
        .datagrid tr:hover td { background: var(--admin-bg); }
        {# Row actions stay pinned to the right edge while the rest of the
           row scrolls under them (requested: keep view/edit/delete fixed,
           make the other columns scrollable). Wide grids scroll far enough
           that the actions used to end up off-screen, so acting on a row
           meant scrolling right, losing sight of which row you were on,
           then scrolling back.

           An OPAQUE background is what makes this work at all: a sticky
           cell still paints in normal table order, so with a transparent
           background the scrolled columns show straight through it.
           --admin-surface is the .card the table sits on, and the hover
           rule has to be repeated here or a hovered row's pinned cell
           keeps the resting colour while the rest of the row changes.
           The inset shadow on the left edge is the cue that content
           continues underneath rather than ending there. #}
        .datagrid td.actions, .datagrid th.actions { text-align: right; white-space: nowrap;
            position: sticky; right: 0; z-index: 5; background: var(--admin-surface);
            box-shadow: -8px 0 8px -8px rgba(0,0,0,.25); }
        .datagrid th.actions { background: var(--admin-bg); z-index: 6; }
        .datagrid tr:hover td.actions { background: var(--admin-bg); }
        .datagrid .actions a, .datagrid .actions button { margin-left: .35rem; }
        {# Sticky: on a full page of rows the pager sat below the fold, so
           reaching page 2 meant scrolling past 20 rows first. Pinned to the
           bottom of the datagrid card it is reachable from any scroll
           position, and it needs its own background + top border or the rows
           show through underneath it. #}
        .paginator { display: flex; align-items: center; gap: .75rem; padding: .75rem .9rem; color: var(--admin-muted); font-size: .9rem;
                     position: sticky; bottom: 0; z-index: 7;
                     background: var(--admin-surface); border-top: 1px solid var(--admin-border); }
        .paginator .pages { margin-left: auto; display: flex; gap: .25rem; }
        .paginator .page-current { background: var(--admin-accent); border-color: var(--admin-accent); color: #fff; cursor: default; }
        .paginator .pages-ellipsis { border: none; background: none; cursor: default; }
        dialog#admin-confirm { border: 1px solid var(--admin-border); border-radius: var(--admin-radius); background: var(--admin-surface);
                               color: inherit; padding: 1.5rem; max-width: 420px; box-shadow: 0 18px 50px rgba(0,0,0,.25); }
        dialog#admin-confirm::backdrop { background: rgba(15, 23, 42, .45); backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px); }
        dialog#admin-confirm p { margin: 0 0 1.25rem; }
        .admin-confirm-actions { display: flex; justify-content: flex-end; gap: .5rem; }
        {# Was `.btn-danger { background: var(--admin-danger) }` - a leftover that
           filled every destructive button everywhere and overrode the neutral
           default below it in the cascade. The tone system handles the colour
           now; only the confirm cap is filled. #}
        .form-footer-danger { border-top: none; padding-top: 0; }
        form.admin-form .form-grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 0 1.25rem; padding: 1.25rem; }
        form.admin-form .form-row { grid-column: span var(--col-span, 12); min-width: 0; margin-bottom: 1rem; }
        {# page/system.html.twig (Settings + API keys) - not a 12-col field
           grid like .form-grid above (it has only up to 3 top-level
           children: intl/unv/valid, each already a self-contained block,
           see that template's own comment), just the same padding so its
           content doesn't sit flush against the card's border. #}
        form.admin-form .system-form-body { padding: 1.25rem; }
        form.admin-form .system-form-body .form-translatable + .form-translatable { margin-top: 1.5rem; }
        {# Section headers (settings page's own intl/unv split - see
           SystemController::renderSystemPage()) - a plain heading, not a
           bordered/backgrounded box: this is a divider between two parts
           of ONE form, not a separate card-within-a-card (see
           .form-password's own comment below for why boxes-within-boxes
           were removed from this same page). #}
        form.admin-form .system-form-group-title { font-size: 1rem; font-weight: 700; margin: 0 0 1rem; padding-bottom: .5rem; border-bottom: 1px solid var(--admin-border); }
        form.admin-form .system-form-group-title:not(:first-child) { margin-top: 2rem; }
        form.admin-form label { display: block; font-weight: 600; margin-bottom: .3rem; }
        {# `color: inherit` next to `font: inherit`, and it is not decoration:
           form controls are the one place `color` does NOT inherit. The UA
           gives input/select/textarea `color: fieldtext` (and buttons
           `buttontext`), which resolves against the page's color-scheme -
           so with only `font: inherit` here, every field's TEXT stayed the
           light-mode system black while its background followed
           --admin-bg into the dark theme: black on #16181d, effectively
           unreadable (reported live). Bootstrap's reboot ships exactly
           this line; the admin loads no Bootstrap, so it has to. The
           `color-scheme` declaration up in :root fixes the same root cause
           for the native chrome CSS can't reach - keep both. #}
        form.admin-form input[type=text], form.admin-form input[type=email], form.admin-form input[type=number],
        form.admin-form input[type=password], form.admin-form select, form.admin-form textarea {
            width: 100%; padding: .5rem .65rem; border: 1px solid var(--admin-border); border-radius: 6px; font: inherit; color: inherit; background: var(--admin-surface);
        }
        {# Editable fields are white; the page grey is reserved for controls you
           genuinely cannot type into. This was --admin-bg for *every* control,
           so an enabled field looked exactly like a disabled one - a live
           comparison shows production giving editable inputs #fff and greying
           only the read-only slug. Restoring that distinction. #}
        form.admin-form input:disabled, form.admin-form select:disabled, form.admin-form textarea:disabled,
        form.admin-form input[readonly], form.admin-form textarea[readonly] {
            background: var(--admin-bg); color: var(--admin-muted); cursor: not-allowed;
        }
        {# base-async.scss paints .form-errors as a lightpink/lightcoral box - an
           EasyAdmin-era look this admin doesn't use, showing errors as plain red
           text instead. The admin was only overriding the colour, so the box's
           background and border survived; with padding reset to 0 elsewhere in
           that same stylesheet an *empty* container collapsed to a 2px pink line
           drawn under every single field, error or not. Drop the box here (the
           public site keeps it) and hide the container entirely when empty. #}
        form.admin-form .form-errors { color: var(--admin-danger); font-size: .85rem; margin-top: .25rem;
            background: none; border: 0; padding: 0; }
        form.admin-form .form-errors:empty { display: none; }
        @media (max-width: 720px) {
            form.admin-form .form-row { grid-column: span 12 !important; }
            {# Side padding is a luxury of a wide screen. Between .admin-main's
               2rem and .form-grid's 1.25rem, a 390px phone spent 104px - over
               a quarter of the viewport - on empty margin, which the content
               column pays for: the article editor was left a 261px measure,
               hyphenating mid-word every second line. Trimmed here rather
               than in either rule's base value so nothing about the desktop
               layout moves. #}
            .admin-main { padding-left: .85rem; padding-right: .85rem; }
            form.admin-form .form-grid { padding-left: .75rem; padding-right: .75rem; }
            {# .admin-topbar and .admin-header bleed to the edge of the column
               with a -2rem margin that cancels .admin-main's padding exactly.
               Trim the padding without trimming these and the cancellation
               overshoots by the difference on each side - the topbar grew 37px
               wider than the viewport and the whole page scrolled sideways.
               They have to move together. #}
            .admin-topbar { margin-left: -.85rem; margin-right: -.85rem; }
            .admin-header { margin-left: -.85rem; margin-right: -.85rem;
                            padding-left: .85rem; padding-right: .85rem; }
        }
        {# BooleanField's confirm-modal markup (form_div_layout.html.twig) is
           Bootstrap ".modal fade" markup: it only ever hides/shows via
           Bootstrap's own CSS+JS, neither of which this package loads (no
           Bootstrap anywhere in the admin by design) - so it's permanently
           inert either way, and left unstyled it renders as a big block of
           plain in-flow text. Hiding it isn't a functional regression, just
           containment of dead markup until/unless a real confirm
           interaction is built for it. #}
        .modal.fade { display: none; }
        {# ...but it IS shown, by BooleanField's confirm dialog ("Action
           demandée sur ...", Annuler/Confirmer) and by the image-preview
           dialogs. Bootstrap's JS reveals a modal with an INLINE
           display:block, which beats the rule above - and with no Bootstrap
           CSS loaded the markup then has no overlay geometry at all, so it
           landed as a block of plain text in the middle of the form
           (reported live: "wrong modal positioning").

           Given real geometry here instead of hiding it harder: the dialog
           is a genuine interaction, it just had no styling to arrive in.
           Both reveal shapes are matched - the .show class and the inline
           display - so it works whether Bootstrap's JS is present or a
           consumer toggles the style directly. #}
        .modal.fade.show,
        .modal.fade[style*="display: block"],
        .modal.fade[style*="display:block"] {
            display: flex !important; position: fixed; inset: 0; z-index: 100030;
            align-items: center; justify-content: center;
            background: rgba(0, 0, 0, .45);
            {# Padding, not an inset offset: the element IS the backdrop, so it
               must stay edge-to-edge or the sidebar shows through un-dimmed.
               Padding shifts the flex-centred dialog onto the content column
               instead - same placement as .filter-modal. #}
            padding: 1rem 1rem 1rem calc(1rem + var(--admin-aside-w));
        }
        .modal .modal-dialog { width: min(30rem, 100%); margin: 0; }
        .modal .modal-content { background: var(--admin-surface); border: 1px solid var(--admin-border);
                                border-radius: 10px; box-shadow: 0 20px 60px rgba(0, 0, 0, .35); overflow: hidden; }
        .modal .modal-header { display: flex; align-items: center; justify-content: space-between;
                               gap: .5rem; padding: .7rem 1rem; border-bottom: 1px solid var(--admin-border); }
        .modal .modal-body { padding: 1rem; }
        .modal .modal-footer { display: flex; align-items: center; justify-content: flex-end; gap: .5rem;
                               padding: .7rem 1rem; border-top: 1px solid var(--admin-border); }
        .modal .btn-close { border: 0; background: none; cursor: pointer; color: var(--admin-muted);
                            font-size: 1.1rem; line-height: 1; padding: .2rem .35rem; border-radius: 6px; }
        .modal .btn-close:hover { background: var(--admin-bg); color: var(--admin-text); }
        .modal img { max-width: 100%; height: auto; display: block; }
        {# select2/tag widgets otherwise compute their own fixed pixel width
           from the underlying <select> at init time, which can end up
           narrower than - or fail to track - their actual CSS grid column
           once ->setColumns() puts them in something less than the full
           12-span. Forcing 100% keeps them honest to the grid track. #}
        form.admin-form .select2-container { width: 100% !important; }
        .select2-avatar { width: 1.3rem; height: 1.3rem; border-radius: 50%; object-fit: cover; vertical-align: middle; flex-shrink: 0; }
        .field-avatar-thumb { width: 2rem; height: 2rem; border-radius: 50%; object-fit: cover; }
        {# select2's vendored "bootstrap4" theme is a fixed light palette -
           it never adapts to the admin's own light/dark toggle, so every
           select2-enhanced field (Authors, Tags, Keywords, Icon, ...) stayed
           a stark white box against an otherwise dark page. Re-themed with
           the same CSS variables as the rest of the admin. Written twice
           (explicit data-theme="dark" + the @media/auto case) rather than
           combined into one selector list, since mixing a plain selector
           and an @media block in one comma-separated prelude is invalid
           CSS and silently drops the whole rule. #}
        :root[data-theme="dark"] .select2-container--bootstrap4 .select2-selection {
            background: var(--admin-bg); border-color: var(--admin-border); color: var(--admin-text);
        }
        :root[data-theme="dark"] .select2-selection__rendered { color: var(--admin-text); }
        :root[data-theme="dark"] .select2-selection__placeholder { color: var(--admin-muted); }
        :root[data-theme="dark"] .select2-selection__arrow b { border-color: var(--admin-muted) transparent transparent transparent; }
        :root[data-theme="dark"] .select2-selection__choice {
            background: var(--admin-surface); border-color: var(--admin-border); color: var(--admin-text);
        }
        :root[data-theme="dark"] .select2-selection__choice__remove { color: var(--admin-muted); }
        :root[data-theme="dark"] .select2-dropdown {
            background: var(--admin-surface); border-color: var(--admin-border); color: var(--admin-text);
        }
        :root[data-theme="dark"] .select2-search__field {
            background: var(--admin-bg); border-color: var(--admin-border); color: var(--admin-text);
        }
        :root[data-theme="dark"] .select2-results__option { color: var(--admin-text); }
        {# Already-selected entries (shown disabled, greyed out in the
           dropdown list under their own chip up top) - select2-bootstrap4's
           theme paints these with a hardcoded near-white background
           (#e9ecef) that was never re-themed, so in dark mode it read as
           barely-legible light text on a near-white box (reported live on
           the Tags field, e.g. an already-picked "Voyages" ghosting out
           against a white row). #}
        :root[data-theme="dark"] .select2-results__option[aria-selected="true"]:not(.select2-results__option--highlighted) {
            background: var(--admin-bg); color: var(--admin-muted);
        }
        :root[data-theme="dark"] .select2-results__option--highlighted { background: var(--admin-accent) !important; color: #fff !important; }
        :root[data-theme="dark"] .select2-results__group { color: var(--admin-muted); }
        @media (prefers-color-scheme: dark) {
            :root:not([data-theme="light"]) .select2-container--bootstrap4 .select2-selection {
                background: var(--admin-bg); border-color: var(--admin-border); color: var(--admin-text);
            }
            :root:not([data-theme="light"]) .select2-selection__rendered { color: var(--admin-text); }
            :root:not([data-theme="light"]) .select2-selection__placeholder { color: var(--admin-muted); }
            :root:not([data-theme="light"]) .select2-selection__arrow b { border-color: var(--admin-muted) transparent transparent transparent; }
            :root:not([data-theme="light"]) .select2-selection__choice {
                background: var(--admin-surface); border-color: var(--admin-border); color: var(--admin-text);
            }
            :root:not([data-theme="light"]) .select2-selection__choice__remove { color: var(--admin-muted); }
            :root:not([data-theme="light"]) .select2-dropdown {
                background: var(--admin-surface); border-color: var(--admin-border); color: var(--admin-text);
            }
            :root:not([data-theme="light"]) .select2-search__field {
                background: var(--admin-bg); border-color: var(--admin-border); color: var(--admin-text);
            }
            :root:not([data-theme="light"]) .select2-results__option { color: var(--admin-text); }
            :root:not([data-theme="light"]) .select2-results__option[aria-selected="true"]:not(.select2-results__option--highlighted) {
                background: var(--admin-bg); color: var(--admin-muted);
            }
            :root:not([data-theme="light"]) .select2-results__option--highlighted { background: var(--admin-accent) !important; color: #fff !important; }
            :root:not([data-theme="light"]) .select2-results__group { color: var(--admin-muted); }
        }
        {# The system-settings pages (API keys, site settings) build their
           form straight from base-bundle's raw PasswordType/BooleanType/
           RouteType/etc - form_rest(form) - never going through a CRUD
           FieldDescriptor, so none of the .form-grid/.form-row markup
           above applies to them. That raw markup is Bootstrap-shaped
           (.form-group/.input-group/.input-group-text/.form-check) but,
           like the confirm-modal above, no Bootstrap CSS loads here - left
           unstyled the icon addon and input stack vertically instead of
           sitting side by side, and every field looks structurally broken
           rather than just plain. #}
        {# The settings/API-key pages (LayoutSettingListType) nest a real
           field up to 4 .form-group levels deep (AssociationType wrapping
           TranslationType wrapping a per-locale collection wrapping the
           actual label+input) - found live via raw HTML inspection, not
           visible from the rendered page alone. The old rule below applied
           margin-bottom to EVERY level via a plain descendant selector, so
           the same field's spacing got counted 3-4 times over, stacking
           into ~120px between two single-line fields that should read as
           adjacent rows. Only the INNERMOST .form-group - the one that
           actually contains a .label-wrapper - is a real visual "row";
           every other .form-group in the chain is pure structural
           wrapping and should contribute nothing. #}
        form.admin-form .form-group { margin-bottom: 0; }
        form.admin-form .form-group:has(> .label-wrapper),
        form.admin-form .form-group:has(> span > .label-wrapper) { margin-bottom: 1rem; }
        {# Same nesting chain also lands a bare structural <div> with class
           "form-control" (a wrapper the underlying vendor form template
           reuses for the value slot, unrelated to this admin's own CSS -
           grep confirms this admin stylesheet never styles .form-control
           itself; real text inputs get their padding from the shared
           easyadmin/stylesheet.css .form-control rule instead). That rule
           doesn't distinguish "a real input" from "a plain layout div" -
           found live adding an extra 12px top+bottom on every single
           field via a div that renders no visible content of its own.
           Scoped to the tag, not the class, so real
           input/textarea/select.form-control elsewhere are untouched. #}
        form.admin-form div.form-control { padding: 0; border: 0; background: transparent; }
        {# .form-entity/.form-collection-items/.form-association normally
           carry their own padding+border (see the shared easyadmin
           stylesheet's `.form-entity > .form-group { padding: 1em 0; }`
           and this file's own `.form-collection-items` rule below) - real,
           deliberate chrome for an actual repeatable collection UI
           elsewhere in the admin. On these system pages specifically
           (LayoutSettingListType) every field gets wrapped in this SAME
           collection machinery even though there's only ever exactly one
           "item" per field - no add/remove UI, nothing to visually group -
           so it was purely adding compounding padding on top of the
           .form-group margin already covering per-field spacing above.
           Scoped to .system-form-body so genuine collection fields
           elsewhere (a real repeatable list) keep their bordered box. #}
        form.admin-form .system-form-body .form-entity,
        form.admin-form .system-form-body .form-collection-items,
        form.admin-form .system-form-body .form-association { padding: 0; margin: 0; border: 0; }
        {# `.form-translatable .tab-pane > div:first-child { padding: 0.5em
           0 0 0; }` (shared easyadmin stylesheet) means "first field in
           this locale tab" on an ordinary translatable entity form - here
           each field gets its OWN private single-item collection wrapper,
           so that wrapper is ALWAYS its collection's only/first child
           regardless of the field's position on the page, recurring on
           every single field instead of just the page's actual first
           one. #}
        form.admin-form .system-form-body .form-translatable .tab-pane > div:first-child { padding-top: 0; }
        {# `.form-password > .form-group { padding: 1em 0.5em 1em 0; }`
           (base-async.css, the old EasyAdmin dashboard bundle's
           stylesheet - still loaded sitewide, see this file's own earlier
           comment on why: unstyled input-group/form-check otherwise) -
           the API-key page's password fields sit directly inside
           .form-password, so every one of them picked up an extra 30px
           (1em top + 1em bottom) on top of the .form-group margin already
           covering row spacing above. Found live via matched-CSS-rule
           inspection, not visible from grep alone (selector never
           mentions anything specific to this page). #}
        form.admin-form .system-form-body .form-password > .form-group { padding: 0; }
        form.admin-form .label-wrapper { display: flex; align-items: center; gap: .4rem; margin-bottom: .3rem; }
        {# Two rows of textarea reads as a slot for a filename, not a paragraph -
           Excerpt is prose. Height, not rows: the attribute comes from the form
           theme and varies per field. #}
        form.admin-form textarea { min-height: 6.5rem; resize: vertical; }
        {# base-async draws the collection frame in hardcoded `lightgrey` (and
           its entry separators in `lightgrey !important`). Invisible on a light
           page, glowing on a dark one. Retinted with the theme tokens - the
           separator override must carry !important to outrank theirs. #}
        {# overflow: clip is what makes the rounding REAL - the first and last
           entry are square boxes, and without clipping their corners poke
           through the frame's radius. Entries then drop their own borders in
           favour of hairline separators, so the group reads as one rounded
           panel of rows rather than a stack of boxes. #}
        form.admin-form .form-collection { border-color: var(--admin-border); border-radius: 8px; overflow: clip; }
        form.admin-form .form-collection .accordion-item {
            border: 0; border-radius: 0; margin-bottom: 0; }
        form.admin-form .form-collection .form-collection-item + .form-collection-item .accordion-item,
        form.admin-form .form-collection .accordion-item + .accordion-item {
            border-top: 1px solid var(--admin-border); }
        form.admin-form .form-collection .form-collection-items .form-collection-item:not(.form-collection-item-last) {
            border-bottom-color: var(--admin-border) !important; }
        {# Collapsible collection entries. The markup is Bootstrap's accordion
           (data-bs-toggle="collapse" + .accordion-collapse.collapse), but this
           admin ships no Bootstrap, so neither the CSS that hides a collapsed
           panel nor the JS that toggles it existed: every entry rendered fully
           expanded. On a record with many related rows that is a wall of
           sub-forms, and each one pulls its own related data - the N+1 this was
           reported as. Collapsed is the resting state; the header opens one on
           demand. #}
        form.admin-form .accordion-collapse.collapse:not(.show) { display: none; }
        form.admin-form .accordion-item { border: 1px solid var(--admin-border); border-radius: 6px;
                                          margin-bottom: .4rem; background: var(--admin-surface); overflow: hidden; }
        form.admin-form .accordion-header { margin: 0; }
        form.admin-form .accordion-button {
            display: flex; align-items: center; gap: .5rem; width: 100%; text-align: left;
            padding: .5rem .7rem; border: 0; background: none; color: inherit; font: inherit;
            cursor: pointer; }
        {# Row-level hover: the whole entry tints, not just the header strip, and
           nothing about it may move - background only, no border/padding/size
           change anywhere in the hover path. #}
        form.admin-form .accordion-button:hover { background: color-mix(in srgb, var(--admin-accent) 6%, var(--admin-bg)); }
        form.admin-form .accordion-item:has(> .accordion-header > .accordion-button:hover) { background: var(--admin-bg); }
        {# The chevron IS the affordance - without Bootstrap's own ::after there
           was nothing to say a row could be opened. Rotates when expanded. #}
        form.admin-form .accordion-button::after {
            content: "\f078"; font-family: "Font Awesome 6 Free"; font-weight: 900;
            margin-left: auto; font-size: .75rem; color: var(--admin-muted);
            transition: transform .15s ease; }
        form.admin-form .accordion-button:not(.collapsed)::after { transform: rotate(180deg); }
        form.admin-form .accordion-body { padding: .7rem; border-top: 1px solid var(--admin-border); }
        {# Icons in a collection header are metadata chips, not content: muted
           and evenly spaced so they read as one group beside the label rather
           than a row of loose glyphs. #}
        form.admin-form .form-collection-item .label-wrapper i,
        form.admin-form .accordion-button i { color: var(--admin-muted); font-size: .8rem; }
        form.admin-form .accordion-button .badge.label { margin-left: .25rem; }
        {# "Load N more" for a windowed collection. Reads as one of the entry
           rows rather than a page control, since that is where it sits. #}
        form.admin-form .form-collection-more {
            display: flex; align-items: center; justify-content: center; gap: .45rem;
            width: 100%; margin-top: .1rem; padding: .45rem .7rem;
            border: 1px dashed var(--admin-border); border-radius: 3px;
            background: var(--admin-surface); color: var(--admin-muted);
            font: inherit; font-size: .85rem; cursor: pointer; }
        form.admin-form .form-collection-more:hover {
            border-color: color-mix(in srgb, var(--admin-accent) 45%, transparent);
            color: var(--admin-accent); }
        form.admin-form .form-collection-more.is-loading { opacity: .6; cursor: progress; }
        form.admin-form .form-collection-more.has-error { border-color: var(--admin-danger); color: var(--admin-danger); }
        {# Per-entry actions (copy / preview / open) are bare <a> elements with
           no class, so with no CSS reset they rendered as browser-default links:
           rgb(0,0,238) and underlined. FLAT on request - a muted glyph that
           tints on hover, matching the action bar's own flat tier; the key-cap
           variant tried here read as heavier than the row it decorates. #}
        form.admin-form .form-collection-item a:has(> i:only-child),
        form.admin-form .form-collection-items a:has(> i:only-child) {
            display: inline-flex; align-items: center; justify-content: center;
            width: 1.9rem; height: 1.8rem; border: 0; border-radius: 5px;
            background: transparent; color: var(--admin-muted); text-decoration: none;
            transition: background .12s ease, color .12s ease; }
        form.admin-form .form-collection-item a:has(> i:only-child):hover,
        form.admin-form .form-collection-items a:has(> i:only-child):hover {
            background: color-mix(in srgb, var(--admin-accent) 10%, transparent);
            color: var(--admin-accent); }
        form.admin-form .form-collection-item a:has(> i:only-child):active,
        form.admin-form .form-collection-items a:has(> i:only-child):active {
            background: color-mix(in srgb, var(--admin-accent) 17%, transparent); }
        form.admin-form .form-collection-item a > i, form.admin-form .form-collection-items a > i {
            font-size: .9rem; }
        {# The translatable group carries padding-left:15px to indent its fields
           under the locale tab strip. renderSingleLocale() hides that strip, so
           the indent had nothing to sit under and every sub-field from Title
           down was nudged 15px right of Tags/Slug above it - a visible step in
           the form's left edge. No strip, no indent. #}
        {# !important to match base-async's own `.form-translatable { padding:
           0 1em !important }` - specificity alone loses to it. #}
        form.admin-form .form-translatable.form-group { padding-left: 0 !important; padding-right: 0 !important; }

        {# Editor and dropzone are input surfaces and should look like one. Both
           render as bare DIVs, so they missed the input rule (which targets
           input/select/textarea) and base-async explicitly strips the background
           off a non-input .form-control - leaving Content and Audio as floating
           text on the page with no outline at all. #}
        form.admin-form .form-editor-codex,
        form.admin-form .dropzone.form-control {
            background: var(--admin-surface); border: 1px solid var(--admin-border);
            border-radius: 6px; padding: .5rem .65rem; box-sizing: border-box; }
        form.admin-form .form-editor-codex:focus-within {
            border-color: var(--admin-accent); }
        {# The "open in a new tab" affordance beside a related record was rendering
           at rgb(0,0,238) - the browser's default unvisited-link blue, not our
           accent. This admin ships no CSS reset, so a bare <a> keeps the UA
           colour; eight of them per edit form read as loud blue squares. Muted
           by default, accent on hover, like every other secondary affordance. #}
        form.admin-form .fa-external-link-square-alt,
        form.admin-form a:has(> .fa-external-link-square-alt) { color: var(--admin-muted); }
        form.admin-form a:hover > .fa-external-link-square-alt,
        form.admin-form a:has(> .fa-external-link-square-alt):hover { color: var(--admin-accent); }
        {# A wrapper with no label of its own is pure spacer + badges. This grid
           doesn't need the spacer (each .form-row stacks its own label), so all
           it produced was a database badge floating between Slug and Title with
           nothing to describe - the translation panel, whose sub-fields already
           carry their own badges. #}
        form.admin-form .label-wrapper-unlabelled { display: none; }
        form.admin-form .label-wrapper label { margin-bottom: 0; }
        {# Padding is deliberately tighter horizontally than vertically: the
           glyphs are wider than they are tall, so equal padding reads as too
           much air on the sides. .3rem/.3rem measured out lopsided next to a
           bold label - .25rem vertical against .3rem horizontal sits the chip
           on the label's own baseline block instead of floating beside it. #}
        form.admin-form .badge.label { display: inline-flex; align-items: center; gap: .3rem; padding: .25rem .3rem; border-radius: 5px;
                                       background: var(--admin-bg); color: var(--admin-muted); font-size: .72rem; line-height: 1; }
        {# fa-fw forces 1.25em fixed width per icon - inside this small
           chip that reads as lopsided horizontal padding around the
           glyph; natural width + the flex gap above spaces multi-icon
           chips (e.g. Mots-clés' database+clipboard pair) evenly. #}
        form.admin-form .badge.label .fa-fw { width: auto; }
        {# form_div_layout renders the badge span UNCONDITIONALLY and a
           string-replace fills it (see password2_row's own comment) - a
           field with no badges keeps the empty span, which painted as a
           bare gray padded blob next to its label. #}
        form.admin-form .badge.label:empty { display: none; }
        form.admin-form .input-group { display: flex; align-items: stretch; position: relative; }
        form.admin-form .input-group-text { display: flex; align-items: center; padding: 0 .65rem; border: 1px solid var(--admin-border);
                                            border-right: 0; border-radius: 6px 0 0 6px; background: var(--admin-bg); color: var(--admin-muted); flex: 0 0 auto; }
        {# Square off only the side an addon actually joins. This was a flat
           `border-radius: 0 6px 6px 0`, which assumes every addon is a LEFT
           prefix (true for the datetime calendar button). Slug's lock is an
           *append*, so the input stayed square on the free left edge and kept
           its rounded corner on the right - underneath the addon - which is
           what made the lock read as a detached, half-clipped chip. #}
        form.admin-form .input-group input, form.admin-form .input-group select { border-radius: 6px; }
        form.admin-form .input-group > .input-group-text:first-child ~ input,
        form.admin-form .input-group > .input-group-text:first-child ~ select {
            border-top-left-radius: 0; border-bottom-left-radius: 0; }
        form.admin-form .input-group:has(> .input-group-append) > input,
        form.admin-form .input-group:has(> .input-group-append) > select,
        form.admin-form .input-group:has(> .input-group-text:last-child) > input,
        form.admin-form .input-group:has(> .input-group-text:last-child) > select {
            border-top-right-radius: 0; border-bottom-right-radius: 0; }
        {# The append wrapper carries no border of its own, so the addon inside
           it has to close the group off: match the input's height and rounding
           and drop the doubled edge where the two meet. #}
        form.admin-form .input-group > .input-group-append {
            display: flex; align-items: stretch; }
        form.admin-form .input-group > .input-group-append > * {
            display: flex; align-items: center; padding: 0 .65rem;
            border: 1px solid var(--admin-border); border-left: 0;
            border-radius: 0 6px 6px 0; background: var(--admin-bg); color: var(--admin-muted); }
        form.admin-form .input-group .form-password-revealer { color: var(--admin-muted); }
        form.admin-form .input-group .form-password-revealer:hover { color: var(--admin-accent); }
        {# Safari renders its own password-AutoFill key button (a gray
           rounded chip) pinned at the right edge of every password input -
           the exact spot the revealer eye above absolutely positions
           itself into (base-async.css: right:.5em), so on the API-keys
           page the two icons stack on top of each other (reported live
           via screenshot). These admin fields are API keys/settings, not
           login credentials - Safari's saved-password UI is meaningless
           noise here, so suppress it rather than play placement chicken
           with it. Scoped to admin-form only: the login page is a real
           credential form where native AutoFill must keep working. #}
        form.admin-form input[type=password]::-webkit-credentials-auto-fill-button,
        form.admin-form input[type=password]::-webkit-strong-password-auto-fill-button {
            visibility: hidden; pointer-events: none; position: absolute; right: 0;
        }
        {# base-async.css's `.required:after` places the red dot with
           relative-offset nudges (right:5px; bottom:4px) tuned for the OLD
           EasyAdmin label metrics - under this layout's own label styles
           those offsets drag the dot back INTO the label's last letter
           (reported live via prod-vs-beta screenshots). rem-FIXED size,
           not em - the dot renders in very different font contexts (field
           labels, locale-tab flags) and an em-relative size made them
           visibly mismatched. Raised via position:relative/top, NOT
           vertical-align:super: super raises the dot IN LAYOUT, growing
           the line box - which pushed the flag image down on exactly the
           locale tabs that carry a required dot, visibly misaligning them
           against their dot-less siblings (reported live). A relative
           offset is purely visual and leaves every line box identical,
           dot or no dot. right/bottom explicitly neutralized or the base
           rule's own nudges come back with position:relative. #}
        form.admin-form .required::after { position: relative; top: -.4em; right: auto; bottom: auto;
                                           margin-left: .12rem; font-size: .85rem; line-height: 1; vertical-align: baseline; }
        {# Right-side addon (e.g. fileupload's ✕ deleteBtn): the base
           .input-group-text rule above assumes a LEFT prefix (border-right
           dropped, left corners rounded) - mirror it when the addon is the
           group's last child instead. #}
        form.admin-form .input-group > .input-group-text:last-child {
            border: 1px solid var(--admin-border); border-left: 0; border-radius: 0 6px 6px 0;
        }
        {# The datetime picker wraps its calendar icon in a .btn INSIDE the
           .input-group-text - .btn's own padding (.45rem .9rem) + border
           stacked on the addon's padding produced a bloated gray box with
           a tiny icon lost in it (reported live: "prefixed icons have
           padding issues"). Inside an addon the button is just an icon
           surface - flatten it. base-async's `.form-stock .input-group-text
           { padding-top:5px }` nudge is part of the same old-metrics tuning,
           zero it too. #}
        form.admin-form .input-group .input-group-text .btn {
            padding: 0; border: 0; background: none; color: inherit; font: inherit; box-shadow: none;
        }
        form.admin-form .input-group.form-stock .input-group-text { padding-top: 0; }
        form.admin-form .input-group .input-group-text { height: auto; min-height: 0; }
        {# Image upload: base-async's .imageupload IS already a flex row
           (figure left, field column right) - what it does NOT control is
           the field column's own internals, which the old EasyAdmin
           stylesheet used to lay out. base-async's `.fileupload .field
           { align-items:center; justify-content:center }` centers the
           file-input row as a shrink-to-fit box floating in the middle of
           the remaining width (reported live twice: "Choose File" box
           adrift top-right, ✕ half-detached above it). Stretch the column
           and pin the row to one full-width nowrap line instead. #}
        {# TOP-aligned like production (base-async's own align-items:start
           carries through untouched) - a centering experiment here was
           explicitly rejected against the prod reference. Only the gap is
           ours. #}
        form.admin-form .imageupload { gap: 1.25rem; }
        {# margin:0, not just margin-right:0 - `figure` is one of the few
           elements with a NON-zero UA default margin (`1em 40px`), and this
           admin deliberately doesn't load Bootstrap, whose reboot
           (`figure{margin:0 0 1rem}`) is what neutralizes it in production.
           base-async only ever zeroes margin-bottom and sets margin-right,
           so the UA's margin-top:1em + margin-left:40px survived: the
           thumbnail sat 15px BELOW the top of the input row it should be
           flush with, and 40px in from the field's left edge (reported
           live against the prod reference - "image alignment"). Verified
           by matched-CSS-rule inspection: no project rule sets either. #}
        form.admin-form .imageupload figure { flex: 0 0 auto; margin: 0; border: 1px solid var(--admin-border); background: var(--admin-surface); }
        form.admin-form .imageupload .imageupload-field { flex: 1 1 0; min-width: 0; }
        form.admin-form .fileupload .field { align-items: stretch; justify-content: flex-start; }
        form.admin-form .fileupload .input-group.field-raw { display: flex; flex-flow: row nowrap; align-items: stretch; width: 100%; }
        {# height 38px !important = production's exact row height, measured
           live. This was `height:auto` for a while because the Choose-File
           button, then styled as a padded pill by the generic rules above,
           rendered TALLER than 38px and poked out of the strip - but auto
           only hid that symptom by letting the row grow to fit (it settled
           at 40px even after the button was fixed, since the button's
           border-box still overflows the 24px content box by design). The
           button is now sized to the row rather than the row to the
           button, so pinning is safe and exact; if you ever change the
           button's padding or font-size, re-measure both together. Inside
           a fileupload row the button also drops the floating-pill look:
           no own border/radius, just a right divider, so it reads as the
           row's left cell like production. #}
        {# padding-right with !important: the absolutely-positioned ✕ (see
           .deleteBtn below) overlays the input's right end, and base-async's
           `.imageupload input { padding-right: 0 !important }` would let
           the filename slide underneath it. Right-side radius too - the ✕
           only covers the corner while a file is set; when it's hidden the
           input IS the row's right edge. #}
        form.admin-form .fileupload .input-group input[type=file] {
            flex: 1 1 auto; min-width: 0; width: auto; height: 38px !important;
            padding: 6px 44px 6px 12px !important; border: 1px solid var(--admin-border); border-radius: 6px; background: var(--admin-surface);
            font-size: .95rem;
        }
        {# The button's NEGATIVE margins are the whole trick, and they are
           production's own (measured live: `-6px 12px -6px -12px` against
           an input padded `6px 0 6px 12px`). -12px left cancels the input's
           left padding so the button starts flush at the border; -6px top
           and bottom cancel the vertical padding so it fills the row edge
           to edge AND, crucially, contributes 12px LESS than its own height
           to layout - which is what keeps the row at production's 38px.
           A previous pass instead grew the padding to .75rem 1.25rem with
           zero margins, reasoning that prod's row "is visibly taller"; that
           was backwards - it pushed the row to 49px, ~30% TALLER than the
           38px prod reference, which is the bloated Choose-File box
           reported live here. Padding must stay 6px 12px: it is load-
           bearing for the height, not cosmetic. #}
        form.admin-form .fileupload .input-group input[type=file]::file-selector-button {
            margin: -6px .75rem -6px -12px; padding: 6px 12px; border: 0; border-right: 1px solid var(--admin-border);
            border-radius: 5px 0 0 5px; background: var(--admin-bg); font-size: .95rem;
        }
        form.admin-form .fileupload .input-group input[type=file]::-webkit-file-upload-button {
            margin: -6px .75rem -6px -12px; padding: 6px 12px; border: 0; border-right: 1px solid var(--admin-border);
            border-radius: 5px 0 0 5px; background: var(--admin-bg); font-size: .95rem;
        }
        {# The ✕ is NOT a flex sibling of the input: base-async's bare
           `.deleteBtn { position:absolute; right:0 }` takes it out of
           flow, anchored to the .input-group (position:relative above).
           That's also exactly how PRODUCTION renders it - there,
           `.input-group-text { height:100% }` resolves against the
           positioned group and the ✕ becomes a flush full-height right
           segment. Two earlier attempts here treated it as a flex child
           (stretch/height:auto), which silently BROKE the 100% and shrank
           it to a floating 38px box - complete the absolute model
           instead of fighting it. Selector deliberately over-specific:
           it must outrank the generic `....input-group-text:last-child`
           rule above (whose border-left:0 would eat prod's divider line)
           AND base-async's `.imageupload .deleteBtn{height:38px
           !important}`. #}
        form.admin-form .fileupload .input-group > .input-group-text.deleteBtn {
            top: 0; right: 0; height: 100% !important; min-height: 0;
            align-items: center; justify-content: center;
            border: 1px solid var(--admin-border); border-radius: 0 6px 6px 0;
            background: var(--admin-surface); cursor: pointer;
        }
        {# The hint under the row ("La taille de fichier maximale...") - a
           child of .fileupload, full width under the input row, never
           beside the figure. #}
        {# The color here is belt-and-braces, not the actual fix: this hint
           reads gray because of the --text-muted alias up in :root (see
           the note there), which is what repairs `.text-muted` for the
           whole admin. Keeping an explicit color anyway means a hint that
           is only `.form-filesize`, with no `.text-muted` on it, still
           lands muted rather than at full body-text strength. #}
        form.admin-form .fileupload .form-filesize { width: 100%; margin: .4rem 0 0; color: var(--admin-muted); }
        {# select2 renders with its bootstrap4 theme (SelectType default),
           whose chip rule overrides select2's own default gray chip with
           "inherit Bootstrap's badge look" - Bootstrap isn't loaded here
           by design, so keyword/tag chips rendered as bare text (reported
           live). Full theme-selector specificity needed to outrank it. #}
        {# padding is !important: base-async.css ships its own
           `.select2-selection--multiple .select2-selection__choice { padding:
           .075em !important }` (a public-site-oriented reset), which
           silently collapsed this to ~1px on every side despite this rule's
           own higher selector specificity - !important only defers to
           specificity AMONG important declarations, so a plain declaration
           here never had a chance. That near-zero padding is what put the
           remove button flush against the chip's own rounded corner
           (reported live: "too close to left") even after its own margin
           was already zeroed out - the fix belongs here, not on the button. #}
        form.admin-form .select2-container--bootstrap4 .select2-selection--multiple .select2-selection__choice {
            background: var(--admin-bg); border: 1px solid var(--admin-border); border-radius: 5px;
            padding: .05rem .45rem !important; margin-right: .3rem; color: inherit;
        }
        {# The glyph alone had no hit-area or button affordance - a bare `×`
           character sized off the chip's own font, sitting flush against
           the icon/label with 3px of padding, so it read as stray
           punctuation rather than a control (reported live). Sized and
           shaped like the admin's other small delete controls (.item-remove
           above: flex-centered square, rounded, solid danger fill on
           hover instead of a color-only change) so it reads as the same
           "remove" affordance everywhere it appears, just smaller to fit
           the chip's own height. #}
        {# align-self:center - the chip is a flex row with align-items left at
           its browser default ("normal" -> stretch), and stretch has no
           effect on a child with an explicit height, which this button has;
           per spec it then falls back to flex-start, pinning the button to
           the TOP of the chip instead of centering it. Combined with the
           negative left margin below (meant to snug it against the chip's
           own padding, but landing it flush against - and visually
           overlapping - the chip's own rounded corner instead), this is
           the "red outline not well-placed" reported live. #}
        form.admin-form .select2-container--bootstrap4 .select2-selection--multiple .select2-selection__choice__remove {
            display: flex; align-items: center; justify-content: center;
            align-self: center;
            width: 1.15rem; height: 1.15rem; margin: 0 .35rem 0 0;
            padding: 0; border-radius: 4px; font-size: .8rem; line-height: 1;
            color: var(--admin-muted); background: none; flex-shrink: 0;
        }
        form.admin-form .select2-container--bootstrap4 .select2-selection--multiple .select2-selection__choice__remove:hover {
            background: var(--admin-danger); color: #fff;
        }
        {# Persistent (not hover-only) state for the click-to-arm/confirm
           guard below - hover alone can't signal "armed", since the mouse
           is still hovering the button in the exact same position right
           after the first click as before it. Pulsing ring makes the
           second, confirming click state visually distinct from plain hover. #}
        form.admin-form .select2-selection__choice__remove.is-confirm-armed,
        form.admin-form .select2-selection__clear.is-confirm-armed {
            background: var(--admin-danger) !important; color: #fff !important;
            animation: select2-confirm-pulse 1s ease-in-out infinite;
        }
        @keyframes select2-confirm-pulse {
            0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--admin-danger) 55%, transparent); }
            50% { box-shadow: 0 0 0 4px color-mix(in srgb, var(--admin-danger) 0%, transparent); }
        }
        {# select2-bootstrap4's own default: a hardcoded light-grey circle
           (#c8c8c8) that never adapted to this admin's palette, reading as
           an unstyled foreign element next to the chips' own themed remove
           buttons (reported live: "circled in light grey and wrong").
           Same square/rounded language as .select2-selection__choice__remove
           above, so "clear everything" reads as the same family of control
           as "remove one", just distinguished by position. #}
        {# top/right/line-height are !important for the same reason as the
           chip padding above: base-async.css's own
           `.select2-selection--multiple .select2-selection__clear { top: 0
           !important; right: .75em !important; line-height: 0 !important }`
           otherwise wins despite this rule's higher specificity.

           Fixed top offset, not the earlier top:50%/negative-margin
           centering trick - centering is relative to the WHOLE selection
           box, which grows taller every time the chips wrap to another row
           (3+ tags), so the button drifted down into the gap between rows
           instead of sitting at a stable top-right corner (reported live,
           twice: "still vertically aligned" after the first attempt only
           swapped which point it centered against). Anchoring to a fixed
           .5rem from the top keeps it in the same place regardless of how
           many rows the chips wrap to.

           margin: 0 - the select2-bootstrap4 theme's own default carries a
           `margin-top: .75em` (~11px) on this element that this rule never
           contested (only top/right/line-height were, since those were the
           properties fighting base-async's !important overrides); with no
           competing declaration for margin-top at all, that ~11px silently
           stacked ON TOP of the intended top:.5rem offset, landing the
           button ~19px down instead - visually "too high a margin, not
           well top-right aligned" even though top itself was correctly 8px
           (still reported live after the top-anchoring fix, confirming
           margin was the actual remaining culprit, found via computed
           style, not the CSS source, since it never appeared in a
           top/right-scoped rule search). #}
        form.admin-form .select2-container--bootstrap4 .select2-selection--multiple .select2-selection__clear {
            display: flex; align-items: center; justify-content: center;
            width: 1.3rem; height: 1.3rem; top: .5rem !important; right: .5rem !important; margin: 0 !important;
            border-radius: 4px; font-size: .85rem; line-height: 1 !important;
            color: var(--admin-muted); background: var(--admin-bg); border: 1px solid var(--admin-border);
        }
        form.admin-form .select2-container--bootstrap4 .select2-selection--multiple .select2-selection__clear:hover {
            background: var(--admin-danger); color: #fff; border-color: var(--admin-danger);
        }
        form.admin-form .form-password-strength { display: flex; gap: .2rem; margin-top: .4rem; }
        form.admin-form .form-password-strength .strength { flex: 1; height: 3px; border-radius: 2px; background: var(--admin-border); }
        {# .form-password used to get its own bordered/padded box here too
           (same reasoning as .form-collection-items below, ported from how
           EasyAdmin's own stylesheet boxed both) - removed: a whole page
           of nothing but password fields (the API keys page) stacked five
           of these boxes-within-a-box, reported live as looking cluttered
           next to production's own flat "label + input" rows sharing one
           outer card. A single password field still reads fine as a plain
           row, same as every other field type - it never needed its own
           box to not look bare, only the collection case right below
           actually does (multiple distinct sub-items with no other visual
           grouping at all). #}
        form.admin-form .form-collection-items { border: 1px solid var(--admin-border); border-radius: var(--admin-radius); padding: 1rem; }
        form.admin-form .form-collection-items > .form-association:last-child,
        form.admin-form .form-collection-items > .form-group:last-child { margin-bottom: 0; }
        {# Multi-locale field tabs (LayoutSettingListType's translatable_widget
           branch for >1 locale - e.g. the Settings page's title/slogan/logo,
           each translatable into fr-FR/en-GB/de-DE) - same raw Bootstrap
           markup again (nav-tabs/tab-content/tab-pane, data-bs-toggle="tab")
           with no Bootstrap CSS OR JS behind it: every locale's pane
           rendered simultaneously, stacked, showing the whole field set 3x
           in a row, with tab buttons that did nothing when clicked -
           arguably the single worst-looking thing on that page. EasyAdmin
           got this for free from Bootstrap's own tabs component; the click
           handler right below is this admin's from-scratch equivalent (see
           that stylesheet's own .form-translatable rules for the padding
           EasyAdmin gave the active pane, mirrored in tab-pane.active below). #}
        {# The 15px left padding is load-bearing, not cosmetic breathing
           room: it insets the first tab so a run of the container hairline
           is visible to its left, which is what makes the row read as tabs
           sitting ON a line rather than one box wedged into the corner.
           Production gets the same 15px from a margin-left on the first
           nav-item; padding on the flex container is equivalent here and
           leaves the border-bottom spanning the full width. gap is 0 for
           the same reason - prod's tabs butt directly against each other,
           and a gap breaks the continuous run of hairline between them. #}
        form.admin-form .nav-tabs { display: flex; gap: 0; list-style: none; margin: 0 0 1rem; padding: .9rem 0 0 15px; border-bottom: 1px solid var(--admin-border); }
        {# border-bottom is a transparent 1px, NOT `none` - and the active
           tab then paints that same edge in its own fill colour rather
           than leaving it off. Both halves are production's structure,
           measured live. `none` collapsed the edge entirely, so the active
           tab kept the container's hairline running along its bottom and
           read as a closed box instead of one that opens into the pane
           below; combined with margin-bottom:-1px, a fill-coloured bottom
           border overlaps that hairline and erases it for exactly the
           width of the tab. Keeping the transparent edge on inactive tabs
           (rather than dropping it) is what keeps every tab the same
           height, so the row doesn't shift by a pixel as you switch
           locales. #}
        form.admin-form .nav-tabs .nav-link { display: flex; align-items: center; margin-bottom: -1px; padding: .5rem 1rem;
                                               border: 1px solid transparent; border-radius: 4px 4px 0 0;
                                               background: none; cursor: pointer; color: inherit; }
        form.admin-form .nav-tabs .nav-link.active { border-color: var(--admin-border); border-bottom-color: var(--admin-surface);
                                                     background: var(--admin-surface); }
        {# NO opacity on .nav-link, and that is the fix, not an omission.
           base-async already dims the FLAG of an untranslated locale
           (`.form-translatable .nav-link.muted:not(.active) .country-flag
           { opacity: .5 }`) - that is the "nothing written in this
           language yet" signal, and production shows exactly that and
           nothing more. Two link-level rules here used to stack on top of
           it and multiply: `.nav-link{opacity:.55}` took every inactive
           flag to .55 where prod shows 1, and `.muted:not(.active)
           {opacity:.3}` compounded to .3 x .5 = .15 - the German flag was
           rendering at under a third of prod's .5 and read as a blank
           smudge (measured live on both). Active/inactive is already
           conveyed by the border + surface background on .active above,
           the same way production does it, so the dimming was never
           load-bearing. Don't reintroduce an opacity here: anything set
           on the link silently multiplies with the flag rule. #}
        {# 5px, deliberately rounder than production's 3.75px - asked for
           directly ("make the flag more round"), so don't "correct" this
           back to the prod value on a later matching pass. height:auto
           keeps each flag's own aspect ratio; an earlier fixed 20x14 with
           object-fit:cover was cropping them. #}
        form.admin-form .nav-tabs .country-flag { width: 30px; height: auto; border-radius: 5px; }
        {# The flag sits inside a <label> in each tab, and the generic
           `form.admin-form label { display:block; margin-bottom:.3rem }`
           rule above was riding every tab's flag ~5px high of the tab's
           own vertical center (reported live: "offset language icons in
           the form"). Flex here also turns the required-dot ::after into
           a centered flex item, so its own raise stays purely visual. #}
        form.admin-form .nav-tabs .nav-link label { display: flex; align-items: center; gap: .1rem; margin-bottom: 0; cursor: pointer; }
        form.admin-form .tab-content .tab-pane { display: none; }
        form.admin-form .tab-content .tab-pane.active { display: block; padding-top: .5rem; }
        form.admin-form .form-text { font-size: .82rem; color: var(--admin-muted); margin-top: .35rem; }
        form.admin-form .form-text.text-danger { color: var(--admin-danger); display: flex; align-items: center; gap: .35rem; }
        form.admin-form .form-text.text-danger::before { content: "\f071"; font-family: "Font Awesome 6 Free"; font-weight: 900; }
        {# flex-direction explicit, not left to default: the PUBLIC site's
           own .form-check rule (base-async.css, loaded here too via the
           shared 'base' Encore entry - see encore_entry_link_tags('base')
           below) sets flex-direction:column for ITS OWN forms. This rule
           already wins on display/align-items (higher specificity, form.
           admin-form .form-check vs a bare .form-check), but never
           declared flex-direction at all - CSS cascades per-property, so
           that one value fell through uncontested from the public rule,
           silently stacking every boolean/switch field's label above its
           toggle and centering both (align-items:center, cross-axis of a
           COLUMN flex is horizontal) instead of the intended label-beside-
           toggle row. Reported live: every toggle field on the settings
           page rendered centered while every other field type stayed
           left-aligned. #}
        form.admin-form .form-check { display: flex; flex-direction: row; align-items: center; gap: .5rem; }
        {# File inputs (avatar/image/document upload fields) were entirely
           unstyled - the native browser "Choose File" button/label don't
           pick up any of the admin's theme (light OR dark: the label text
           stays whatever color the OS renders it, independent of this
           page's own color scheme), and its height/padding never matched
           any other control on the same form. ::file-selector-button is
           the standard, well-supported way to theme the native button
           itself without replacing the whole control with a JS widget. #}
        form.admin-form input[type=file] { display: flex; align-items: center; gap: .6rem; color: var(--admin-muted); font: inherit; font-size: .85rem; }
        {# Safari/WebKit only recognizes the vendor-prefixed pseudo-element -
           the unprefixed ::file-selector-button silently matches nothing
           there, leaving the native button unstyled. Both rules target the
           same button; harmless duplication in engines that support both. #}
        form.admin-form input[type=file]::file-selector-button {
            padding: .45rem .9rem; border-radius: 6px; border: 1px solid var(--admin-border);
            background: var(--admin-surface); color: inherit; font: inherit; font-size: .9rem; cursor: pointer;
        }
        form.admin-form input[type=file]::file-selector-button:hover { border-color: var(--admin-accent); color: var(--admin-accent); }
        form.admin-form input[type=file]::-webkit-file-upload-button {
            padding: .45rem .9rem; border-radius: 6px; border: 1px solid var(--admin-border);
            background: var(--admin-surface); color: inherit; font: inherit; font-size: .9rem; cursor: pointer;
        }
        form.admin-form input[type=file]::-webkit-file-upload-button:hover { border-color: var(--admin-accent); color: var(--admin-accent); }
        {# A boolean field reads as a toggle switch everywhere else it
           appears (datagrid rows, detail page) but fell back to a tiny bare
           native checkbox here - the one visibly "non-uniform" field in an
           otherwise consistent form. Same visual as .field-switch (the
           datagrid's PATCH-toggle), pure CSS this time since a form
           checkbox already submits correctly on its own - no JS/PATCH
           wiring needed, just appearance. #}
        form.admin-form .form-check-input[type=checkbox] {
            appearance: none; -webkit-appearance: none; width: 34px; height: 19px; margin: 0; flex-shrink: 0;
            border: none; border-radius: 999px; background: var(--admin-border); position: relative; cursor: pointer;
            transition: background .15s ease;
        }
        form.admin-form .form-check-input[type=checkbox]::after {
            content: ''; position: absolute; top: 2px; left: 2px; width: 15px; height: 15px; border-radius: 50%;
            background: #fff; box-shadow: 0 1px 2px rgba(0,0,0,.3); transition: transform .15s ease;
        }
        form.admin-form .form-check-input[type=checkbox]:checked { background: var(--admin-accent); }
        form.admin-form .form-check-input[type=checkbox]:checked::after { transform: translateX(15px); }
        form.admin-form .form-check-input:not([type=checkbox]) { width: 1.1rem; height: 1.1rem; margin: 0; accent-color: var(--admin-accent); }
        form.admin-form footer { margin-top: .4rem; }
        form.admin-form footer hr { display: none; }
        form.admin-form .form-entity, form.admin-form .form-translatable, form.admin-form .form-collection-items,
        form.admin-form .form-collection-no-add-button { display: block; }
        .form-footer { display: flex; gap: .5rem; padding: 1rem 1.25rem; border-top: 1px solid var(--admin-border); }
        dl.detail { padding: 1.25rem; display: grid; grid-template-columns: 200px 1fr; gap: .5rem 1rem; margin: 0; }
        dl.detail dt { font-weight: 600; color: var(--admin-muted); }
        dl.detail dd { margin: 0; }
        .empty-state { padding: 3rem; text-align: center; color: var(--admin-muted); }
        {# Floating, not in flow. These sat in the normal document flow, so
           every flash pushed the whole page down by its own height - the
           maintenance banner in particular, which is present on every
           render while the mode is on, permanently displaced the content
           under it (reported live: "should be absolute with an overlay,
           but it is relative"). Absolute against .admin-main instead, so a
           message appearing or clearing never reflows the page (and, per
           that column's own position:relative comment above, scrolls away
           with the content it belongs to rather than chasing the reader
           down the page like a viewport-fixed toast would).

           Anchored to the top-right corner as a narrow stack, not a wide
           bar spanning the column - a single-line confirmation like "Les
           modifications ont été enregistrées." read as an oddly-placed
           banner floating dead-center over the page (reported live), where
           a toast in the corner is the shape readers expect a transient
           confirmation to take.

           pointer-events:none on the stack, auto on each flash: the empty
           column would otherwise swallow clicks aimed at whatever is
           behind it. #}
        {# top offset clears .admin-topbar, not just a small gap from
           .admin-main's own padding-box: the topbar sits INSIDE .admin-main
           as its first child, pulled out to the full edge via a negative
           margin equal to .admin-main's own padding (see .admin-topbar's
           rule above) - so .admin-main's padding-box top is exactly where
           the topbar itself starts, and a plain `top: .5rem` landed the
           toast stack right on top of it (reported live: the toast
           overlapped the search bar/action buttons). #}
        .flashes { position: absolute; top: calc(3.3rem + .75rem); right: 0; z-index: 30;
                   width: 100%; max-width: 22rem;
                   display: flex; flex-direction: column; gap: .5rem; pointer-events: none; }
        .flash { padding: .7rem .9rem; border-radius: 8px; border: 1px solid var(--admin-border);
                 border-left-width: 3px; background: var(--admin-surface); pointer-events: auto;
                 box-shadow: 0 10px 30px rgba(0, 0, 0, .18);
                 animation: flash-in .22s ease; }
        @keyframes flash-in { from { opacity: 0; transform: translate(.75rem, -.25rem); } }
        .flash-success { border-color: #86efac; border-left-color: #16a34a; background: #f0fdf4; color: #166534; }
        .flash-warning { border-color: #fde68a; border-left-color: #d97706; background: #fffbeb; color: #92400e; }
        .flash-danger, .flash-error { border-color: #fecaca; border-left-color: #dc2626; background: #fef2f2; color: #991b1b; }
        {# A flash had no way out: no close control and no timeout, so one
           "the website is now displayed in English" sat over the page until
           the next full navigation. Every flash now carries a dismiss, and
           the non-error ones retire themselves. #}
        .flash { display: flex; align-items: flex-start; gap: .6rem; }
        {# margin-top centers the icon glyph against the FIRST line of
           .flash-body's text specifically (not the whole, possibly-wrapped
           message) - text sits in a 22.5px line-height at 15px font-size,
           the icon box is ~15.2px tall, so half the ~7.3px leading (.15rem
           undershot it, reported live as visibly high) is what centers it. #}
        .flash-icon { flex-shrink: 0; margin-top: .23rem; font-size: .95rem; opacity: .85; }
        .flash-body { flex: 1; min-width: 0; padding-top: .05rem; }
        .flash-close { flex-shrink: 0; border: 0; background: none; color: inherit; cursor: pointer;
                       font: inherit; font-size: 1.15rem; line-height: 1; padding: 0 .1rem;
                       opacity: .55; transition: opacity .12s ease; }
        .flash-close:hover { opacity: 1; }
        .flash.is-dismissing { opacity: 0; transform: translate(.75rem, 0);
                               transition: opacity .25s ease, transform .25s ease; }
        .search-form { display: inline-flex; gap: .4rem; }
        .search-form input { padding: .45rem .65rem; border: 1px solid var(--admin-border); border-radius: 6px; font: inherit; min-width: 220px;
                             background: var(--admin-bg); color: var(--admin-text); }
        .quick-access { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: .75rem; padding: 1.25rem; }
        .quick-access a { display: block; padding: 1rem; border: 1px solid var(--admin-border); border-radius: var(--admin-radius); text-decoration: none; color: inherit; background: var(--admin-surface); }
        .quick-access a:hover { border-color: var(--admin-accent); color: var(--admin-accent); }
        .dashboard-header { align-items: center; gap: 1rem; }
        .dashboard-brand-icon { width: 3.5rem; height: 3.5rem; display: flex; align-items: center; justify-content: center;
                                font-size: 1.6rem; border: 1px solid var(--admin-border); border-radius: 12px; background: var(--admin-surface); }
        .dashboard-slogan { color: var(--admin-muted); }
        {# Now a sibling of the h1/slogan inside the title stack (moved into
           .admin-header, kept always visible instead of scrolling away with
           the rest of .content) - the old margin-left:4.5rem was compensating
           for sitting OUTSIDE that stack, offsetting past the brand icon;
           inside it, that would double up as an extra, wrong indent. #}
        .dashboard-welcome { margin: .3rem 0 0; color: var(--admin-muted); font-size: .92rem; }
        {# The "welcome" widget (see Base\Admin\Widget\WelcomeWidgetType) -
           .dashboard-welcome's own margin above was tuned to sit right
           under the header's h1/slogan stack, wrong once it's the ONLY
           thing in its own standalone card. #}
        {# 1rem, not every other card's own 1.5rem (analytics-card/
           composite-card/...) - reported live as excess empty space
           around one short line of text at 1.5rem. Stays a single fixed
           value rather than something that shrinks further once the
           background toggle strips the .card look: that toggle is a pure
           client-side class flip with no matching server round-trip (see
           welcome.html.twig's own comment), so a padding rule gated on
           .no-card-bg would only ever apply AFTER a reload, never live in
           the preview - same trap the .card class itself was in before
           this fix. #}
        .widget-welcome { padding: 1rem; display: flex; align-items: center; }
        .widget-welcome .dashboard-welcome { margin: 0; font-size: 1rem; }
        {# Same reasoning/same value as .analytics-card-header's own
           padding-right below: handle+toggle-hidden+toggle-background+
           remove is the same 4-icon max case (4 * 1.5rem + 3 * .3rem gap +
           .6rem right offset = 7.5rem) - without this, a long single line
           of welcome text runs right up under .widget-controls' icons
           (position:absolute, unaware of text flow) instead of wrapping
           or stopping short of them, reported live as the text visibly
           overlapping the icon row. Resize floats separately at the
           bottom-right corner, so no extra room needed for that. #}
        body.is-customizing .widget-welcome { padding-right: 7.5rem; }
        {# Dashboard-only, rendered into layout.html.twig's own
           topbar_dashboard_extra block (see there) rather than scrolling
           away with the page content - only ever visible while
           is-customizing is on, same display:none/flex toggle pattern as
           #admin-customize-done right beside it, so a superadmin merely
           VIEWING the dashboard (not editing it) sees neither control. #}
        .admin-topbar-dashboard-extra { display: none; align-items: center; gap: .75rem; }
        body.is-customizing .admin-topbar-dashboard-extra { display: flex; }
        [data-widget-palette-menu] { min-width: 12rem; }
        {# Sized to match .btn exactly (padding/font-size/border-radius) so
           the columns picker and "+ Ajouter un widget" read as one
           harmonized control group, not two mismatched widgets bolted
           together - the ask was explicit: "harmonized in size". #}
        .admin-columns-select { display: flex; align-items: center; gap: .5rem; font-size: .9rem; color: var(--admin-muted); }
        {# A plain <select> renders with browser-native chrome that's
           noticeably taller than .btn (confirmed live: ~42px vs ~32px in
           WebKit) even with identical padding - appearance:none strips
           that, with an explicit height matching .btn's own so the two
           controls line up as one group. <select> itself can't take a
           ::after (no generated-content support on that element), hence
           the wrapping span for the custom chevron. #}
        .admin-select-wrap { position: relative; display: inline-flex; }
        .admin-select-wrap::after { content: ''; position: absolute; right: .6rem; top: 50%; width: .4rem; height: .4rem;
            border-right: 2px solid var(--admin-muted); border-bottom: 2px solid var(--admin-muted); transform: translateY(-65%) rotate(45deg); pointer-events: none; }
        {# Same vertical padding (.45rem) and font-size as .btn, so the two
           end up the same rendered height without guessing a fixed px
           value - only the horizontal padding differs (room for the
           chevron on the right instead of .btn's symmetric .9rem). #}
        .admin-columns-select select { -webkit-appearance: none; appearance: none; box-sizing: border-box;
            border: 1px solid var(--admin-border); border-radius: 6px; padding: .45rem 1.7rem .45rem .6rem;
            background: var(--admin-surface); color: var(--admin-text); font: inherit; font-size: .9rem; line-height: 1; cursor: pointer; }
        {# A real, configurable column count (LayoutConfig::$columns,
           default 5) rather than however many ~240px tracks happen to fit
           the viewport - auto-fill made "row" position genuinely
           unpredictable when dragging (a wide screen fits 7 narrow
           columns, so dropping something into what LOOKS like a new row
           just fills a leftover gap in the row above instead), and meant
           a widget's 1-3 "size" didn't reliably correspond to 1/3, 2/3, or
           a full row width the way the resize control implies. #}
        {# repeat(N, 1fr) alone (N = --widget-columns) was the FIRST version
           of this - it fixed the unpredictable-row problem above, but
           dropped the old auto-fill grid's implicit "never narrower than
           240px" floor entirely: at columns:10, each of the 10 tracks
           just gets whatever a bare 1fr computes to on the current
           screen, however cramped - reported live as columns/labels
           wrapping and visually overflowing their cards.
           repeat(auto-fit, minmax(...)) restores a real minimum per
           column (240px) while still targeting N columns: the minmax
           basis is "100% split N ways, gaps subtracted, but never below
           240px" - on a screen wide enough for N real ≥240px columns,
           auto-fit renders exactly N (matching the configured intent
           precisely); on a narrower one, auto-fit naturally renders
           fewer, wider columns instead of cramming N in - the same
           graceful-degradation the @media override below already does
           for a phone-sized viewport specifically, just continuous
           instead of a single hard breakpoint. #}
        {# flex + wrap, not CSS Grid's repeat(auto-fit, ...) - tried that
           first, it does not actually work here. auto-fit only creates as
           many 240px-minimum tracks as fit the container, and a widget
           whose OWN span equals or exceeds however many tracks it actually
           created can't wrap onto a new row the way a flex item would -
           grid instead EXTENDS the grid with extra implicit tracks to
           satisfy that span, making the whole row wider than the container.
           Tried clamping each widget's span against a --widget-max-span
           lowered via @media next: wrong tool for this - @media reads the
           browser VIEWPORT's width, but this admin opened inside
           transparentJS's nested overlay renders in a PANEL capped at
           max-width:1600px (see @glitchr/transparent's own CSS) that can be
           narrower than the viewport by any amount depending on the actual
           window size - a wide desktop window still overflows the (much
           narrower) panel with zero @media rule ever matching, since it's
           the viewport that's wide, not the panel. flex-wrap has no such
           mismatch: it always measures the real immediate container,
           whatever ancestor actually constrains it, panel or viewport
           alike - a widget that doesn't fit the current line simply starts
           a new one, full stop, with no fixed track count to get wrong. #}
        .widget-grid { display: flex; flex-wrap: wrap; gap: 1.5rem;
                       --widget-col-width: max(240px, calc((100% - (var(--widget-columns, 5) - 1) * 1.5rem) / var(--widget-columns, 5))); }
        {# A widget's flex-basis is its own --widget-col-width times however
           many columns it spans, plus the gaps BETWEEN those columns (span
           3 = 3 columns' width + 2 internal gaps) - same size grid's own
           `span N` produced, just reached through flex-basis instead of a
           track count. min-width wrapped in min(...,100%) is the actual
           overflow guard: without it, a widget on a container narrower than
           even one full --widget-col-width (a phone, or this panel resized
           very small) would still refuse to shrink past its own natural
           minimum and overflow anyway - capping the FLOOR itself at 100%
           means it can never demand more than the container actually has,
           full width becoming its own single column of one on that line. #}
        .widget-block, .widget-group {
            flex-grow: 0; flex-shrink: 1;
            flex-basis: calc(var(--widget-col-width) * var(--widget-span, 1) + (var(--widget-span, 1) - 1) * 1.5rem);
            min-width: min(var(--widget-col-width), 100%);
        }
        {# While customizing, .item-resize-handle (bottom:.6rem, 1.8rem
           tall - see its own rule below) and .widget-controls (top:.6rem,
           its icons ~1.5rem tall) are BOTH absolutely positioned corner
           overlays, independent of each other and of the card's own
           content height. A short enough card (a single line of text -
           the Bienvenue/"Generic" widget's own reduced padding, see that
           widget's own comment, made this the first one short enough to
           actually hit it) leaves too little vertical room between "near
           the top" and "near the bottom" for the two to avoid overlapping
           - reported live as the resize handle sitting visually on top of
           the remove icon. This is a customize-mode-only floor (matches
           the two overlays it exists to keep apart, neither of which
           renders outside customize mode either), not a general min-
           height for every view - a short widget still renders as short
           normally, only gains a bit of headroom while its own edit
           controls are on screen. #}
        body.is-customizing .widget-block, body.is-customizing .widget-group { min-height: 4.75rem; }
        {# Widgets span 1-N tracks (N = --widget-columns, superadmin-
           adjustable via both the resize control AND the columns select
           above, persisted like everything else in LayoutConfig). Each
           widget is also its own CSS containment context, so its content
           can react to the space IT was actually given rather than just
           the viewport - see the analytics_card @container rules below
           for what that unlocks at size 1. #}
        .widget-block, .widget-group { container-type: inline-size; }
        {# .widget-group IS its own visible card (one div, both the flex
           item AND the bordered/backgrounded box) - .widget-grid's default
           align-items:stretch (flexbox's own, same keyword/behavior as CSS
           Grid's own default this used to rely on before the switch to
           flex-wrap above) already makes it fill its own LINE's full
           height (matched to the tallest sibling wrapped onto the same
           line) with no extra work. .widget-block is different: it's a
           plain wrapper around whatever the resolved widget type actually
           renders (.analytics-card, or composite's .card) - the WRAPPER
           stretches to the line height by that same default, but its child
           does NOT, since nothing tells it to. That left a real visible
           bug: a short block-type card (e.g. a narrow analytics_card
           instance showing just its stat row, chart/picker hidden by the
           @container rule below) sitting next to a taller sibling on the
           same line shows its own white card ending early, with the
           PAGE's grey background visible underneath, all the way down to
           the line's actual height - it looks broken because the visible
           box doesn't fill the space it was actually given. flex:1 on the
           child makes it stretch to fill instead, exactly matching how
           .widget-group already behaves. A no-op whenever nothing on the
           line is taller than this widget's own natural height. #}
        .widget-block { display: flex; }
        {# min-height here reads --widget-height (set inline alongside the
           wrapper's own min-height whenever widget.height is stored/set,
           see _block.html.twig and layout.html.twig's applyWidgetHeight())
           rather than staying a flat 0 - the wrapper's OWN min-height only
           grows the wrapper itself if the row was already going to be
           that tall for some other reason (a taller sibling stretching
           it - see .widget-block's own comment above), which isn't the
           case for a lone/tallest card being resized taller. Mirroring
           the same height onto the actual visible child is what makes a
           custom height show up at all, both right after a drag AND on
           a fresh page load of a previously-saved custom height. #}
        .widget-block > .analytics-card, .widget-block > .card { flex: 1 1 auto; min-height: var(--widget-height, 0); }
        {# --widget-height is only ever a FLOOR (min-height above) - the row's
           own align-items:stretch default can still pull a widget TALLER
           than that floor to match a taller sibling on the same line,
           which made a height-resize silently look like it did nothing:
           shrink a widget shorter than its neighbor and stretch just
           pulls it right back up to match. Once a widget has an explicit
           height at all (data-widget-height, set the instant a resize
           drag ever touches height - see applyWidgetHeight()), it opts
           out of that shared-row stretching entirely and sits at exactly
           its own height instead, even if that means a shorter card next
           to a taller one - deliberately, since a resize the admin
           performed on purpose should stick, not get silently overridden
           by whatever else happens to share its row. #}
        .widget-block[data-widget-height], .widget-group[data-widget-height] { align-self: flex-start; }
        {# Every widget collapses to one full-width column at mobile width,
           regardless of its own configured span - a deliberate stricter
           simplification on top of flex-wrap's own already-continuous
           reflow above (that alone would still fit 2+ narrow spans side by
           side on a ~600px phone; this forces a single stacked column
           instead). --widget-columns:1 alone is enough to do it, with no
           !important needed the way grid's own span property used to: it
           feeds the very same --widget-col-width formula above, which
           resolves to ~100% once there's only one column to divide by -
           every widget's min-width floor becomes the full container width
           no matter what --widget-span it was actually given. #}
        @media (max-width: 720px) {
            .widget-grid { --widget-columns: 1; }
        }
        .widget-group { padding: 1.25rem 1.5rem; }
        .widget-group h2, .composite-pane h2 { margin: .6rem 0 .7rem; font-size: 1.25rem; }
        .widget-icon { font-size: 2rem; }
        {# .composite-pane shares this same <ul><li><a> markup (see
           composite.html.twig's link-list pane branch) but deliberately
           has no .widget-group wrapper of its own - merging two link-list
           widgets must never nest a card-styled box inside another card,
           the same "never a card in a card" rule analytics_card.html.twig
           follows via embedded:true. Without also listing it here, a
           merged Photos/Blog pane's links fell back to the browser's raw
           default blue/purple/underlined styling - found live, and easy
           to mistake for a caching issue since it only ever showed up
           once two widgets were actually merged. #}
        .widget-group ul, .composite-pane ul { list-style: none; margin: 0; padding: 0; }
        .widget-group li, .composite-pane li { margin: .35rem 0; }
        .widget-group li a, .composite-pane li a { display: inline-flex; align-items: center; gap: .5rem; color: inherit; text-decoration: none; }
        .widget-group li a:hover, .composite-pane li a:hover { color: var(--admin-accent); }
        .widget-group li a i, .composite-pane li a i { width: 1.2rem; text-align: center; }
        .widget-group li a .fa-circle-plus, .composite-pane li a .fa-circle-plus { color: var(--admin-accent); }
        .analytics-card { padding: 1.5rem; }
        .analytics-card-header { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 1.5rem; margin-bottom: 1.25rem; }
        {# .widget-controls floats absolutely over the card's top-right
           corner (handle+toggle-visibility+toggle-background+remove, see
           _block.html.twig - 4 icons, no "settings" among them; series
           visibility is legend-click only now, see analytics_card.html.
           twig's own comment) - without this, a wide stat row's own
           right-aligned content (e.g. the last stat's change badge) runs
           right up against those icons. Resize floats separately at the
           bottom-right corner (see .item-resize-handle), so this only
           needs room for that one row: 4 * 1.5rem + 3 * .3rem gap + .6rem
           right offset = 6.9rem from .widget-block's own edge - but this
           padding-right lives INSIDE .analytics-card's own content box,
           which already sits 1.5rem in from that same edge (.analytics-
           card's own padding, right above) - so only 6.9 - 1.5 ≈ 6rem is
           actually needed here, not the full amount. Confirmed via live
           pixel measurement: without subtracting that 1.5rem, this
           right-aligned content lands a real, visible gap short of
           actually touching the control icons. Only needed while the
           controls are actually visible. #}
        body.is-customizing .analytics-card-header { padding-right: 6rem; }
        .analytics-card-header h2 { margin: 0; font-size: 1.1rem; }
        .analytics-stat-row { display: flex; gap: 1.75rem; flex-wrap: wrap; }
        .analytics-stat { min-width: 6rem; }
        .analytics-stat-value { display: block; font-size: 1.4rem; font-weight: 700; line-height: 1.2; }
        .analytics-stat-label { display: block; font-size: .78rem; color: var(--admin-muted); text-transform: uppercase; letter-spacing: .03em; }
        .analytics-stat-change { font-size: .8rem; font-weight: 600; margin-left: .4rem; }
        .analytics-stat-change.is-up { color: var(--admin-success); }
        .analytics-stat-change.is-down { color: var(--admin-danger); }
        {# "Counter" widget's own big number - deliberately much larger
           than .analytics-stat-value (1.4rem): the whole card IS this one
           figure, not one of several stats sharing a row with it. #}
        .counter-value-row { display: flex; align-items: baseline; gap: .5rem; }
        .counter-value { font-size: 2.75rem; font-weight: 700; line-height: 1.1; }
        .analytics-range-picker { display: flex; flex-wrap: wrap; gap: .4rem; margin-bottom: 1rem; transition: opacity .15s ease; }
        .analytics-range-picker.is-loading { opacity: .5; }
        .analytics-range-btn { border: 1px solid var(--admin-border); background: transparent; color: var(--admin-muted); font-size: .78rem; font-weight: 600; padding: .3rem .75rem; border-radius: 999px; cursor: pointer; transition: background .15s ease, color .15s ease, border-color .15s ease; }
        .analytics-range-btn:hover { border-color: var(--admin-accent); color: var(--admin-text); }
        .analytics-range-btn.is-active { background: var(--admin-accent); border-color: var(--admin-accent); color: #fff; }
        .analytics-chart-wrap { position: relative; height: 240px; }
        {# Pinned-day marker: a vertical rule at the clicked point, drawn as
           a DOM overlay rather than a Chart.js plugin so it needs nothing
           from the built admin-charts bundle (the chart instance is already
           exposed on the canvas, its x scale gives the pixel). pointer-
           events:none or it would eat the click that moves it. #}
        .analytics-daymark { position: absolute; width: 1px; pointer-events: none; z-index: 2;
                             background: var(--admin-accent); opacity: .75; }
        .analytics-daymark::before { content: ''; position: absolute; left: -3px; top: -3px; width: 7px; height: 7px;
                                     border-radius: 50%; background: var(--admin-accent); }
        {# The counters change meaning while a day is pinned, so the state
           has to be visible and reversible from the header itself - not
           only by finding the line again in the chart. #}
        .analytics-day-chip { display: inline-flex; align-items: center; gap: .4rem; margin-left: .1rem;
                              padding: .15rem .3rem .15rem .55rem; border-radius: 999px;
                              border: 1px solid var(--admin-accent); color: var(--admin-accent);
                              background: var(--admin-surface); font-size: .74rem; font-weight: 600; }
        .analytics-day-chip button { border: 0; background: none; color: inherit; cursor: pointer;
                                     font: inherit; line-height: 1; padding: .1rem .25rem; border-radius: 50%; }
        .analytics-day-chip button:hover { background: var(--admin-bg); }
        .analytics-card.is-day-pinned .analytics-stat-change { display: none; }
        {# Generic "nothing to show yet" message inside an analytics-style
           card (e.g. App\Admin\Widget\ArticleViewsWidgetType before an
           article has been picked in its settings panel) - not article-
           specific, lives here alongside the other shared card primitives
           for the same reason .widget-settings-panel does. #}
        .analytics-empty-state { color: var(--admin-muted); font-size: .85rem; text-align: center; padding: 2rem 1rem; margin: 0; }
        {# Belt-and-suspenders with the JS reset in the "Terminé" handler
           below: this panel's own visibility is otherwise driven purely by
           its `hidden` attribute, with nothing tying it to customize mode
           at all - opening it, then leaving customize mode any OTHER way
           than the panel's own Cancel/Apply buttons (clicking "Terminé",
           for one) left it stuck open outside customize mode too, found
           live. This is the CSS-level fallback: even if some future exit
           path forgets to reset `hidden` again, the panel still can't
           render outside body.is-customizing. #}
        {# Generic per-instance settings panel shell - shared by any widget
           type that offers one (composite's pane-ratio selector below,
           entity_views'/counter's own class+instance picker). analytics_card
           used to have one too (a series-visibility checklist duplicating
           the chart's own legend) - removed, see that template's own
           comment. #}
        .widget-settings-panel { display: none; }
        body.is-customizing .widget-settings-panel:not([hidden]) { border: 1px solid var(--admin-border); border-radius: var(--admin-radius); padding: 1rem; margin-bottom: 1rem; display: flex; flex-direction: column; gap: .9rem; background: var(--admin-surface); }
        .widget-settings-field { display: flex; flex-direction: column; gap: .4rem; font-size: .78rem; color: var(--admin-muted); text-transform: uppercase; letter-spacing: .03em; }
        .widget-settings-field input[type="text"], .widget-settings-field select { font: inherit; text-transform: none; letter-spacing: normal; color: var(--admin-text); background: var(--admin-bg); border: 1px solid var(--admin-border); border-radius: 6px; padding: .4rem .6rem; }
        .widget-settings-actions { display: flex; justify-content: flex-end; gap: .5rem; }
        {# The traffic widget's title, in place: contenteditable is toggled
           by JS (see refreshTitleEditability()), not rendered conditionally
           server-side - a plain focus ring is enough affordance, no other
           chrome change needed to signal "editable" here. #}
        [data-analytics-title][contenteditable="true"]:focus, [data-widget-text][contenteditable="true"]:focus { outline: 2px solid var(--admin-accent); outline-offset: 2px; border-radius: 4px; }
        {# Elementary info only (just the 3 numbers) once the widget is
           shrunk down to a single grid track - the chart needs real width
           to be legible and just clips awkwardly otherwise. Queries the
           widget's own rendered width (container-type: inline-size above),
           not the viewport, so this reacts to a customize-mode resize the
           same way it reacts to a narrow screen. #}
        @container (max-width: 320px) {
            .analytics-card { padding: 1.1rem; }
            .analytics-card-header { flex-direction: column; gap: .5rem; }
            .analytics-stat-row { gap: 1rem; }
            .analytics-range-picker { display: none; }
            .analytics-chart-wrap { display: none; }
        }
        {# CompositeWidgetType ("dual-width card"): ONE .card (composite-card)
           holds N panes side by side - each pane's own widget-type template
           renders with embedded:true (drops its normally-own .card, see
           analytics_card.html.twig's comment), so there's exactly ONE
           visible border/background for the whole thing - a bordered box
           per pane read as two small cards awkwardly stuck together
           inside a bigger card, not one merged card, found live.
           Separation between panes is the grid gap alone (below), not a
           border or divider line of any kind. Reuses the SAME container-
           type: inline-size mechanism already on .widget-block (line
           ~576) to stack panes vertically once the composite itself is
           sized/viewport-narrow - same responsive trigger a customize-
           mode resize already uses everywhere else on this page. #}
        {# display:flex + column here is what lets .composite-panes below
           actually fill the card's real height. .widget-block > .card
           (this card) already stretches to match a taller sibling in the
           same dashboard row (see that rule's own comment on
           .widget-block), but that stretch stopped one level too
           shallow: .composite-card itself grew, yet its plain-block
           child (.composite-panes) just took its own natural content
           height and left the REST as visible empty space at the
           bottom - reported live as a composite next to something taller
           showing a big blank gap under its panes. flex:1 on
           .composite-panes (below) is what finally propagates the
           stretch all the way down to the actual pane boxes. #}
        {# Bottom/right padding is wider than top/left specifically to clear
           .item-resize-handle (1.8rem circle, inset .6rem from this card's
           own edge - see that rule) - a plain 1.5rem gutter is narrower
           than the handle's 2.4rem footprint, so the handle visually cut
           across the last pane's own rounded corner instead of sitting in
           the gutter beside it. Only composite-card needs this: a plain
           .widget-group/.analytics-card has no nested bordered pane for
           the handle to collide with in the first place. #}
        {# Top/left are ZERO on purpose: .composite-pane already carries the
           same 1.25rem/1.5rem padding a plain .widget-group does, so any
           top/left padding here is applied a SECOND time and pushes the
           pane's heading in past every sibling card's. Measured live: a
           merged card's icon sat at (49,45) from the card edge where every
           standalone card's sits at (25,21) - reported as merged-card icons
           looking misplaced and offset. Panes have no border or background
           of their own, so this padding was buying nothing visually.
           Bottom/right keep the wide gutter for the reason below. #}
        .composite-card { padding: 0 2.75rem 2.75rem 0; display: flex; flex-direction: column; }
        {# 2 columns, not a single flex row - up to MAX_COMPOSITE_PANES (4)
           panes can land here now (merge onto an existing composite grows
           its own panes), wrapping naturally into a 2x2 arrangement for
           3-4 rather than squeezing everything into one ever-narrower
           row. Separation between panes is the grid gap alone (no border,
           no divider line - see .composite-pane below and the comment on
           .composite-card above) - the gap generalizes to a wrapped 2x2
           the same way a border-per-pane would have, without the "two
           small cards glued together" look a full border around every
           pane produced. overflow:hidden on .composite-pane is now just
           an overflow guard (a long unbroken link, a mid-resize canvas)
           rather than a rounded-corner clip - nothing left to clip a
           corner against once the pane has no border of its own. flex:1
           (not just display:grid) is what
           lets this actually consume the composite-card's full stretched
           height instead of only its own content's natural height -
           CSS Grid's own align-items:stretch default then does the rest,
           making each .composite-pane fill that height too. #}
        .composite-panes { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; flex: 1 1 auto; }
        .composite-pane { min-width: 0; overflow: hidden; padding: 1.25rem 1.5rem; }
        {# A real grid item (see composite.html.twig's own comment on why),
           not an overlay - align-items:stretch (the grid default) already
           makes it fill the row's height, matching the panes either side
           of it, no extra rule needed for that. Only ever rendered for
           exactly 2 panes (only case with a `dragging IS the control`
           mechanism at all - see layout.html.twig's own
           [data-composite-pane-divider] handler), invisible in
           customize mode off since dragging only ever works there. #}
        {# 6px, not the original 10px - read as a visually heavy bar next to
           everything else's thin 1px borders, reported live. Must match
           composite.html.twig's own inline grid-template-columns track
           width exactly (same "10px" literal there) or the divider element
           and the gap the grid actually reserves for it drift apart. #}
        {# Vertical inset is deliberately NOT symmetric in margin terms,
           because the card it sits in isn't either: .composite-card above
           has zero top padding and a 2.75rem bottom gutter (for the resize
           handle). As a plain stretched grid item the divider inherited
           exactly that - it ran flush into the card's top edge and then
           stopped 45px short of the bottom, which read as a broken/lopsided
           rule rather than a deliberate separator (reported live: 1px inset
           at the top against 45px at the bottom).

           margin-top matches .composite-pane's own 1.25rem top padding, so
           the divider starts level with the pane content beside it instead
           of above it. margin-bottom cancels the card's bottom gutter back
           out (1.25rem - 2.75rem) so the inset from the CARD's bottom edge
           comes out the same 1.25rem. Result: 21px top, 21px bottom.

           Safe to reach into that bottom gutter here: the gutter exists to
           keep .item-resize-handle off the last pane's corner, and the
           handle is a circle in the bottom-RIGHT corner (~x 1022-1050 on a
           768px card) while this divider is horizontally centred (~x 651) -
           they never meet. #}
        .composite-pane-divider { width: 6px; border-radius: 999px; background: var(--admin-border); cursor: col-resize; touch-action: none; transition: background .15s ease;
            margin-top: 1.25rem; margin-bottom: calc(1.25rem - 2.75rem); }
        body:not(.is-customizing) .composite-pane-divider { cursor: default; pointer-events: none; opacity: .4; }
        .composite-pane-divider:hover, .composite-pane-divider.is-dragging { background: var(--admin-accent); }
        @container (max-width: 480px) {
            {# !important: exactly-2-pane composites carry an inline
               grid-template-columns (composite.html.twig, drag-to-resize
               ratio) which otherwise always wins over ANY stylesheet rule
               regardless of specificity or @container/@media context -
               without it this breakpoint was a dead rule, matched
               correctly (confirmed live: .widget-block's own
               container-type:inline-size ancestor really does report
               ~326px on a phone) but never actually applied, so Photos/
               Blog-style merged widgets stayed forced side by side down
               to a two-word-wide column each, truncating every label. #}
            .composite-panes { grid-template-columns: 1fr !important; }
            {# The drag divider has no meaning once panes are stacked
               instead of side-by-side (nothing left to drag horizontally)
               and, unlike .composite-panes, was never inline-styled -
               plain display:none is enough here, no !important needed. #}
            .composite-pane-divider { display: none; }
        }
        {# Filter dialog (crud/index.html.twig). Replaces the always-visible
           .filter-bar below, whose rules are kept only because the bar's
           inner markup (label / .filter-range / .filter-comparison) is
           reused verbatim inside the panel body. #}
        .filter-modal[hidden] { display: none; }
        {# left offset by the sidebar for the same reason as .flashes: a
           viewport-centred panel sits visibly left of the datagrid it is
           filtering. The backdrop still covers everything. #}
        .filter-modal { position: fixed; inset: 0 0 0 var(--admin-aside-w); z-index: 100020; display: flex; align-items: flex-start; justify-content: center; padding: 4rem 1rem 1rem; }
        {# Stretched back over the sidebar: .filter-modal is inset by the
           aside width so its PANEL centres on the content column, but the
           scrim must still cover the whole viewport or the sidebar stays
           bright and clickable behind an open modal. #}
        .filter-modal-backdrop { position: absolute; inset: 0 0 0 calc(-1 * var(--admin-aside-w)); background: rgba(0,0,0,.35); }
        .filter-modal-panel { position: relative; width: min(38rem, 100%); max-height: calc(100vh - 6rem); display: flex; flex-direction: column;
            background: var(--admin-surface); border: 1px solid var(--admin-border); border-radius: var(--admin-radius); box-shadow: 0 16px 48px rgba(0,0,0,.25); overflow: hidden; }
        {# 3 columns with the title centred, so Effacer/Appliquer sit hard
           against the two edges however wide the title is - the shape
           production uses. #}
        .filter-modal-header { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: .5rem;
            padding: .75rem .9rem; border-bottom: 1px solid var(--admin-border); background: var(--admin-bg); }
        .filter-modal-header > a { justify-self: start; }
        .filter-modal-header > button { justify-self: end; }
        .filter-modal-title { display: inline-flex; align-items: center; gap: .4rem; font-weight: 600; }
        .filter-modal-body { padding: .9rem; overflow: auto; display: grid; gap: .75rem; }
        {# One filter per row, label above control, every control the same
           width - the point of the rebuild. The old bar laid them out
           inline so a date range, a comparison pair and a plain select all
           ended up different heights on one wrapped line. #}
        .filter-modal-body label { display: grid; gap: .25rem; font-size: .82rem; color: var(--admin-muted); }
        .filter-modal-body label > span { font-weight: 600; color: var(--admin-text); }
        .filter-modal-body input, .filter-modal-body select {
            width: 100%; padding: .45rem .55rem; border: 1px solid var(--admin-border); border-radius: 6px;
            font: inherit; font-size: .9rem; color: inherit; background: var(--admin-bg); }
        .filter-modal-body .filter-range, .filter-modal-body .filter-comparison { display: flex; gap: .4rem; }
        {# The operator select must not eat the row: it holds a symbol, the
           value input holds the actual term. #}
        .filter-modal-body .filter-comparison select { flex: 0 0 5rem; }
        .filter-modal-body .filter-comparison input { flex: 1 1 auto; min-width: 0; }
        .filter-modal-body .filter-range input { flex: 1 1 0; min-width: 0; }
        {# Reorderable top-right action buttons (customize mode only). The
           grab cursor and dashed outline are the only affordance - the row
           is otherwise unchanged, so nothing shifts when customize mode is
           off. #}
        body.is-customizing [data-action-row] { user-select: none; -webkit-user-select: none; }
        body.is-customizing [data-action-row] [data-action-key] { cursor: grab; }
        body.is-customizing [data-action-row] [data-action-key]:hover { outline: 1px dashed var(--admin-accent); outline-offset: 2px; }
        body.is-customizing [data-action-row] [data-action-key].is-dragging { opacity: .4; cursor: grabbing; }
        {# The drop marker: a thin accent bar rendered on whichever button the
           pointer is currently before/after. Using an outline edge rather
           than inserting a placeholder node keeps the row's own flex layout
           from reflowing mid-drag. #}
        body.is-customizing [data-action-row] [data-action-key].drop-before { box-shadow: -3px 0 0 0 var(--admin-accent); }
        body.is-customizing [data-action-row] [data-action-key].drop-after { box-shadow: 3px 0 0 0 var(--admin-accent); }
        {# An action hidden on this page. It is dropped server-side for anyone
           who cannot customize at all, but a superadmin's markup always
           carries the customize hooks (customize_enabled is a PERMISSION,
           not the live mode - that is body.is-customizing, client-side
           only), so the ghost has to be hidden by CSS for the mode itself.
           Written as "hide unless customizing" rather than a hide/restore
           pair on purpose: no rule applies while customizing, so each
           element keeps its own natural display (.btn is inline-flex, the
           create-dropdown is a <details>) instead of being forced into one.
           While customizing it stays there, draggable and clickable, so the
           toggle that brings it back is reachable - same contract a hidden
           sidebar entry already has. #}
        body:not(.is-customizing) [data-action-row] .is-hidden { display: none; }
        body.is-customizing [data-action-row] .is-hidden { opacity: .38; text-decoration: line-through; }
        .filter-count { display: inline-flex; align-items: center; justify-content: center; min-width: 1.15rem; height: 1.15rem; padding: 0 .3rem;
            margin-left: .35rem; border-radius: 999px; background: var(--admin-accent); color: #fff; font-size: .7rem; font-weight: 700; }
        .filter-bar { display: flex; flex-wrap: wrap; align-items: flex-end; gap: .75rem; padding: .75rem .9rem; margin-bottom: 1rem;
                      background: var(--admin-surface); border: 1px solid var(--admin-border); border-radius: var(--admin-radius); }
        .filter-bar label { display: flex; flex-direction: column; gap: .2rem; font-size: .82rem; color: var(--admin-muted); }
        .filter-bar input, .filter-bar select { padding: .4rem .55rem; border: 1px solid var(--admin-border); border-radius: 6px; font: inherit; background: var(--admin-bg); }
        .filter-bar .filter-range { display: flex; gap: .3rem; }
        .filter-bar .filter-comparison { display: flex; gap: .3rem; }
        .filter-bar .filter-comparison select { width: auto; min-width: 3.2rem; }
        .new-dropdown { position: relative; display: inline-block; }
        .new-dropdown summary { list-style: none; }
        .new-dropdown summary::-webkit-details-marker { display: none; }
        .new-dropdown-menu { position: absolute; right: 0; top: calc(100% + 4px); z-index: 30; min-width: 180px;
                             background: var(--admin-surface); border: 1px solid var(--admin-border); border-radius: var(--admin-radius);
                             box-shadow: 0 8px 24px rgba(0,0,0,.15); padding: .3rem; }
        .new-dropdown-menu a { display: block; padding: .45rem .7rem; border-radius: 6px; color: inherit; text-decoration: none; }
        .new-dropdown-menu a:hover { background: var(--admin-bg); color: var(--admin-accent); }
        .datagrid th.batch, .datagrid td.batch { width: 2rem; text-align: center; }

        {# ── Field-type templates (crud/field/*.html.twig) ──────────────── #}
        .badge { display: inline-flex; align-items: center; gap: .3rem; padding: .15rem .55rem; border-radius: 999px;
                 background: var(--admin-bg); border: 1px solid var(--admin-border); font-size: .8rem; line-height: 1.5; white-space: nowrap; }
        .badge i { font-size: .75rem; }
        .badge-accent { background: color-mix(in srgb, var(--admin-accent) 12%, transparent); border-color: color-mix(in srgb, var(--admin-accent) 35%, transparent); color: var(--admin-accent); }
        .badge-muted { color: var(--admin-muted); }
        .badge-list { display: flex; flex-wrap: wrap; gap: .3rem; }
        {# No single chip may dictate a column's width. Table cells size to their
           widest content, so one verbose label (a tag phrase, an author's full
           name) stretched its column and pushed the whole grid past its
           container - the Tags header was rendering as "Ta" with the chips
           sliced mid-word. The full text stays available as the title tooltip. #}
        {# Safety net for every OTHER cell type. Truncation in the field
           templates handles the known offenders, but a table cell sizes to its
           widest content whatever renders it, so one long value anywhere still
           dictates a column. A ceiling with an ellipsis keeps any single column
           from doing that; the full value stays in the title attribute where
           the templates set one. #}
        .datagrid td { max-width: 15rem; }   /* 240px, matching production's widest column */
        {# :not(.badge) matters - a badge is inline-FLEX and uses `gap` to space
           its icon from its label. Forcing inline-block here killed the gap and
           the state pill rendered its icon jammed against the text. Badges do
           their own eliding via .badge-list above. #}
        .datagrid td .field-association a,
        .datagrid td .field-translatable,
        .datagrid td > span:only-child:not(.badge):not(.badge-list):not(.badges) {
            display: inline-block; max-width: 100%; overflow: hidden;
            text-overflow: ellipsis; white-space: nowrap; vertical-align: bottom; }
        .datagrid .badge-list { max-width: 14rem; }
        .datagrid .badge-list > .badge {
            max-width: 11rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        {# A related entity rendered as a badge (SelectField/AssociationField
           with entityDisplay and/or crudControllerFqcn set). text-decoration
           because the linked variant is an <a> and this admin loads no
           Bootstrap reboot to strip the UA underline. In 'avatar' mode the
           badge holds only the image, so the pill padding would frame it
           oddly - drop it and let the circle be the badge. #}
        .badge-entity { text-decoration: none; }
        .badge-entity:hover { border-color: var(--admin-accent); }
        .badge-entity:has(.badge-avatar) { padding: 0; border: 0; background: none; }
        .badge-avatar { width: 1.6rem; height: 1.6rem; border-radius: 999px; object-fit: cover; display: block;
            border: 1px solid var(--admin-border); background: var(--admin-bg); }

        /* position:relative is load-bearing, not decoration. The input below
           is absolutely positioned to hide it from sight while keeping it
           focusable; without a positioned ancestor its containing block
           became main.admin-main, so on a phone it was laid out at
           left:745px - escaping the datagrid's own scroll box and
           stretching the whole page to 750px of sideways scroll. */
        .field-switch { display: inline-flex; align-items: center; cursor: pointer; position: relative; }
        .field-switch input { position: absolute; opacity: 0; width: 1px; height: 1px; }
        .field-switch .track { width: 34px; height: 19px; border-radius: 999px; background: var(--admin-border); position: relative; transition: background .15s ease; flex: 0 0 auto; }
        .field-switch .track::after { content: ''; position: absolute; top: 2px; left: 2px; width: 15px; height: 15px; border-radius: 50%; background: #fff; box-shadow: 0 1px 2px rgba(0,0,0,.3); transition: transform .15s ease; }
        .field-switch input:checked + .track { background: var(--admin-accent); }
        .field-switch input:checked + .track::after { transform: translateX(15px); }
        .field-switch.is-saving { opacity: .6; pointer-events: none; }

        .field-color { display: inline-flex; align-items: center; gap: .4rem; }
        .field-color .swatch { width: 15px; height: 15px; border-radius: 4px; border: 1px solid rgba(0,0,0,.15); flex: 0 0 auto; }

        .field-country { display: inline-flex; align-items: center; gap: .4rem; }
        .field-country .flag { font-size: 1.05rem; line-height: 1; }

        .field-media { display: inline-flex; align-items: center; gap: .5rem; }
        .field-media img, .field-media .avatar { width: 32px; height: 32px; border-radius: 6px; object-fit: cover; border: 1px solid var(--admin-border); background: var(--admin-bg); }
        .field-media .avatar { border-radius: 50%; }
        .field-media a { color: inherit; }

        .field-mono { font-variant-numeric: tabular-nums; }
        .field-money, .field-number { font-variant-numeric: tabular-nums; white-space: nowrap; }

        {# The identifier stays put while the grid scrolls sideways, exactly as
           in the admin being replaced (`position: sticky; left: 0` on its ID
           cell). On a 13-column grid the row you are reading otherwise loses
           the only thing that names it. z-index below .actions so the two
           pinned edges layer predictably. #}
        .datagrid td.cell-id, .datagrid th.cell-id {
            position: sticky; left: 0; z-index: 4; background: var(--admin-surface);
            box-shadow: 8px 0 8px -8px rgba(0, 0, 0, .18); }
        .datagrid th.cell-id { background: var(--admin-bg); z-index: 6; }
        .datagrid tr:hover td.cell-id { background: var(--admin-bg); }

        {# ------------------------------------------------------------------
           The datagrid on a phone.

           A 13-column grid is 1677px wide. Sideways scrolling keeps it honest
           on a laptop, but on a 390px screen the sticky ID and action columns
           between them fill the viewport, so the list reads as a column of
           bare "#1147" with four icons beside it - every field that actually
           identifies a row sits off-screen in the 1300px nobody thinks to
           drag. Below 720px the table stops being a table: each row becomes a
           card, each cell a label/value line, with the heading supplied by the
           data-label the index template writes onto every td.

           display:block on table parts is what makes this work, and it means
           colspan, sticky positioning and the min-width:max-content floor all
           have to be undone explicitly - they are meaningless once the rows
           are no longer laid out as a table.
           ------------------------------------------------------------------ #}
        @media (max-width: 720px) {
            .table-responsive { overflow-x: visible; }

            table.datagrid { min-width: 0; display: block; }
            .datagrid thead { display: none; }
            .datagrid tbody, .datagrid tr, .datagrid td { display: block; }

            .datagrid tr {
                position: relative;
                border: 1px solid var(--admin-border);
                border-radius: 10px;
                margin: 0 0 .6rem;
                padding: .2rem .1rem;
                background: var(--admin-surface);
            }
            .datagrid tr:hover td { background: transparent; }

            .datagrid td {
                border-bottom: 1px solid var(--admin-border);
                padding: .5rem .8rem;
                white-space: normal;
                max-width: none;
                display: flex;
                align-items: baseline;
                justify-content: space-between;
                gap: 1rem;
            }
            .datagrid td:last-child { border-bottom: 0; }

            .datagrid td::before {
                content: attr(data-label);
                flex: 0 0 40%;
                color: var(--admin-muted);
                font-size: .78rem;
                text-transform: uppercase;
                letter-spacing: .03em;
                {# The td carries an inline text-align from the field's own
                   textAlign option, which a ::before inherits - so a column
                   configured to centre its values centred its LABEL too, and
                   the label column came out ragged down the card. Labels
                   always start at the same edge. #}
                text-align: left;
            }

            {# A cell whose value is empty would otherwise render as a lone
               floating label. Nothing useful to say, so say nothing. #}
            .datagrid td:empty { display: none; }

            {# Undo the pinned columns: there are no columns left to pin. #}
            .datagrid td.cell-id, .datagrid th.cell-id,
            .datagrid td.actions, .datagrid th.actions {
                position: static; box-shadow: none; background: transparent; }

            {# The identifier is the card's title, not one of its fields. #}
            .datagrid td.cell-id {
                padding-right: 3.2rem;
                font-size: 1rem;
                border-bottom: 1px solid var(--admin-border);
            }
            .datagrid td.cell-id::before { display: none; }
            .datagrid td.cell-id .field-id { font-size: 1rem; color: var(--admin-fg); font-weight: 600; }

            {# The batch checkbox rides in the card's top-right corner rather
               than taking a full line of its own. #}
            .datagrid td.batch {
                position: absolute; top: .45rem; right: .6rem;
                width: auto; padding: 0; border: 0; display: block; }
            .datagrid td.batch::before { display: none; }

            {# Actions become a footer strip, laid out left to right with room
               enough to hit with a thumb. #}
            .datagrid td.actions {
                display: flex; justify-content: flex-start; flex-wrap: wrap;
                gap: .25rem; text-align: left;
                padding-top: .6rem; padding-bottom: .6rem;
                border-top: 1px solid var(--admin-border);
            }
            .datagrid td.actions::before { display: none; }
            .datagrid .actions a, .datagrid .actions button { margin-left: 0; }
            .datagrid td.actions .btn-icon { min-width: 2.5rem; min-height: 2.5rem; }

            {# Long values (badge lists, translations) wrap instead of being
               clipped to an ellipsis - there is vertical room here. #}
            .datagrid td .field-association a,
            .datagrid td .field-translatable,
            .datagrid td > span:only-child:not(.badge):not(.badge-list):not(.badges) {
                max-width: none; overflow: visible; text-overflow: clip; white-space: normal; }
            .datagrid .badge-list { max-width: none; }
        }

        .field-id { color: var(--admin-muted); font-size: .85rem; }
        .field-id a { color: inherit; text-decoration: none; }
        .field-id a:hover { color: var(--admin-accent); }

        .field-slug code { background: var(--admin-bg); border: 1px solid var(--admin-border); border-radius: 4px; padding: .1rem .4rem; font-size: .85em; }
        .field-slug .lock { color: var(--admin-muted); font-size: .8em; margin-left: .3rem; }

        .field-translatable { display: inline-flex; align-items: center; gap: .4rem; }
        .field-translatable .locale-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
        .field-translatable .locale-dot.is-complete { background: #22c55e; }
        .field-translatable .locale-dot.is-missing { background: var(--admin-border); }

        .field-association a { color: inherit; text-decoration: none; border-bottom: 1px dotted var(--admin-muted); }
        .field-association a:hover { color: var(--admin-accent); border-color: var(--admin-accent); }
        .batch-toolbar { padding: .6rem .9rem; border-top: 1px solid var(--admin-border); }
        .manual-menu-section { margin-top: .5rem; }
        .manual-tree { list-style: none; margin: 0; padding-left: 1.1rem; }
        .manual-tree a { display: block; padding: .3rem 1.25rem; color: inherit; text-decoration: none; font-size: .92rem; }
        .manual-tree a:hover { color: var(--admin-accent); }
        .manual-tree li.selected > a { color: var(--admin-accent); font-weight: 600; }
        .manual-content { padding: 1.5rem; }
        .manual-meta { text-align: right; color: var(--admin-muted); font-size: .82rem; margin-bottom: .5rem; }
        .manual-excerpt { color: var(--admin-muted); }
    </style>
    {% endblock %}
    {% block form_assets %}
        {# base-bundle's prebuilt widget bundles (select2, editor, datetime,
           color, dropzone, ...) - published under /bundles/base and resolved
           through its WebpackTagRenderer; the widgets initialise themselves
           from DOM markers rendered by @Base/form/form_div_layout.html.twig #}
        {{ encore_entry_link_tags('form') }}
        {{ encore_entry_script_tags('form') }}
        {# Chart.js (tree-shaken to line/point/linear+category-scale/filler/
           tooltip/legend only) - a generic [data-admin-chart] initializer
           any page can use, not just the dashboard. Loaded globally like
           'form'/'base' rather than per-page: transparentJS's in-admin
           navigation only swaps #page's content, so a <head> script tied
           to one specific page would never (re-)run when navigating INTO
           that page via the SPA swap instead of a fresh full load. #}
        {{ encore_entry_script_tags('admin-charts') }}
        {# FontAwesome's class rules (.fa-solid/.fas/.far/...) live in the
           'base' entry's CSS, not 'form' - the font FILES were always
           reachable, but nothing mapped fa-* classes to glyphs, so every
           icon referenced by field/action config (IconField, EmailField,
           row action icons, ...) rendered as invisible/blank. CSS only -
           no need for 'base''s JS here. #}
        {{ encore_entry_link_tags('base') }}
        {# One SPA engine for the whole product: transparentJS, vendored here
           as plain UMD scripts (no Encore/webpack involvement - the package
           has no build step of its own). Same library the public site and
           the website-in-website overlay use; in-admin navigation now works
           the same way everything else does: AJAX swap of #page, cached
           pages, fade transitions - instead of a hard reload per click. #}
        <link rel="stylesheet" href="{{ asset('bundles/admin/css/transparent.css') }}">
        <style>
            {# transparent.css pins its native progress bar to the VIEWPORT's
               top (position:fixed) - generic default for any consumer. In
               the admin it should belong to the DOCUMENT instead (requested
               live): absolute anchors it to the page's own top edge, so it
               scrolls away with the content rather than shadowing the
               sticky topbar. Must come AFTER the transparent.css <link> -
               same specificity, cascade order is what makes this override
               win. #}
            html.progress-bar-native.ready:not(.first).progress-bar-active body::before {
                position: absolute;
            }
        </style>
        <script src="{{ asset('bundles/admin/js/jquery.min.js') }}"></script>
        <script src="{{ asset('bundles/admin/js/transparent.js') }}"></script>
        {% if customize_enabled is defined and customize_enabled %}
            {# Superadmin-only download - moderators/admins never fetch this. #}
            <script src="{{ asset('bundles/admin/js/sticky-sortable.js') }}"></script>
        {% endif %}
        <script>
            // Transparent.ready() was NEVER being called here - meaning
            // `isReady` stayed false forever, and __main__'s early-return
            // for that case does NOT call e.preventDefault() first. Every
            // click on every admin link was silently falling through to a
            // real, hard browser navigation of this iframe (not the AJAX
            // swap the rest of this layout's comments and markup assume) -
            // confirmed live: a genuine multi-hundred-ms blank-white gap
            // (a real page load, not a styled transition) on every single
            // in-admin navigation. {once:true} matters here exactly like it
            // does on the public site's equivalent call (see
            // assets/app-defer.js): transparent.js re-dispatches a
            // synthetic 'load' event on every SPA nav, so a non-once
            // listener would re-run ready() (and its side effects) on every
            // click inside the admin too.
            window.addEventListener('load', function () {
                if (!window.Transparent) return;
                Transparent.ready({
                    // Confine the SPA swap to /admin/* - a link out to the
                    // public site (e.g. a "view online" link on an
                    // article) should be a plain navigation, not an
                    // attempt to AJAX-swap the whole unrelated page into
                    // this frame.
                    exceptions: [/^(?!\/admin(\/|$)).*/],
                    // Changes on every real deploy, so a tab with an admin
                    // page cached from before a deploy purges its whole
                    // Transparent cache instead of replaying stale HTML
                    // forever - see transparent.js's own cache_version doc.
                    // admin_dev_version(): debug-only mtime suffix so
                    // UNCOMMITTED vendor edits purge it too - see
                    // DevVersionTwigExtension.
                    cache_version: '{{ deploy_version() }}{{ admin_dev_version() }}'
                });
            }, { once: true });
        </script>
        <script>
            // Quick GET submits (search box, filter bar): transparentJS only
            // binds its form handling to forms present at first load (a
            // static $("form").on(...) at init, not a delegated listener),
            // and its submit path bails on admin forms anyway - so every
            // search/filter submit was a full hard page load, unlike the
            // production admin where Turbo Drive swapped them in place.
            // Delegated interceptor: serialize the GET form into its target
            // URL and hand it to transparentJS's link pipeline (a synthetic
            // in-#page anchor click - __main__'s document-level click
            // listener treats it exactly like any sidebar link, giving the
            // same fast AJAX swap, progress bar included). POST forms
            // (edit/new/delete/batch) keep their native submit.
            document.addEventListener('submit', function (e) {
                const form = e.target;
                if (!(form instanceof HTMLFormElement)) return;
                if ((form.method || 'get').toLowerCase() !== 'get') return;
                const page = document.getElementById('page');
                if (!page || !page.contains(form)) return;

                e.preventDefault();
                const url = new URL(form.getAttribute('action') || location.pathname, location.origin);
                url.search = new URLSearchParams(new FormData(form)).toString();

                if (window.Transparent) {
                    const anchor = document.createElement('a');
                    anchor.href = url.pathname + url.search;
                    anchor.style.display = 'none';
                    form.appendChild(anchor);
                    anchor.click();
                    anchor.remove();
                } else {
                    location.assign(url.toString());
                }
            });
        </script>
        <script>
            // Filter bar: [data-autosubmit] selects/date inputs (boolean,
            // choice, association, comparison-operator, date range) apply
            // immediately on change instead of requiring a separate click on
            // "Filtrer" - matches prod's instant filtering. Free-text/number
            // value inputs deliberately do NOT autosubmit (that would fire
            // on every keystroke); those still need the explicit button.
            // Delegated on document for the same AJAX-swap-survival reason
            // as the switch/dropdown listeners around it.
            document.addEventListener('change', function (e) {
                const field = e.target.closest('[data-autosubmit]');
                if (!field || !field.form) return;
                field.form.requestSubmit();
            });

            // Filter dialog open/close. Delegated on document for the same
            // AJAX-swap-survival reason as every other listener here - the
            // button and the panel are both inside #page and get replaced
            // wholesale on each in-admin navigation.
            function setFilterModal(open) {
                const modal = document.getElementById('filter-modal');
                const toggle = document.getElementById('filter-toggle');
                if (!modal) return;
                modal.hidden = !open;
                if (toggle) toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
                if (open) {
                    // Focus the first control so the dialog is usable from
                    // the keyboard immediately.
                    const first = modal.querySelector('input, select');
                    if (first) first.focus();
                }
            }
            // CAPTURE phase, and it submits the form itself rather than
            // letting the button's own default do it. transparentJS's
            // document-level click handler treats a submit button as a
            // navigation candidate and runs its own swap for the form's
            // ACTION only - dropping every filter field, so "Appliquer"
            // reloaded the unfiltered list (verified: the same form via
            // requestSubmit() produces the correct ?filters[...] query,
            // the click produced none). Capturing lets us mark the event
            // handled before transparentJS's bubble-phase listener sees
            // it; that listener bails on e.defaultPrevented, which is
            // exactly the hook we want here.
            document.addEventListener('click', function (e) {
                const submit = e.target.closest('.filter-modal-panel [type="submit"]');
                if (!submit) return;
                const form = submit.form || submit.closest('form');
                if (!form) return;
                e.preventDefault();
                form.requestSubmit();
            }, true);

            document.addEventListener('click', function (e) {
                if (e.target.closest('#filter-toggle')) {
                    const modal = document.getElementById('filter-modal');
                    setFilterModal(!!modal && modal.hidden);
                    return;
                }
                // Backdrop only - a click anywhere inside the panel (including
                // on a <label>, which would otherwise bubble from its control)
                // must not close it mid-edit.
                if (e.target.closest('[data-filter-close]')) setFilterModal(false);
            });
            document.addEventListener('keydown', function (e) {
                if ('Escape' !== e.key) return;
                const modal = document.getElementById('filter-modal');
                if (modal && !modal.hidden) setFilterModal(false);
            });
        </script>
        <script>
            // crud/field/boolean.html.twig's inline switch: a delegated
            // listener on `document` (not the individual checkboxes)
            // survives every future in-admin AJAX swap without needing to
            // be re-bound - #page's content gets replaced, document itself
            // never does.
            //
            // Listens for 'click' on the LABEL and manages `checked`
            // itself (e.preventDefault() on the native forwarding),
            // rather than listening for 'change' and trusting the browser
            // to forward a label click to its nested checkbox first -
            // one less moving part between "user clicked" and "we know
            // the new value", and avoids depending on exactly how/when
            // that native forwarding fires.
            document.addEventListener('click', function (e) {
                const label = e.target.closest('.field-switch');
                if (!label) return;
                e.preventDefault();

                const input = label.querySelector('input[type=checkbox]');
                const previousChecked = input.checked;
                const url = label.dataset.toggleUrl;
                const property = label.dataset.property;
                const token = label.dataset.token;

                input.checked = !previousChecked;
                label.classList.add('is-saving');
                fetch(url, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ property: property, _token: token }),
                }).then(function (response) {
                    if (!response.ok) throw new Error('toggle failed');
                    return response.json();
                }).then(function (data) {
                    input.checked = !!data.value;
                }).catch(function () {
                    input.checked = previousChecked; // revert on any failure
                }).finally(function () {
                    label.classList.remove('is-saving');
                });
            });
        </script>
        <script>
            // Generic dropdown open/close - drives the topbar's appearance
            // and language menus, plus the sidebar account menu (same
            // [data-dropdown] wrapper + .admin-icon-btn/[aria-haspopup]
            // toggle convention). Delegated on document (same pattern as
            // the boolean switch above) so it survives future in-admin
            // AJAX swaps with nothing to rebind. Opening one dropdown
            // closes any other that's open; clicking anything inside the
            // menu (a real link, or a choice button below) closes it too.
            document.addEventListener('click', function (e) {
                // The sidebar's own [role=button] IS the dropdown trigger,
                // and the editable brand title/slogan live right inside it
                // (see the blur handler further below) - while actually
                // editing one, a click to place the cursor must not ALSO
                // toggle the account dropdown open underneath it.
                if (e.target.closest('[data-brand-title][contenteditable="true"]')) return;

                const toggle = e.target.closest('[data-dropdown] > .admin-icon-btn, [data-dropdown] > [aria-haspopup]');
                if (toggle) {
                    const dropdown = toggle.closest('[data-dropdown]');
                    const willOpen = !dropdown.classList.contains('is-open');
                    document.querySelectorAll('[data-dropdown].is-open').forEach(function (d) {
                        d.classList.remove('is-open');
                        const btn = d.querySelector('[aria-haspopup]');
                        if (btn) btn.setAttribute('aria-expanded', 'false');
                    });
                    if (willOpen) {
                        dropdown.classList.add('is-open');
                        toggle.setAttribute('aria-expanded', 'true');
                    }
                    return;
                }

                const openDropdown = document.querySelector('[data-dropdown].is-open');
                if (openDropdown) {
                    openDropdown.classList.remove('is-open');
                    const btn2 = openDropdown.querySelector('[aria-haspopup]');
                    if (btn2) btn2.setAttribute('aria-expanded', 'false');
                }
            });
            // [role=button] toggles (the sidebar account block isn't a real
            // <button>, so Enter/Space need a hand here - a real <button>
            // like the topbar dropdowns gets this for free from the browser).
            document.addEventListener('keydown', function (e) {
                if (e.key !== 'Enter' && e.key !== ' ') return;
                // Same reasoning as the click guard above - typing a literal
                // space into the editable slogan, or pressing Enter to
                // commit it, must not also fire the dropdown's own
                // Enter/Space-to-toggle handling.
                if (e.target.closest('[data-brand-title][contenteditable="true"]')) return;
                const toggle = e.target.closest('[data-dropdown] > [role=button][aria-haspopup]');
                if (!toggle) return;
                e.preventDefault();
                toggle.click();
            });
            // Theme choice itself: separate from the generic open/close
            // above, only cares about which [data-theme-choice] was picked.
            document.addEventListener('click', function (e) {
                const choiceBtn = e.target.closest('[data-theme-choice]');
                if (!choiceBtn) return;

                const choice = choiceBtn.dataset.themeChoice;
                if (choice === 'auto') {
                    localStorage.removeItem('admin-theme');
                    document.documentElement.removeAttribute('data-theme');
                } else {
                    localStorage.setItem('admin-theme', choice);
                    document.documentElement.setAttribute('data-theme', choice);
                }
            });
            // reflect the saved/current choice with an "active" mark and
            // keep it in sync if the OS theme changes while "system" is
            // selected (no saved override) - re-runs the same tiny check
            // rather than needing a page reload to notice.
            (function () {
                function markActive() {
                    var saved = localStorage.getItem('admin-theme') || 'auto';
                    document.querySelectorAll('[data-theme-choice]').forEach(function (btn) {
                        btn.classList.toggle('is-active', btn.dataset.themeChoice === saved);
                    });
                }
                markActive();
                document.addEventListener('click', function (e) {
                    if (e.target.closest('[data-theme-choice]')) markActive();
                });
            })();

            // Sidebar collapse toggle - persisted the same way as the theme
            // choice, applied pre-paint above so there's no flash of the
            // wrong width on load.
            //
            // Event-delegated (document-level click, matched by ID at CLICK
            // time via closest()), like the dropdown/theme-choice handlers
            // above - NOT document.getElementById() + a direct listener.
            // This whole script block runs in <head>, before the button
            // (way down in <body>) has been parsed into the DOM yet -
            // getElementById() found nothing, so the click listener never
            // attached to anything, silently. Delegation sidesteps that
            // entirely: the lookup only ever happens later, at actual click
            // time, by which point the button obviously exists.
            document.addEventListener('click', function (e) {
                var toggle = e.target.closest('#admin-sidebar-collapse-toggle');
                if (!toggle) return;
                var on = !document.documentElement.classList.contains('is-sidebar-collapsed');
                document.documentElement.classList.toggle('is-sidebar-collapsed', on);
                toggle.setAttribute('aria-pressed', on ? 'true' : 'false');
                try { localStorage.setItem('admin-sidebar-collapsed', on ? '1' : '0'); } catch (err) {}
            });
            // One-time aria-pressed sync on load - deferred to DOMContentLoaded
            // for the same reason (the button doesn't exist yet up here).
            document.addEventListener('DOMContentLoaded', function () {
                var toggle = document.getElementById('admin-sidebar-collapse-toggle');
                if (toggle) toggle.setAttribute('aria-pressed', document.documentElement.classList.contains('is-sidebar-collapsed') ? 'true' : 'false');
            });

            // Mobile off-canvas nav toggle - same event-delegation reasoning
            // as the desktop collapse toggle above. Not persisted like that
            // one is: a fresh page load (a real navigation, not an SPA
            // route swap - every sidebar link is a plain <a>) always starts
            // with the nav closed, so there's nothing to sync pre-paint or
            // on DOMContentLoaded here.
            document.addEventListener('click', function (e) {
                var toggle = e.target.closest('#admin-mobile-nav-toggle');
                if (toggle) {
                    var open = !document.documentElement.classList.contains('is-mobile-nav-open');
                    document.documentElement.classList.toggle('is-mobile-nav-open', open);
                    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
                    return;
                }
                if (e.target.closest('#admin-mobile-nav-backdrop')) {
                    document.documentElement.classList.remove('is-mobile-nav-open');
                }
            });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') document.documentElement.classList.remove('is-mobile-nav-open');
            });

            // Sidebar stats panel: click-to-toggle (event-delegated, same
            // reasoning as the collapse toggle right above).
            document.addEventListener('click', function (e) {
                var toggle = e.target.closest('[data-stats-toggle]');
                if (!toggle) return;
                var panel = document.getElementById('admin-sidebar-stats');
                if (!panel) return;
                var open = !panel.classList.contains('is-open');
                panel.classList.toggle('is-open', open);
                toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
                if (open) panel.scrollIntoView({ block: 'nearest' });
            });

            // Collapsed-rail section flyout: opens downward from the
            // trigger's own top edge by default (see the CSS), which runs
            // straight off the bottom of the viewport for any section low
            // enough in the menu - a section doesn't have to be the LAST
            // one for this to happen, just low enough that its own flyout
            // height overflows what's left below it. Measured per-hover
            // (not cached) since the flyout's height varies per section and
            // the viewport can change between hovers; the group is briefly
            // made visible-but-hidden to get a real layout height, since
            // display:none elements report zero for everything.
            function positionFlyout(group) {
                if (!document.documentElement.classList.contains('is-sidebar-collapsed')) return;
                var flyout = group.querySelector(':scope > ul');
                if (!flyout) return;
                var triggerTop = group.getBoundingClientRect().top;
                var wasHidden = getComputedStyle(flyout).display === 'none';
                if (wasHidden) { flyout.style.visibility = 'hidden'; flyout.style.display = 'block'; }
                var flyoutHeight = flyout.getBoundingClientRect().height;
                if (wasHidden) { flyout.style.removeProperty('visibility'); flyout.style.removeProperty('display'); }
                group.classList.toggle('flyout-open-upward', triggerTop + flyoutHeight > window.innerHeight - 16);
            }
            document.addEventListener('mouseover', function (e) {
                var group = e.target.closest('.section-group');
                if (group) positionFlyout(group);
            });
            document.addEventListener('focusin', function (e) {
                var group = e.target.closest('.section-group');
                if (group) positionFlyout(group);
            });

            // Multi-locale field tabs (see the .nav-tabs/.tab-pane CSS
            // comment above) - Bootstrap's own data-bs-toggle="tab" markup,
            // no Bootstrap JS behind it to act on a click. Event-delegated
            // like every other toggle on this page - this script runs in
            // <head>, before the form itself exists in the DOM yet.
            document.addEventListener('click', function (e) {
                var tabBtn = e.target.closest('[data-bs-toggle="tab"]');
                if (!tabBtn) return;
                e.preventDefault();
                var target = document.querySelector(tabBtn.dataset.bsTarget);
                if (!target) return;

                var tabList = tabBtn.closest('.nav-tabs');
                if (tabList) {
                    tabList.querySelectorAll('.nav-link').forEach(function (btn) {
                        btn.classList.toggle('active', btn === tabBtn);
                    });
                }

                var tabContent = target.closest('.tab-content');
                if (tabContent) {
                    tabContent.querySelectorAll(':scope > .tab-pane').forEach(function (pane) {
                        pane.classList.toggle('active', pane === target);
                        pane.classList.toggle('show', pane === target);
                    });
                }
            });

        </script>
    {% endblock %}
</head>
<body>
{# id="page": transparentJS only engages its SPA click/swap handling when
   the current document contains this element (same convention the public
   site's base.html.twig uses) - everything inside it is what gets swapped
   and cached on navigation. #}
<div id="page" class="admin-shell">
    {# Only ever shown/clickable via the is-mobile-nav-open class (see the
       @media block on .admin-mobile-nav-backdrop above) - a straight
       sibling of .admin-aside/.admin-main, not nested in either, so its
       fixed positioning isn't affected by .admin-aside's own transform. #}
    <div class="admin-mobile-nav-backdrop" id="admin-mobile-nav-backdrop"></div>
    <aside class="admin-aside">
        {% set hasUserMenu = admin_context is defined and admin_context.userMenu is not empty %}
        {% set canEditBrand = is_granted('ROLE_SUPERADMIN') %}
        <div class="admin-account"{% if hasUserMenu %} data-dropdown{% endif %}{% if canEditBrand %} data-csrf-token="{{ csrf_token('admin-settings-quick') }}"{% endif %}>
            <div class="brand"{% if hasUserMenu %} role="button" tabindex="0" aria-haspopup="true" aria-expanded="false"{% endif %}>
                {% block brand %}
                    {% if app.site.logo is not empty %}
                        <img class="brand-logo" src="{{ app.site.logo|thumbnail(64, 64) }}" alt="">
                    {% endif %}
                    <div class="brand-text">
                        <div class="brand-title-row">
                            <span class="brand-title" data-brand-title>{% block brand_title %}{{ app.site.title ?? 'Administration' }}{% endblock %}</span>
                            {% if hasUserMenu %}<i class="fa-solid fa-chevron-down account-caret"></i>{% endif %}
                        </div>
                        {% if app.user %}<span class="brand-user">{{ app.user }}</span>{% endif %}
                    </div>
                {% endblock %}
            </div>
            {% block user_menu %}
                {% if hasUserMenu %}
                <ul class="admin-menu admin-usermenu admin-dropdown-menu" role="menu">
                    {# The brand row above carries the SITE logo and title; the account
                       it belongs to was only named there, never shown. Lead the dropdown
                       with the signed-in user - their own avatar, not the site logo -
                       the way the admin being replaced does, so the two images stay
                       tellable apart at a glance. #}
                    {% if app.user %}
                        {% set accountAvatar = app.user.avatar is defined ? app.user.avatar : null %}
                        <li class="admin-usermenu-account">
                            {% if accountAvatar is not empty %}
                                <img class="admin-usermenu-avatar" src="{{ accountAvatar|thumbnail(64, 64) }}" alt="">
                            {% else %}
                                <span class="admin-usermenu-avatar admin-usermenu-avatar-empty"><i class="fa-solid fa-user"></i></span>
                            {% endif %}
                            <span class="admin-usermenu-identity">
                                <span class="admin-usermenu-label">{{ 'menu.signed_in_as'|trans({}, 'admin') }}</span>
                                <span class="admin-usermenu-name">{{ app.user }}</span>
                            </span>
                        </li>
                        <li class="admin-usermenu-divider" role="separator"></li>
                    {% endif %}
                    {% for item in admin_context.userMenu %}
                        {# Sign-out closes the menu and gets its own group, like production.
                           Keyed off the loop position rather than the label: userMenu is
                           host-configurable, and matching on 'menu.logout' silently did
                           nothing the moment an app supplied its own label. #}
                        {% if loop.last and not loop.first %}<li class="admin-usermenu-divider" role="separator"></li>{% endif %}
                        <li><a href="{{ item.linkUrl ?? '#' }}">{% if item.icon %}<i class="{{ item.icon }}"></i> {% endif %}{{ item.label|trans({}, 'admin') }}</a></li>
                    {% endfor %}
                </ul>
                {% endif %}
            {% endblock %}
        </div>
        {% block main_menu %}
            {% if admin_context is defined and admin_context.mainMenu is not empty %}
            <ul class="admin-menu" data-sortable="sidebar">
                {% for item in admin_context.mainMenu %}
                    {% if item.type == 'block' %}
                        {# rendered separately, in the bottom icon row below - not a navigable link #}
                    {% elseif item.section %}
                        {# A section and its members are one DOM subtree (this <li> plus the
                           nested <ul> below) - dragging the section by its own handle carries
                           every member along with it for free, since they're its actual DOM
                           children. Members stay independently reorderable/hideable inside
                           their own nested data-sortable list (same pattern the dashboard
                           already uses for a widget's sub-items). #}
                        {# .section-flyout: in collapsed-rail mode the section's label and
                           members have nowhere to sit inline, so hovering/focusing the
                           whole group pops them out as one panel to the right instead -
                           see the .is-sidebar-collapsed CSS and the section's own label
                           repeated as a flyout-only heading (hidden in normal expanded
                           mode, where the inline .section label already shows it). #}
                        <li class="section-group {{ item.hidden ? 'is-hidden' }}" data-sortable-item data-sortable-key="{{ item.key }}">
                            {# icon + label-text share ONE flex slot (like a regular item's
                               <a> does) rather than being two independent children of
                               .section's own justify-content:space-between row - otherwise,
                               with item-controls absent outside customize mode, space-between
                               had exactly two visible children (icon, label) and pushed the
                               LAST one - the label - all the way to the right edge. #}
                            {# No title="" here - the native browser tooltip and the
                               custom flyout panel below both trigger on the same
                               hover, so with one it'd pop up floating and
                               disconnected right alongside the flyout (reported
                               live via screenshot: a small "Rôles" box detached
                               from the actual panel). The flyout's own heading
                               (.flyout-heading, collapsed-mode only) already
                               shows this label - a plain link's title (below,
                               in the expanded per-item .section-label) is the
                               only other place a bare label ever needs one. #}
                            <div class="section">
                                <span class="section-label">
                                    {% if item.icon %}<i class="{{ item.icon }}"></i>{% endif %}
                                    <span class="label-text">{{ item.label|trans({}, 'admin') }}</span>
                                </span>
                                {% if customize_enabled is defined and customize_enabled %}
                                    <span class="item-controls">
                                        <button type="button" class="item-handle" data-sortable-handle title="{{ 'customize.reorder'|trans({}, 'admin') }}"><i class="fa-solid fa-grip-vertical"></i></button>
                                        <button type="button" class="item-toggle" data-toggle-hidden title="{{ 'customize.toggle_visibility'|trans({}, 'admin') }}"><i class="fa-solid fa-eye{{ item.hidden ? '-slash' }}"></i></button>
                                    </span>
                                {% endif %}
                            </div>
                            {% if item.subItems is not empty %}
                            <ul data-sortable="sidebar-section-{{ item.key }}">
                                <li class="flyout-heading">{{ item.label|trans({}, 'admin') }}</li>
                                {% for member in item.subItems %}
                                    <li class="{{ member.selected ? 'selected' }} {{ member.hidden ? 'is-hidden' }}" data-sortable-item data-sortable-key="{{ member.key }}">
                                        <a href="{{ member.linkUrl ?? '#' }}"{% if member.linkTarget %} target="{{ member.linkTarget }}"{% endif %} title="{{ member.label|trans({}, 'admin') }}">{% if member.icon %}<i class="{{ member.icon }}"></i> {% endif %}<span class="label-text">{{ member.label|trans({}, 'admin') }}</span></a>
                                        {% if customize_enabled is defined and customize_enabled %}
                                            <span class="item-controls">
                                                <button type="button" class="item-handle" data-sortable-handle title="{{ 'customize.reorder'|trans({}, 'admin') }}"><i class="fa-solid fa-grip-vertical"></i></button>
                                                <button type="button" class="item-toggle" data-toggle-hidden title="{{ 'customize.toggle_visibility'|trans({}, 'admin') }}"><i class="fa-solid fa-eye{{ member.hidden ? '-slash' }}"></i></button>
                                            </span>
                                        {% endif %}
                                    </li>
                                    {% for subItem in member.subItems %}
                                        <li class="{{ subItem.selected ? 'selected' }} sub"><a href="{{ subItem.linkUrl ?? '#' }}" title="{{ subItem.label|trans({}, 'admin') }}">{% if subItem.icon %}<i class="{{ subItem.icon }}"></i> {% endif %}<span class="label-text">{{ subItem.label|trans({}, 'admin') }}</span></a></li>
                                    {% endfor %}
                                {% endfor %}
                            </ul>
                            {% endif %}
                        </li>
                    {% else %}
                        <li class="{{ item.selected ? 'selected' }} {{ item.hidden ? 'is-hidden' }}" data-sortable-item data-sortable-key="{{ item.key }}">
                            <a href="{{ item.linkUrl ?? '#' }}"{% if item.linkTarget %} target="{{ item.linkTarget }}"{% endif %} title="{{ item.label|trans({}, 'admin') }}">{% if item.icon %}<i class="{{ item.icon }}"></i> {% endif %}<span class="label-text">{{ item.label|trans({}, 'admin') }}</span></a>
                            {% if customize_enabled is defined and customize_enabled %}
                                <span class="item-controls">
                                    <button type="button" class="item-handle" data-sortable-handle title="{{ 'customize.reorder'|trans({}, 'admin') }}"><i class="fa-solid fa-grip-vertical"></i></button>
                                    <button type="button" class="item-toggle" data-toggle-hidden title="{{ 'customize.toggle_visibility'|trans({}, 'admin') }}"><i class="fa-solid fa-eye{{ item.hidden ? '-slash' }}"></i></button>
                                </span>
                            {% endif %}
                        </li>
                        {% for subItem in item.subItems %}
                            <li class="{{ subItem.selected ? 'selected' }} sub"><a href="{{ subItem.linkUrl ?? '#' }}" title="{{ subItem.label|trans({}, 'admin') }}">{% if subItem.icon %}<i class="{{ subItem.icon }}"></i> {% endif %}<span class="label-text">{{ subItem.label|trans({}, 'admin') }}</span></a></li>
                        {% endfor %}
                    {% endif %}
                {% endfor %}
            </ul>
            {% endif %}
        {% endblock %}
        {% block sidebar_footer %}
            {% set analyticsItem = admin_context is defined ? (admin_context.mainMenu|filter(i => i.type == 'block' and i.blockName == 'analytics_widget')|first) : null %}
            <div class="admin-sidebar-footer">
                {# Was a plain link to the public site ("/") - repurposed to
                   the admin dashboard itself, taking over the job of the
                   top nav's own "Tableau de bord" link (now removed from
