<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en') }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block page_title %}Admin{% endblock %}</title>
    {# Applied before any CSS paints, not after - reading this in a normal
       body-level script would show the light theme for one frame then
       flash to dark. "auto" (the default - no explicit choice saved yet)
       intentionally sets no attribute at all: the plain
       @media(prefers-color-scheme:dark) rule below already covers it, no
       need to duplicate that logic in JS too. #}
    <script>
        (function () {
            var saved = localStorage.getItem('admin-theme');
            if (saved === 'light' || saved === 'dark') {
                document.documentElement.setAttribute('data-theme', saved);
            }
            // Same pre-paint timing as the theme choice above: the sidebar
            // collapse toggles a width change (230px -> icon rail), so
            // applying it after first paint would show a flash of the wrong
            // width for one frame instead of just the wrong color.
            if (localStorage.getItem('admin-sidebar-collapsed') === '1') {
                document.documentElement.classList.add('is-sidebar-collapsed');
            }
        })();
    </script>
    {% block head_stylesheets %}
    <style>
        :root {
            --admin-bg: #f6f7f9; --admin-surface: #fff; --admin-border: #e3e6ea;
            --admin-text: #1f2429; --admin-muted: #6b7683; --admin-accent: #2563eb;
            --admin-danger: #dc2626; --admin-success: #16a34a; --admin-radius: 8px;
        }
        {# "auto" (no data-theme attribute at all) follows the OS - explicit
           data-theme="dark"/"light" (set above from a saved preference)
           always wins regardless of OS setting. #}
        @media (prefers-color-scheme: dark) {
            :root:not([data-theme="light"]) {
                --admin-bg: #16181d; --admin-surface: #1e2127; --admin-border: #2c3038;
                --admin-text: #e6e8eb; --admin-muted: #8b94a1; --admin-accent: #6ea8fe;
                --admin-danger: #f87171; --admin-success: #4ade80;
            }
        }
        :root[data-theme="dark"] {
            --admin-bg: #16181d; --admin-surface: #1e2127; --admin-border: #2c3038;
            --admin-text: #e6e8eb; --admin-muted: #8b94a1; --admin-accent: #6ea8fe;
            --admin-danger: #f87171; --admin-success: #4ade80;
        }
        {# Sticky at top:0 with no shadow, only a 1px border, gave the bar no
           visual weight of its own - at rest (no scroll needed, the negative
           margin already pulls it flush with the viewport edge) it read as
           part of whatever sits above the page rather than page content.
           A real shadow gives it depth/definition regardless of what's
           behind/above it. #}
        {# height, not padding - see the matching comment on .admin-aside
           .brand, which this is deliberately kept in sync with (same
           3.3rem) so both bars' bottom borders land on the same line. #}
        .admin-topbar { display: flex; align-items: center; gap: 1rem; height: 3.3rem; padding: 0 .9rem; margin: -1.5rem -2rem 1.25rem; border-bottom: 1px solid var(--admin-border);
                       position: sticky; top: 0; z-index: 15; background: var(--admin-bg); box-shadow: 0 2px 6px rgba(0,0,0,.1); }
        .topbar-search { flex: 1; max-width: 420px; display: flex; align-items: center; gap: .5rem; padding: .4rem .8rem; border: 1px solid var(--admin-border);
                         border-radius: 999px; background: var(--admin-surface); color: var(--admin-muted); }
        .topbar-search i { flex: 0 0 auto; }
        .topbar-search input { flex: 1; border: 0; background: none; font: inherit; color: inherit; min-width: 0; }
        .topbar-search input:focus { outline: none; }
        .admin-topbar-icons { margin-left: auto; display: flex; align-items: center; gap: .4rem; }
        .admin-icon-dropdown { position: relative; }
        .admin-icon-btn { display: flex; align-items: center; justify-content: center; width: 2.1rem; height: 2.1rem; border-radius: 999px; border: 1px solid transparent;
            background: none; color: var(--admin-muted); cursor: pointer; font: inherit; }
        .admin-icon-btn:hover { border-color: var(--admin-border); color: var(--admin-accent); background: var(--admin-surface); }
        .admin-dropdown-menu { display: none; position: absolute; top: calc(100% + .3rem); right: 0; min-width: 150px; z-index: 20;
            background: var(--admin-surface); border: 1px solid var(--admin-border); border-radius: var(--admin-radius); box-shadow: 0 8px 24px rgba(0,0,0,.15); overflow: hidden; }
        [data-dropdown].is-open .admin-dropdown-menu { display: block; }
        .admin-dropdown-menu button, .admin-dropdown-menu a { display: flex; align-items: center; gap: .5rem; width: 100%; padding: .5rem .8rem; border: 0; background: none; text-align: left;
            color: inherit; text-decoration: none; cursor: pointer; font: inherit; font-size: .85rem; box-sizing: border-box; }
        .admin-dropdown-menu button:hover, .admin-dropdown-menu a:hover { background: var(--admin-bg); }
        .admin-dropdown-menu button.is-active, .admin-dropdown-menu a.is-active { color: var(--admin-accent); font-weight: 600; }
        .admin-dropdown-menu i { width: 1rem; text-align: center; }
        .admin-locale-flag { width: 1.15rem; height: .85rem; object-fit: cover; border-radius: 2px; flex-shrink: 0; }
        {# The avatar cluster IS the "shown by default" summary (not hidden
           behind opening the dropdown) - the dropdown itself is purely the
           "expand to a full list" part. #}
        .admin-active-users-trigger { width: auto; padding: 0 .5rem 0 .3rem; border-radius: 999px; gap: .25rem; }
        .admin-active-avatars { display: flex; }
        .admin-avatar-initial { display: flex; align-items: center; justify-content: center; width: 1.6rem; height: 1.6rem; border-radius: 50%;
            background: var(--admin-accent); color: #fff; font-size: .7rem; font-weight: 700; border: 2px solid var(--admin-surface); flex-shrink: 0; }
        .admin-active-avatars .admin-avatar-initial + .admin-avatar-initial { margin-left: -.5rem; }
        .admin-active-count { font-size: .72rem; color: var(--admin-muted); font-weight: 600; }
        .admin-active-users-list { min-width: 220px; }
        .dropdown-heading { padding: .5rem .8rem .3rem; font-size: .72rem; text-transform: uppercase; letter-spacing: .04em; color: var(--admin-muted); }
        .admin-active-user-row { display: flex; align-items: center; gap: .5rem; padding: .4rem .8rem; font-size: .85rem; }
        .admin-active-user-row .admin-avatar-initial { border: 0; }
        .admin-active-user-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .admin-active-dot { width: .5rem; height: .5rem; border-radius: 50%; background: var(--admin-muted); flex-shrink: 0; }
        .admin-active-dot.is-online { background: var(--admin-success); }
        * { box-sizing: border-box; }
        body { margin: 0; font: 15px/1.5 system-ui, -apple-system, sans-serif; background: var(--admin-bg); color: var(--admin-text); }
        .admin-shell { display: flex; min-height: 100vh; }
        {# Without this, .admin-shell's flex layout stretches .admin-aside to
           match .admin-main's full content height, so on any page taller
           than the viewport (basically every dashboard/CRUD page) the whole
           sidebar - including the bottom Système/Rôles/Documentation
           sections - scrolls away with the page instead of staying put. #}
        {# No top padding here (moved to bottom-only) - it used to push the
           brand row down 1rem before it even started, while .admin-topbar
           sits flush at the very top of the viewport (sticky, top:0, no
           equivalent offset) - the single biggest contributor to the two
           bars' borders not lining up. #}
        {# 230px was tight enough that routine French labels ("Réponses aux
           commentaires", "Super administrateurs", "Paramètres du site")
           wrapped to two lines by default, before even accounting for the
           customize-mode handle/eye icons eating further into the same
           width - reads as a cramped sidebar regardless of how much room
           the surrounding page/nest panel actually has. #}
        {# z-index matters here for more than just its own stacking: .admin-
           aside has none of its own positioned descendants poking outside
           its bounds UNTIL the collapsed-rail flyout (further down) needs
           to. Without an explicit z-index on .admin-aside ITSELF, it and
           .admin-main are both "auto"-stacked siblings, resolved by plain
           DOM order - .admin-main comes second, so it paints on top
           regardless of any z-index set on something nested inside .admin-
           aside; the flyout's own z-index:30 only ever wins within THIS
           element's local stacking context, never against .admin-main's
           content sitting in a different one entirely. #}
        .admin-aside { width: 260px; flex-shrink: 0; display: flex; flex-direction: column; background: var(--admin-surface); border-right: 1px solid var(--admin-border); padding: 0 0 1rem;
                      position: sticky; top: 0; height: 100vh; overflow-y: auto; scroll-behavior: smooth; z-index: 20; }
        {# Fixed height (matching .admin-topbar's own, below) instead of
           content-driven padding, so the brand row's bottom border and the
           topbar's bottom border land at the exact same Y regardless of
           either one's actual content (logo vs. icon buttons are
           different sizes) - align-items:center on both handles the
           vertical centering that the removed padding used to. #}
        .admin-aside .brand { display: flex; align-items: center; gap: .6rem; height: 3.3rem; padding: 0 1.25rem; border-bottom: 1px solid var(--admin-border); }
        .admin-aside .brand-logo { width: 2.25rem; height: 2.25rem; border-radius: 6px; object-fit: cover; flex-shrink: 0; }
        .admin-aside .brand-text { display: flex; flex-direction: column; min-width: 0; }
        .admin-aside .brand-title { font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .admin-aside .brand-user { font-size: .8rem; color: var(--admin-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .admin-menu { list-style: none; margin: .75rem 0 0; padding: 0; }
        {# prod-style vertical rhythm: quick links (dashboard) stay at the
           top, the first section - and everything after it - is pushed to
           the bottom of the aside, leaving the middle empty. Navigation
           itself lives in the dashboard's central widget groups, NOT here. #}
        aside.admin-aside > ul.admin-menu:first-of-type { flex: 1; display: flex; flex-direction: column; }
        aside.admin-aside > ul.admin-menu:first-of-type > li:first-child { margin-bottom: auto; }
        {# .section-group (the <li>) holds the label row and its nested
           member <ul> stacked vertically - overrides the generic
           ".admin-menu li { display:flex }" row layout below, which is
           for individual nav items, not this section-plus-members group. #}
        .admin-menu li.section-group { display: block; }
        {# No right padding here - .item-controls supplies its own right
           margin (below) so a section's icon pair and a regular item's
           icon pair land at the exact same inset regardless of which
           container (a padded .section div vs an unpadded <li>) they're
           actually sitting in. #}
        .admin-menu .section { display: flex; align-items: center; justify-content: space-between;
            padding: .9rem 0 .3rem 1.25rem; font-size: .78rem; text-transform: uppercase; letter-spacing: .04em; color: var(--admin-muted); }
        {# flex:1 so this - not the trailing item-controls - is what
           absorbs the row's leftover space; keeps icon+label pinned left
           regardless of whether item-controls is even present. #}
        .admin-menu .section-label { display: flex; align-items: center; flex: 1; min-width: 0; gap: .3rem; }
        .admin-menu .section-label i { width: 1.1rem; text-align: center; }
        .admin-menu .section-group > ul { list-style: none; margin: 0; padding: 0; }
        .admin-menu a { display: flex; align-items: center; padding: .45rem 1.25rem; color: inherit; text-decoration: none; border-left: 3px solid transparent; }
        .admin-menu li:hover > a { background: var(--admin-bg); }
        .admin-menu .selected > a { border-left-color: var(--admin-accent); color: var(--admin-accent); font-weight: 600; }
        .admin-menu a i { width: 1.1rem; text-align: center; margin-right: .3rem; }
        .admin-menu .sub a { padding-left: 2.75rem; font-size: .92rem; }
        .admin-menu li.is-hidden, .widget-group.is-hidden, .widget-block.is-hidden { display: none; }
        body.is-customizing .admin-menu li.is-hidden, body.is-customizing .widget-group.is-hidden, body.is-customizing .widget-block.is-hidden {
            display: block; opacity: .45;
        }
        {# Handle/toggle controls: invisible and inert outside customize
           mode (not just hidden - the drag handle must not intercept
           clicks or show a grab cursor on a normal page). #}
        #admin-customize-toggle.is-active { color: var(--admin-accent); border-color: var(--admin-accent); background: var(--admin-surface); }
        .item-controls { display: none; align-items: center; gap: .3rem; }
        body.is-customizing .item-controls { display: inline-flex; }
        {# align-items:stretch (the flex default - overriding the old
           explicit "center") + min-height together are what make a
           single-line row and a wrapped two-line row hover/highlight as
           the same consistent shape: the <a> now fills its <li>'s full
           box (so the hover background - moved to li:hover > a above -
           always covers the complete row, not just the link's own
           intrinsic content height), and every row has the same floor
           height regardless of how much text it holds. #}
        .admin-menu li { display: flex; align-items: stretch; justify-content: space-between; min-height: 2.4rem; }
        .admin-menu li a { flex: 1; }
        .admin-menu li .item-controls { align-self: center; }
        .item-handle, .item-toggle, .item-remove, .item-split { display: flex; align-items: center; justify-content: center; width: 1.6rem; height: 1.6rem; border: 0; border-radius: 6px;
            background: none; color: var(--admin-muted); cursor: pointer; font-size: .78rem; flex-shrink: 0; }
        .item-handle:hover, .item-toggle:hover, .item-split:hover { background: var(--admin-bg); color: var(--admin-text); }
        {# Danger-tinted hover only, not a permanent color - only ad-hoc/
           palette-added widgets ever get this button (see _block.html.twig),
           and it deletes immediately with no confirmation step, so the
           hover state is the one warning a user gets before clicking. #}
        .item-remove:hover { background: var(--admin-danger); color: #fff; }
        {# ── Collapsed sidebar (icon-only rail) ──────────────────────────
           A section's label + members have nowhere to sit inline once
           collapsed, so the whole section-group pops them out as a flyout
           on hover/focus instead - .section stays as the icon-only trigger,
           its nested <ul> (already in the DOM either way, see main_menu)
           becomes that flyout's content, with a heading row (flyout-only,
           hidden in normal expanded mode) repeating the label that's no
           longer visible inline. Ungrouped top-level items get a plain
           native title="" tooltip instead - a single link never needed a
           whole flyout for one label. #}
        html.is-sidebar-collapsed .admin-aside { width: 4.5rem; }
        html.is-sidebar-collapsed .admin-aside .brand { justify-content: center; padding-left: 0; padding-right: 0; }
        html.is-sidebar-collapsed .admin-aside .brand-text, html.is-sidebar-collapsed .admin-aside .account-caret { display: none; }
        {# .admin-menu a is display:block normally (no flex, so nothing to
           center) - only the collapsed rail needs it centered on its icon. #}
        html.is-sidebar-collapsed .admin-menu a { display: flex; align-items: center; justify-content: center; padding-left: 0; padding-right: 0; }
        html.is-sidebar-collapsed .admin-menu .section { justify-content: center; padding-left: 0; padding-right: 0; }
        {# Without this, .section-label's flex:1 (needed in expanded mode to
           keep item-controls pinned right) stretches it across the whole
           collapsed row, leaving its own content (just the icon, once
           .label-text hides) sitting at flex-start instead of centered. #}
        html.is-sidebar-collapsed .admin-menu .section-label { flex: none; justify-content: center; }
        html.is-sidebar-collapsed .admin-menu a i { margin-right: 0; }
        html.is-sidebar-collapsed .admin-menu .label-text, html.is-sidebar-collapsed .admin-menu .sub { display: none; }
        {# Both halves must stay scoped to .admin-menu - .item-resize-handle
           on its own (no .admin-menu prefix) matched EVERY resize handle in
           the document, including the dashboard widget-grid's own ones
           while actively customizing it (body.is-customizing's own
           .item-resize-handle{display:flex} rule lost to this !important
           regardless of the sidebar's collapse state) - found live: drag
           handles on dashboard cards silently vanished whenever the
           sidebar happened to be collapsed (a persisted localStorage
           preference), with no visible error to explain why. #}
        html.is-sidebar-collapsed .admin-menu .item-controls, html.is-sidebar-collapsed .admin-menu .item-resize-handle { display: none !important; }
        html.is-sidebar-collapsed .admin-sidebar-stats { display: none; }
        html.is-sidebar-collapsed .section-group { position: relative; }
        {# .admin-aside is overflow-y:auto (it's the scrollable sidebar
           itself - see the scroll-reveal stats panel further down) - which
           clips ANY horizontal overflow too, flyout included, no matter how
           high its own z-index. Suspending that clip exactly while a flyout
           is open (rather than switching to position:fixed + JS-computed
           coordinates) keeps this whole feature CSS-only; losing the
           sidebar's own scrollability for the moment you're hovering a
           flyout is a non-issue in practice. #}
        html.is-sidebar-collapsed .admin-aside:has(.section-group:hover, .section-group:focus-within) { overflow: visible; }
        html.is-sidebar-collapsed .section-group > ul { display: none; }
        html.is-sidebar-collapsed .section-group:hover > ul, html.is-sidebar-collapsed .section-group:focus-within > ul {
            display: block; position: absolute; left: 100%; top: 0; min-width: 13rem; margin-left: .5rem;
            background: var(--admin-surface); border: 1px solid var(--admin-border); border-radius: var(--admin-radius);
            box-shadow: 0 8px 24px rgba(0,0,0,.15); padding: .4rem 0; z-index: 30;
        }
        {# .flyout-open-upward is set per-hover by JS (see the mouseover/
           focusin handlers) whenever a downward flyout from this section
           would run past the bottom of the viewport - anchoring from the
           trigger's own bottom edge instead keeps the whole panel on
           screen regardless of how low the section sits in the menu. #}
        html.is-sidebar-collapsed .section-group.flyout-open-upward:hover > ul,
        html.is-sidebar-collapsed .section-group.flyout-open-upward:focus-within > ul {
            top: auto; bottom: 0;
        }
        html.is-sidebar-collapsed .section-group:hover > ul .label-text,
        html.is-sidebar-collapsed .section-group:focus-within > ul .label-text { display: inline; }
        {# Higher specificity than the blanket ".admin-menu .sub { display:none }"
           above (extra .section-group > ul context) - restores the <li>'s
           correct display type. Only matters once the ancestor <ul> itself
           is shown (the :hover/:focus-within rule above), so this doesn't
           need its own hover scoping. #}
        html.is-sidebar-collapsed .section-group > ul .sub { display: list-item; }
        html.is-sidebar-collapsed .section-group > ul a, html.is-sidebar-collapsed .section-group > ul .flyout-heading { justify-content: flex-start; padding: .45rem 1rem; }
        html.is-sidebar-collapsed .section-group > ul a i { margin-right: .3rem; }
        {# ".admin-menu li" (0,0,1,1) beats a bare ".flyout-heading" (0,0,1,0)
           on specificity regardless of source order, so its display:flex
           was winning over this rule's display:none - the heading rendered
           in NORMAL expanded mode too, duplicating the section's own label
           right underneath it. Scoped through .admin-menu li to match or
           beat that specificity instead of relying on source-order luck. #}
        .admin-menu li.flyout-heading { display: none; padding: .3rem 1rem .5rem; font-size: .72rem; text-transform: uppercase; letter-spacing: .04em; color: var(--admin-muted); }
        html.is-sidebar-collapsed .section-group > ul li.flyout-heading { display: block; }
        #admin-sidebar-collapse-toggle i { transition: transform .15s; }
        html.is-sidebar-collapsed #admin-sidebar-collapse-toggle i { transform: rotate(180deg); }
        {# Drag horizontally to grow/shrink a widget's grid-column span,
           with a live ghost-outline preview (see the pointerdown/move/up
           handlers + .admin-resize-ghost below) rather than resizing the
           real widget mid-drag. A real <button> (tab-reachable, ArrowLeft/
           Right fallback - see the keydown handler). Rendered on every
           card, including a plain link-group one whose own content
           doesn't visually adapt to size - sizing is still useful there
           purely for layout purposes (e.g. leaving room beside a merged
           composite card in the same row).

           Lives in the SAME top-right .item-controls row as the grip/eye
           buttons, not a separate bottom-right corner tab - a corner tab's
           visibility depends on the card's own height and how far you've
           scrolled (worse inside the nest overlay's own constrained iframe
           height), and was repeatedly reported as invisible despite
           genuinely working once found. Solid accent fill (not just on
           hover) keeps it obviously distinct from its two plain siblings. #}
        {# Bottom-right corner, its own floating circle - not grouped into
           the top-right .widget-controls row anymore. Explicitly asked
           for back after the top-row placement (moved there earlier over
           a "hard to find when scrolled/small" concern) - safe to make
           standalone regardless of where it sits in .item-controls'
           markup, since position:absolute anchors it to .widget-block/
           .widget-group's own box (both position:relative) either way,
           not to whatever row it's DOM-nested in. #}
        .item-resize-handle { display: none; width: 1.8rem; height: 1.8rem; border: 0; border-radius: 50%;
            align-items: center; justify-content: center; color: #fff; cursor: ew-resize; touch-action: none;
            background: var(--admin-accent); padding: 0; font: inherit; flex-shrink: 0;
            position: absolute; bottom: .6rem; right: .6rem; z-index: 2; box-shadow: 0 2px 8px rgba(0,0,0,.3); }
        body.is-customizing .item-resize-handle { display: flex; }
        .item-resize-handle:hover, .item-resize-handle.is-resizing { filter: brightness(1.12); }
        .item-resize-handle i { font-size: .75rem; }
        .admin-resize-ghost { position: fixed; border: 2px dashed var(--admin-accent); border-radius: var(--admin-radius);
            background: rgba(37,99,235,.08); pointer-events: none; z-index: 1000; }
        @supports (background: color-mix(in srgb, red 8%, transparent)) {
            .admin-resize-ghost { background: color-mix(in srgb, var(--admin-accent) 8%, transparent); }
        }
        .admin-resize-ghost-badge { position: absolute; top: .5rem; right: .5rem; background: var(--admin-accent); color: #fff;
            font-size: .75rem; font-weight: 600; padding: .2rem .6rem; border-radius: 999px; }
        {# Armed while dragging one dashboard card over the INNER zone of
           another (see sticky-sortable.js's mergeable/findMergeTarget) -
           dropping here fuses the two into a composite instead of
           reordering. Solid accent outline (not dashed, unlike the resize
           ghost) so it reads as "land HERE, on this exact card" rather
           than the resize ghost's "resize to roughly this size" preview. #}
        .is-merge-target { outline: 3px solid var(--admin-accent); outline-offset: -3px; background: rgba(37,99,235,.08); }
        @supports (background: color-mix(in srgb, red 8%, transparent)) {
            .is-merge-target { background: color-mix(in srgb, var(--admin-accent) 8%, transparent); }
        }
        {# merge/split both do a real server round trip (~0.7-1s on this
           dev-mode environment, measured live) - this is what makes that
           wait visibly "something is happening" instead of looking inert
           (see the pendingKeys comment in the script below for why that
           mattered: no feedback read as broken and invited a duplicate
           click/drop for the same card). A gentle pulse, not a spinner -
           the card's own content stays fully legible the whole time. #}
        .is-busy { animation: admin-busy-pulse 1s ease-in-out infinite; cursor: wait; }
        @keyframes admin-busy-pulse { 0%, 100% { opacity: 1; } 50% { opacity: .55; } }
        .item-handle { cursor: grab; touch-action: none; }
        body.is-customizing [data-sortable-item] { cursor: default; }
        .is-dragging { opacity: .85; box-shadow: 0 8px 20px rgba(0,0,0,.18); border-radius: 6px; background: var(--admin-surface); }
        .is-sortable-placeholder { border: 2px dashed var(--admin-border); border-radius: 6px; margin: .15rem 0; }
        .widget-controls { position: absolute; top: .6rem; right: .6rem; }
        .widget-group, .widget-block { position: relative; }
        #admin-customize-done { display: none; }
        body.is-customizing #admin-customize-done { display: inline-flex; }
        .admin-sidebar-footer { display: flex; align-items: center; justify-content: center; gap: .5rem; padding: .9rem 1.25rem; border-top: 1px solid var(--admin-border); flex-shrink: 0; }
        {# Collapsed rail is ~4.5rem wide - a horizontal row of up to 4
           icon buttons (home/stats/exit/collapse-toggle) doesn't fit that
           width and either overflows or crowds together. Stacked as a
           column instead, matching how the main menu itself is already
           one icon per row once collapsed. #}
        html.is-sidebar-collapsed .admin-sidebar-footer { flex-direction: column; padding: .9rem .5rem; gap: .6rem; }
        {# Hidden until explicitly toggled open (data-stats-toggle) - see the
           delegated click handler in the script below. #}
        .admin-sidebar-stats { display: none; flex-shrink: 0; padding: .9rem 1.25rem 1.1rem; border-top: 1px solid var(--admin-border); }
        .admin-sidebar-stats.is-open { display: block; }
        [data-stats-toggle][aria-expanded="true"] { color: var(--admin-accent); border-color: var(--admin-accent); background: var(--admin-surface); }
        .admin-sidebar-stats .admin-analytics { font-size: .8rem; color: var(--admin-muted); }
        .admin-sidebar-stats .analytics-window { font-size: .72rem; text-transform: uppercase; letter-spacing: .04em; margin: .5rem 0 .2rem; }
        .admin-sidebar-stats .analytics-window:first-child { margin-top: 0; }
        .admin-sidebar-stats .row { margin: .1rem 0; }
        .admin-account { position: relative; }
        .admin-aside .brand[role=button] { cursor: pointer; }
        .admin-aside .brand[role=button]:hover { background: var(--admin-bg); }
        .admin-aside .brand .account-caret { flex-shrink: 0; font-size: .75rem; color: var(--admin-muted); transition: transform .15s; }
        .admin-account.is-open .brand .account-caret { transform: rotate(180deg); }
        .admin-account .admin-dropdown-menu { left: 1.25rem; right: 1.25rem; top: calc(100% - .3rem); }
        {# left/right:1.25rem resolves against .admin-account's OWN width -
           fine at 260px, but at the collapsed rail's 4.5rem it computes to
           a near-zero box with nothing to actually constrain the menu's
           real content (account/settings/logout labels), which just
           overflowed it and bled into the main content area next to the
           sidebar. Same "pop out to the right" treatment as the section
           flyout instead of trying to fit inside the rail at all. #}
        html.is-sidebar-collapsed .admin-account .admin-dropdown-menu {
            left: 100%; right: auto; top: 0; margin-left: .5rem; min-width: 13rem;
        }
        .admin-usermenu a i { width: 1.1rem; text-align: center; }
        .admin-main { flex: 1; padding: 1.5rem 2rem; min-width: 0; }
        {# sticks right under the topbar (itself sticky at top:0) so the
           title/entity-actions stay reachable while scrolling a long form
           or datagrid, matching production - top offset matches the
           topbar's own rendered height (icon buttons + vertical padding). #}
        {# No shadow of its own - .admin-topbar directly above already casts
           one, and the two sitting flush against each other doubled up
           into a visibly darker band right at the seam between them. #}
        .admin-header { display: flex; align-items: center; gap: 1rem; margin: 0 -2rem 1.25rem; padding: 1rem 2rem;
                        position: sticky; top: 3.3rem; z-index: 14; background: var(--admin-bg); }
        .admin-header h1 { margin: 0; font-size: 1.35rem; }
        .admin-header-titles { min-width: 0; }
        .admin-header-subtitle { font-size: .82rem; color: var(--admin-muted); margin-top: .2rem; }
        .admin-header .global-actions { margin-left: auto; display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .5rem; }
        .card { background: var(--admin-surface); border: 1px solid var(--admin-border); border-radius: var(--admin-radius); }
        .btn { display: inline-flex; align-items: center; gap: .4rem; padding: .45rem .9rem; border-radius: 6px; border: 1px solid var(--admin-border);
               background: var(--admin-surface); color: inherit; text-decoration: none; font-size: .9rem; cursor: pointer; }
        .btn:hover { border-color: var(--admin-accent); color: var(--admin-accent); }
        .btn-primary { background: var(--admin-accent); border-color: var(--admin-accent); color: #fff; }
        .btn-primary:hover { color: #fff; filter: brightness(1.08); }
        .btn-success { background: var(--admin-success); border-color: var(--admin-success); color: #fff; }
        .btn-success:hover { color: #fff; filter: brightness(1.08); }
        .text-danger, .btn.text-danger { color: var(--admin-danger); }
        {# Row actions (edit/detail/goto/delete) carry only an icon, no
           label, but shared the same left/right padding as text buttons
           ("Filtrer", "Créer"...) - that padding is sized for text, so an
           icon alone sat inside a rectangle noticeably wider than tall,
           looking arbitrarily larger/smaller next to its neighbours
           depending on how much surrounding whitespace happened to render.
           Square, fixed-size buttons for icon-only actions fix that. #}
        .btn-icon { width: 2.1rem; height: 2.1rem; padding: 0; justify-content: center; flex-shrink: 0; }
        {# A datagrid can easily grow past the viewport width (many
           entities have 8-10+ index columns) - without its own scroll
           container that either overflows the whole page (fighting the
           sticky sidebar/header) or squeezes columns unreadably thin. #}
        .table-responsive { overflow-x: auto; }
        table.datagrid { width: 100%; min-width: max-content; border-collapse: collapse; }
        .datagrid th, .datagrid td { text-align: left; padding: .6rem .9rem; border-bottom: 1px solid var(--admin-border); white-space: nowrap; }
        .datagrid th a { color: inherit; text-decoration: none; }
        .datagrid tr:hover td { background: var(--admin-bg); }
        .datagrid td.actions, .datagrid th.actions { text-align: right; white-space: nowrap; }
        .datagrid .actions a, .datagrid .actions button { margin-left: .35rem; }
        .paginator { display: flex; align-items: center; gap: .75rem; padding: .75rem .9rem; color: var(--admin-muted); font-size: .9rem; }
        .paginator .pages { margin-left: auto; display: flex; gap: .25rem; }
        .paginator .page-current { background: var(--admin-accent); border-color: var(--admin-accent); color: #fff; cursor: default; }
        .paginator .pages-ellipsis { border: none; background: none; cursor: default; }
        dialog#admin-confirm { border: 1px solid var(--admin-border); border-radius: var(--admin-radius); background: var(--admin-surface);
                               color: inherit; padding: 1.5rem; max-width: 420px; box-shadow: 0 18px 50px rgba(0,0,0,.25); }
        dialog#admin-confirm::backdrop { background: rgba(15, 23, 42, .45); backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px); }
        dialog#admin-confirm p { margin: 0 0 1.25rem; }
        .admin-confirm-actions { display: flex; justify-content: flex-end; gap: .5rem; }
        .btn-danger { background: var(--admin-danger); border-color: var(--admin-danger); color: #fff; }
        .form-footer-danger { border-top: none; padding-top: 0; }
        form.admin-form .form-grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 0 1.25rem; padding: 1.25rem; }
        form.admin-form .form-row { grid-column: span var(--col-span, 12); min-width: 0; margin-bottom: 1rem; }
        form.admin-form label { display: block; font-weight: 600; margin-bottom: .3rem; }
        form.admin-form input[type=text], form.admin-form input[type=email], form.admin-form input[type=number],
        form.admin-form input[type=password], form.admin-form select, form.admin-form textarea {
            width: 100%; padding: .5rem .65rem; border: 1px solid var(--admin-border); border-radius: 6px; font: inherit; background: var(--admin-bg);
        }
        form.admin-form .form-errors { color: var(--admin-danger); font-size: .85rem; margin-top: .25rem; }
        @media (max-width: 720px) { form.admin-form .form-row { grid-column: span 12 !important; } }
        {# BooleanField's confirm-modal markup (form_div_layout.html.twig) is
           Bootstrap ".modal fade" markup: it only ever hides/shows via
           Bootstrap's own CSS+JS, neither of which this package loads (no
           Bootstrap anywhere in the admin by design) - so it's permanently
           inert either way, and left unstyled it renders as a big block of
           plain in-flow text. Hiding it isn't a functional regression, just
           containment of dead markup until/unless a real confirm
           interaction is built for it. #}
        form.admin-form .modal.fade { display: none; }
        {# select2/tag widgets otherwise compute their own fixed pixel width
           from the underlying <select> at init time, which can end up
           narrower than - or fail to track - their actual CSS grid column
           once ->setColumns() puts them in something less than the full
           12-span. Forcing 100% keeps them honest to the grid track. #}
        form.admin-form .select2-container { width: 100% !important; }
        .select2-avatar { width: 1.3rem; height: 1.3rem; border-radius: 50%; object-fit: cover; vertical-align: middle; flex-shrink: 0; }
        .field-avatar-thumb { width: 2rem; height: 2rem; border-radius: 50%; object-fit: cover; }
        {# select2's vendored "bootstrap4" theme is a fixed light palette -
           it never adapts to the admin's own light/dark toggle, so every
           select2-enhanced field (Authors, Tags, Keywords, Icon, ...) stayed
           a stark white box against an otherwise dark page. Re-themed with
           the same CSS variables as the rest of the admin. Written twice
           (explicit data-theme="dark" + the @media/auto case) rather than
           combined into one selector list, since mixing a plain selector
           and an @media block in one comma-separated prelude is invalid
           CSS and silently drops the whole rule. #}
        :root[data-theme="dark"] .select2-container--bootstrap4 .select2-selection {
            background: var(--admin-bg); border-color: var(--admin-border); color: var(--admin-text);
        }
        :root[data-theme="dark"] .select2-selection__rendered { color: var(--admin-text); }
        :root[data-theme="dark"] .select2-selection__placeholder { color: var(--admin-muted); }
        :root[data-theme="dark"] .select2-selection__arrow b { border-color: var(--admin-muted) transparent transparent transparent; }
        :root[data-theme="dark"] .select2-selection__choice {
            background: var(--admin-surface); border-color: var(--admin-border); color: var(--admin-text);
        }
        :root[data-theme="dark"] .select2-selection__choice__remove { color: var(--admin-muted); }
        :root[data-theme="dark"] .select2-dropdown {
            background: var(--admin-surface); border-color: var(--admin-border); color: var(--admin-text);
        }
        :root[data-theme="dark"] .select2-search__field {
            background: var(--admin-bg); border-color: var(--admin-border); color: var(--admin-text);
        }
        :root[data-theme="dark"] .select2-results__option { color: var(--admin-text); }
        :root[data-theme="dark"] .select2-results__option--highlighted { background: var(--admin-accent) !important; color: #fff !important; }
        :root[data-theme="dark"] .select2-results__group { color: var(--admin-muted); }
        @media (prefers-color-scheme: dark) {
            :root:not([data-theme="light"]) .select2-container--bootstrap4 .select2-selection {
                background: var(--admin-bg); border-color: var(--admin-border); color: var(--admin-text);
            }
            :root:not([data-theme="light"]) .select2-selection__rendered { color: var(--admin-text); }
            :root:not([data-theme="light"]) .select2-selection__placeholder { color: var(--admin-muted); }
            :root:not([data-theme="light"]) .select2-selection__arrow b { border-color: var(--admin-muted) transparent transparent transparent; }
            :root:not([data-theme="light"]) .select2-selection__choice {
                background: var(--admin-surface); border-color: var(--admin-border); color: var(--admin-text);
            }
            :root:not([data-theme="light"]) .select2-selection__choice__remove { color: var(--admin-muted); }
            :root:not([data-theme="light"]) .select2-dropdown {
                background: var(--admin-surface); border-color: var(--admin-border); color: var(--admin-text);
            }
            :root:not([data-theme="light"]) .select2-search__field {
                background: var(--admin-bg); border-color: var(--admin-border); color: var(--admin-text);
            }
            :root:not([data-theme="light"]) .select2-results__option { color: var(--admin-text); }
            :root:not([data-theme="light"]) .select2-results__option--highlighted { background: var(--admin-accent) !important; color: #fff !important; }
            :root:not([data-theme="light"]) .select2-results__group { color: var(--admin-muted); }
        }
        {# The system-settings pages (API keys, site settings) build their
           form straight from base-bundle's raw PasswordType/BooleanType/
           RouteType/etc - form_rest(form) - never going through a CRUD
           FieldDescriptor, so none of the .form-grid/.form-row markup
           above applies to them. That raw markup is Bootstrap-shaped
           (.form-group/.input-group/.input-group-text/.form-check) but,
           like the confirm-modal above, no Bootstrap CSS loads here - left
           unstyled the icon addon and input stack vertically instead of
           sitting side by side, and every field looks structurally broken
           rather than just plain. #}
        form.admin-form .form-group { margin-bottom: 1.1rem; }
        form.admin-form .form-group .form-group { margin-bottom: .6rem; }
        form.admin-form .label-wrapper { display: flex; align-items: center; gap: .4rem; margin-bottom: .3rem; }
        form.admin-form .label-wrapper label { margin-bottom: 0; }
        form.admin-form .badge.label { display: inline-flex; align-items: center; padding: .1rem .35rem; border-radius: 5px;
                                       background: var(--admin-bg); color: var(--admin-muted); font-size: .75rem; }
        form.admin-form .input-group { display: flex; align-items: stretch; position: relative; }
        form.admin-form .input-group-text { display: flex; align-items: center; padding: 0 .65rem; border: 1px solid var(--admin-border);
                                            border-right: 0; border-radius: 6px 0 0 6px; background: var(--admin-bg); color: var(--admin-muted); flex: 0 0 auto; }
        form.admin-form .input-group input, form.admin-form .input-group select { border-radius: 0 6px 6px 0; }
        form.admin-form .input-group .form-password-revealer { color: var(--admin-muted); }
        form.admin-form .input-group .form-password-revealer:hover { color: var(--admin-accent); }
        form.admin-form .form-password-strength { display: flex; gap: .2rem; margin-top: .4rem; }
        form.admin-form .form-password-strength .strength { flex: 1; height: 3px; border-radius: 2px; background: var(--admin-border); }
        form.admin-form .form-text { font-size: .82rem; color: var(--admin-muted); margin-top: .35rem; }
        form.admin-form .form-text.text-danger { color: var(--admin-danger); display: flex; align-items: center; gap: .35rem; }
        form.admin-form .form-text.text-danger::before { content: "\f071"; font-family: "Font Awesome 6 Free"; font-weight: 900; }
        form.admin-form .form-check { display: flex; align-items: center; gap: .5rem; }
        {# File inputs (avatar/image/document upload fields) were entirely
           unstyled - the native browser "Choose File" button/label don't
           pick up any of the admin's theme (light OR dark: the label text
           stays whatever color the OS renders it, independent of this
           page's own color scheme), and its height/padding never matched
           any other control on the same form. ::file-selector-button is
           the standard, well-supported way to theme the native button
           itself without replacing the whole control with a JS widget. #}
        form.admin-form input[type=file] { display: flex; align-items: center; gap: .6rem; color: var(--admin-muted); font: inherit; font-size: .85rem; }
        {# Safari/WebKit only recognizes the vendor-prefixed pseudo-element -
           the unprefixed ::file-selector-button silently matches nothing
           there, leaving the native button unstyled. Both rules target the
           same button; harmless duplication in engines that support both. #}
        form.admin-form input[type=file]::file-selector-button {
            padding: .45rem .9rem; border-radius: 6px; border: 1px solid var(--admin-border);
            background: var(--admin-surface); color: inherit; font: inherit; font-size: .9rem; cursor: pointer;
        }
        form.admin-form input[type=file]::file-selector-button:hover { border-color: var(--admin-accent); color: var(--admin-accent); }
        form.admin-form input[type=file]::-webkit-file-upload-button {
            padding: .45rem .9rem; border-radius: 6px; border: 1px solid var(--admin-border);
            background: var(--admin-surface); color: inherit; font: inherit; font-size: .9rem; cursor: pointer;
        }
        form.admin-form input[type=file]::-webkit-file-upload-button:hover { border-color: var(--admin-accent); color: var(--admin-accent); }
        {# A boolean field reads as a toggle switch everywhere else it
           appears (datagrid rows, detail page) but fell back to a tiny bare
           native checkbox here - the one visibly "non-uniform" field in an
           otherwise consistent form. Same visual as .field-switch (the
           datagrid's PATCH-toggle), pure CSS this time since a form
           checkbox already submits correctly on its own - no JS/PATCH
           wiring needed, just appearance. #}
        form.admin-form .form-check-input[type=checkbox] {
            appearance: none; -webkit-appearance: none; width: 34px; height: 19px; margin: 0; flex-shrink: 0;
            border: none; border-radius: 999px; background: var(--admin-border); position: relative; cursor: pointer;
            transition: background .15s ease;
        }
        form.admin-form .form-check-input[type=checkbox]::after {
            content: ''; position: absolute; top: 2px; left: 2px; width: 15px; height: 15px; border-radius: 50%;
            background: #fff; box-shadow: 0 1px 2px rgba(0,0,0,.3); transition: transform .15s ease;
        }
        form.admin-form .form-check-input[type=checkbox]:checked { background: var(--admin-accent); }
        form.admin-form .form-check-input[type=checkbox]:checked::after { transform: translateX(15px); }
        form.admin-form .form-check-input:not([type=checkbox]) { width: 1.1rem; height: 1.1rem; margin: 0; accent-color: var(--admin-accent); }
        form.admin-form footer { margin-top: .4rem; }
        form.admin-form footer hr { display: none; }
        form.admin-form .form-entity, form.admin-form .form-translatable, form.admin-form .form-collection-items,
        form.admin-form .form-collection-no-add-button { display: block; }
        .form-footer { display: flex; gap: .5rem; padding: 1rem 1.25rem; border-top: 1px solid var(--admin-border); }
        dl.detail { padding: 1.25rem; display: grid; grid-template-columns: 200px 1fr; gap: .5rem 1rem; margin: 0; }
        dl.detail dt { font-weight: 600; color: var(--admin-muted); }
        dl.detail dd { margin: 0; }
        .empty-state { padding: 3rem; text-align: center; color: var(--admin-muted); }
        .flashes { margin-bottom: 1rem; }
        .flash { padding: .6rem .9rem; border-radius: 6px; margin-bottom: .4rem; border: 1px solid var(--admin-border); background: var(--admin-surface); }
        .flash-success { border-color: #86efac; background: #f0fdf4; color: #166534; }
        .flash-warning { border-color: #fde68a; background: #fffbeb; color: #92400e; }
        .flash-danger, .flash-error { border-color: #fecaca; background: #fef2f2; color: #991b1b; }
        .search-form { display: inline-flex; gap: .4rem; }
        .search-form input { padding: .45rem .65rem; border: 1px solid var(--admin-border); border-radius: 6px; font: inherit; min-width: 220px;
                             background: var(--admin-bg); color: var(--admin-text); }
        .quick-access { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: .75rem; padding: 1.25rem; }
        .quick-access a { display: block; padding: 1rem; border: 1px solid var(--admin-border); border-radius: var(--admin-radius); text-decoration: none; color: inherit; background: var(--admin-surface); }
        .quick-access a:hover { border-color: var(--admin-accent); color: var(--admin-accent); }
        .dashboard-header { align-items: center; gap: 1rem; }
        .dashboard-brand-icon { width: 3.5rem; height: 3.5rem; display: flex; align-items: center; justify-content: center;
                                font-size: 1.6rem; border: 1px solid var(--admin-border); border-radius: 12px; background: var(--admin-surface); }
        .dashboard-slogan { color: var(--admin-muted); }
        {# Now a sibling of the h1/slogan inside the title stack (moved into
           .admin-header, kept always visible instead of scrolling away with
           the rest of .content) - the old margin-left:4.5rem was compensating
           for sitting OUTSIDE that stack, offsetting past the brand icon;
           inside it, that would double up as an extra, wrong indent. #}
        .dashboard-welcome { margin: .3rem 0 0; color: var(--admin-muted); font-size: .92rem; }
        {# Dashboard-only, rendered into layout.html.twig's own
           topbar_dashboard_extra block (see there) rather than scrolling
           away with the page content - only ever visible while
           is-customizing is on, same display:none/flex toggle pattern as
           #admin-customize-done right beside it, so a superadmin merely
           VIEWING the dashboard (not editing it) sees neither control. #}
        .admin-topbar-dashboard-extra { display: none; align-items: center; gap: .75rem; }
        body.is-customizing .admin-topbar-dashboard-extra { display: flex; }
        [data-widget-palette-menu] { min-width: 12rem; }
        {# Sized to match .btn exactly (padding/font-size/border-radius) so
           the columns picker and "+ Ajouter un widget" read as one
           harmonized control group, not two mismatched widgets bolted
           together - the ask was explicit: "harmonized in size". #}
        .admin-columns-select { display: flex; align-items: center; gap: .5rem; font-size: .9rem; color: var(--admin-muted); }
        {# A plain <select> renders with browser-native chrome that's
           noticeably taller than .btn (confirmed live: ~42px vs ~32px in
           WebKit) even with identical padding - appearance:none strips
           that, with an explicit height matching .btn's own so the two
           controls line up as one group. <select> itself can't take a
           ::after (no generated-content support on that element), hence
           the wrapping span for the custom chevron. #}
        .admin-select-wrap { position: relative; display: inline-flex; }
        .admin-select-wrap::after { content: ''; position: absolute; right: .6rem; top: 50%; width: .4rem; height: .4rem;
            border-right: 2px solid var(--admin-muted); border-bottom: 2px solid var(--admin-muted); transform: translateY(-65%) rotate(45deg); pointer-events: none; }
        {# Same vertical padding (.45rem) and font-size as .btn, so the two
           end up the same rendered height without guessing a fixed px
           value - only the horizontal padding differs (room for the
           chevron on the right instead of .btn's symmetric .9rem). #}
        .admin-columns-select select { -webkit-appearance: none; appearance: none; box-sizing: border-box;
            border: 1px solid var(--admin-border); border-radius: 6px; padding: .45rem 1.7rem .45rem .6rem;
            background: var(--admin-surface); color: var(--admin-text); font: inherit; font-size: .9rem; line-height: 1; cursor: pointer; }
        {# A real, configurable column count (LayoutConfig::$columns,
           default 5) rather than however many ~240px tracks happen to fit
           the viewport - auto-fill made "row" position genuinely
           unpredictable when dragging (a wide screen fits 7 narrow
           columns, so dropping something into what LOOKS like a new row
           just fills a leftover gap in the row above instead), and meant
           a widget's 1-3 "size" didn't reliably correspond to 1/3, 2/3, or
           a full row width the way the resize control implies. #}
        {# repeat(N, 1fr) alone (N = --widget-columns) was the FIRST version
           of this - it fixed the unpredictable-row problem above, but
           dropped the old auto-fill grid's implicit "never narrower than
           240px" floor entirely: at columns:10, each of the 10 tracks
           just gets whatever a bare 1fr computes to on the current
           screen, however cramped - reported live as columns/labels
           wrapping and visually overflowing their cards.
           repeat(auto-fit, minmax(...)) restores a real minimum per
           column (240px) while still targeting N columns: the minmax
           basis is "100% split N ways, gaps subtracted, but never below
           240px" - on a screen wide enough for N real ≥240px columns,
           auto-fit renders exactly N (matching the configured intent
           precisely); on a narrower one, auto-fit naturally renders
           fewer, wider columns instead of cramming N in - the same
           graceful-degradation the @media override below already does
           for a phone-sized viewport specifically, just continuous
           instead of a single hard breakpoint. #}
        .widget-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(max(240px, calc((100% - (var(--widget-columns, 5) - 1) * 1.5rem) / var(--widget-columns, 5))), 1fr)); gap: 1.5rem; }
        {# Widgets span 1-N tracks (N = --widget-columns, superadmin-
           adjustable via both the resize control AND the columns select
           above, persisted like everything else in LayoutConfig). Each
           widget is also its own CSS containment context, so its content
           can react to the space IT was actually given rather than just
           the viewport - see the analytics_card @container rules below
           for what that unlocks at size 1. #}
        .widget-block, .widget-group { container-type: inline-size; }
        {# .widget-group IS its own visible card (one div, both the grid
           item AND the bordered/backgrounded box) - CSS Grid's default
           align-items:stretch already makes it fill its row's full height
           (matched to the tallest sibling in the same row) with no extra
           work. .widget-block is different: it's a plain wrapper around
           whatever the resolved widget type actually renders (.analytics-
           card, or composite's .card) - the WRAPPER stretches to the row
           height by the same grid default, but its child does NOT, since
           nothing tells it to. That left a real visible bug: a short
           block-type card (e.g. a narrow analytics_card instance showing
           just its stat row, chart/picker hidden by the @container rule
           below) sitting next to a taller sibling in the same row shows
           its own white card ending early, with the PAGE's grey
           background visible underneath, all the way down to the row's
           actual height - it looks broken because the visible box
           doesn't fill the space it was actually given. flex:1 on the
           child makes it stretch to fill instead, exactly matching how
           .widget-group already behaves. A no-op whenever nothing in the
           row is taller than this widget's own natural height. #}
        .widget-block { display: flex; }
        .widget-block > .analytics-card, .widget-block > .card { flex: 1 1 auto; min-height: 0; }
        {# grid-column is set inline per-widget now (style="grid-column:
           span N", see _block.html.twig/dashboard.html.twig) rather than
           via a widget-size-N class - N can now go up to 10 (configurable
           columns), and a class-per-N approach doesn't scale as cleanly as
           just setting the property directly. !important here still wins
           over that plain (non-important) inline style, same as it did
           over the old classes. #}
        @media (max-width: 720px) {
            .widget-grid { --widget-columns: 1; }
            .widget-block, .widget-group { grid-column: span 1 !important; }
        }
        .widget-group { padding: 1.25rem 1.5rem; }
        .widget-group h2 { margin: .6rem 0 .7rem; font-size: 1.25rem; }
        .widget-icon { font-size: 2rem; }
        .widget-group ul { list-style: none; margin: 0; padding: 0; }
        .widget-group li { margin: .35rem 0; }
        .widget-group li a { display: inline-flex; align-items: center; gap: .5rem; color: inherit; text-decoration: none; }
        .widget-group li a:hover { color: var(--admin-accent); }
        .widget-group li a i { width: 1.2rem; text-align: center; }
        .widget-group li a .fa-circle-plus { color: var(--admin-accent); }
        .analytics-card { padding: 1.5rem; }
        .analytics-card-header { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 1.5rem; margin-bottom: 1.25rem; }
        {# .widget-controls floats absolutely over the card's top-right
           corner - without this, a wide stat row's own right-aligned
           content (e.g. the last stat's change badge) runs right up
           against the handle/toggle/remove icons. Resize now floats
           separately at the bottom-right corner (see .item-resize-handle),
           so this only needs room for the MAX top-row case (an ad-hoc
           analytics_card instance gets all 3: handle+toggle+remove -
           3 * 1.6rem + 2 * .3rem gap + the .6rem right offset = 5.7rem,
           rounded up) - the built-in, code-defined instance only ever
           shows 2, so this is a little generous there, which is harmless.
           Only needed while the controls are actually visible. #}
        body.is-customizing .analytics-card-header { padding-right: 6rem; }
        .analytics-card-header h2 { margin: 0; font-size: 1.1rem; }
        .analytics-stat-row { display: flex; gap: 1.75rem; flex-wrap: wrap; }
        .analytics-stat { min-width: 6rem; }
        .analytics-stat-value { display: block; font-size: 1.4rem; font-weight: 700; line-height: 1.2; }
        .analytics-stat-label { display: block; font-size: .78rem; color: var(--admin-muted); text-transform: uppercase; letter-spacing: .03em; }
        .analytics-stat-change { font-size: .8rem; font-weight: 600; margin-left: .4rem; }
        .analytics-stat-change.is-up { color: var(--admin-success); }
        .analytics-stat-change.is-down { color: var(--admin-danger); }
        .analytics-range-picker { display: flex; flex-wrap: wrap; gap: .4rem; margin-bottom: 1rem; transition: opacity .15s ease; }
        .analytics-range-picker.is-loading { opacity: .5; }
        .analytics-range-btn { border: 1px solid var(--admin-border); background: transparent; color: var(--admin-muted); font-size: .78rem; font-weight: 600; padding: .3rem .75rem; border-radius: 999px; cursor: pointer; transition: background .15s ease, color .15s ease, border-color .15s ease; }
        .analytics-range-btn:hover { border-color: var(--admin-accent); color: var(--admin-text); }
        .analytics-range-btn.is-active { background: var(--admin-accent); border-color: var(--admin-accent); color: #fff; }
        .analytics-chart-wrap { position: relative; height: 240px; }
        {# Reused by the series-toggle checkboxes in the widget's settings
           panel below as a color swatch next to each series' label - kept
           dark-mode aware since it's driven by the same
           AnalyticsSeriesPalette colors as the chart itself. #}
        .analytics-source-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--chip-color); display: inline-block; flex-shrink: 0; }
        :root[data-theme="dark"] .analytics-source-dot { background: var(--chip-color-dark, var(--chip-color)); }
        @media (prefers-color-scheme: dark) {
