        .field-media { display: inline-flex; align-items: center; gap: .5rem; }
        .field-media img, .field-media .avatar { width: 32px; height: 32px; border-radius: 6px; object-fit: cover; border: 1px solid var(--admin-border); background: var(--admin-bg); }
        .field-media .avatar { border-radius: 50%; }
        .field-media a { color: inherit; }

        .field-mono { font-variant-numeric: tabular-nums; }
