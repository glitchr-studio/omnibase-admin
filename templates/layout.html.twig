        .manual-excerpt { color: var(--admin-muted); }
    </style>
    {% endblock %}
    {% block form_assets %}
        {# base-bundle's prebuilt widget bundles (select2, editor, datetime,
           color, dropzone, ...) - published under /bundles/base and resolved
           through its WebpackTagRenderer; the widgets initialise themselves
           from DOM markers rendered by @Base/form/form_div_layout.html.twig #}
        {{ encore_entry_link_tags('form') }}
        {{ encore_entry_script_tags('form') }}
        {# Chart.js (tree-shaken to line/point/linear+category-scale/filler/
           tooltip/legend only) - a generic [data-admin-chart] initializer
           any page can use, not just the dashboard. Loaded globally like
           'form'/'base' rather than per-page: transparentJS's in-admin
           navigation only swaps #page's content, so a <head> script tied
           to one specific page would never (re-)run when navigating INTO
           that page via the SPA swap instead of a fresh full load. #}
        {{ encore_entry_script_tags('admin-charts') }}
        {# FontAwesome's class rules (.fa-solid/.fas/.far/...) live in the
           'base' entry's CSS, not 'form' - the font FILES were always
           reachable, but nothing mapped fa-* classes to glyphs, so every
           icon referenced by field/action config (IconField, EmailField,
           row action icons, ...) rendered as invisible/blank. CSS only -
           no need for 'base''s JS here. #}
        {{ encore_entry_link_tags('base') }}
        {# One SPA engine for the whole product: transparentJS, vendored here
           as plain UMD scripts (no Encore/webpack involvement - the package
           has no build step of its own). Same library the public site and
           the website-in-website overlay use; in-admin navigation now works
           the same way everything else does: AJAX swap of #page, cached
           pages, fade transitions - instead of a hard reload per click. #}
        <link rel="stylesheet" href="{{ asset('bundles/admin/css/transparent.css') }}">
        <script src="{{ asset('bundles/admin/js/jquery.min.js') }}"></script>
        <script src="{{ asset('bundles/admin/js/transparent.js') }}"></script>
        {% if customize_enabled is defined and customize_enabled %}
            {# Superadmin-only download - moderators/admins never fetch this. #}
            <script src="{{ asset('bundles/admin/js/sticky-sortable.js') }}"></script>
        {% endif %}
        <script>
            // Transparent.ready() was NEVER being called here - meaning
            // `isReady` stayed false forever, and __main__'s early-return
            // for that case does NOT call e.preventDefault() first. Every
            // click on every admin link was silently falling through to a
            // real, hard browser navigation of this iframe (not the AJAX
            // swap the rest of this layout's comments and markup assume) -
            // confirmed live: a genuine multi-hundred-ms blank-white gap
            // (a real page load, not a styled transition) on every single
            // in-admin navigation. {once:true} matters here exactly like it
            // does on the public site's equivalent call (see
            // assets/app-defer.js): transparent.js re-dispatches a
            // synthetic 'load' event on every SPA nav, so a non-once
            // listener would re-run ready() (and its side effects) on every
            // click inside the admin too.
            window.addEventListener('load', function () {
                if (!window.Transparent) return;
                Transparent.ready({
                    // Confine the SPA swap to /admin/* - a link out to the
                    // public site (e.g. a "view online" link on an
                    // article) should be a plain navigation, not an
                    // attempt to AJAX-swap the whole unrelated page into
                    // this frame.
                    exceptions: [/^(?!\/admin(\/|$)).*/],
                    // Changes on every real deploy, so a tab with an admin
                    // page cached from before a deploy purges its whole
                    // Transparent cache instead of replaying stale HTML
                    // forever - see transparent.js's own cache_version doc.
                    cache_version: '{{ deploy_version() }}'
                });
            }, { once: true });
        </script>
        <script>
            // Quick GET submits (search box, filter bar): transparentJS only
            // binds its form handling to forms present at first load (a
            // static $("form").on(...) at init, not a delegated listener),
            // and its submit path bails on admin forms anyway - so every
            // search/filter submit was a full hard page load, unlike the
            // production admin where Turbo Drive swapped them in place.
            // Delegated interceptor: serialize the GET form into its target
            // URL and hand it to transparentJS's link pipeline (a synthetic
            // in-#page anchor click - __main__'s document-level click
            // listener treats it exactly like any sidebar link, giving the
            // same fast AJAX swap, progress bar included). POST forms
            // (edit/new/delete/batch) keep their native submit.
            document.addEventListener('submit', function (e) {
                const form = e.target;
                if (!(form instanceof HTMLFormElement)) return;
                if ((form.method || 'get').toLowerCase() !== 'get') return;
                const page = document.getElementById('page');
                if (!page || !page.contains(form)) return;

                e.preventDefault();
                const url = new URL(form.getAttribute('action') || location.pathname, location.origin);
                url.search = new URLSearchParams(new FormData(form)).toString();

                if (window.Transparent) {
                    const anchor = document.createElement('a');
                    anchor.href = url.pathname + url.search;
                    anchor.style.display = 'none';
                    form.appendChild(anchor);
                    anchor.click();
                    anchor.remove();
                } else {
                    location.assign(url.toString());
                }
            });
        </script>
        <script>
            // Filter bar: [data-autosubmit] selects/date inputs (boolean,
            // choice, association, comparison-operator, date range) apply
            // immediately on change instead of requiring a separate click on
            // "Filtrer" - matches prod's instant filtering. Free-text/number
            // value inputs deliberately do NOT autosubmit (that would fire
            // on every keystroke); those still need the explicit button.
            // Delegated on document for the same AJAX-swap-survival reason
            // as the switch/dropdown listeners around it.
            document.addEventListener('change', function (e) {
                const field = e.target.closest('[data-autosubmit]');
                if (!field || !field.form) return;
                field.form.requestSubmit();
            });
        </script>
        <script>
            // crud/field/boolean.html.twig's inline switch: a delegated
            // listener on `document` (not the individual checkboxes)
            // survives every future in-admin AJAX swap without needing to
            // be re-bound - #page's content gets replaced, document itself
            // never does.
            //
            // Listens for 'click' on the LABEL and manages `checked`
            // itself (e.preventDefault() on the native forwarding),
            // rather than listening for 'change' and trusting the browser
            // to forward a label click to its nested checkbox first -
            // one less moving part between "user clicked" and "we know
            // the new value", and avoids depending on exactly how/when
            // that native forwarding fires.
            document.addEventListener('click', function (e) {
                const label = e.target.closest('.field-switch');
                if (!label) return;
                e.preventDefault();

                const input = label.querySelector('input[type=checkbox]');
                const previousChecked = input.checked;
                const url = label.dataset.toggleUrl;
                const property = label.dataset.property;
                const token = label.dataset.token;

                input.checked = !previousChecked;
                label.classList.add('is-saving');
                fetch(url, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ property: property, _token: token }),
                }).then(function (response) {
                    if (!response.ok) throw new Error('toggle failed');
                    return response.json();
                }).then(function (data) {
                    input.checked = !!data.value;
                }).catch(function () {
                    input.checked = previousChecked; // revert on any failure
                }).finally(function () {
                    label.classList.remove('is-saving');
                });
            });
        </script>
        <script>
            // Generic dropdown open/close - drives the topbar's appearance
            // and language menus, plus the sidebar account menu (same
            // [data-dropdown] wrapper + .admin-icon-btn/[aria-haspopup]
            // toggle convention). Delegated on document (same pattern as
            // the boolean switch above) so it survives future in-admin
            // AJAX swaps with nothing to rebind. Opening one dropdown
            // closes any other that's open; clicking anything inside the
            // menu (a real link, or a choice button below) closes it too.
            document.addEventListener('click', function (e) {
                const toggle = e.target.closest('[data-dropdown] > .admin-icon-btn, [data-dropdown] > [aria-haspopup]');
                if (toggle) {
                    const dropdown = toggle.closest('[data-dropdown]');
                    const willOpen = !dropdown.classList.contains('is-open');
                    document.querySelectorAll('[data-dropdown].is-open').forEach(function (d) {
                        d.classList.remove('is-open');
                        const btn = d.querySelector('[aria-haspopup]');
                        if (btn) btn.setAttribute('aria-expanded', 'false');
                    });
                    if (willOpen) {
                        dropdown.classList.add('is-open');
                        toggle.setAttribute('aria-expanded', 'true');
                    }
                    return;
                }

                const openDropdown = document.querySelector('[data-dropdown].is-open');
                if (openDropdown) {
                    openDropdown.classList.remove('is-open');
                    const btn2 = openDropdown.querySelector('[aria-haspopup]');
                    if (btn2) btn2.setAttribute('aria-expanded', 'false');
                }
            });
            // [role=button] toggles (the sidebar account block isn't a real
            // <button>, so Enter/Space need a hand here - a real <button>
            // like the topbar dropdowns gets this for free from the browser).
            document.addEventListener('keydown', function (e) {
                if (e.key !== 'Enter' && e.key !== ' ') return;
                const toggle = e.target.closest('[data-dropdown] > [role=button][aria-haspopup]');
                if (!toggle) return;
                e.preventDefault();
                toggle.click();
            });
            // Theme choice itself: separate from the generic open/close
            // above, only cares about which [data-theme-choice] was picked.
            document.addEventListener('click', function (e) {
                const choiceBtn = e.target.closest('[data-theme-choice]');
                if (!choiceBtn) return;

                const choice = choiceBtn.dataset.themeChoice;
                if (choice === 'auto') {
                    localStorage.removeItem('admin-theme');
                    document.documentElement.removeAttribute('data-theme');
                } else {
                    localStorage.setItem('admin-theme', choice);
                    document.documentElement.setAttribute('data-theme', choice);
                }
            });
            // reflect the saved/current choice with an "active" mark and
            // keep it in sync if the OS theme changes while "system" is
            // selected (no saved override) - re-runs the same tiny check
            // rather than needing a page reload to notice.
            (function () {
                function markActive() {
                    var saved = localStorage.getItem('admin-theme') || 'auto';
                    document.querySelectorAll('[data-theme-choice]').forEach(function (btn) {
                        btn.classList.toggle('is-active', btn.dataset.themeChoice === saved);
                    });
                }
                markActive();
                document.addEventListener('click', function (e) {
                    if (e.target.closest('[data-theme-choice]')) markActive();
                });
            })();

            // Sidebar collapse toggle - persisted the same way as the theme
            // choice, applied pre-paint above so there's no flash of the
            // wrong width on load.
            //
            // Event-delegated (document-level click, matched by ID at CLICK
            // time via closest()), like the dropdown/theme-choice handlers
            // above - NOT document.getElementById() + a direct listener.
            // This whole script block runs in <head>, before the button
            // (way down in <body>) has been parsed into the DOM yet -
            // getElementById() found nothing, so the click listener never
            // attached to anything, silently. Delegation sidesteps that
            // entirely: the lookup only ever happens later, at actual click
            // time, by which point the button obviously exists.
            document.addEventListener('click', function (e) {
                var toggle = e.target.closest('#admin-sidebar-collapse-toggle');
                if (!toggle) return;
                var on = !document.documentElement.classList.contains('is-sidebar-collapsed');
                document.documentElement.classList.toggle('is-sidebar-collapsed', on);
                toggle.setAttribute('aria-pressed', on ? 'true' : 'false');
                try { localStorage.setItem('admin-sidebar-collapsed', on ? '1' : '0'); } catch (err) {}
            });
            // One-time aria-pressed sync on load - deferred to DOMContentLoaded
            // for the same reason (the button doesn't exist yet up here).
            document.addEventListener('DOMContentLoaded', function () {
                var toggle = document.getElementById('admin-sidebar-collapse-toggle');
                if (toggle) toggle.setAttribute('aria-pressed', document.documentElement.classList.contains('is-sidebar-collapsed') ? 'true' : 'false');
            });

            // Sidebar stats panel: click-to-toggle (event-delegated, same
            // reasoning as the collapse toggle right above).
            document.addEventListener('click', function (e) {
                var toggle = e.target.closest('[data-stats-toggle]');
                if (!toggle) return;
                var panel = document.getElementById('admin-sidebar-stats');
                if (!panel) return;
                var open = !panel.classList.contains('is-open');
                panel.classList.toggle('is-open', open);
                toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
                if (open) panel.scrollIntoView({ block: 'nearest' });
            });

            // Collapsed-rail section flyout: opens downward from the
            // trigger's own top edge by default (see the CSS), which runs
            // straight off the bottom of the viewport for any section low
            // enough in the menu - a section doesn't have to be the LAST
            // one for this to happen, just low enough that its own flyout
            // height overflows what's left below it. Measured per-hover
            // (not cached) since the flyout's height varies per section and
            // the viewport can change between hovers; the group is briefly
            // made visible-but-hidden to get a real layout height, since
            // display:none elements report zero for everything.
            function positionFlyout(group) {
                if (!document.documentElement.classList.contains('is-sidebar-collapsed')) return;
                var flyout = group.querySelector(':scope > ul');
                if (!flyout) return;
                var triggerTop = group.getBoundingClientRect().top;
                var wasHidden = getComputedStyle(flyout).display === 'none';
                if (wasHidden) { flyout.style.visibility = 'hidden'; flyout.style.display = 'block'; }
                var flyoutHeight = flyout.getBoundingClientRect().height;
                if (wasHidden) { flyout.style.removeProperty('visibility'); flyout.style.removeProperty('display'); }
                group.classList.toggle('flyout-open-upward', triggerTop + flyoutHeight > window.innerHeight - 16);
            }
            document.addEventListener('mouseover', function (e) {
                var group = e.target.closest('.section-group');
                if (group) positionFlyout(group);
            });
            document.addEventListener('focusin', function (e) {
                var group = e.target.closest('.section-group');
                if (group) positionFlyout(group);
            });

        </script>
    {% endblock %}
</head>
<body>
{# id="page": transparentJS only engages its SPA click/swap handling when
   the current document contains this element (same convention the public
   site's base.html.twig uses) - everything inside it is what gets swapped
   and cached on navigation. #}
<div id="page" class="admin-shell">
    <aside class="admin-aside">
        {% set hasUserMenu = admin_context is defined and admin_context.userMenu is not empty %}
        <div class="admin-account"{% if hasUserMenu %} data-dropdown{% endif %}>
            <div class="brand"{% if hasUserMenu %} role="button" tabindex="0" aria-haspopup="true" aria-expanded="false"{% endif %}>
                {% block brand %}
                    {% if app.site.logo is not empty %}
                        <img class="brand-logo" src="{{ app.site.logo|thumbnail(64, 64) }}" alt="">
                    {% endif %}
                    <div class="brand-text">
                        <span class="brand-title">{% block brand_title %}{{ app.site.title ?? 'Administration' }}{% endblock %}</span>
                        {% if app.user %}<span class="brand-user">{{ app.user }}</span>{% endif %}
                    </div>
                    {% if hasUserMenu %}<i class="fa-solid fa-chevron-down account-caret"></i>{% endif %}
                {% endblock %}
            </div>
            {% block user_menu %}
                {% if hasUserMenu %}
                <ul class="admin-menu admin-usermenu admin-dropdown-menu" role="menu">
                    {% for item in admin_context.userMenu %}
                        <li><a href="{{ item.linkUrl ?? '#' }}">{% if item.icon %}<i class="{{ item.icon }}"></i> {% endif %}{{ item.label|trans({}, 'admin') }}</a></li>
                    {% endfor %}
                </ul>
                {% endif %}
            {% endblock %}
        </div>
        {% block main_menu %}
            {% if admin_context is defined and admin_context.mainMenu is not empty %}
            <ul class="admin-menu" data-sortable="sidebar">
                {% for item in admin_context.mainMenu %}
                    {% if item.type == 'block' %}
                        {# rendered separately, in the bottom icon row below - not a navigable link #}
                    {% elseif item.section %}
                        {# A section and its members are one DOM subtree (this <li> plus the
                           nested <ul> below) - dragging the section by its own handle carries
                           every member along with it for free, since they're its actual DOM
                           children. Members stay independently reorderable/hideable inside
                           their own nested data-sortable list (same pattern the dashboard
                           already uses for a widget's sub-items). #}
                        {# .section-flyout: in collapsed-rail mode the section's label and
                           members have nowhere to sit inline, so hovering/focusing the
                           whole group pops them out as one panel to the right instead -
                           see the .is-sidebar-collapsed CSS and the section's own label
                           repeated as a flyout-only heading (hidden in normal expanded
                           mode, where the inline .section label already shows it). #}
                        <li class="section-group {{ item.hidden ? 'is-hidden' }}" data-sortable-item data-sortable-key="{{ item.key }}">
                            {# icon + label-text share ONE flex slot (like a regular item's
                               <a> does) rather than being two independent children of
                               .section's own justify-content:space-between row - otherwise,
                               with item-controls absent outside customize mode, space-between
                               had exactly two visible children (icon, label) and pushed the
                               LAST one - the label - all the way to the right edge. #}
                            {# No title="" here - the native browser tooltip and the
                               custom flyout panel below both trigger on the same
                               hover, so with one it'd pop up floating and
                               disconnected right alongside the flyout (reported
                               live via screenshot: a small "Rôles" box detached
                               from the actual panel). The flyout's own heading
                               (.flyout-heading, collapsed-mode only) already
                               shows this label - a plain link's title (below,
                               in the expanded per-item .section-label) is the
                               only other place a bare label ever needs one. #}
                            <div class="section">
                                <span class="section-label">
                                    {% if item.icon %}<i class="{{ item.icon }}"></i>{% endif %}
                                    <span class="label-text">{{ item.label|trans({}, 'admin') }}</span>
                                </span>
                                {% if customize_enabled is defined and customize_enabled %}
                                    <span class="item-controls">
                                        <button type="button" class="item-handle" data-sortable-handle title="{{ 'customize.reorder'|trans({}, 'admin') }}"><i class="fa-solid fa-grip-vertical"></i></button>
                                        <button type="button" class="item-toggle" data-toggle-hidden title="{{ 'customize.toggle_visibility'|trans({}, 'admin') }}"><i class="fa-solid fa-eye{{ item.hidden ? '-slash' }}"></i></button>
                                    </span>
                                {% endif %}
                            </div>
                            {% if item.subItems is not empty %}
                            <ul data-sortable="sidebar-section-{{ item.key }}">
                                <li class="flyout-heading">{{ item.label|trans({}, 'admin') }}</li>
                                {% for member in item.subItems %}
                                    <li class="{{ member.selected ? 'selected' }} {{ member.hidden ? 'is-hidden' }}" data-sortable-item data-sortable-key="{{ member.key }}">
                                        <a href="{{ member.linkUrl ?? '#' }}"{% if member.linkTarget %} target="{{ member.linkTarget }}"{% endif %} title="{{ member.label|trans({}, 'admin') }}">{% if member.icon %}<i class="{{ member.icon }}"></i> {% endif %}<span class="label-text">{{ member.label|trans({}, 'admin') }}</span></a>
                                        {% if customize_enabled is defined and customize_enabled %}
                                            <span class="item-controls">
                                                <button type="button" class="item-handle" data-sortable-handle title="{{ 'customize.reorder'|trans({}, 'admin') }}"><i class="fa-solid fa-grip-vertical"></i></button>
                                                <button type="button" class="item-toggle" data-toggle-hidden title="{{ 'customize.toggle_visibility'|trans({}, 'admin') }}"><i class="fa-solid fa-eye{{ member.hidden ? '-slash' }}"></i></button>
                                            </span>
                                        {% endif %}
                                    </li>
                                    {% for subItem in member.subItems %}
                                        <li class="{{ subItem.selected ? 'selected' }} sub"><a href="{{ subItem.linkUrl ?? '#' }}" title="{{ subItem.label|trans({}, 'admin') }}">{% if subItem.icon %}<i class="{{ subItem.icon }}"></i> {% endif %}<span class="label-text">{{ subItem.label|trans({}, 'admin') }}</span></a></li>
                                    {% endfor %}
                                {% endfor %}
                            </ul>
                            {% endif %}
                        </li>
                    {% else %}
                        <li class="{{ item.selected ? 'selected' }} {{ item.hidden ? 'is-hidden' }}" data-sortable-item data-sortable-key="{{ item.key }}">
                            <a href="{{ item.linkUrl ?? '#' }}"{% if item.linkTarget %} target="{{ item.linkTarget }}"{% endif %} title="{{ item.label|trans({}, 'admin') }}">{% if item.icon %}<i class="{{ item.icon }}"></i> {% endif %}<span class="label-text">{{ item.label|trans({}, 'admin') }}</span></a>
                            {% if customize_enabled is defined and customize_enabled %}
                                <span class="item-controls">
                                    <button type="button" class="item-handle" data-sortable-handle title="{{ 'customize.reorder'|trans({}, 'admin') }}"><i class="fa-solid fa-grip-vertical"></i></button>
                                    <button type="button" class="item-toggle" data-toggle-hidden title="{{ 'customize.toggle_visibility'|trans({}, 'admin') }}"><i class="fa-solid fa-eye{{ item.hidden ? '-slash' }}"></i></button>
                                </span>
                            {% endif %}
                        </li>
                        {% for subItem in item.subItems %}
                            <li class="{{ subItem.selected ? 'selected' }} sub"><a href="{{ subItem.linkUrl ?? '#' }}" title="{{ subItem.label|trans({}, 'admin') }}">{% if subItem.icon %}<i class="{{ subItem.icon }}"></i> {% endif %}<span class="label-text">{{ subItem.label|trans({}, 'admin') }}</span></a></li>
                        {% endfor %}
                    {% endif %}
                {% endfor %}
            </ul>
            {% endif %}
        {% endblock %}
        {% block sidebar_footer %}
            {% set analyticsItem = admin_context is defined ? (admin_context.mainMenu|filter(i => i.type == 'block' and i.blockName == 'analytics_widget')|first) : null %}
            <div class="admin-sidebar-footer">
                <a class="admin-icon-btn" href="/" title="{{ 'sidebar.home'|trans({}, 'admin') }}">
                    <i class="fa-solid fa-house"></i>
                </a>
                {% if analyticsItem and not analyticsItem.hidden %}
                    {# Click-to-toggle, not scroll-to-reveal: the stats panel is
                       hidden by default and only shown while explicitly opened
                       (data-stats-toggle, see the delegated click handler in the
                       script below) - per explicit request, twice, in favor of
                       the earlier scroll-reveal design. #}
                    <button type="button" class="admin-icon-btn" data-stats-toggle aria-expanded="false" title="{{ 'sidebar.stats'|trans({}, 'admin') }}">
                        <i class="fa-solid fa-chart-simple"></i>
                    </button>
                {% endif %}
                <a class="admin-icon-btn" href="{{ path('security_logout') }}" title="{{ 'sidebar.exit'|trans({}, 'admin') }}">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                </a>
                {# In the sidebar itself, not the topbar on the opposite side
                   of the screen - this row is already icon-only regardless
                   of collapsed state, so it needs no separate collapsed-mode
                   positioning of its own, unlike the brand row above. #}
                <button type="button" class="admin-icon-btn" id="admin-sidebar-collapse-toggle" title="{{ 'topbar.collapse_sidebar'|trans({}, 'admin') }}" aria-pressed="false">
                    <i class="fa-solid fa-angles-left"></i>
                </button>
            </div>
            {% if analyticsItem and not analyticsItem.hidden %}
                <div class="admin-sidebar-stats" id="admin-sidebar-stats">
                    {# Base\Service\Analytics's page-view/visitor/user counters, via
                       the Twig functions base-bundle's AnalyticsTwigExtension exposes -
                       a single summary() call gets every window in one round trip.
                       Named block (still overridable/reusable by FQCN) defined here,
                       inside its one actual render point, rather than as a standalone
                       block that would render inline unconditionally. #}
                    {% block analytics_widget %}
                        {% set stats = analytics_summary() %}
                        <div class="admin-analytics">
                            <div class="analytics-window">{{ 'analytics.today'|trans({}, 'admin') }}</div>
                            <div class="row">{{ 'analytics.page_views'|trans({'%count%': stats.today.pageViews}, 'admin') }}</div>
                            <div class="row">{{ 'analytics.unique_visitors'|trans({'%count%': stats.today.uniqueVisitors}, 'admin') }}</div>
                            {% if stats.today.uniqueUsers > 0 %}
                            <div class="row">{{ 'analytics.unique_users'|trans({'%count%': stats.today.uniqueUsers}, 'admin') }}</div>
                            {% endif %}
                            <div class="analytics-window">{{ 'analytics.last_7_days'|trans({}, 'admin') }}</div>
                            <div class="row">{{ 'analytics.page_views'|trans({'%count%': stats['7d'].pageViews}, 'admin') }}</div>
                            <div class="row">{{ 'analytics.unique_visitors'|trans({'%count%': stats['7d'].uniqueVisitors}, 'admin') }}</div>
                            {% if stats['7d'].uniqueUsers > 0 %}
                            <div class="row">{{ 'analytics.unique_users'|trans({'%count%': stats['7d'].uniqueUsers}, 'admin') }}</div>
                            {% endif %}
                        </div>
                    {% endblock %}
                </div>
            {% endif %}
        {% endblock %}
    </aside>
    <main class="admin-main">
        {% block topbar %}
            <div class="admin-topbar">
                {% if admin_context is defined and admin_context.crudControllerFqcn %}
                    {# persistent search, present on every page of a CRUD (index/
                       new/edit/detail) not just the index listing - always
                       submits back to that CRUD's own index, matching
                       production's global-looking-but-context-scoped search bar.
                       First now (not last): its flex:1 is what absorbs the
                       leftover space, pulling everything after it - the
                       customize controls, then the icon cluster - over to
                       the right side of the bar instead of them sitting
                       flush left. #}
                    <form class="topbar-search" method="get" action="{{ admin_url(admin_context.crudControllerFqcn, 'index') }}">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="search" name="query" placeholder="{{ 'datagrid.search_placeholder'|trans({}, 'admin') }}">
                    </form>
                {% else %}
                    <span></span>
                {% endif %}
                {# Dashboard-only customize controls (widget palette, column
                   count) - empty on every other admin page, since only
                   dashboard.html.twig overrides this block. #}
                {% block topbar_dashboard_extra %}{% endblock %}
                {% if is_granted('ROLE_SUPERADMIN') %}
                    {# Last among the customize-mode controls (after the
                       palette/columns, right before the icon cluster) -
                       "Done" reads as the final action in that group, not
                       the first thing you see. Still its own sibling, not
                       merged into .admin-topbar-icons: that cluster is
                       right-anchored (margin-left: auto), which already
                       keeps ITS OWN position fixed regardless of what
                       shows/hides before it - nothing here can displace it. #}
                    <button type="button" class="btn btn-primary" id="admin-customize-done" data-csrf-token="{{ csrf_token('admin-layout') }}">{{ 'customize.done'|trans({}, 'admin') }}</button>
                {% endif %}
                <div class="admin-topbar-icons">
                    {% if admin_active_users is defined and admin_active_users is not empty %}
                        {# Shown by default (the avatar cluster itself, not
                           hidden behind a click) - expandable to the full
                           list, which is short in practice (a handful of
                           real admin accounts, not hundreds). #}
                        <div class="admin-icon-dropdown" data-dropdown>
                            <button type="button" class="admin-icon-btn admin-active-users-trigger" aria-haspopup="true" aria-expanded="false" title="{{ 'topbar.active_admins'|trans({'%count%': admin_active_users|length}, 'admin') }}">
                                <span class="admin-active-avatars">
                                    {% for activeUser in admin_active_users|slice(0, 3) %}
                                        <span class="admin-avatar-initial">{{ (activeUser ~ '')|slice(0, 1)|upper }}</span>
                                    {% endfor %}
                                </span>
                                {% if admin_active_users|length > 3 %}<span class="admin-active-count">+{{ admin_active_users|length - 3 }}</span>{% endif %}
                            </button>
                            <div class="admin-dropdown-menu admin-active-users-list" role="menu">
                                <div class="dropdown-heading">{{ 'topbar.active_admins'|trans({'%count%': admin_active_users|length}, 'admin') }}</div>
                                {% for activeUser in admin_active_users %}
                                    <div class="admin-active-user-row">
                                        <span class="admin-avatar-initial">{{ (activeUser ~ '')|slice(0, 1)|upper }}</span>
                                        <span class="admin-active-user-name">{{ activeUser }}</span>
                                        <span class="admin-active-dot {{ activeUser.isOnline ? 'is-online' : '' }}" title="{{ (activeUser.isOnline ? 'topbar.online' : 'topbar.recently_active')|trans({}, 'admin') }}"></span>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                    <div class="admin-icon-dropdown" data-dropdown>
                        <button type="button" class="admin-icon-btn" aria-haspopup="true" aria-expanded="false" title="{{ 'topbar.appearance'|trans({}, 'admin') }}">
                            <i class="fa-solid fa-circle-half-stroke"></i>
                        </button>
                        <div class="admin-dropdown-menu" role="menu" data-theme-menu>
                            <button type="button" data-theme-choice="light"><i class="fa-solid fa-sun"></i> {{ 'topbar.theme_light'|trans({}, 'admin') }}</button>
                            <button type="button" data-theme-choice="dark"><i class="fa-solid fa-moon"></i> {{ 'topbar.theme_dark'|trans({}, 'admin') }}</button>
                            <button type="button" data-theme-choice="auto"><i class="fa-solid fa-cloud-moon"></i> {{ 'topbar.theme_auto'|trans({}, 'admin') }}</button>
                        </div>
                    </div>
                    {% set availableLocales = app.localizer.availableLocales %}
                    {% if availableLocales|length > 1 %}
                        <div class="admin-icon-dropdown" data-dropdown>
                            <button type="button" class="admin-icon-btn" aria-haspopup="true" aria-expanded="false" title="{{ 'topbar.language'|trans({}, 'admin') }}">
                                <i class="fa-solid fa-globe"></i>
                            </button>
                            <div class="admin-dropdown-menu" role="menu">
                                {% for locale in availableLocales %}
                                    <a href="{{ path('_switch_locale', {_locale: locale|lang}) }}" class="{{ locale == app.localizer.locale ? 'is-active' }}">
                                        <img class="admin-locale-flag" alt="{{ locale|country }}" src="{{ asset('bundles/base/images/flags/' ~ (locale|country) ~ '.svg') }}">
                                        {{ locale|lang_name|capitalize }}
                                    </a>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                    {% if is_granted('ROLE_SUPERADMIN') %}
                        <button type="button" class="admin-icon-btn" id="admin-customize-toggle" title="{{ 'topbar.customize'|trans({}, 'admin') }}" aria-pressed="false">
                            <i class="fa-solid fa-arrows-up-down-left-right"></i>
                        </button>
                    {% endif %}
                </div>
            </div>
        {% endblock %}
        {% block flashes %}
            {% set flashes = app.flashes %}
            {% if flashes is not empty %}
            <div class="flashes">
                {% for type, messages in flashes %}
                    {% for message in messages %}
                        <div class="flash flash-{{ type }}">{{ message|trans }}</div>
                    {% endfor %}
                {% endfor %}
            </div>
            {% endif %}
        {% endblock %}
        {% block content_header %}{% endblock %}
        {% block content %}{% endblock %}
    </main>
</div>
{# Shared confirmation modal (native <dialog>, replaces window.confirm):
   any form carrying data-confirm="message" gets intercepted; confirming
   re-submits it through requestSubmit() with the ORIGINAL submitter
   button preserved (a plain form.submit() would drop a row-delete
   button's formaction and delete via the form's own action instead). #}
<dialog id="admin-confirm">
    <p id="admin-confirm-message"></p>
    <div class="admin-confirm-actions">
        <button type="button" class="btn" data-role="cancel">{{ 'action.cancel'|trans({}, 'admin') }}</button>
        <button type="button" class="btn btn-danger" data-role="confirm">{{ 'action.confirm'|trans({}, 'admin') }}</button>
    </div>
</dialog>
<script>
    (function () {
        var dialog = document.getElementById('admin-confirm');
        var pendingForm = null, pendingSubmitter = null;

        document.addEventListener('submit', function (e) {
            var form = e.target;
            if (!(form instanceof HTMLFormElement) || !form.dataset.confirm) return;
            if (form.dataset.confirmed === '1') { delete form.dataset.confirmed; return; }
            e.preventDefault();
            pendingForm = form;
            pendingSubmitter = e.submitter || null;
            document.getElementById('admin-confirm-message').textContent = form.dataset.confirm;
            dialog.showModal();
        }, true);

        dialog.addEventListener('click', function (e) {
            var role = e.target.closest('[data-role]')?.dataset.role;
            if (!role) return;
            dialog.close();
            if (role === 'confirm' && pendingForm) {
                pendingForm.dataset.confirmed = '1';
                pendingForm.requestSubmit(pendingSubmitter);
            }
            pendingForm = pendingSubmitter = null;
        });
    })();
</script>
{% if customize_enabled is defined and customize_enabled %}
<script>
    (function () {
        var STORAGE_KEY = 'admin-customizing';
        var body = document.body;
        var toggleBtn = document.getElementById('admin-customize-toggle');
        var doneBtn = document.getElementById('admin-customize-done');
        var sortablesInitialized = false;

        function setCustomizing(on) {
            body.classList.toggle('is-customizing', on);
            if (toggleBtn) toggleBtn.classList.toggle('is-active', on);
            if (toggleBtn) toggleBtn.setAttribute('aria-pressed', on ? 'true' : 'false');
            try { localStorage.setItem(STORAGE_KEY, on ? '1' : '0'); } catch (e) {}
            if (on) initSortables();
        }

        function initSortables() {
            if (sortablesInitialized || typeof window.StickySortable === 'undefined' || typeof $ === 'undefined') return;
            sortablesInitialized = true;
            // The dashboard widget grid is multi-column - axis:'y' (every
            // other list here: sidebar menu, a section's members, a
            // widget-group's own items) would lock horizontal position and
            // only ever let a widget move up/down within its own column.
            $('[data-sortable]').each(function () {
                var isDashboard = 'dashboard' === this.dataset.sortable;
                var opts = { handle: '[data-sortable-handle]', axis: isDashboard ? null : 'y' };
                if (isDashboard) {
                    // Only a card carrying its own data-merge-def can be
                    // DRAGGED to start a merge - a composite never does
                    // (see _block.html.twig), so picking one up and moving
                    // it always just reorders, never fuses it into
                    // something else. A composite CAN be a merge TARGET
                    // though (isMergeTarget, separate from isMergeable) -
                    // dropping a third/fourth card onto one grows its own
                    // panes instead of creating a new nested composite.
                    opts.mergeable = true;
                    opts.isMergeable = function (el) { return !!el.dataset.mergeDef; };
                    opts.isMergeTarget = function (el) { return !!el.dataset.mergeDef || 'composite' === el.dataset.blockName; };
                    opts.onMerge = handleMerge;
                }
                $(this).stickySortable(opts);
            });
        }

        // Reads a card's self-contained definition (see _block.html.twig
        // and dashboard.html.twig's own data-merge-def comments) so it can
        // be sent to admin_dashboard_widget_merge as-is - the server
        // trusts nothing in it beyond shape-validating it the same way
        // LayoutConfig::fromArray() already treats any client input.
        function captureMergeDefinition(el) {
            try {
                var def = JSON.parse(el.dataset.mergeDef || '');
                // This widget's OWN sortable key, round-tripped through the
                // server into the composite's stored pane data (see
                // DashboardWidgetController::sanitizePaneDefinition()) so
                // LayoutArranger can recognize "this code-defined key was
                // merged into a composite" and skip re-appending it as a
                // separate standalone card on the next save/reload.
                def.sourceKey = el.dataset.sortableKey || null;
                return def;
            } catch (err) {
                return null;
            }
        }

        // A composite's OWN definition (data-widget-params, present on
        // every adHoc widget - a composite is always adHoc) is just
        // {panes: [...]} already shaped exactly how the server expects a
        // pane list - no separate capture format needed for "this IS a
        // composite" vs "this is a plain card being merged".
        function captureWidgetParams(el) {
            try {
                return JSON.parse(el.dataset.widgetParams || '{}');
            } catch (err) {
                return {};
            }
        }

        var MAX_COMPOSITE_PANES = 4;

        // merge/split both do a real server round trip (rendering fresh
        // Twig fragments, not a client-only DOM tweak) - measured live
        // against this dev-mode beta environment at roughly 0.7-1s per
        // request, consistently, not just a one-off cold start. With zero
        // visual feedback during that window, a click/drop looked like it
        // "didn't work" and a repeated attempt fired a SECOND overlapping
        // request for the same card - reported live as "doesn't work the
        // first time, only the second". pendingKeys tracks which widget
        // keys currently have a request in flight so a second attempt on
        // the SAME card is a deliberate no-op (not a race), and .is-busy
        // gives the wait itself a visible state instead of looking inert.
        var pendingKeys = {};
        function isPending(el) { return !!pendingKeys[el.dataset.sortableKey]; }
        function markPending(el) { pendingKeys[el.dataset.sortableKey] = true; el.classList.add('is-busy'); }
        function clearPending(el) { delete pendingKeys[el.dataset.sortableKey]; el.classList.remove('is-busy'); }

        function handleMerge(draggedEl, targetEl) {
            if (isPending(draggedEl) || isPending(targetEl)) return;

            var dragged = captureMergeDefinition(draggedEl);
            if (!dragged) return; // isMergeable() already guards this - defensive only

            var isExistingComposite = 'composite' === targetEl.dataset.blockName;
            var panes;
            if (isExistingComposite) {
                var existing = captureWidgetParams(targetEl).panes;
                panes = Array.isArray(existing) ? existing.slice() : [];
            } else {
                var target = captureMergeDefinition(targetEl);
                if (!target) return;
                panes = [target];
            }

            if (panes.length >= MAX_COMPOSITE_PANES) return; // already full - drop is simply a no-op, not an error
            panes.push(dragged);

            markPending(draggedEl);
            markPending(targetEl);

            var url = '{{ path("admin_dashboard_widget_merge") }}?panes=' + encodeURIComponent(JSON.stringify(panes));

            fetch(url)
                .then(function (r) { if (!r.ok) throw new Error('merge failed: ' + r.status); return r.text(); })
                .then(function (html) {
                    targetEl.insertAdjacentHTML('beforebegin', html);
                    targetEl.remove();
                    draggedEl.remove();
                    // Same reasoning as the palette's own insert flow just
                    // below: a plain DOM insertion never triggers either of
                    // admin-charts.js's own init paths.
                    if (window.AdminCharts && window.AdminCharts.init) window.AdminCharts.init();
                })
                .catch(function () {
                    // Leave both cards exactly as they were - clearing
                    // pending below (via finally) is what lets a retry work.
                })
                .finally(function () {
                    clearPending(draggedEl);
                    clearPending(targetEl);
                });
        }

        // Split a composite back into its standalone panes - the inverse
        // of handleMerge(). Sends the composite's OWN panes list as-is;
        // the server renders each one as its own fresh widget fragment
        // (possibly several sibling elements in one response) and this
        // swaps them in for the composite node.
        document.addEventListener('click', function (e) {
            var button = e.target.closest('[data-split-item]');
            if (!button || !body.classList.contains('is-customizing')) return;
            var item = button.closest('[data-sortable-item]');
            if (!item || isPending(item)) return;

            var panes = captureWidgetParams(item).panes;
            if (!Array.isArray(panes) || !panes.length) return;

            markPending(item);
            button.disabled = true;

            var url = '{{ path("admin_dashboard_widget_split") }}?panes=' + encodeURIComponent(JSON.stringify(panes));
            fetch(url)
                .then(function (r) { if (!r.ok) throw new Error('split failed: ' + r.status); return r.text(); })
                .then(function (html) {
                    item.insertAdjacentHTML('beforebegin', html);
                    item.remove();
                    if (window.AdminCharts && window.AdminCharts.init) window.AdminCharts.init();
                })
                .catch(function () {
                    button.disabled = false;
                })
                .finally(function () {
                    clearPending(item);
                });
        });

        if (toggleBtn) {
            toggleBtn.addEventListener('click', function () {
                setCustomizing(!body.classList.contains('is-customizing'));
            });
        }

        // hide/show toggle - flips the class + icon only, batched to the
        // server on "Done" (SettingBag::set() invalidates the whole
        // compiled settings snapshot per call - one save, not one per click).
        document.addEventListener('click', function (e) {
            var toggle = e.target.closest('[data-toggle-hidden]');
            if (!toggle || !body.classList.contains('is-customizing')) return;
            var item = toggle.closest('[data-sortable-item]');
            if (!item) return;
            item.classList.toggle('is-hidden');
            var icon = toggle.querySelector('i');
            if (icon) icon.classList.toggle('fa-eye-slash', item.classList.contains('is-hidden'));
            if (icon) icon.classList.toggle('fa-eye', !item.classList.contains('is-hidden'));
        });

        // Remove (ad-hoc/palette-added widgets only - see _block.html.twig's
        // own comment on why a code-defined widget only ever gets hide/show).
        // Immediate DOM removal, no confirmation: the next captureLevel()
        // simply won't see this node anymore, and LayoutArranger's
        // synthesis pass never re-creates a key nothing mentions - that
        // absence IS the removal, nothing else to signal server-side.
        document.addEventListener('click', function (e) {
            var button = e.target.closest('[data-remove-item]');
            if (!button || !body.classList.contains('is-customizing')) return;
            var item = button.closest('[data-sortable-item]');
            if (item) item.remove();
        });

        // resize drag, with an explicit live preview: dragging the corner
        // does NOT touch the real widget/grid at all while the pointer is
        // down - it moves/resizes a separate dashed-outline ghost (fixed-
        // positioned off getBoundingClientRect(), so it's immune to any
        // ancestor's overflow/clipping and never fights the grid's own
        // reflow) with a size badge. Width snaps to whichever grid-column
        // count the pointer is currently over (like before); height is
        // free-form pixels, not quantized to anything - there's no "row
        // grid" to snap to the way there's a column count. Both the real
        // inline grid-column AND min-height styles - and the real reflow -
        // only ever get applied once, on release, to whatever the ghost
        // was last showing.
        var resizing = null;
        // Below this, a card reads as broken (controls overlapping
        // content) rather than just small - same floor
        // LayoutConfig/MenuItem enforce server-side, kept in sync here so
        // the live ghost preview never promises a height the save would
        // silently clamp away from.
        var MIN_WIDGET_HEIGHT = 80;
        // Small vertical movement shouldn't retroactively pin a card's
        // height to "whatever it happened to be" just because someone
        // grabbed the corner to resize its WIDTH only - a purely
        // horizontal drag must leave height exactly as auto/flex-driven
        // as it always was. Only once the pointer has genuinely moved
        // vertically past this does a resize start touching height at all
        // (same dragThreshold-style guard sticky-sortable.js already uses
        // for "is this a drag or just a click").
        var HEIGHT_TOUCH_THRESHOLD = 4;

        // The dashboard's own configured column count (see
        // dashboard.html.twig's data-widget-columns) - the resize
        // control's own upper bound, so "size" can never exceed however
        // many columns actually exist right now. Falls back to 5 (the
        // same default LayoutConfig itself uses) if the grid isn't found
        // for some reason, never to the old hardcoded 3.
        function currentColumns() {
            var grid = document.querySelector('[data-sortable="dashboard"]');
            var n = grid ? parseInt(grid.dataset.widgetColumns, 10) : NaN;
            return n && n > 0 ? n : 5;
        }

        function paintResizeGhost(ghost, badge, rect, columnWidth, size, height) {
            ghost.style.left = rect.left + 'px';
            ghost.style.top = rect.top + 'px';
            ghost.style.width = (columnWidth * size) + 'px';
            ghost.style.height = height + 'px';
            badge.textContent = size + ' / ' + currentColumns() + ' · ' + Math.round(height) + 'px';
        }

        document.addEventListener('pointerdown', function (e) {
            var handle = e.target.closest('[data-resize-handle]');
            if (!handle || !body.classList.contains('is-customizing')) return;
            var item = handle.closest('[data-sortable-item]');
            if (!item) return;

            // A previous drag's pointerup/pointercancel can be lost entirely
            // in ways this page has no way to observe (the window losing
            // focus mid-drag, a trackpad gesture producing an inconsistent
            // event sequence, etc.) - leaving its ghost permanently stuck,
            // fixed-positioned on top of everything. Starting a new resize
            // is the next guaranteed opportunity to notice and clean that up.
            if (resizing) commitResize();

            e.preventDefault();
            handle.setPointerCapture(e.pointerId);
            handle.classList.add('is-resizing');

            var startSize = parseInt(item.dataset.widgetSize || '1', 10);
            var rect = item.getBoundingClientRect();
            // The widget's OWN current rendered width divided by how many
            // columns it currently spans, rather than parsing the grid's
            // computed gridTemplateColumns string - fewer ways for this to
            // silently come back wrong.
            var columnWidth = (rect.width / startSize) || 240;
            // Prefer the STORED height (if this card was already given an
            // explicit one) over the rendered rect - the rendered height
            // can be taller than what was actually set, stretched to match
            // a taller sibling in the same row (see .widget-block/.widget-
            // group's own flex-fill rules) - starting a new drag from that
            // inflated value would silently bake the stretch in as a new
            // explicit height the instant you touched the corner at all.
            var startHeight = parseInt(item.dataset.widgetHeight || '', 10) || rect.height;

            var ghost = document.createElement('div');
            ghost.className = 'admin-resize-ghost';
            var badge = document.createElement('span');
            badge.className = 'admin-resize-ghost-badge';
            ghost.appendChild(badge);
            document.body.appendChild(ghost);
            paintResizeGhost(ghost, badge, rect, columnWidth, startSize, startHeight);

            resizing = {
                item: item, handle: handle, ghost: ghost, badge: badge, rect: rect,
                pointerId: e.pointerId, startX: e.clientX, startY: e.clientY,
                startSize: startSize, startHeight: startHeight, columnWidth: columnWidth,
                target: startSize, targetHeight: startHeight, heightTouched: false,
            };
        });

        document.addEventListener('pointermove', function (e) {
            if (!resizing || e.pointerId !== resizing.pointerId) return;
            var deltaColumns = Math.round((e.clientX - resizing.startX) / resizing.columnWidth);
            var next = Math.max(1, Math.min(currentColumns(), resizing.startSize + deltaColumns));

            var deltaY = e.clientY - resizing.startY;
            if (Math.abs(deltaY) > HEIGHT_TOUCH_THRESHOLD) resizing.heightTouched = true;
            var nextHeight = Math.max(MIN_WIDGET_HEIGHT, Math.round(resizing.startHeight + deltaY));

            if (next !== resizing.target || nextHeight !== resizing.targetHeight) {
                resizing.target = next;
                resizing.targetHeight = nextHeight;
                paintResizeGhost(resizing.ghost, resizing.badge, resizing.rect, resizing.columnWidth, next, nextHeight);
            }
        });

        function commitResize() {
            if (!resizing) return;
            resizing.ghost.remove();
            resizing.handle.classList.remove('is-resizing');
            // Pointer capture can already be invalid by the time this runs
            // (that's exactly the kind of lost/out-of-order event this
            // function exists to recover from) - releasing it is a courtesy,
            // never a precondition for cleaning up the ghost/committing.
            try { resizing.handle.releasePointerCapture(resizing.pointerId); } catch (err) {}
            var item = resizing.item;
            var next = resizing.target;
            if (parseInt(item.dataset.widgetSize, 10) !== next) {
                item.style.gridColumn = 'span ' + next;
                item.dataset.widgetSize = next;
            }
            if (resizing.heightTouched) {
                item.style.minHeight = resizing.targetHeight + 'px';
                item.dataset.widgetHeight = resizing.targetHeight;
            }
            resizing = null;
        }

        // Deliberately NOT gated on e.pointerId matching resizing.pointerId:
        // only one resize is ever in flight at a time (one ghost, one
        // handle with capture), so there's nothing genuinely ambiguous to
        // disambiguate - and requiring an exact match is that much more
        // surface for a lost/mismatched event to leave the ghost stuck
        // forever, which is exactly the failure this whole function exists
        // to prevent.
        document.addEventListener('pointerup', function () { commitResize(); });
        document.addEventListener('pointercancel', function () { commitResize(); });
        // Last-resort safety nets: the window losing focus or the tab being
        // hidden mid-drag (alt-tab, switching apps, a trackpad gesture that
        // hands control to the OS) can lose the pointerup/pointercancel
        // event entirely - these fire regardless and guarantee the ghost
        // never survives past the interaction that created it.
        window.addEventListener('blur', function () { commitResize(); });
        document.addEventListener('visibilitychange', function () {
            if (document.hidden) commitResize();
        });

        // Keyboard fallback: focus the handle (it's a real button, tab-
        // reachable) - ArrowLeft/ArrowRight cycles width by one column,
        // ArrowUp/ArrowDown adjusts height by a fixed step. Same parity
        // with a pointer drag as StickySortable's own arrow-key fallback
        // gives its drag handles. Unlike a pointer drag's small-movement
        // guard, a keyboard press is already a discrete, deliberate action
        // - no threshold needed before it commits an explicit height.
        var HEIGHT_KEY_STEP = 20;
        document.addEventListener('keydown', function (e) {
            var isWidthKey = 'ArrowLeft' === e.key || 'ArrowRight' === e.key;
            var isHeightKey = 'ArrowUp' === e.key || 'ArrowDown' === e.key;
            if (!isWidthKey && !isHeightKey) return;
            var handle = e.target.closest && e.target.closest('[data-resize-handle]');
            if (!handle) return;
            var item = handle.closest('[data-sortable-item]');
            if (!item) return;
            e.preventDefault();

            if (isWidthKey) {
                var current = parseInt(item.dataset.widgetSize || '1', 10);
                var next = Math.max(1, Math.min(currentColumns(), current + (e.key === 'ArrowRight' ? 1 : -1)));
                if (next !== current) {
                    item.style.gridColumn = 'span ' + next;
                    item.dataset.widgetSize = next;
                }
                return;
            }

            var currentHeight = parseInt(item.dataset.widgetHeight || '', 10) || item.getBoundingClientRect().height;
            var nextHeight = Math.max(MIN_WIDGET_HEIGHT, Math.round(currentHeight + HEIGHT_KEY_STEP * (e.key === 'ArrowDown' ? 1 : -1)));
            if (nextHeight !== currentHeight) {
                item.style.minHeight = nextHeight + 'px';
                item.dataset.widgetHeight = nextHeight;
            }
        });

        // Analytics card range picker: re-fetches analytics_daily_breakdown()
        // for the clicked range and hands the JSON straight to admin-charts.js's
        // update() - see AnalyticsController::breakdown(). The stat row above
        // the picker is deliberately left untouched (see the template comment
        // by the picker's markup): only the chart re-renders.
        //
        // The endpoint always returns all 5 datasets, each tagged with its
        // source `key` - the picker only keeps whichever ones are CURRENTLY
        // plotted (read straight off the live Chart.js instance's own
        // dataset keys) before handing the swap to admin-charts.js, so a
        // range change never reintroduces a series the admin turned off in
        // this instance's settings.
        //
        // requestId guards against out-of-order responses: two ranges fetched
        // in quick succession aren't guaranteed to RESOLVE in click order (the
        // earlier click's response can land after the later one's), which
        // would otherwise leave the chart showing stale data under a pill
        // that says something else. Only the response matching the picker's
        // latest click is ever applied.
        document.addEventListener('click', function (e) {
            var btn = e.target.closest('[data-analytics-range-picker] [data-range]');
            if (!btn || btn.classList.contains('is-active')) return;
            var picker = btn.closest('[data-analytics-range-picker]');
            var endpoints = JSON.parse(picker.dataset.analyticsEndpoints || '{}');
            var url = endpoints[btn.dataset.range];
            var canvas = picker.closest('.analytics-card').querySelector('[data-admin-chart]');
            if (!url || !canvas) return;

            picker.querySelectorAll('[data-range]').forEach(function (b) { b.classList.remove('is-active'); });
            btn.classList.add('is-active');
            picker.classList.add('is-loading');

            var requestId = (picker._analyticsRequestId = (picker._analyticsRequestId || 0) + 1);

            fetch(url, { headers: { Accept: 'application/json' } })
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    if (requestId !== picker._analyticsRequestId) return;
                    if (window.AdminCharts) {
                        var currentChart = canvas._adminChart;
                        var visibleKeys = currentChart
                            ? currentChart.data.datasets.map(function (ds) { return ds.key; })
                            : null;
                        var datasets = visibleKeys
                            ? (data.datasets || []).filter(function (ds) { return visibleKeys.indexOf(ds.key) !== -1; })
                            : data.datasets;
                        window.AdminCharts.update(canvas, { labels: data.labels, datasets: datasets, events: data.events });
                    }
                    // "Depuis toujours" only covers days actually tracked, so
                    // it can show a SHORTER span than "30 jours" (which
                    // zero-fills days before tracking even began) - a title
                    // showing the real start date explains why, rather than
                    // making it look inconsistent or broken.
                    if (btn.dataset.range === 'all' && btn.dataset.sincePrefix && data.labels && data.labels.length) {
                        btn.title = btn.dataset.sincePrefix + ' ' + data.labels[0];
                    }
                    picker.classList.remove('is-loading');
                })
                .catch(function () {
                    if (requestId === picker._analyticsRequestId) picker.classList.remove('is-loading');
                });
        });

        // Analytics card settings panel (title + which series it plots).
        // Applying writes data-block-name/data-widget-label/data-widget-
        // params straight onto the SAME widget-block node captureLevel()
        // already knows how to read (see its own comment, above) - "Done"
        // then round-trips this through the existing save/load path with
        // zero new server plumbing. LayoutArranger::applyLevel() applies
        // the stored override onto the matched CODE-DEFINED item in place
        // (see its own docblock) rather than spawning an ad-hoc duplicate
        // alongside the built-in card - tried the duplicate-friendly
        // approach first and it does exactly that, since
        // configureDashboardBlockItems() re-offers the built-in key every
        // request regardless of what's stored under a DIFFERENT key.
        //
        // data-merge-def (see _block.html.twig) is the one existing source
        // of "this instance's current blockName/label/icon/params" for
        // ANY widget with a blockName, code-defined or ad-hoc alike - read
        // on open (to pre-fill the form) and again on apply (to preserve
        // any OTHER params this instance already carries, e.g. 'days',
        // instead of clobbering them with just {series: [...]}).
        document.addEventListener('click', function (e) {
            var toggle = e.target.closest('[data-analytics-settings-toggle]');
            if (toggle) {
                var toggleCard = toggle.closest('[data-analytics-card]');
                var togglePanel = toggleCard.querySelector('[data-analytics-settings-panel]');
                var opening = !!togglePanel.hidden;
                if (opening) {
                    var toggleBlock = toggleCard.closest('[data-sortable-item]');
                    var toggleDef = JSON.parse((toggleBlock && toggleBlock.dataset.mergeDef) || '{}');
                    var toggleSeries = (toggleDef.params && toggleDef.params.series) || null;
                    toggleCard.querySelector('[data-analytics-settings-title]').value = toggleDef.label || '';
                    toggleCard.querySelectorAll('[data-analytics-settings-series]').forEach(function (cb) {
                        cb.checked = toggleSeries ? toggleSeries.indexOf(cb.value) !== -1 : true;
                    });
                }
                togglePanel.hidden = !opening;
                toggle.classList.toggle('is-active', opening);
                return;
            }

            var cancel = e.target.closest('[data-analytics-settings-cancel]');
            if (cancel) {
                var cancelCard = cancel.closest('[data-analytics-card]');
                cancelCard.querySelector('[data-analytics-settings-panel]').hidden = true;
                cancelCard.querySelector('[data-analytics-settings-toggle]').classList.remove('is-active');
                return;
            }

            var apply = e.target.closest('[data-analytics-settings-apply]');
            if (!apply) return;

            var applyCard = apply.closest('[data-analytics-card]');
            var applyBlock = applyCard.closest('[data-sortable-item]');
            var applyDef = JSON.parse((applyBlock && applyBlock.dataset.mergeDef) || '{}');
            var titleInput = applyCard.querySelector('[data-analytics-settings-title]');
            var title = titleInput.value.trim();
            var series = Array.prototype.map.call(
                applyCard.querySelectorAll('[data-analytics-settings-series]:checked'),
                function (cb) { return cb.value; }
            );
            // At least one series - an empty chart is never a useful state,
            // and AnalyticsCardWidgetType already falls back to "all" server-
            // side for an empty/unknown selection, so this just keeps the
            // CLIENT-side preview honest with what a reload would actually show.
            if (!series.length) {
                series = Array.prototype.map.call(
                    applyCard.querySelectorAll('[data-analytics-settings-series]'),
                    function (cb) { return cb.value; }
                );
            }

            applyBlock.dataset.blockName = applyDef.blockName || 'analytics_card';
            applyBlock.dataset.widgetLabel = title || applyDef.label || '';
            applyBlock.dataset.widgetIcon = applyDef.icon || '';
            applyBlock.dataset.widgetParams = JSON.stringify(Object.assign({}, applyDef.params, { series: series }));

            var titleEl = applyCard.querySelector('[data-analytics-title]');
            if (titleEl) titleEl.textContent = title || applyDef.label || '';

            var applyCanvas = applyCard.querySelector('[data-admin-chart]');
            var applyPicker = applyCard.querySelector('[data-analytics-range-picker]');
            var applyActiveBtn = applyPicker && (applyPicker.querySelector('[data-range].is-active') || applyPicker.querySelector('[data-range]'));
            var applyEndpoints = applyPicker ? JSON.parse(applyPicker.dataset.analyticsEndpoints || '{}') : {};
            var applyUrl = applyActiveBtn ? applyEndpoints[applyActiveBtn.dataset.range] : null;
            if (applyCanvas && applyUrl && window.AdminCharts) {
                fetch(applyUrl, { headers: { Accept: 'application/json' } })
                    .then(function (res) { return res.json(); })
                    .then(function (data) {
                        var datasets = (data.datasets || []).filter(function (ds) { return series.indexOf(ds.key) !== -1; });
                        window.AdminCharts.update(applyCanvas, { labels: data.labels, datasets: datasets, events: data.events });
                    });
            }

            applyCard.querySelector('[data-analytics-settings-panel]').hidden = true;
            applyCard.querySelector('[data-analytics-settings-toggle]').classList.remove('is-active');
        });

        // "+ Add widget" palette: fetches the registered type list once
        // (lazily, on first open - reuses the SAME generic [data-dropdown]
        // open/close handler already wired above for the topbar's theme/
        // language menus, nothing new there), then GETs a fresh instance's
        // rendered markup and inserts it directly - no separate JSON
        // contract to keep in sync, the fragment already carries its own
        // data-sortable-key/data-block-name/etc (see _block.html.twig).
        // Reachable only from inside an already-active customize session,
        // so the inserted node is immediately draggable/resizable/
        // removable for free: StickySortable binds on the CONTAINER, not
        // per-item, and the resize/hide/remove handlers above are all
        // document-delegated - nothing here needs to re-init anything.
        // Live-updates the grid's own custom property + data attribute the
        // instant the value changes - the resize control (currentColumns())
        // and the eventual "Done" save (saveScope() reads this same data
        // attribute) both pick it up with no separate state to sync.
        var columnsSelect = document.querySelector('[data-columns-select]');
        if (columnsSelect) {
            columnsSelect.addEventListener('change', function () {
                var grid = document.querySelector('[data-sortable="dashboard"]');
                if (!grid) return;
                grid.dataset.widgetColumns = columnsSelect.value;
                grid.style.setProperty('--widget-columns', columnsSelect.value);
            });
        }

        var paletteTypes = null;
        var paletteTrigger = document.getElementById('admin-add-widget-trigger');
        var paletteMenu = document.querySelector('[data-widget-palette-menu]');
        if (paletteTrigger && paletteMenu) {
            paletteTrigger.addEventListener('click', function () {
                if (paletteTypes) return;
                fetch('{{ path("admin_dashboard_widget_types") }}')
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        paletteTypes = data.types || [];
                        paletteMenu.innerHTML = paletteTypes.map(function (t) {
                            return '<button type="button" data-add-widget-type="' + t.name + '">'
                                + (t.icon ? '<i class="' + t.icon + '"></i> ' : '') + t.label + '</button>';
                        }).join('');
                    });
            });
        }
        document.addEventListener('click', function (e) {
            var button = e.target.closest('[data-add-widget-type]');
            if (!button) return;
            var grid = document.querySelector('[data-sortable="dashboard"]');
            if (!grid) return;

            var label = window.prompt('{{ 'customize.add_widget'|trans({}, 'admin')|e('js') }}', button.textContent.trim());
            if (null === label) return; // cancelled

            var url = '{{ path("admin_dashboard_widget_new", {blockName: "__BLOCK__"}) }}'.replace('__BLOCK__', encodeURIComponent(button.dataset.addWidgetType))
                + '?label=' + encodeURIComponent(label);
            fetch(url)
                .then(function (r) { return r.text(); })
                .then(function (html) {
                    grid.insertAdjacentHTML('beforeend', html);
                    // Neither the 'load'-driven init nor the SPA-swap path
                    // in admin-charts.js ever sees a plain DOM insertion
                    // like this one - the new canvas needs an explicit push.
                    if (window.AdminCharts && window.AdminCharts.init) window.AdminCharts.init();
                });
        });

        function captureLevel(container) {
            var items = [];
            container.querySelectorAll(':scope > [data-sortable-item]').forEach(function (el) {
                var childContainer = el.querySelector(':scope > [data-sortable]');
                var entry = {
                    key: el.dataset.sortableKey,
                    visible: !el.classList.contains('is-hidden'),
                    size: parseInt(el.dataset.widgetSize || '1', 10),
                    // null (not omitted) when never explicitly resized -
                    // matches LayoutConfig's own "height: ?int" shape, and
                    // lets a later save correctly CLEAR a previously-set
                    // height back to auto if that's ever wired up client-
                    // side, rather than the key just silently vanishing.
                    height: el.dataset.widgetHeight ? parseInt(el.dataset.widgetHeight, 10) : null,
                    children: childContainer ? captureLevel(childContainer) : [],
                };
                // Ad-hoc/palette-added widgets carry their own definition in
                // data-* attributes (see _block.html.twig) - an ordinary
                // code-tracked node never has data-block-name, so this stays
                // a no-op and every existing widget's captured shape is
                // unaffected.
                if (el.dataset.blockName) {
                    entry.blockName = el.dataset.blockName;
                    entry.label = el.dataset.widgetLabel || '';
                    entry.icon = el.dataset.widgetIcon || null;
                    try { entry.params = JSON.parse(el.dataset.widgetParams || '{}'); } catch (err) { entry.params = {}; }
                }
                items.push(entry);
            });
            return items;
        }

        // path() validates route requirements (scope: sidebar|dashboard) at
        // render time - a placeholder value wouldn't match the pattern and
        // would throw, so both real URLs are generated server-side and
        // looked up by scope name client-side, rather than building one
        // templated URL string and substituting into it.
        var LAYOUT_SAVE_URLS = {
            sidebar: '{{ path("admin_layout_save", {scope: "sidebar"}) }}',
            dashboard: '{{ path("admin_layout_save", {scope: "dashboard"}) }}',
        };

        function saveScope(scope, container) {
            var payload = { version: 1, items: captureLevel(container) };
            // columns only means anything for the dashboard grid - reads
            // the CURRENT value straight off the grid's own data attribute
            // (kept live-in-sync by the columns-select handler below), not
            // a separate piece of state to keep consistent by hand.
            if ('dashboard' === scope) {
                payload.columns = parseInt(container.dataset.widgetColumns, 10) || 5;
            }
            return fetch(LAYOUT_SAVE_URLS[scope], {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': doneBtn.dataset.csrfToken },
                body: JSON.stringify(payload),
            });
        }

        if (doneBtn) {
            doneBtn.addEventListener('click', function () {
                var saves = [];
                document.querySelectorAll('[data-sortable="sidebar"]').forEach(function (el) { saves.push(saveScope('sidebar', el)); });
                document.querySelectorAll('[data-sortable="dashboard"]').forEach(function (el) { saves.push(saveScope('dashboard', el)); });

                Promise.all(saves).then(function () {
                    setCustomizing(false);
                    window.location.reload();
                }).catch(function () {
                    // leave customize mode open so nothing is silently lost
                });
            });
        }

        var wasCustomizing = false;
        try { wasCustomizing = localStorage.getItem(STORAGE_KEY) === '1'; } catch (e) {}
        if (wasCustomizing) setCustomizing(true);
    })();
</script>
{% endif %}
{% block body_javascript %}{% endblock %}
{# NOT calling parent.Transparent.notifyNestReady() here (tried it,
   reverted - see git history / transparent.js's mount()). A plain
   inline <script> this close to </body> still runs during HTML
   PARSING, roughly DOMContentLoaded timing, well before images/
   stylesheets/deferred scripts have actually finished loading and
   applied. Measured directly against the real admin dashboard: firing
   it unconditionally here revealed the overlay while this document's
   readyState was still "interactive", 668ms before it reached
   "complete" - the exact "page goes white, nested site hasn't finished
   loading" bug. Gating it on this document's OWN 'load' event instead
   just re-races the parent's identical 'load'-driven reveal with no
   guaranteed ordering between the two, for no proven benefit - this
   app's actual asset loading (form-defer included, all real <script>
   tags) is already fully covered by the parent's load+settle fallback
   in Transparent.nest's mount(). Reconsider notifyNestReady() only if a
   future page here has real async work that genuinely continues after
   its own 'load' event. #}
</html>
