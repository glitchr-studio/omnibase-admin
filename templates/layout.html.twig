{# Shared confirmation modal (native <dialog>, replaces window.confirm):
   any form carrying data-confirm="message" gets intercepted; confirming
   re-submits it through requestSubmit() with the ORIGINAL submitter
   button preserved (a plain form.submit() would drop a row-delete
   button's formaction and delete via the form's own action instead). #}
<dialog id="admin-confirm">
    <p id="admin-confirm-message"></p>
    <div class="admin-confirm-actions">
        <button type="button" class="btn" data-role="cancel">{{ 'action.cancel'|trans({}, 'admin') }}</button>
        <button type="button" class="btn btn-danger" data-role="confirm">{{ 'action.confirm'|trans({}, 'admin') }}</button>
    </div>
</dialog>
<script>
    (function () {
        var dialog = document.getElementById('admin-confirm');
        var pendingForm = null, pendingSubmitter = null;

        document.addEventListener('submit', function (e) {
            var form = e.target;
            if (!(form instanceof HTMLFormElement) || !form.dataset.confirm) return;
            if (form.dataset.confirmed === '1') { delete form.dataset.confirmed; return; }
            e.preventDefault();
            pendingForm = form;
            pendingSubmitter = e.submitter || null;
            document.getElementById('admin-confirm-message').textContent = form.dataset.confirm;
            dialog.showModal();
        }, true);

        dialog.addEventListener('click', function (e) {
            var role = e.target.closest('[data-role]')?.dataset.role;
            if (!role) return;
            dialog.close();
            if (role === 'confirm' && pendingForm) {
                pendingForm.dataset.confirmed = '1';
                pendingForm.requestSubmit(pendingSubmitter);
            }
            pendingForm = pendingSubmitter = null;
        });
    })();
</script>
{% if customize_enabled is defined and customize_enabled %}
<script>
    (function () {
        // This IIFE binds document-level listeners: transparentJS's SPA
        // body-merge can re-insert this script node after navigating from
        // a page that lacked it, and a second execution would double every
        // delegated handler (two toggles = visual no-op). One global guard
        // beats auditing each listener for idempotency.
        if (window.__adminCustomizeBound) return;
        window.__adminCustomizeBound = true;

        var STORAGE_KEY = 'admin-customizing';
        var body = document.body;
        // LIVE lookups, never parse-time element captures: every in-admin
        // navigation swaps #page's whole subtree (topbar included), so an
        // element grabbed here once would be a detached ghost after the
        // first SPA click - the exact reason the customize toggle "worked
        // only on the page you happened to hard-load" (reported live).
        function getToggleBtn() { return document.getElementById('admin-customize-toggle'); }
        function getDoneBtn() { return document.getElementById('admin-customize-done'); }
        function layoutCsrfToken() {
            var btn = getDoneBtn();
            return btn ? btn.dataset.csrfToken : '';
        }
        var sortablesInitialized = false;

        // Applies the CURRENT customize-mode state to every
        // [data-analytics-title] (plus the sidebar's own [data-brand-title],
        // same in-place-edit pattern - see the blur handler further below)
        // in the document - called from
        // setCustomizing() AND after every insertion point that can add a
        // fresh one (palette add / merge / split, right next to their
        // existing window.AdminCharts.init() calls below) since a node
        // inserted mid-session never goes through setCustomizing() itself.
        function refreshTitleEditability() {
            var on = body.classList.contains('is-customizing');
            // data-widget-text ("Generic"'s own body content, see welcome.
            // html.twig's own comment) rides along here too - same toggle
            // mechanism, different data-* target/persistence path.
            // data-page-title/data-page-desc: a non-dashboard page's own
            // H1/description (see system.html.twig / crud/index.html.twig)
            // - same in-place-edit pattern, persisted into the SIDEBAR
            // scope's matching menu item so the sidebar label stays in
            // sync by construction (one stored value shown twice).
            document.querySelectorAll('[data-analytics-title], [data-brand-title], [data-widget-text], [data-page-title], [data-page-desc]').forEach(function (el) {
                el.contentEditable = on ? 'true' : 'false';
            });
        }

        function setCustomizing(on) {
            var toggleBtn = getToggleBtn();
            body.classList.toggle('is-customizing', on);
            if (toggleBtn) toggleBtn.classList.toggle('is-active', on);
            if (toggleBtn) toggleBtn.setAttribute('aria-pressed', on ? 'true' : 'false');
            try { localStorage.setItem(STORAGE_KEY, on ? '1' : '0'); } catch (e) {}
            if (on) initSortables();
            // The traffic widget's title edits in place now (contenteditable
            // heading, see analytics_card.html.twig's own comment) - toggled
            // here rather than rendered server-side, since customize_enabled
            // (a superadmin PERMISSION check, true on every page load for
            // one) and is-customizing (this CLIENT-toggled UI state) are
            // different things - a permission-gated contenteditable would
            // stay clickable-into on a normal, non-customizing dashboard
            // view too. article_views' own title shares data-analytics-title
            // (same heading pattern, see that widget's own template) and
            // gets the exact same treatment for free.
            refreshTitleEditability();
            // Every way OUT of customize mode (Terminé, the toolbar toggle,
            // whatever else calls this with on=false) must also close any
            // widget settings panel left open (entity_views'/counter's own,
            // and analytics_card's own series-checkbox panel too - the
            // composite's pane-ratio control is a direct drag divider,
            // not a panel, see [data-composite-pane-divider] below) - its
            // own `hidden` state otherwise has nothing tying it to
            // customize mode at all, and stayed stuck open outside
            // customize mode once entered, found live. Discards whatever
            // was mid-edit, same as clicking the panel's own Cancel would -
            // leaving customize mode is already an implicit "never mind"
            // for everything else here too.
            if (!on) {
                document.querySelectorAll('[data-entity-views-settings-panel]:not([hidden]), [data-counter-settings-panel]:not([hidden])').forEach(function (panel) {
                    panel.hidden = true;
                    // Both toggle buttons live INSIDE their own widget's
                    // own card, a SIBLING of the panel, not an ancestor of
                    // it - reachable from the common .widget-block
                    // ancestor either way.
                    var widgetBlock = panel.closest('[data-sortable-item]');
                    var toggle = widgetBlock && widgetBlock.querySelector('[data-entity-views-settings-toggle], [data-counter-settings-toggle]');
                    if (toggle) toggle.classList.remove('is-active');
                });
            }
        }

        function initSortables() {
            if (sortablesInitialized || typeof window.StickySortable === 'undefined' || typeof $ === 'undefined') return;
            sortablesInitialized = true;
            // The dashboard widget grid is multi-column - axis:'y' (every
            // other list here: sidebar menu, a section's members, a
            // widget-group's own items) would lock horizontal position and
            // only ever let a widget move up/down within its own column.
            $('[data-sortable]').each(function () {
                var isDashboard = 'dashboard' === this.dataset.sortable;
                var opts = { handle: '[data-sortable-handle]', axis: isDashboard ? null : 'y' };
                if (isDashboard) {
                    // Only a card carrying its own data-merge-def can be
                    // DRAGGED to start a merge - a composite never does
                    // (see _block.html.twig), so picking one up and moving
                    // it always just reorders, never fuses it into
                    // something else. A composite CAN be a merge TARGET
                    // though (isMergeTarget, separate from isMergeable) -
                    // dropping a third/fourth card onto one grows its own
                    // panes instead of creating a new nested composite.
                    opts.mergeable = true;
                    opts.isMergeable = function (el) { return !!el.dataset.mergeDef; };
                    opts.isMergeTarget = function (el) { return !!el.dataset.mergeDef || 'composite' === el.dataset.blockName; };
                    opts.onMerge = handleMerge;
                }
                $(this).stickySortable(opts);
            });
        }

        // Reads a card's self-contained definition (see _block.html.twig
        // and dashboard.html.twig's own data-merge-def comments) so it can
        // be sent to admin_dashboard_widget_merge as-is - the server
        // trusts nothing in it beyond shape-validating it the same way
        // LayoutConfig::fromArray() already treats any client input.
        function captureMergeDefinition(el) {
            try {
                var def = JSON.parse(el.dataset.mergeDef || '');
                // This widget's OWN sortable key, round-tripped through the
                // server into the composite's stored pane data (see
                // DashboardWidgetController::sanitizePaneDefinition()) so
                // LayoutArranger can recognize "this code-defined key was
                // merged into a composite" and skip re-appending it as a
                // separate standalone card on the next save/reload.
                def.sourceKey = el.dataset.sortableKey || null;
                // This widget's CURRENT dashboard-grid width, carried into
                // the pane as its relative width WITHIN the composite (see
                // composite.html.twig's grid-template-columns) - a 1-wide
                // and a 2-wide card merge into a 1fr/2fr split instead of
                // both being forced to an equal share.
                def.size = parseInt(el.dataset.widgetSize || '1', 10) || 1;
                return def;
            } catch (err) {
                return null;
            }
        }

        // A composite's OWN definition (data-widget-params, present on
        // every adHoc widget - a composite is always adHoc) is just
        // {panes: [...]} already shaped exactly how the server expects a
        // pane list - no separate capture format needed for "this IS a
        // composite" vs "this is a plain card being merged".
        function captureWidgetParams(el) {
            try {
                return JSON.parse(el.dataset.widgetParams || '{}');
            } catch (err) {
                return {};
            }
        }

        var MAX_COMPOSITE_PANES = 4;

        // merge/split both do a real server round trip (rendering fresh
        // Twig fragments, not a client-only DOM tweak) - measured live
        // against this dev-mode beta environment at roughly 0.7-1s per
        // request, consistently, not just a one-off cold start. With zero
        // visual feedback during that window, a click/drop looked like it
        // "didn't work" and a repeated attempt fired a SECOND overlapping
        // request for the same card - reported live as "doesn't work the
        // first time, only the second". pendingKeys tracks which widget
        // keys currently have a request in flight so a second attempt on
        // the SAME card is a deliberate no-op (not a race), and .is-busy
        // gives the wait itself a visible state instead of looking inert.
        var pendingKeys = {};
        function isPending(el) { return !!pendingKeys[el.dataset.sortableKey]; }
        function markPending(el) { pendingKeys[el.dataset.sortableKey] = true; el.classList.add('is-busy'); }
        function clearPending(el) { delete pendingKeys[el.dataset.sortableKey]; el.classList.remove('is-busy'); }

        function handleMerge(draggedEl, targetEl) {
            if (isPending(draggedEl) || isPending(targetEl)) return;

            var dragged = captureMergeDefinition(draggedEl);
            if (!dragged) return; // isMergeable() already guards this - defensive only

            var isExistingComposite = 'composite' === targetEl.dataset.blockName;
            var panes;
            if (isExistingComposite) {
                var existing = captureWidgetParams(targetEl).panes;
                panes = Array.isArray(existing) ? existing.slice() : [];
            } else {
                var target = captureMergeDefinition(targetEl);
                if (!target) return;
                panes = [target];
            }

            if (panes.length >= MAX_COMPOSITE_PANES) return; // already full - drop is simply a no-op, not an error
            panes.push(dragged);

            markPending(draggedEl);
            markPending(targetEl);

            // columns lets merge() clamp the composite's own summed size
            // (see DashboardWidgetController::merge()) to what the grid
            // can actually fit, same upper bound the resize handle itself
            // already respects (currentColumns(), defined below - a
            // function DECLARATION, hoisted, safe to call from here).
            var url = '{{ path("admin_dashboard_widget_merge") }}?panes=' + encodeURIComponent(JSON.stringify(panes)) + '&columns=' + currentColumns();

            fetch(url)
                .then(function (r) { if (!r.ok) throw new Error('merge failed: ' + r.status); return r.text(); })
                .then(function (html) {
                    targetEl.insertAdjacentHTML('beforebegin', html);
                    targetEl.remove();
                    draggedEl.remove();
                    // Same reasoning as the palette's own insert flow just
                    // below: a plain DOM insertion never triggers either of
                    // admin-charts.js's own init paths.
                    if (window.AdminCharts && window.AdminCharts.init) window.AdminCharts.init();
                    refreshTitleEditability();
                })
                .catch(function () {
                    // Leave both cards exactly as they were - clearing
                    // pending below (via finally) is what lets a retry work.
                })
                .finally(function () {
                    clearPending(draggedEl);
                    clearPending(targetEl);
                });
        }

        // Split a composite back into its standalone panes - the inverse
        // of handleMerge(). Sends the composite's OWN panes list as-is;
        // the server renders each one as its own fresh widget fragment
        // (possibly several sibling elements in one response) and this
        // swaps them in for the composite node.
        document.addEventListener('click', function (e) {
            var button = e.target.closest('[data-split-item]');
            if (!button || !body.classList.contains('is-customizing')) return;
            var item = button.closest('[data-sortable-item]');
            if (!item || isPending(item)) return;

            var panes = captureWidgetParams(item).panes;
            if (!Array.isArray(panes) || !panes.length) return;

            markPending(item);
            button.disabled = true;

            var url = '{{ path("admin_dashboard_widget_split") }}?panes=' + encodeURIComponent(JSON.stringify(panes));
            fetch(url)
                .then(function (r) { if (!r.ok) throw new Error('split failed: ' + r.status); return r.text(); })
                .then(function (html) {
                    item.insertAdjacentHTML('beforebegin', html);
                    item.remove();
                    if (window.AdminCharts && window.AdminCharts.init) window.AdminCharts.init();
                    refreshTitleEditability();
                })
                .catch(function () {
                    button.disabled = false;
                })
                .finally(function () {
                    clearPending(item);
                });
        });

        // Delegated (not element-bound): the button node is replaced on
        // every SPA swap, a direct listener died with the first navigation.
        document.addEventListener('click', function (e) {
            if (!e.target.closest('#admin-customize-toggle')) return;
            setCustomizing(!body.classList.contains('is-customizing'));
        });

        // hide/show toggle - flips the class + icon only, batched to the
        // server on "Done" (SettingBag::set() invalidates the whole
        // compiled settings snapshot per call - one save, not one per click).
        document.addEventListener('click', function (e) {
            var toggle = e.target.closest('[data-toggle-hidden]');
            if (!toggle || !body.classList.contains('is-customizing')) return;
            var item = toggle.closest('[data-sortable-item]');
            if (!item) return;
            item.classList.toggle('is-hidden');
            var icon = toggle.querySelector('i');
            if (icon) icon.classList.toggle('fa-eye-slash', item.classList.contains('is-hidden'));
            if (icon) icon.classList.toggle('fa-eye', !item.classList.contains('is-hidden'));
        });

        // Card-background toggle - same shape/batching as hide/show above
        // (see MenuItem::$background's own docblock: generic, works for
        // ANY widget type, not just "Generic"/Bienvenue). .no-card-bg
        // strips the chrome via CSS below; captureLevel() reads it back
        // the same way it already reads .is-hidden.
        document.addEventListener('click', function (e) {
            var toggle = e.target.closest('[data-toggle-background]');
            if (!toggle || !body.classList.contains('is-customizing')) return;
            var item = toggle.closest('[data-sortable-item]');
            if (!item) return;
            item.classList.toggle('no-card-bg');
            toggle.classList.toggle('is-active', item.classList.contains('no-card-bg'));
        });

        // Remove - every widget now, code-defined or ad-hoc alike (see
        // LayoutConfig's own 'deleted' flag). Marks the node rather than
        // actually removing it from the DOM: captureLevel() below just
        // walks whatever [data-sortable-item]s are still direct children
        // of its container, so a node that's still there (just hidden via
        // .is-deleted, and carrying data-deleted for captureLevel() to
        // read) gets swept up into the save payload exactly like any
        // other entry - no separate "remember what got deleted"
        // bookkeeping needed. No confirmation dialog: nothing is actually
        // persisted until "Terminé", the same safety net every other
        // customize-mode edit already relies on.
        document.addEventListener('click', function (e) {
            var button = e.target.closest('[data-remove-item]');
            if (!button || !body.classList.contains('is-customizing')) return;
            var item = button.closest('[data-sortable-item]');
            if (!item) return;
            item.classList.add('is-deleted');
            item.dataset.deleted = '1';
        });

        // resize drag, with an explicit live preview: dragging the corner
        // does NOT touch the real widget/grid at all while the pointer is
        // down - it moves/resizes a separate dashed-outline ghost (fixed-
        // positioned off getBoundingClientRect(), so it's immune to any
        // ancestor's overflow/clipping and never fights the grid's own
        // reflow) with a size badge. Width snaps to whichever grid-column
        // count the pointer is currently over (like before); height is
        // free-form pixels, not quantized to anything - there's no "row
        // grid" to snap to the way there's a column count. Both the real
        // inline grid-column AND min-height styles - and the real reflow -
        // only ever get applied once, on release, to whatever the ghost
        // was last showing.
        var resizing = null;
        // Below this, a card reads as broken (controls overlapping
        // content) rather than just small - same floor
        // LayoutConfig/MenuItem enforce server-side, kept in sync here so
        // the live ghost preview never promises a height the save would
        // silently clamp away from.
        var MIN_WIDGET_HEIGHT = 80;
        // Small vertical movement shouldn't retroactively pin a card's
        // height to "whatever it happened to be" just because someone
        // grabbed the corner to resize its WIDTH only - a purely
        // horizontal drag must leave height exactly as auto/flex-driven
        // as it always was. Only once the pointer has genuinely moved
        // vertically past this does a resize start touching height at all
        // (same dragThreshold-style guard sticky-sortable.js already uses
        // for "is this a drag or just a click").
        var HEIGHT_TOUCH_THRESHOLD = 4;
        // How close (in px) a drag needs to land to this card's own
        // natural content height before it snaps straight to it - see
        // the pointermove handler's own comment on why this is the real
        // "magnetized" behavior, not the HEIGHT_KEY_STEP grid alone.
        // Wide enough to actually catch a real drag (a mouse rarely stops
        // on the exact pixel), narrow enough that it only fires near a
        // genuine "this fits" point rather than swallowing the whole
        // usable drag range.
        var HEIGHT_MAGNET_RADIUS = 24;

        // .widget-block's own min-height is NOT enough on its own: the
        // wrapper is a CSS Grid item stretched to its row's auto-sized
        // height (see .widget-block's own comment above), and the actual
        // visible box is a FLEX CHILD of it (.analytics-card/.card, flex:1
        // 1 auto) - growing the wrapper's min-height only grows the
        // wrapper if the row was already going to be at least that tall
        // for some other reason (a taller sibling), which is not the
        // common case for a lone/tallest card in its row. --widget-height
        // (read by the child's own min-height rule, see the .widget-block
        // > .analytics-card/.card CSS above) mirrors the same floor onto
        // the element you can actually see, independent of the wrapper's
        // own stretch behavior - same custom property _block.html.twig
        // sets server-side for a previously-saved height, so a fresh page
        // load and a live drag both go through the one mechanism.
        function applyWidgetHeight(item, height) {
            item.style.minHeight = height + 'px';
            item.style.setProperty('--widget-height', height + 'px');
            item.dataset.widgetHeight = height;
        }

        // The dashboard's own configured column count (see
        // dashboard.html.twig's data-widget-columns) - the resize
        // control's own upper bound, so "size" can never exceed however
        // many columns actually exist right now. Falls back to 5 (the
        // same default LayoutConfig itself uses) if the grid isn't found
        // for some reason, never to the old hardcoded 3.
        function currentColumns() {
            var grid = document.querySelector('[data-sortable="dashboard"]');
            var n = grid ? parseInt(grid.dataset.widgetColumns, 10) : NaN;
            return n && n > 0 ? n : 5;
        }

        function paintResizeGhost(ghost, badge, rect, columnWidth, size, height) {
            ghost.style.left = rect.left + 'px';
            ghost.style.top = rect.top + 'px';
            ghost.style.width = (columnWidth * size) + 'px';
            ghost.style.height = height + 'px';
            badge.textContent = size + ' / ' + currentColumns() + ' · ' + Math.round(height) + 'px';
        }

        document.addEventListener('pointerdown', function (e) {
            var handle = e.target.closest('[data-resize-handle]');
            if (!handle || !body.classList.contains('is-customizing')) return;
            var item = handle.closest('[data-sortable-item]');
            if (!item) return;

            // A previous drag's pointerup/pointercancel can be lost entirely
            // in ways this page has no way to observe (the window losing
            // focus mid-drag, a trackpad gesture producing an inconsistent
            // event sequence, etc.) - leaving its ghost permanently stuck,
            // fixed-positioned on top of everything. Starting a new resize
            // is the next guaranteed opportunity to notice and clean that up.
            if (resizing) commitResize();

            e.preventDefault();
            handle.setPointerCapture(e.pointerId);
            handle.classList.add('is-resizing');

            var startSize = parseInt(item.dataset.widgetSize || '1', 10);
            var rect = item.getBoundingClientRect();
            // The widget's OWN current rendered width divided by how many
            // columns it currently spans, rather than parsing the grid's
            // computed gridTemplateColumns string - fewer ways for this to
            // silently come back wrong.
            var columnWidth = (rect.width / startSize) || 240;
            // Prefer the STORED height (if this card was already given an
            // explicit one) over the rendered rect - the rendered height
            // can be taller than what was actually set, stretched to match
            // a taller sibling in the same row (see .widget-block/.widget-
            // group's own flex-fill rules) - starting a new drag from that
            // inflated value would silently bake the stretch in as a new
            // explicit height the instant you touched the corner at all.
            var startHeight = parseInt(item.dataset.widgetHeight || '', 10) || rect.height;

            // This card's own TRUE content height, momentarily freed from
            // both its explicit --widget-height floor AND align-items:
            // stretch (which pulls a shorter card up to match a taller
            // sibling on the same line - see .widget-block/.widget-group's
            // own comment) - a snap target real "this now fits" magnetism
            // needs, not just a blind pixel grid. Measured synchronously
            // before any paint (set styles, read scrollHeight, restore),
            // so there's no visible flicker.
            var prevAlignSelf = item.style.alignSelf;
            var prevMinHeight = item.style.minHeight;
            var prevVarHeight = item.style.getPropertyValue('--widget-height');
            item.style.alignSelf = 'flex-start';
            item.style.minHeight = '0';
            item.style.removeProperty('--widget-height');
            var naturalHeight = item.scrollHeight;
            item.style.alignSelf = prevAlignSelf;
            item.style.minHeight = prevMinHeight;
            if (prevVarHeight) item.style.setProperty('--widget-height', prevVarHeight);

            var ghost = document.createElement('div');
            ghost.className = 'admin-resize-ghost';
            var badge = document.createElement('span');
            badge.className = 'admin-resize-ghost-badge';
            ghost.appendChild(badge);
            document.body.appendChild(ghost);
            paintResizeGhost(ghost, badge, rect, columnWidth, startSize, startHeight);

            resizing = {
                item: item, handle: handle, ghost: ghost, badge: badge, rect: rect,
                pointerId: e.pointerId, startX: e.clientX, startY: e.clientY,
                startSize: startSize, startHeight: startHeight, columnWidth: columnWidth,
                naturalHeight: naturalHeight,
                target: startSize, targetHeight: startHeight, heightTouched: false,
            };
        });

        document.addEventListener('pointermove', function (e) {
            if (!resizing || e.pointerId !== resizing.pointerId) return;
            var deltaColumns = Math.round((e.clientX - resizing.startX) / resizing.columnWidth);
            var next = Math.max(1, Math.min(currentColumns(), resizing.startSize + deltaColumns));

            var deltaY = e.clientY - resizing.startY;
            if (Math.abs(deltaY) > HEIGHT_TOUCH_THRESHOLD) resizing.heightTouched = true;
            var rawHeight = Math.max(MIN_WIDGET_HEIGHT, resizing.startHeight + deltaY);
            // Real magnetism, not just a blind pixel grid: within
            // HEIGHT_MAGNET_RADIUS of this card's OWN natural/unstretched
            // content height (measured once at pointerdown - see its own
            // comment), the drag PULLS straight to that exact value - "let
            // go of the corner and it clicks into a height that actually
            // fits the content" is what "magnetized" needs to mean here,
            // a fixed-size grid alone can't promise that since natural
            // content height is essentially never a clean round number.
            // Falls back to the HEIGHT_KEY_STEP grid (same one the
            // keyboard fallback already moves in) everywhere else, so a
            // deliberately-taller-than-content resize still lands on a
            // clean, comparable-across-cards value instead of an
            // arbitrary one.
            var nextHeight = Math.abs(rawHeight - resizing.naturalHeight) <= HEIGHT_MAGNET_RADIUS
                ? resizing.naturalHeight
                : Math.round(rawHeight / HEIGHT_KEY_STEP) * HEIGHT_KEY_STEP;

            if (next !== resizing.target || nextHeight !== resizing.targetHeight) {
                resizing.target = next;
                resizing.targetHeight = nextHeight;
                paintResizeGhost(resizing.ghost, resizing.badge, resizing.rect, resizing.columnWidth, next, nextHeight);
            }
        });

        function commitResize() {
            if (!resizing) return;
            resizing.ghost.remove();
            resizing.handle.classList.remove('is-resizing');
            // Pointer capture can already be invalid by the time this runs
            // (that's exactly the kind of lost/out-of-order event this
            // function exists to recover from) - releasing it is a courtesy,
            // never a precondition for cleaning up the ghost/committing.
            try { resizing.handle.releasePointerCapture(resizing.pointerId); } catch (err) {}
            var item = resizing.item;
            var next = resizing.target;
            if (parseInt(item.dataset.widgetSize, 10) !== next) {
                item.style.setProperty('--widget-span', next);
                item.dataset.widgetSize = next;
            }
            if (resizing.heightTouched) {
                applyWidgetHeight(item, resizing.targetHeight);
            }
            resizing = null;
        }

        // Deliberately NOT gated on e.pointerId matching resizing.pointerId:
        // only one resize is ever in flight at a time (one ghost, one
        // handle with capture), so there's nothing genuinely ambiguous to
        // disambiguate - and requiring an exact match is that much more
        // surface for a lost/mismatched event to leave the ghost stuck
        // forever, which is exactly the failure this whole function exists
        // to prevent.
        document.addEventListener('pointerup', function () { commitResize(); });
        document.addEventListener('pointercancel', function () { commitResize(); });
        // Last-resort safety nets: the window losing focus or the tab being
        // hidden mid-drag (alt-tab, switching apps, a trackpad gesture that
        // hands control to the OS) can lose the pointerup/pointercancel
        // event entirely - these fire regardless and guarantee the ghost
        // never survives past the interaction that created it.
        window.addEventListener('blur', function () { commitResize(); });
        document.addEventListener('visibilitychange', function () {
            if (document.hidden) commitResize();
        });

        // Keyboard fallback: focus the handle (it's a real button, tab-
        // reachable) - ArrowLeft/ArrowRight cycles width by one column,
        // ArrowUp/ArrowDown adjusts height by a fixed step. Same parity
        // with a pointer drag as StickySortable's own arrow-key fallback
        // gives its drag handles. Unlike a pointer drag's small-movement
        // guard, a keyboard press is already a discrete, deliberate action
        // - no threshold needed before it commits an explicit height.
        var HEIGHT_KEY_STEP = 20;
        document.addEventListener('keydown', function (e) {
            var isWidthKey = 'ArrowLeft' === e.key || 'ArrowRight' === e.key;
            var isHeightKey = 'ArrowUp' === e.key || 'ArrowDown' === e.key;
            if (!isWidthKey && !isHeightKey) return;
            var handle = e.target.closest && e.target.closest('[data-resize-handle]');
            if (!handle) return;
            var item = handle.closest('[data-sortable-item]');
            if (!item) return;
            e.preventDefault();

            if (isWidthKey) {
                var current = parseInt(item.dataset.widgetSize || '1', 10);
                var next = Math.max(1, Math.min(currentColumns(), current + (e.key === 'ArrowRight' ? 1 : -1)));
                if (next !== current) {
                    item.style.setProperty('--widget-span', next);
                    item.dataset.widgetSize = next;
                }
                return;
            }

            var currentHeight = parseInt(item.dataset.widgetHeight || '', 10) || item.getBoundingClientRect().height;
            var nextHeight = Math.max(MIN_WIDGET_HEIGHT, Math.round(currentHeight + HEIGHT_KEY_STEP * (e.key === 'ArrowDown' ? 1 : -1)));
            if (nextHeight !== currentHeight) {
                applyWidgetHeight(item, nextHeight);
            }
        });

        // Analytics card range picker: re-fetches analytics_daily_breakdown()
        // for the clicked range and hands the JSON straight to admin-charts.js's
        // update() - see AnalyticsController::breakdown(). The stat row above
        // the picker is deliberately left untouched (see the template comment
        // by the picker's markup): only the chart re-renders.
        //
        // The endpoint always returns all 5 datasets, each tagged with its
        // source `key`. All 5 always get handed to admin-charts.js too
        // (never filtered down to a subset - see analytics_card.html.twig's
        // own comment on why an OMITTED dataset would have no legend entry
        // to click back on) - what the picker DOES preserve across the
        // swap is each series' CURRENT hidden/shown state (read straight
        // off the live Chart.js instance's per-dataset meta), so a range
        // change never re-shows a series the admin hid via the legend.
        //
        // requestId guards against out-of-order responses: two ranges fetched
        // in quick succession aren't guaranteed to RESOLVE in click order (the
        // earlier click's response can land after the later one's), which
        // would otherwise leave the chart showing stale data under a pill
        // that says something else. Only the response matching the picker's
        // latest click is ever applied.
        // Rebuilds each [data-stat]'s value + change badge from scratch
        // (innerHTML, not a text-node tweak) - mirrors analytics_card.
        // html.twig's own conditional markup exactly (no badge at all when
        // change[key] is null, e.g. a prior period with zero traffic to
        // compare against) rather than leaving a stale badge from whatever
        // range was showing before.
        // Tweens a stat's leading number from whatever it currently reads
        // to `target` instead of snapping straight there - both the range
        // picker (a whole new period's totals) and the chart legend
        // (hiding/showing a series changes what's summed into the same
        // stat) land here now, so "the numbers never actually move" reads
        // as one consistent animation either way rather than an instant
        // swap on one path and nothing at all on the other.
        // data-raw-value (not textContent) is the tween's source of truth:
        // mid-animation textContent is itself a rounded in-between value,
        // re-reading THAT as the next start point would drift/stutter on
        // rapid repeated toggles.
        function animateStatNumber(numberEl, target) {
            target = Math.round(target);
            var start = parseInt(numberEl.dataset.rawValue, 10);
            if (isNaN(start)) start = parseInt(numberEl.textContent, 10) || 0;
            numberEl.dataset.rawValue = target;
            if (numberEl._statAnimFrame) cancelAnimationFrame(numberEl._statAnimFrame);
            if (start === target) return;
            var duration = 450;
            var startTime = null;
            function step(ts) {
                if (startTime === null) startTime = ts;
                var progress = Math.min(1, (ts - startTime) / duration);
                var eased = 1 - Math.pow(1 - progress, 3);
                numberEl.textContent = Math.round(start + (target - start) * eased);
                if (progress < 1) {
                    numberEl._statAnimFrame = requestAnimationFrame(step);
                } else {
                    numberEl._statAnimFrame = null;
                }
            }
            numberEl._statAnimFrame = requestAnimationFrame(step);
        }

        function updateStatRow(card, totals, change) {
            if (!totals || !change) return;
            var row = card.querySelector('.analytics-stat-row');
            if (!row) return;
            Object.keys(totals).forEach(function (key) {
                var stat = row.querySelector('[data-stat="' + key + '"]');
                if (!stat) return;
                var number = stat.querySelector('.analytics-stat-number');
                if (number) animateStatNumber(number, totals[key]);
                var valueEl = stat.querySelector('.analytics-stat-value');
                var existingChange = valueEl && valueEl.querySelector('.analytics-stat-change');
                var pct = change[key];
                if (pct !== null && pct !== undefined) {
                    var cls = pct >= 0 ? 'is-up' : 'is-down';
                    var html = (pct >= 0 ? '+' : '') + pct + '%';
                    if (!existingChange) {
                        existingChange = document.createElement('span');
                        valueEl.appendChild(existingChange);
                    }
                    existingChange.className = 'analytics-stat-change ' + cls;
                    existingChange.textContent = html;
                } else if (existingChange) {
                    existingChange.remove();
                }
            });
        }

        // Same idea as updateStatRow above, but sourced from the chart's
        // OWN currently-plotted data (chart.data.datasets[i].data, summed)
        // rather than a fresh server payload - a legend click has no
        // request/response round trip to hang a totals/change object off
        // of, it's a pure client-side visibility flip, so the stat row has
        // to derive its own numbers from exactly what's now visible.
        // pageViews has no single matching dataset key (it's Human+Bot+AI
        // combined, see AnalyticsSeriesPalette) - every other stat key IS
        // one dataset's own key 1:1, hence the two branches below.
        // period-over-period % is left untouched here: that comparison is
        // only meaningful against a matching PRIOR-period series-filtered
        // sum this client-side data doesn't have, not something to fake.
        function recomputeStatsFromChart(card, chart) {
            var row = card.querySelector('.analytics-stat-row');
            if (!row) return;
            var sums = { pageViews: 0, uniqueVisitors: 0, uniqueUsers: 0 };
            var pageViewKeys = { pageViewsHuman: true, pageViewsBot: true, pageViewsAi: true };
            chart.data.datasets.forEach(function (ds, i) {
                if (chart.getDatasetMeta(i).hidden) return;
                var total = (ds.data || []).reduce(function (a, b) { return a + (Number(b) || 0); }, 0);
                if (pageViewKeys[ds.key]) sums.pageViews += total;
                else if (ds.key === 'uniqueVisitors' || ds.key === 'uniqueUsers') sums[ds.key] = total;
            });
            Object.keys(sums).forEach(function (key) {
                var number = row.querySelector('[data-stat="' + key + '"] .analytics-stat-number');
                if (number) animateStatNumber(number, sums[key]);
            });
        }

        // ---- pinning a single day -----------------------------------
        //
        // Clicking a point pins that day: a vertical rule marks it and the
        // stat row switches from "total over the range" to "that day".
        // Clicking it again (or the chip's ×, or Escape) unpins and the row
        // goes back to the range totals.
        //
        // The % badges are HIDDEN while a day is pinned rather than
        // recomputed day-over-day. They mean period-over-period, and this
        // client-side data has no matching prior day to compare a pinned
        // day against - same reason recomputeStatsFromChart() above leaves
        // them alone instead of faking a number in the same badge style.

        // Same key mapping as recomputeStatsFromChart(), one index instead
        // of the whole series - pageViews is Human+Bot+AI combined, every
        // other stat is one dataset 1:1.
        function statsAtIndex(chart, index) {
            var sums = { pageViews: 0, uniqueVisitors: 0, uniqueUsers: 0 };
            var pageViewKeys = { pageViewsHuman: true, pageViewsBot: true, pageViewsAi: true };
            chart.data.datasets.forEach(function (ds, i) {
                if (chart.getDatasetMeta(i).hidden) return;
                var value = Number((ds.data || [])[index]) || 0;
                if (pageViewKeys[ds.key]) sums.pageViews += value;
                else if (ds.key === 'uniqueVisitors' || ds.key === 'uniqueUsers') sums[ds.key] = value;
            });
            return sums;
        }

        function applyStats(card, sums) {
            var row = card.querySelector('.analytics-stat-row');
            if (!row) return;
            Object.keys(sums).forEach(function (key) {
                var number = row.querySelector('[data-stat="' + key + '"] .analytics-stat-number');
                if (number) animateStatNumber(number, sums[key]);
            });
        }

        function placeDaymark(card, chart, index) {
            var wrap = chart.canvas.closest('.analytics-chart-wrap');
            var scale = chart.scales && chart.scales.x;
            if (!wrap || !scale) return;

            var mark = wrap.querySelector('.analytics-daymark');
            if (!mark) {
                mark = document.createElement('div');
                mark.className = 'analytics-daymark';
                wrap.appendChild(mark);
            }
            // Positioned against the WRAP, so the canvas's own offset inside
            // it has to be added - they are not always flush (the canvas is
            // sized by Chart.js, the wrap by CSS).
            mark.style.left = (chart.canvas.offsetLeft + scale.getPixelForValue(index)) + 'px';
            mark.style.top = (chart.canvas.offsetTop + chart.chartArea.top) + 'px';
            mark.style.height = (chart.chartArea.bottom - chart.chartArea.top) + 'px';
        }

        function pinDay(card, chart, index) {
            card._pinnedDay = index;
            card.classList.add('is-day-pinned');
            placeDaymark(card, chart, index);
            applyStats(card, statsAtIndex(chart, index));

            var header = card.querySelector('.analytics-card-header');
            var chip = card.querySelector('.analytics-day-chip');
            if (header && !chip) {
                chip = document.createElement('span');
                chip.className = 'analytics-day-chip';
                header.appendChild(chip);
            }
            if (chip) {
                chip.innerHTML = '';
                chip.appendChild(document.createTextNode(chart.data.labels[index] || ''));
                var close = document.createElement('button');
                close.type = 'button';
                close.setAttribute('aria-label', 'Reset');
                close.textContent = '×';
                chip.appendChild(close);
            }
        }

        function unpinDay(card) {
            var canvas = card.querySelector('[data-admin-chart]');
            var chart = canvas && canvas._adminChart;
            card._pinnedDay = null;
            card.classList.remove('is-day-pinned');

            var mark = card.querySelector('.analytics-daymark');
            if (mark) mark.remove();
            var chip = card.querySelector('.analytics-day-chip');
            if (chip) chip.remove();

            // Back to the totals for the whole range - and recomputed from
            // the chart rather than restored from a snapshot, so a legend
            // series toggled while a day was pinned is still respected.
            if (chart) recomputeStatsFromChart(card, chart);
        }

        document.addEventListener('click', function (e) {
            var card = e.target.closest('[data-analytics-card]');
            if (!card) return;

            if (e.target.closest('.analytics-day-chip button')) {
                unpinDay(card);
                return;
            }

            var canvas = e.target.closest('[data-admin-chart]');
            var chart = canvas && canvas._adminChart;
            if (!chart) return;

            // intersect:false so anywhere in the day's column works - having
            // to hit the 3px point itself would make this feel broken.
            var points = chart.getElementsAtEventForMode(e, 'index', { intersect: false }, true);
            if (!points.length) return;

            var index = points[0].index;
            if (card._pinnedDay === index) unpinDay(card);
            else pinDay(card, chart, index);
        });

        document.addEventListener('keydown', function (e) {
            if ('Escape' !== e.key) return;
            document.querySelectorAll('.analytics-card.is-day-pinned').forEach(unpinDay);
        });

        // The marker is placed in pixels, so it has to follow a resize -
        // otherwise it drifts away from the day it marks.
        window.addEventListener('resize', function () {
            document.querySelectorAll('.analytics-card.is-day-pinned').forEach(function (card) {
                var canvas = card.querySelector('[data-admin-chart]');
                if (canvas && canvas._adminChart && null != card._pinnedDay) {
                    placeDaymark(card, canvas._adminChart, card._pinnedDay);
                }
            });
        });

        // ---- why did Enregistrer do nothing? -------------------------
        //
        // base-bundle's translatable-form handler ends its invalid-form
        // branch with `return false`, which jQuery turns into
        // preventDefault() AND stopPropagation(). So on an invalid form the
        // click dies there: no submit, no navigation, and nothing
        // downstream (transparentJS included) ever gets to say why. The
        // button just looks broken - reported live on /admin/settings,
        // where one empty required file input silently killed every click.
        //
        // That handler does try to point at the offender, but it looks for
        // it by locale-prefixed id inside the translation tabs, so a field
        // that isn't shaped that way - a file input, anything outside a
        // locale pane - never matches and the user is told nothing at all.
        //
        // CAPTURE phase, so this runs BEFORE the handler that stops the
        // event. Read-only: it reports, it never submits, so it cannot
        // double-fire a save.
        document.addEventListener('click', function (e) {
            var button = e.target.closest('button[type="submit"], input[type="submit"]');
            if (!button || button.classList.contains('skip-validation')) return;
            // While customizing, a click on an action button EDITS it (see
            // the action-row click handler further down, which
            // preventDefault()s it) - nothing is submitted, so nothing must
            // be marked busy. Without this the button kept a stale
            // .is-submitting that the next unrelated navigation would light
            // up as if a save were in flight.
            if (document.body.classList.contains('is-customizing')) return;

            var form = button.form || button.closest('form');
            if (!form) return;

            if (form.checkValidity()) {
                // Mark THIS button as the one submitting, so the busy state
                // (see .is-submitting) applies to it alone. html.loading is
                // set for any navigation, so styling every submit button off
                // that class made "Enregistrer" spin when the reader merely
                // clicked a link.
                button.classList.add('is-submitting');
                return;
            }

            var invalid = Array.prototype.find.call(form.elements, function (field) {
                return field.willValidate && !field.checkValidity();
            });
            if (!invalid) return;

            // A field inside a collapsed locale tab cannot be shown or
            // scrolled to - reveal its pane first, or the bubble would be
            // anchored to something invisible.
            var pane = invalid.closest('.tab-pane');
            if (pane && !pane.classList.contains('active')) {
                var tab = document.querySelector('[data-bs-target="#' + pane.id + '"], [href="#' + pane.id + '"]');
                if (tab) tab.click();
            }

            // Instant, not smooth: the native bubble anchors to wherever the
            // field is at the moment reportValidity() runs, so a scroll still
            // in flight leaves the message pinned to the top of the viewport,
            // pointing at nothing. Deterministic beats pretty here.
            if (invalid.scrollIntoView) invalid.scrollIntoView({block: 'center'});
            requestAnimationFrame(function () {
                if (invalid.reportValidity) invalid.reportValidity();
            });
        }, true);

        // Clear the marker the moment the navigation ends. Without this the
        // button keeps .is-submitting, and the NEXT unrelated navigation
        // (any link click sets html.loading) would light it up again as if it
        // were saving.
        new MutationObserver(function () {
            if (document.documentElement.classList.contains('loading')) return;
            document.querySelectorAll('.is-submitting').forEach(function (el) {
                el.classList.remove('is-submitting');
            });
        }).observe(document.documentElement, {attributes: true, attributeFilter: ['class']});
        document.addEventListener('click', function (e) {
            var btn = e.target.closest('[data-analytics-range-picker] [data-range]');
            if (!btn || btn.classList.contains('is-active')) return;
            var picker = btn.closest('[data-analytics-range-picker]');
            var endpoints = JSON.parse(picker.dataset.analyticsEndpoints || '{}');
            var url = endpoints[btn.dataset.range];
            var card = picker.closest('.analytics-card');
            var canvas = card && card.querySelector('[data-admin-chart]');
            if (!url || !canvas) return;

            // A pinned day is an INDEX into the current series; the new
            // range renumbers every index, so keeping the pin would silently
            // move the marker to a different date. Drop it.
            if (card.classList.contains('is-day-pinned')) unpinDay(card);

            picker.querySelectorAll('[data-range]').forEach(function (b) { b.classList.remove('is-active'); });
            btn.classList.add('is-active');
            picker.classList.add('is-loading');

            var requestId = (picker._analyticsRequestId = (picker._analyticsRequestId || 0) + 1);

            fetch(url, { headers: { Accept: 'application/json' } })
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    if (requestId !== picker._analyticsRequestId) return;
                    if (window.AdminCharts) {
                        var currentChart = canvas._adminChart;
                        var hiddenKeys = {};
                        if (currentChart) {
                            currentChart.data.datasets.forEach(function (ds, i) {
                                if (currentChart.getDatasetMeta(i).hidden) hiddenKeys[ds.key] = true;
                            });
                        }
                        var datasets = (data.datasets || []).map(function (ds) {
                            return Object.assign({}, ds, { hidden: !!hiddenKeys[ds.key] });
                        });
                        window.AdminCharts.update(canvas, { labels: data.labels, datasets: datasets, events: data.events });
                    }
                    updateStatRow(card, data.totals, data.change);
                    // "Depuis toujours" only covers days actually tracked, so
                    // it can show a SHORTER span than "30 jours" (which
                    // zero-fills days before tracking even began) - a title
                    // showing the real start date explains why, rather than
                    // making it look inconsistent or broken.
                    if (btn.dataset.range === 'all' && btn.dataset.sincePrefix && data.labels && data.labels.length) {
                        btn.title = btn.dataset.sincePrefix + ' ' + data.labels[0];
                    }
                    picker.classList.remove('is-loading');
                })
                .catch(function () {
                    if (requestId === picker._analyticsRequestId) picker.classList.remove('is-loading');
                });
        });

        // Analytics card editing is fully in-place now (no settings panel -
        // see analytics_card.html.twig's own comment on why): the title is
        // a contenteditable heading, and which series show is just the
        // chart's own legend. Both still land on the SAME widget-block
        // data-block-name/data-widget-label/data-widget-params attributes
        // captureLevel() already knows how to read (see LayoutArranger's
        // own docblock for how a code-defined widget's override applies in
        // place on "Done") - only WHEN they get written changed, not where.
        //
        // ensureCustomizableWidget() is the one-time "first edit" step
        // (was each apply handler's first few lines, inlined 3x - factored
        // out here since continuous inline edits need to call it on every
        // keystroke/click, not once on a batch Apply): if this widget-block
        // was never customized before (no data-block-name yet), seed its
        // data-widget-label/-params/-icon from data-merge-def (the one
        // existing source of "this instance's current definition" for any
        // widget with a blockName, code-defined or ad-hoc alike) before any
        // partial edit tries to merge into them.
        function ensureCustomizableWidget(widgetBlock) {
            if (widgetBlock.dataset.blockName) return;
            var def = JSON.parse(widgetBlock.dataset.mergeDef || '{}');
            widgetBlock.dataset.blockName = def.blockName || '';
            widgetBlock.dataset.widgetLabel = def.label || '';
            widgetBlock.dataset.widgetIcon = def.icon || '';
            // def.params is PHP's own MenuItem::getParams() round-tripped
            // through json_encode - an empty PHP array (no params ever
            // set, e.g. the built-in Trafic widget before its first edit)
            // encodes as JSON `[]`, not `{}` (PHP can't tell an empty LIST
            // from an empty MAP). `[] || {}` still picks `[]` (truthy), so
            // every later `params.series = ...`/`params.panes = ...` sets
            // a non-index property JSON.stringify silently drops off an
            // array - found live via the analytics settings panel's own
            // Apply losing its selection with no error anywhere. Explicit
            // Array.isArray check, not just truthiness, is what actually
            // guards against this.
            var params = def.params;
            widgetBlock.dataset.widgetParams = JSON.stringify((params && !Array.isArray(params)) ? params : {});
        }

        // Enter commits (blurs) instead of inserting a newline - this is a
        // single-line heading, not a text area. Covers the sidebar's own
        // brand title/slogan too (same in-place-edit pattern, see the blur
        // handler further below for how THEY persist).
        document.addEventListener('keydown', function (e) {
            if (e.key !== 'Enter') return;
            var title = e.target.closest('[data-analytics-title][contenteditable="true"], [data-brand-title][contenteditable="true"]');
            if (!title) return;
            e.preventDefault();
            title.blur();
        });

        // 'input' (not 'blur') so a title edit survives even if the user
        // never blurs it before clicking "Terminé" directly - contenteditable
        // fires 'input' on every keystroke, same event a real <input> would.
        document.addEventListener('input', function (e) {
            var title = e.target.closest('[data-analytics-title][contenteditable="true"]');
            if (!title || !document.body.classList.contains('is-customizing')) return;
            var widgetBlock = title.closest('[data-sortable-item]');
            if (!widgetBlock) return;
            ensureCustomizableWidget(widgetBlock);
            // A composite pane's OWN title (see composite.html.twig's
            // data-pane-index) doesn't belong on the outer composite's own
            // label - closest('[data-sortable-item]') always finds the
            // whole composite (no data-sortable-item on .composite-pane
            // itself), so writing widgetLabel here unconditionally was
            // silently editing the wrong thing for any pane title (found
            // live: "can't modify title" on a merged card). Routes into
            // params.panes[i].label instead, same
            // read/modify/JSON.stringify-back pattern the pane-ratio
            // divider handler below already uses for panes[i].size.
            var pane = title.closest('.composite-pane[data-pane-index]');
            if (pane) {
                var paneIndex = parseInt(pane.dataset.paneIndex, 10);
                var params = JSON.parse(widgetBlock.dataset.widgetParams || '{}');
                var panes = Array.isArray(params.panes) ? params.panes : [];
                if (panes[paneIndex]) {
                    panes[paneIndex] = Object.assign({}, panes[paneIndex], { label: title.textContent.trim() });
                    params.panes = panes;
                    widgetBlock.dataset.widgetParams = JSON.stringify(params);
                }
                return;
            }
            widgetBlock.dataset.widgetLabel = title.textContent.trim();
        });

        // "Generic" widget's own body text (see welcome.html.twig's own
        // comment on why this is a separate mechanism from the title one
        // above) - writes into params.text, not the label, and (unlike
        // the single-line title) deliberately allows Enter to insert a
        // real line break rather than committing/blurring - a free-form
        // text block reasonably wants more than one line.
        document.addEventListener('input', function (e) {
            var text = e.target.closest('[data-widget-text][contenteditable="true"]');
            if (!text || !document.body.classList.contains('is-customizing')) return;
            var widgetBlock = text.closest('[data-sortable-item]');
            if (!widgetBlock) return;
            ensureCustomizableWidget(widgetBlock);
            var params = JSON.parse(widgetBlock.dataset.widgetParams || '{}');
            params.text = text.textContent.trim();
            widgetBlock.dataset.widgetParams = JSON.stringify(params);
        });

        // Widget title/text: the 'input' handlers above only ever update
        // the local data-attribute, persisted later via "Terminé"/
        // admin_layout_save - a contenteditable field visually commits the
        // instant you type though, so leaving customize mode any other
        // way (closing the tab, navigating off, is-customizing simply
        // toggled off without the button) silently lost the edit,
        // reported live. This mirrors the brand-title blur handler right
        // below (same "commit immediately on blur" idea, same CSRF token)
        // but hits admin_layout_quick instead - a narrow, single-field
        // PATCH against the CURRENTLY PERSISTED layout (see
        // LayoutController::quickSave()'s own doc comment for why it's
        // scoped to just label/text and not position/size/etc, which keep
        // batching via "Terminé" exactly as before).
        var LAYOUT_QUICK_URL = '{{ path("admin_layout_quick", {scope: "dashboard"}) }}';
        document.addEventListener('blur', function (e) {
            var field = e.target.closest('[data-analytics-title][contenteditable="true"], [data-widget-text][contenteditable="true"]');
            if (!field || !getDoneBtn()) return;
            var widgetBlock = field.closest('[data-sortable-item]');
            if (!widgetBlock || !widgetBlock.dataset.sortableKey) return;

            var payload = { key: widgetBlock.dataset.sortableKey, value: field.textContent.trim() };
            var pane = field.closest('.composite-pane[data-pane-index]');
            if (pane) {
                payload.field = 'label';
                payload.paneIndex = parseInt(pane.dataset.paneIndex, 10);
            } else if (field.hasAttribute('data-widget-text')) {
                payload.field = 'text';
            } else {
                payload.field = 'label';
            }

            fetch(LAYOUT_QUICK_URL, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': layoutCsrfToken() },
                body: JSON.stringify(payload),
            }).catch(function () {});
        }, true);

        // Page title/description (non-dashboard pages: system pages' own
        // H1/subtitle, a CRUD index's H1) - persisted against the SIDEBAR
        // scope's menu item for this page (data-menu-key, resolved
        // server-side from the selected menu entry), which is exactly what
        // keeps the sidebar label "always in sync with the title": there
        // is only one stored value, the sidebar and the heading both
        // render it. The sidebar's visible label is also patched in place
        // immediately - no reload needed to see the sync happen.
        var SIDEBAR_QUICK_URL = '{{ path("admin_layout_quick", {scope: "sidebar"}) }}';
        // CRUD pages persist into their OWN scope, keyed by the CRUD slug -
        // they mostly have no sidebar menu item to hang a customization on
        // (see LayoutScope::CRUD). An element opts in with
        // data-layout-scope="crud"; everything else keeps posting to the
        // sidebar scope exactly as before.
        var CRUD_QUICK_URL = '{{ path("admin_layout_quick", {scope: "crud"}) }}';

        // Quick-saves run ONE AT A TIME. Each request is a read-modify-write
        // of the whole layout config server-side (quickSave loads it, patches
        // one field, saves it back), so two in flight together both read the
        // pre-edit state and the second one's save silently discards the
        // first's field. Reproduced: editing the title and description in the
        // same tick persisted only the description, losing the title with no
        // error anywhere. Tabbing straight from one to the other is exactly
        // that pattern, so this is a real loss, not a test artefact.
        // Chaining on a single promise keeps each request reading the state
        // the previous one wrote. Failures are swallowed deliberately - a
        // rejected link must not break the chain for later edits.
        var quickSaveChain = Promise.resolve();
        function queueQuickSave(url, payload) {
            quickSaveChain = quickSaveChain.then(function () {
                return fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': layoutCsrfToken() },
                    body: JSON.stringify(payload),
                }).catch(function () {});
            });
            return quickSaveChain;
        }
        document.addEventListener('blur', function (e) {
            var field = e.target.closest('[data-page-title][contenteditable="true"], [data-page-desc][contenteditable="true"]');
            if (!field) return;
            var key = field.dataset.menuKey;
            if (!key) return;
            var isTitle = field.hasAttribute('data-page-title');
            var value = field.textContent.trim();
            var isCrudScope = 'crud' === field.dataset.layoutScope;

            var payload = { key: key, field: isTitle ? 'label' : 'description', value: value };
            // The item's section (see groupIntoSections()) - quickSave's
            // upsert needs it to place a never-before-stored entry at the
            // right nesting level, not the top of the tree. Never sent for
            // the CRUD scope: that one is a flat list keyed by slug.
            if (!isCrudScope && field.dataset.menuParentKey) payload.parentKey = field.dataset.menuParentKey;

            queueQuickSave(isCrudScope ? CRUD_QUICK_URL : SIDEBAR_QUICK_URL, payload);

            // Sidebar-label sync only applies to the sidebar scope - a CRUD
            // slug is not a menu key, so this would silently match nothing
            // (or, worse, a same-named item) for the crud scope.
            if (!isCrudScope && isTitle && value) {
                var menuLabel = document.querySelector('.admin-menu [data-sortable-key="' + (window.CSS && CSS.escape ? CSS.escape(key) : key) + '"] .label-text');
                if (menuLabel) menuLabel.textContent = value;
            }
        }, true);

        // Enter commits the single-line page title, same as the widget/
        // brand titles above. The description stays multi-line-friendly
        // (same reasoning as data-widget-text).
        document.addEventListener('keydown', function (e) {
            if (e.key !== 'Enter') return;
            var title = e.target.closest('[data-page-title][contenteditable="true"]');
            if (!title) return;
            e.preventDefault();
            title.blur();
        });

        // Drag-to-reorder for a CRUD page's top-right action buttons.
        // Pointer events rather than HTML5 drag-and-drop: several of these
        // buttons are <a href> (and one is a <form>), which the native API
        // treats as link drags with their own ghost image and default
        // navigation. Only elements carrying data-action-key move; the
        // search box and filter button are untouched.
        (function () {
            var dragEl = null, row = null, startOrder = null, pendingBefore = null;
            // A press with no real movement is a CLICK, not a drag. Without
            // this the mouseup path treated every click as a drop with no
            // target and appended the button to the end of the row - which
            // both silently reordered it and swallowed the click, because
            // re-inserting the node mid-gesture stops the click firing at
            // all (observed: activating any action button did nothing).
            var startX = 0, moved = false;
            var DRAG_THRESHOLD = 4;

            function clearMarkers() {
                if (!row) return;
                row.querySelectorAll('.drop-before, .drop-after').forEach(function (n) {
                    n.classList.remove('drop-before', 'drop-after');
                });
            }

            function currentOrder(el) {
                return [].map.call(el.querySelectorAll('[data-action-key]'), function (n) {
                    return n.dataset.actionKey;
                });
            }

            function finish(persist) {
                if (!dragEl || !row) { dragEl = null; row = null; return; }
                dragEl.classList.remove('is-dragging');
                clearMarkers();

                // The actual move happens HERE, once, on release - and only
                // for a real drag.
                if (persist && moved) {
                    if (pendingBefore) row.insertBefore(dragEl, pendingBefore);
                    else row.appendChild(dragEl);
                }

                var order = currentOrder(row);
                if (persist && moved && startOrder && order.join() !== startOrder.join()) {
                    // Swallow the click that follows the drop - a reorder is
                    // not an activation of the button it landed on.
                    dragEl.dataset.justReordered = '1';
                    // Serialized like every other quick-save: quickSave is a
                    // read-modify-write of the whole layout config.
                    queueQuickSave(CRUD_QUICK_URL, { key: row.dataset.pageKey, field: 'actions', value: order });
                }

                dragEl = null; row = null; startOrder = null; pendingBefore = null; moved = false;
            }

            // Kill the browser's OWN link drag first. Most of these buttons
            // are <a href>, and pressing + moving on a link makes Chrome
            // start a native drag-and-drop: that cancels the pointer
            // sequence outright, so pointerup/mouseup never arrive and the
            // drop could never be committed or saved (verified - a control
            // drag over plain page text fired down/move/up/click normally,
            // the identical drag over an action button fired only down and
            // move). preventDefault on dragstart keeps the gesture ours.
            document.addEventListener('dragstart', function (e) {
                if (!document.body.classList.contains('is-customizing')) return;
                if (e.target.closest && e.target.closest('[data-action-row] [data-action-key]')) e.preventDefault();
            });

            document.addEventListener('pointerdown', function (e) {
                if (!document.body.classList.contains('is-customizing')) return;
                if (0 !== e.button) return;
                var handle = e.target.closest('[data-action-row] [data-action-key]');
                if (!handle || e.target.closest('.new-dropdown-menu')) return;
                dragEl = handle;
                row = handle.closest('[data-action-row]');
                startOrder = currentOrder(row);
                startX = e.clientX;
                moved = false;
            });

            // Compute the insertion point from sibling MIDPOINTS and show it
            // as a marker - the dragged node itself is deliberately NOT moved
            // until release. Moving it mid-drag re-inserts it in the DOM,
            // which drops the pointer-event stream (pointerup stopped firing
            // entirely, so the reorder applied visually but never saved).
            // Midpoints rather than elementFromPoint because the dragged
            // element still occupies its own slot under the cursor.
            document.addEventListener('pointermove', function (e) {
                if (!dragEl || !row) return;
                if (!moved) {
                    if (Math.abs(e.clientX - startX) < DRAG_THRESHOLD) return;
                    moved = true;
                    dragEl.classList.add('is-dragging');
                }
                // NO preventDefault() here: on a pointermove it makes Chrome
                // treat the gesture as browser-handled and fire pointercancel
                // instead of pointerup, so the drop never committed and the
                // save never fired (observed: zero pointerup/mouseup events
                // for a completed drag). Text selection is suppressed with
                // user-select in CSS instead.
                clearMarkers();

                pendingBefore = null;
                var siblings = [].filter.call(row.querySelectorAll('[data-action-key]'), function (n) {
                    return n !== dragEl;
                });
                for (var i = 0; i < siblings.length; i++) {
                    var r = siblings[i].getBoundingClientRect();
                    if (e.clientX < r.left + r.width / 2) { pendingBefore = siblings[i]; break; }
                }

                if (pendingBefore) pendingBefore.classList.add('drop-before');
                else if (siblings.length) siblings[siblings.length - 1].classList.add('drop-after');
            });

            // Both events, and on window: a pointerup that lands outside the
            // document (or is swallowed by a synthetic-input quirk) would
            // otherwise leave the row reordered but never persisted.
            window.addEventListener('pointerup', function () { finish(true); });
            window.addEventListener('mouseup', function () { finish(true); });
            document.addEventListener('pointercancel', function () { finish(false); });

            document.addEventListener('click', function (e) {
                var moved = e.target.closest('[data-action-row] [data-action-key]');
                if (!moved) return;

                if (moved.dataset.justReordered) {
                    delete moved.dataset.justReordered;
                    e.preventDefault();
                    e.stopPropagation();
                    return;
                }

                // While customizing, a click EDITS the button rather than
                // performing it - otherwise reaching for its icon navigates
                // away (or worse, submits the form the button belongs to).
                // preventDefault only: the icon-picker listener is on the
                // bubble phase and still needs to receive this click.
                if (document.body.classList.contains('is-customizing')) {
                    e.preventDefault();
                }
            }, true);
        })();


        // Page icon editor: the header's icon box IS the click target
        // (see system.html.twig's data-page-icon) - a small popover with
        // the Font Awesome class + live preview, persisted through the
        // same sidebar quickSave path as the title (field 'icon',
        // locale-agnostic server-side), and the sidebar item's own icon
        // patched in place immediately - same one-stored-value sync
        // contract as the title/description.
        var iconPopover = null;
        function closeIconPopover() {
            if (iconPopover) { iconPopover.remove(); iconPopover = null; }
        }

        function applyPageIcon(box, value) {
            // An ACTION icon lives on the CRUD page's own entry, as the icon of
            // the child keyed by the action name - the same children that carry
            // the button order. parentKey scopes the lookup to this page, since
            // action names ("new", "delete") repeat across every CRUD.
            if (box.dataset.actionKey) {
                queueQuickSave(CRUD_QUICK_URL, {
                    key: box.dataset.actionKey,
                    parentKey: box.dataset.actionPage,
                    field: 'icon',
                    value: value
                });
                box.dataset.pageIconValue = value;
                var actionIcon = box.querySelector('i');
                if (actionIcon) actionIcon.className = value || 'fa-solid fa-circle-question';
                return;
            }

            var payload = { key: box.dataset.menuKey, field: 'icon', value: value };
            if (box.dataset.menuParentKey) payload.parentKey = box.dataset.menuParentKey;
            queueQuickSave(SIDEBAR_QUICK_URL, payload);

            box.dataset.pageIconValue = value;
            var headerIcon = box.querySelector('i');
            if (headerIcon) headerIcon.className = value || 'fa-solid fa-circle-question';

            if (!value) return; // cleared = reset on next load; nothing sane to paint in the sidebar meanwhile
            var keyEsc = window.CSS && CSS.escape ? CSS.escape(box.dataset.menuKey) : box.dataset.menuKey;
            var link = document.querySelector('.admin-menu li[data-sortable-key="' + keyEsc + '"] > a');
            if (!link) return;
            var menuIcon = link.querySelector(':scope > i');
            if (!menuIcon) {
                menuIcon = document.createElement('i');
                link.insertBefore(menuIcon, link.firstChild);
            }
            menuIcon.className = value;
        }

        // Flash dismissal. Delegated + re-scanned on transparentJS swaps, since
        // a flash arrives with the swapped-in page rather than on a full load.
        // Errors are NOT auto-retired: a failure the operator blinked past is
        // worse than one they have to close.
        (function () {
            var AUTO_MS = 6000;

            function dismiss(flash) {
                if (!flash || flash.classList.contains('is-dismissing')) return;
                flash.classList.add('is-dismissing');
                setTimeout(function () {
                    var box = flash.parentNode;
                    flash.remove();
                    // Drop the empty container too - it is absolutely positioned
                    // over the page and would keep intercepting nothing forever.
                    if (box && box.classList.contains('flashes') && !box.children.length) box.remove();
                }, 260);
            }

            document.addEventListener('click', function (e) {
                var btn = e.target.closest('[data-flash-close]');
                if (btn) dismiss(btn.closest('.flash'));
            });

            function arm(root) {
                (root || document).querySelectorAll('.flash:not([data-armed])').forEach(function (flash) {
                    flash.setAttribute('data-armed', '');
                    if (flash.classList.contains('flash-danger') || flash.classList.contains('flash-error')) return;
                    setTimeout(function () { dismiss(flash); }, AUTO_MS);
                });
            }

            arm(document);
            document.addEventListener('DOMContentLoaded', function () { arm(document); });
            // transparentJS replaces the main region wholesale; catch flashes
            // that arrive with a swapped page.
            new MutationObserver(function (records) {
                for (var i = 0; i < records.length; i++) {
                    for (var j = 0; j < records[i].addedNodes.length; j++) {
                        var n = records[i].addedNodes[j];
                        if (n.nodeType !== 1) continue;
                        if (n.classList && n.classList.contains('flash')) arm(n.parentNode);
                        else if (n.querySelector && n.querySelector('.flash')) arm(n);
                    }
                }
            }).observe(document.body, { childList: true, subtree: true });
        })();

        // Click-to-confirm guard on select2's own "remove one" / "remove
        // all" controls: both fired with no confirmation at all, so one
        // misclick on a Tags/Authors/... chip (or the "clear all" circle)
        // silently dropped a selection with no way to tell it happened
        // besides noticing the chip is gone (reported live). Two DIFFERENT
        // event types need guarding, not one - select2's own source binds
        // "remove one" on 'click' (multiple.js) but "clear all" on
        // 'mousedown' (allowClear.js, so it fires before the field would
        // otherwise focus/open); a guard on 'click' alone would silently
        // never arm the clear-all circle at all. Both listen in the CAPTURE
        // phase directly on document, so they run BEFORE select2's own
        // bubble-phase delegated handler ever sees the event. First
        // press: block it (stopImmediatePropagation, so select2 never gets
        // it) and arm the button (.is-confirm-armed, see layout CSS).
        // Second press within ARM_MS on the SAME already-armed button: let
        // it through untouched - select2 removes it normally. Pressing
        // anywhere else, or letting the window lapse, disarms without
        // removing anything.
        if (!window.__adminSelect2ConfirmBound) {
        window.__adminSelect2ConfirmBound = true;
        var ARM_MS = 2500;
        function disarmSelect2Remove(btn) {
            delete btn.dataset.confirmArmed;
            btn.classList.remove('is-confirm-armed');
            if (btn._confirmTimer) { clearTimeout(btn._confirmTimer); btn._confirmTimer = null; }
            if (btn._confirmTitle !== undefined) { btn.title = btn._confirmTitle; btn._confirmTitle = undefined; }
        }
        function guardSelect2Remove(selector) {
            return function (e) {
                var btn = e.target.closest(selector);
                if (!btn) return;

                if (btn.dataset.confirmArmed) {
                    disarmSelect2Remove(btn);
                    return; // let it proceed - select2's own handler removes it
                }

                e.preventDefault();
                e.stopImmediatePropagation();

                btn.dataset.confirmArmed = '1';
                btn.classList.add('is-confirm-armed');
                btn._confirmTitle = btn.title;
                btn.title = '{{ 'action.confirm_again'|trans({}, 'admin')|e('js') }}';
                btn._confirmTimer = setTimeout(function () { disarmSelect2Remove(btn); }, ARM_MS);
            };
        }
        document.addEventListener('click', guardSelect2Remove('.select2-selection__choice__remove'), true);
        document.addEventListener('mousedown', guardSelect2Remove('.select2-selection__clear'), true);
        }

        // Accordion toggle for collection entries. data-bs-toggle="collapse" is
        // Bootstrap's contract and nothing here implements it, so the headers
        // were inert - the panels simply stayed open. Delegated, so entries
        // added by the collection's own "add" button work without rebinding.
        if (!window.__adminCollapseBound) {
        window.__adminCollapseBound = true;
        document.addEventListener('click', function (e) {
            var btn = e.target.closest('[data-bs-toggle="collapse"]');
            if (!btn) return;

            var sel = btn.getAttribute('data-bs-target') || btn.getAttribute('href');
            if (!sel) return;

            var panel;
            try { panel = document.querySelector(sel); } catch (err) { return; }
            if (!panel) return;

            e.preventDefault();
            var open = panel.classList.toggle('show');
            btn.classList.toggle('collapsed', !open);
            btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
        }

        // Hoist the page's action bar into the topbar. It lives inside
        // .admin-header in the templates (where each CRUD page renders it), but
        // there it shares a line with the record title and a long title pushed
        // it onto three rows. The topbar is full-width, already sticky, and has
        // room once the idle search shrinks - so the buttons get a dedicated
        // line at the very top. Moving the element itself (not a copy) keeps
        // form= associations, the customize drag/drop and the icon picker all
        // working untouched.
        (function () {
            if (window.__adminActionsHoisted) return;
            window.__adminActionsHoisted = true;

            function hoist() {
                var bar = document.querySelector('.admin-header .global-actions');
                var topbar = document.querySelector('.admin-topbar');
                if (!bar || !topbar) return;

                // Narrow viewports keep the bar in the header, where it may
                // wrap onto its own full-width line (see the max-width:720px
                // rules) - the topbar cannot fit search + actions + icons on
                // a phone, and unlike the header it is not allowed to wrap.
                if (window.innerWidth < 900) return;

                var icons = topbar.querySelector('.admin-topbar-icons');
                if (icons) topbar.insertBefore(bar, icons);
                else topbar.appendChild(bar);
            }

            function boot() {
                hoist();
                // transparentJS swaps the main region wholesale, which brings a
                // fresh .admin-header (and a fresh action bar) with it.
                new MutationObserver(function () { hoist(); })
                    .observe(document.body, { childList: true, subtree: true });
            }

            if ('loading' === document.readyState) document.addEventListener('DOMContentLoaded', boot);
            else boot();
        })();

        // Lazy-load the rest of a windowed collection.
        //
        // Entries past the cap are never built server-side (each one costs
        // ~3 queries), so this asks for the next slice and appends it. The
        // endpoint renders those entries through the same form, with the
        // collection windowed to the requested range - so their field names
        // carry their real indices and bind correctly on submit.
        if (!window.__adminCollectionMoreBound) {
        window.__adminCollectionMoreBound = true;
        document.addEventListener('click', function (e) {
            var btn = e.target.closest('[data-collection-more]');
            if (!btn || btn.disabled) return;
            e.preventDefault();

            var list = btn.parentNode.querySelector('.form-collection-items');
            if (!list) return;

            // The endpoint is derived, not injected: the button is rendered by
            // base-bundle's shared form theme, which has no business knowing an
            // admin route. The edit URL already identifies the record, and the
            // collection's own DOM id carries the field name
            // ("crud_form_comments__collection" -> "comments").
            var field = (list.id || '').replace(/^.*?_/, '').replace(/__collection$/, '');
            var m = /^crud_form_(.+?)__collection$/.exec(list.id || '');
            if (m) field = m[1];
            if (!field) return;

            var url = location.pathname.replace(/\/edit\/?$/, '') + '/collection/' + field;

            var loaded = parseInt(btn.dataset.loaded, 10) || 0;
            var total = parseInt(btn.dataset.total, 10) || 0;
            var limit = parseInt(btn.dataset.limit, 10) || 10;

            btn.disabled = true;
            btn.classList.add('is-loading');

            fetch(url + (url.indexOf('?') > -1 ? '&' : '?') + 'offset=' + loaded + '&limit=' + limit,
                  { credentials: 'same-origin' })
                .then(function (r) { return r.ok ? r.text() : Promise.reject(r.status); })
                .then(function (html) {
                    list.insertAdjacentHTML('beforeend', html);

                    // Extend the rendered-set declaration with the indices this
                    // slice brought in - the server restores anything OUTSIDE
                    // the set on submit, so an unreported fetched entry would be
                    // "restored" over the operator's own edits/deletion of it.
                    var reg = btn.parentNode.querySelector('[data-collection-rendered]');
                    if (reg) {
                        var have = reg.value ? reg.value.split(',') : [];
                        var m2, rx = /\[_collection\]\[(\d+)\]/g;
                        while ((m2 = rx.exec(html))) {
                            if (have.indexOf(m2[1]) < 0) have.push(m2[1]);
                        }
                        reg.value = have.join(',');
                    }

                    loaded = Math.min(total, loaded + limit);
                    btn.dataset.loaded = String(loaded);

                    if (loaded >= total) {
                        btn.remove();
                        return;
                    }
                    var label = btn.querySelector('[data-collection-more-label]');
                    if (label) label.textContent = String(total - loaded);
                })
                .catch(function () {
                    // Leave the button usable: a failed fetch must not strand
                    // the operator with no way to retry.
                    btn.classList.add('has-error');
                })
                .finally(function () {
                    btn.disabled = false;
                    btn.classList.remove('is-loading');
                });
        });
        }

        var ICON_SEARCH_URL = '{{ path("admin_icon_search") }}';

        // Capture phase on purpose: an action button's click is swallowed
        // somewhere between the button and document before the bubble phase
        // (verified live - the click reaches document-capture with
        // defaultPrevented=true, then never arrives), so a bubble listener
        // could open the picker for a page heading but never for a button in
        // the action row. Capture sees it first either way.
        // Registered ONCE per document. transparentJS re-executes this inline
        // script on every page swap, so without the guard the handler stacks up:
        // the first copy opens the popover, the next one sees it already open,
        // decides the click landed outside it and closes it again - a click
        // that visibly did nothing. Synthetic clicks dispatched before any swap
        // worked, which is exactly what made this look like an event-plumbing
        // problem rather than a duplicate-listener one.
        if (!window.__adminIconPickerBound) {
        window.__adminIconPickerBound = true;
        document.addEventListener('click', function (e) {
            if (iconPopover && !iconPopover.contains(e.target)) closeIconPopover();
            var box = e.target.closest('[data-page-icon]');
            if (!box || !body.classList.contains('is-customizing')) return;

            var popover = document.createElement('div');
            popover.className = 'page-icon-popover';
            var header = document.createElement('div');
            header.className = 'page-icon-popover-header';
            var preview = document.createElement('span');
            preview.className = 'page-icon-preview';
            var previewIcon = document.createElement('i');
            previewIcon.className = box.dataset.pageIconValue || 'fa-solid fa-circle-question';
            preview.appendChild(previewIcon);
            var searchWrap = document.createElement('span');
            searchWrap.className = 'page-icon-search';
            var input = document.createElement('input');
            input.type = 'text';
            input.value = box.dataset.pageIconValue || '';
            input.placeholder = '{{ 'customize.icon_search'|trans({}, 'admin')|e('js') }}';
            input.setAttribute('aria-label', box.title || 'icon');
            var spinnerEl = document.createElement('i');
            spinnerEl.className = 'icon-search-spinner fa-solid fa-circle-notch fa-spin';
            var clearBtn = document.createElement('button');
            clearBtn.type = 'button';
            clearBtn.className = 'icon-search-clear';
            clearBtn.textContent = '✕';
            clearBtn.title = '{{ 'customize.icon_clear'|trans({}, 'admin')|e('js') }}';
            searchWrap.appendChild(input);
            searchWrap.appendChild(spinnerEl);
            searchWrap.appendChild(clearBtn);
            header.appendChild(preview);
            header.appendChild(searchWrap);
            var grid = document.createElement('div');
            grid.className = 'page-icon-grid';
            popover.appendChild(header);
            popover.appendChild(grid);

            // Show/hide THIS button on THIS page - only for an action box
            // (a page heading's own icon has nothing to hide). It lives in
            // the icon popover rather than as a second control in the row
            // itself: clicking a button while customizing is already the
            // "edit this button" gesture, and squeezing an eye toggle
            // beside every action would re-wrap the header row it is
            // supposed to be tidying. Persisted immediately, like the icon.
            if (box.dataset.actionKey && box.dataset.actionPage) {
                var visRow = document.createElement('button');
                visRow.type = 'button';
                visRow.className = 'page-icon-visibility';
                var syncVisRow = function () {
                    var hidden = '1' === box.dataset.actionHidden;
                    visRow.innerHTML = '';
                    var eye = document.createElement('i');
                    eye.className = hidden ? 'fa-solid fa-eye' : 'fa-solid fa-eye-slash';
                    visRow.appendChild(eye);
                    visRow.appendChild(document.createTextNode(' ' + (hidden
                        ? '{{ 'customize.show_action'|trans({}, 'admin')|e('js') }}'
                        : '{{ 'customize.hide_action'|trans({}, 'admin')|e('js') }}')));
                };
                syncVisRow();
                visRow.addEventListener('mousedown', function (ev) { ev.preventDefault(); });
                visRow.addEventListener('click', function () {
                    var nowHidden = '1' !== box.dataset.actionHidden;
                    box.dataset.actionHidden = nowHidden ? '1' : '0';
                    box.classList.toggle('is-hidden', nowHidden);
                    // The delete action's own box is a <form style="display:
                    // contents"> wrapping the button (it needs its own POST
                    // target - see crud/detail.html.twig). Such an element
                    // generates no box of its own, so the ghost's opacity/
                    // strike-through would land on nothing: mark the button
                    // inside it too, which is where the server renders the
                    // class on the next load anyway.
                    var inner = box.querySelector('.btn');
                    if (inner) inner.classList.toggle('is-hidden', nowHidden);
                    queueQuickSave(CRUD_QUICK_URL, {
                        key: box.dataset.actionKey,
                        parentKey: box.dataset.actionPage,
                        field: 'visible',
                        value: !nowHidden
                    });
                    closeIconPopover();
                });
                popover.appendChild(visRow);
            }
            function syncHasTerm() {
                popover.classList.toggle('has-term', '' !== input.value.trim());
            }
            syncHasTerm();

            var rect = box.getBoundingClientRect();
            popover.style.left = rect.left + 'px';
            popover.style.top = (rect.bottom + 6) + 'px';
            document.body.appendChild(popover);
            iconPopover = popover;
            input.focus();
            input.select();

            // Searchable grid, fed by admin_icon_search (base-bundle's own
            // cached FontAwesome metadata). The text input stays the
            // power-user path: any string still commits as a raw class via
            // Enter/blur, whether or not the search found it.
            var searchSeq = 0;
            function renderGrid(icons) {
                grid.textContent = '';
                icons.forEach(function (icon) {
                    var cell = document.createElement('button');
                    cell.type = 'button';
                    cell.className = 'page-icon-cell';
                    cell.title = icon.label;
                    var i = document.createElement('i');
                    i.className = icon.class;
                    cell.appendChild(i);
                    // mousedown preventDefault: keep focus in the input so
                    // its commit-on-blur below never fires for a grid pick.
                    cell.addEventListener('mousedown', function (ev) { ev.preventDefault(); });
                    cell.addEventListener('click', function () {
                        applyPageIcon(box, icon.class);
                        closeIconPopover();
                    });
                    grid.appendChild(cell);
                });
            }
            function search(term) {
                var seq = ++searchSeq;
                popover.classList.add('is-loading');
                fetch(ICON_SEARCH_URL + '?term=' + encodeURIComponent(term))
                    .then(function (r) { return r.ok ? r.json() : { icons: [] }; })
                    .then(function (data) {
                        if (seq !== searchSeq || iconPopover !== popover) return; // stale response / closed
                        renderGrid(data.icons || []);
                    })
                    .catch(function () {})
                    .finally(function () {
                        // only the LATEST request may clear the spinner - an
                        // older response finishing after a newer one started
                        // must not hide the newer one's own loading state.
                        if (seq === searchSeq) popover.classList.remove('is-loading');
                    });
            }
            // Seed with the current icon's own NAME (not the full class -
            // "fa-solid fa-key" as a term matches nothing, "key" matches
            // the whole family), or everything when unset.
            var seed = (box.dataset.pageIconValue || '').split(' ').pop().replace(/^fa-/, '');
            search(seed);

            var debounce = null;
            input.addEventListener('input', function () {
                previewIcon.className = input.value.trim() || 'fa-solid fa-circle-question';
                syncHasTerm();
                clearTimeout(debounce);
                debounce = setTimeout(function () {
                    // Same normalization as the seed: typing/pasting a full
                    // class should still find its family in the grid.
                    search(input.value.trim().split(' ').pop().replace(/^fa-/, ''));
                }, 250);
            });
            // ✕ empties the field and reruns the unfiltered search - it
            // does NOT commit anything (resetting the stored icon stays an
            // explicit clear-the-field-then-Enter action). mousedown
            // preventDefault keeps focus in the input so the blur-close
            // below never swallows the click.
            clearBtn.addEventListener('mousedown', function (ev) { ev.preventDefault(); });
            clearBtn.addEventListener('click', function () {
                input.value = '';
                previewIcon.className = box.dataset.pageIconValue || 'fa-solid fa-circle-question';
                syncHasTerm();
                clearTimeout(debounce);
                search('');
                input.focus();
            });
            input.addEventListener('keydown', function (ev) {
                if ('Enter' === ev.key) {
                    ev.preventDefault();
                    applyPageIcon(box, input.value.trim());
                    closeIconPopover();
                } else if ('Escape' === ev.key) {
                    closeIconPopover();
                }
            });
            // Blur/outside-click just CLOSES, it never commits - unlike the
            // titles' commit-on-blur contract, this input doubles as the
            // SEARCH field, and silently saving a half-typed search term
            // ("calendar") as a raw icon class would break the icon. The
            // explicit commit paths are Enter (raw class, power users) and
            // clicking a grid cell.
            // Ignore the focus churn of the very click that opened this. A
            // real mouse click focuses the button it landed on, so the input
            // blurs microseconds after being focused and the popover closed
            // itself ~10ms after opening - the picker looked like it never
            // opened at all. A synthetic click moves no focus, which is why it
            // appeared to work and sent this hunt after event plumbing.
            var blurArmed = false;
            setTimeout(function () { blurArmed = true; }, 200);
            input.addEventListener('blur', function () {
                if (!blurArmed) { input.focus(); return; }
                if (!iconPopover) return; // Escape already closed it
                closeIconPopover();
            });
        }, true);
        }

        // Brand title: same "commit immediately on blur" idea as the
        // widget-title/text handler just above, just against a plain
        // SettingBag path (admin_settings_quick) instead of one item
        // inside a LayoutConfig (admin_layout_quick) - the sidebar has no
        // per-item key/scope concept the way dashboard widgets do, so it
        // never shared that handler, only the pattern. Delegated on
        // 'blur' in the CAPTURE phase - unlike 'input'/'click', 'blur'
        // does not bubble, so a plain document-level listener would never
        // see it fire on a field nested this deep.
        document.addEventListener('blur', function (e) {
            var field = e.target.closest('[data-brand-title][contenteditable="true"]');
            if (!field) return;
            var path = 'base.settings.title';
            var value = field.textContent.trim();
            var account = document.querySelector('.admin-account[data-csrf-token]');
            if (!account) return;
            fetch('{{ path("admin_settings_quick") }}', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': account.dataset.csrfToken },
                body: JSON.stringify({ path: path, value: value }),
            }).catch(function () {});
        }, true);

        // The chart's own legend IS the series-visibility control now (see
        // admin-charts.js's legendOnClick - Chart.js already toggles a
        // series for free on legend click, this just also dispatches a DOM
        // event so the currently-visible set can be persisted here).
        // data-analytics-card scopes this to the site-wide traffic widget
        // specifically - article_views' own chart dispatches the exact
        // same generic event (admin-charts.js has no idea which widget
        // type is listening), but that widget hardcodes its 3 series
        // unconditionally and has no params.series concept to write one
        // into, so a legend click there stays a harmless temporary view
        // preference instead of attempting to persist something that
        // doesn't exist.
        document.addEventListener('admin-chart:legend-toggle', function (e) {
            var card = e.target.closest('[data-analytics-card]');
            var chart = e.target._adminChart;
            if (!card || !chart) return;

            // The stat row reacts to every legend click regardless of
            // customize mode - it's just reflecting what the chart itself
            // is now showing, same as hovering a point already does via
            // the tooltip. Persisting that choice for every OTHER admin
            // (below) stays gated to customize mode, same as any other
            // layout edit.
            //
            // While a day is pinned the row is showing THAT day, so it has
            // to be recomputed for the same day - recomputing the range
            // totals here would silently unpin the row while the marker
            // stayed on the chart, leaving the two contradicting each other.
            if (card.classList.contains('is-day-pinned') && null != card._pinnedDay) {
                applyStats(card, statsAtIndex(chart, card._pinnedDay));
                placeDaymark(card, chart, card._pinnedDay);
            } else {
                recomputeStatsFromChart(card, chart);
            }

            if (!document.body.classList.contains('is-customizing')) return;
            var widgetBlock = card.closest('[data-sortable-item]');
            if (!widgetBlock) return;

            ensureCustomizableWidget(widgetBlock);

            var visible = [];
            chart.data.datasets.forEach(function (ds, i) {
                if (!chart.getDatasetMeta(i).hidden) visible.push(ds.key);
            });
            // At least one series - an all-hidden chart is never a useful
            // saved state (Chart.js itself allows toggling every series
            // off at once, but that's not a state worth persisting).
            if (!visible.length) return;

            var params = JSON.parse(widgetBlock.dataset.widgetParams || '{}');
            params.series = visible;
            widgetBlock.dataset.widgetParams = JSON.stringify(params);
        });

        // Composite pane ratio (exactly-2-pane composites only, see
        // _block.html.twig's own comment on why) - a direct drag divider
        // between the two panes now, not a dropdown-plus-form: dragging IS
        // the control, no separate open/apply/cancel steps for something
        // this directly visual. Writes straight onto the widget-block's
        // own data-widget-params (composite is always adHoc, so this
        // round-trips through the existing save/load path with zero new
        // server plumbing - see DashboardWidgetController::merge() and
        // LayoutArranger's own docblock) and live-updates .composite-panes'
        // grid-template-columns during the drag itself - cheap enough
        // (one local grid re-layout) that it doesn't need the outer
        // widget-resize handle's separate fixed-position ghost preview.
        document.addEventListener('pointerdown', function (e) {
            var divider = e.target.closest('[data-composite-pane-divider]');
            if (!divider || !body.classList.contains('is-customizing')) return;
            var panesEl = divider.closest('[data-composite-panes]');
            var widgetBlock = divider.closest('[data-sortable-item]');
            if (!panesEl || !widgetBlock) return;
            e.preventDefault();
            divider.setPointerCapture(e.pointerId);
            divider.classList.add('is-dragging');

            var sizes = (divider.dataset.paneSizes || '1,1').split(',').map(function (n) { return parseInt(n, 10) || 1; });
            // MIN_PANE_SIZE(1)/MAX_PANE_SIZE(6), mirroring
            // DashboardWidgetController's own constants (no direct line to
            // import them from here). A FIXED reference span for the
            // delta-to-fr scaling below, NOT sizes[0]+sizes[1] - every
            // fresh composite starts both panes at size 1 (see
            // DashboardWidgetController::sanitizePaneDefinition()'s own
            // default), so scaling/clamping off the CURRENT total
            // collapsed to a single frozen value (1+1=2, so
            // max(1,2-6)=1 and min(6,2-1)=1 - the divider could never
            // move AT ALL, for every composite, from the moment it's
            // created). Found live via instrumented console logging:
            // pointerdown/pointermove/onMove/paint all fired correctly on
            // every real drag, paint() just always re-clamped straight
            // back to the same value - this was never an event-handling
            // bug, the clamp math itself was unsatisfiable.
            var MIN = 1, MAX = 6, SPAN = MIN + MAX;
            var rect = panesEl.getBoundingClientRect();
            var startX = e.clientX;
            var startLeft = sizes[0];
            var startRight = sizes[1];
            var pointerId = e.pointerId;

            function paint(left, right) {
                panesEl.style.gridTemplateColumns = left + 'fr 6px ' + right + 'fr';
                divider.dataset.paneSizes = left + ',' + right;
            }

            function onMove(ev) {
                if (ev.pointerId !== pointerId) return;
                // Both sides start from their OWN actual current size (no
                // jump the instant you touch the divider) and move in
                // lockstep, opposite directions, off the SAME fixed-SPAN
                // delta - independently clamped to [MIN, MAX] rather than
                // forced to keep summing to whatever they started at, so
                // one side can keep growing toward MAX even past the
                // point where the other has already hit MIN.
                var deltaFr = ((ev.clientX - startX) / rect.width) * SPAN;
                var left = Math.max(MIN, Math.min(MAX, Math.round(startLeft + deltaFr)));
                var right = Math.max(MIN, Math.min(MAX, Math.round(startRight - deltaFr)));
                paint(left, right);
            }

            function onUp(ev) {
                if (ev.pointerId !== pointerId) return;
                document.removeEventListener('pointermove', onMove);
                document.removeEventListener('pointerup', onUp);
                divider.classList.remove('is-dragging');
                try { divider.releasePointerCapture(pointerId); } catch (err) {}

                var finalSizes = (divider.dataset.paneSizes || '1,1').split(',').map(function (n) { return parseInt(n, 10) || 1; });
                ensureCustomizableWidget(widgetBlock);
                var params = JSON.parse(widgetBlock.dataset.widgetParams || '{}');
                var panes = Array.isArray(params.panes) ? params.panes : [];
                if (panes.length === 2) {
                    panes[0] = Object.assign({}, panes[0], { size: finalSizes[0] });
                    panes[1] = Object.assign({}, panes[1], { size: finalSizes[1] });
                    params.panes = panes;
                    widgetBlock.dataset.widgetParams = JSON.stringify(params);
                }
            }

            document.addEventListener('pointermove', onMove);
            document.addEventListener('pointerup', onUp);
        });
        // Keyboard fallback, same parity the outer widget-resize handle
        // already gives its own drag (see HEIGHT_KEY_STEP's own comment) -
        // a discrete, deliberate action, no drag-threshold guard needed.
        document.addEventListener('keydown', function (e) {
            if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
            var divider = e.target.closest && e.target.closest('[data-composite-pane-divider]');
            if (!divider) return;
            var panesEl = divider.closest('[data-composite-panes]');
            var widgetBlock = divider.closest('[data-sortable-item]');
            if (!panesEl || !widgetBlock) return;
            e.preventDefault();

            // Same fixed MIN/MAX clamp as the pointer-drag handler above
            // (see its own comment) - independently clamped sides, not
            // derived from the current sizes' own volatile sum.
            var sizes = (divider.dataset.paneSizes || '1,1').split(',').map(function (n) { return parseInt(n, 10) || 1; });
            var MIN = 1, MAX = 6;
            var step = e.key === 'ArrowRight' ? 1 : -1;
            var left = Math.max(MIN, Math.min(MAX, sizes[0] + step));
            var right = Math.max(MIN, Math.min(MAX, sizes[1] - step));

            panesEl.style.gridTemplateColumns = left + 'fr 6px ' + right + 'fr';
            divider.dataset.paneSizes = left + ',' + right;

            ensureCustomizableWidget(widgetBlock);
            var params = JSON.parse(widgetBlock.dataset.widgetParams || '{}');
            var panes = Array.isArray(params.panes) ? params.panes : [];
            if (panes.length === 2) {
                panes[0] = Object.assign({}, panes[0], { size: left });
                panes[1] = Object.assign({}, panes[1], { size: right });
                params.panes = panes;
                widgetBlock.dataset.widgetParams = JSON.stringify(params);
            }
        });

        // Entity-views widget settings panel (which entity, across ANY
        // pickable class - title edits in place on the heading itself,
        // see entity_views.html.twig's own comment) - Base\Admin\Widget\
        // EntityViewsWidgetType, generalized from the old Article-only
        // ArticleViewsWidgetType, reusing this same generic settings-panel
        // shell. Simpler than analytics_card's own: no live chart re-fetch
        // here (no per-entity breakdown endpoint exists yet) - applying
        // just relies on "Done" to reload+re-render the chart itself with
        // the new selection, same as any other customize-mode edit that
        // doesn't have its own live preview.
        //
        // The class select's own 'change' populates the entity select's
        // options from data-instances-by-class (embedded server-side JSON,
        // see the template's own comment) - client-side, no AJAX round
        // trip, matching this widget's existing "no live chart" simplicity.
        document.addEventListener('change', function (e) {
            var classSelect = e.target.closest('[data-entity-views-settings-class]');
            if (!classSelect) return;
            var panel = classSelect.closest('[data-entity-views-settings-panel]');
            var entitySelect = panel && panel.querySelector('[data-entity-views-settings-entity]');
            if (!entitySelect) return;

            var byClass = JSON.parse(panel.dataset.instancesByClass || '{}');
            var instances = byClass[classSelect.value] || [];
            entitySelect.disabled = !classSelect.value;
            entitySelect.innerHTML = '<option value=""></option>' + (classSelect.value ? '<option value="all">' + (entitySelect.dataset.allLabel || 'all') + '</option>' : '')
                + instances.map(function (instance) {
                    return '<option value="' + instance.id + '">' + instance.label.replace(/&/g, '&amp;').replace(/</g, '&lt;') + '</option>';
                }).join('');
        });

        document.addEventListener('click', function (e) {
            var toggle = e.target.closest('[data-entity-views-settings-toggle]');
            if (toggle) {
                var toggleBlock = toggle.closest('[data-sortable-item]');
                var toggleCard = toggleBlock && toggleBlock.querySelector('[data-entity-views-card]');
                if (!toggleCard) return;
                var togglePanel = toggleCard.querySelector('[data-entity-views-settings-panel]');
                var opening = !!togglePanel.hidden;
                if (opening) {
                    var toggleDef = JSON.parse((toggleBlock && toggleBlock.dataset.mergeDef) || '{}');
                    var toggleClass = (toggleDef.params && toggleDef.params.entityClass) || '';
                    var toggleEntityId = (toggleDef.params && toggleDef.params.entityId) || '';
                    toggleCard.querySelector('[data-entity-views-settings-class]').value = toggleClass;
                    // Repaint the entity select for whatever class was
                    // already saved, THEN select its saved value - the
                    // 'change' handler above only builds the option list,
                    // it doesn't know what should end up selected.
                    toggleCard.querySelector('[data-entity-views-settings-class]').dispatchEvent(new Event('change', { bubbles: true }));
                    toggleCard.querySelector('[data-entity-views-settings-entity]').value = toggleEntityId;
                }
                togglePanel.hidden = !opening;
                toggle.classList.toggle('is-active', opening);
                return;
            }

            var cancel = e.target.closest('[data-entity-views-settings-cancel]');
            if (cancel) {
                cancel.closest('[data-entity-views-settings-panel]').hidden = true;
                var cancelBlock = cancel.closest('[data-sortable-item]');
                var cancelToggle = cancelBlock && cancelBlock.querySelector('[data-entity-views-settings-toggle]');
                if (cancelToggle) cancelToggle.classList.remove('is-active');
                return;
            }

            var apply = e.target.closest('[data-entity-views-settings-apply]');
            if (!apply) return;

            var applyCard = apply.closest('[data-entity-views-card]');
            var applyBlock = applyCard && applyCard.closest('[data-sortable-item]');
            if (!applyBlock) return;

            var applyDef = JSON.parse(applyBlock.dataset.mergeDef || '{}');
            var classSelectApply = applyCard.querySelector('[data-entity-views-settings-class]');
            var entitySelectApply = applyCard.querySelector('[data-entity-views-settings-entity]');
            var entityClass = classSelectApply.value || null;
            // 'all' (every instance of entityClass, summed - see the
            // widget type's own ALL_INSTANCES constant) is the one
            // non-numeric option value; everything else is a real id.
            var entityId = entitySelectApply.value === 'all' ? 'all' : (entitySelectApply.value ? parseInt(entitySelectApply.value, 10) : null);

            // Label is NOT touched here - the heading's own contenteditable
            // input handler (generic over any [data-analytics-title]) owns
            // widgetLabel entirely, independent of whether this panel is
            // even open.
            applyBlock.dataset.blockName = applyDef.blockName || 'entity_views';
            applyBlock.dataset.widgetLabel = applyBlock.dataset.widgetLabel || applyDef.label || '';
            applyBlock.dataset.widgetIcon = applyDef.icon || '';
            applyBlock.dataset.widgetParams = JSON.stringify(Object.assign({}, applyDef.params, { entityClass: entityClass, entityId: entityId }));

            applyCard.querySelector('[data-entity-views-settings-panel]').hidden = true;
            var applyToggle = applyBlock.querySelector('[data-entity-views-settings-toggle]');
            if (applyToggle) applyToggle.classList.remove('is-active');
        });

        // "Counter" widget settings panel - exact same picker mechanism as
        // entity_views' own above, just under its own data-counter-
        // settings-* namespace/data-counter-card scoping (see counter.
        // html.twig's own comment on why this stays a separate copy
        // rather than a shared abstraction).
        document.addEventListener('change', function (e) {
            var classSelect = e.target.closest('[data-counter-settings-class]');
            if (!classSelect) return;
            var panel = classSelect.closest('[data-counter-settings-panel]');
            var entitySelect = panel && panel.querySelector('[data-counter-settings-entity]');
            if (!entitySelect) return;

            var byClass = JSON.parse(panel.dataset.instancesByClass || '{}');
            var instances = byClass[classSelect.value] || [];
            entitySelect.disabled = !classSelect.value;
            entitySelect.innerHTML = '<option value=""></option>' + (classSelect.value ? '<option value="all">' + (entitySelect.dataset.allLabel || 'all') + '</option>' : '')
                + instances.map(function (instance) {
                    return '<option value="' + instance.id + '">' + instance.label.replace(/&/g, '&amp;').replace(/</g, '&lt;') + '</option>';
                }).join('');
        });

        document.addEventListener('click', function (e) {
            var toggle = e.target.closest('[data-counter-settings-toggle]');
            if (toggle) {
                var toggleBlock = toggle.closest('[data-sortable-item]');
                var toggleCard = toggleBlock && toggleBlock.querySelector('[data-counter-card]');
                if (!toggleCard) return;
                var togglePanel = toggleCard.querySelector('[data-counter-settings-panel]');
                var opening = !!togglePanel.hidden;
                if (opening) {
                    var toggleDef = JSON.parse((toggleBlock && toggleBlock.dataset.mergeDef) || '{}');
                    var toggleClass = (toggleDef.params && toggleDef.params.entityClass) || '';
                    var toggleEntityId = (toggleDef.params && toggleDef.params.entityId) || '';
                    toggleCard.querySelector('[data-counter-settings-class]').value = toggleClass;
                    toggleCard.querySelector('[data-counter-settings-class]').dispatchEvent(new Event('change', { bubbles: true }));
                    toggleCard.querySelector('[data-counter-settings-entity]').value = toggleEntityId;
                }
                togglePanel.hidden = !opening;
                toggle.classList.toggle('is-active', opening);
                return;
            }

            var cancel = e.target.closest('[data-counter-settings-cancel]');
            if (cancel) {
                cancel.closest('[data-counter-settings-panel]').hidden = true;
                var cancelBlock = cancel.closest('[data-sortable-item]');
                var cancelToggle = cancelBlock && cancelBlock.querySelector('[data-counter-settings-toggle]');
                if (cancelToggle) cancelToggle.classList.remove('is-active');
                return;
            }

            var apply = e.target.closest('[data-counter-settings-apply]');
            if (!apply) return;

            var applyCard = apply.closest('[data-counter-card]');
            var applyBlock = applyCard && applyCard.closest('[data-sortable-item]');
            if (!applyBlock) return;

            var applyDef = JSON.parse(applyBlock.dataset.mergeDef || '{}');
            var classSelectApply = applyCard.querySelector('[data-counter-settings-class]');
            var entitySelectApply = applyCard.querySelector('[data-counter-settings-entity]');
            var entityClass = classSelectApply.value || null;
            var entityId = entitySelectApply.value === 'all' ? 'all' : (entitySelectApply.value ? parseInt(entitySelectApply.value, 10) : null);

            applyBlock.dataset.blockName = applyDef.blockName || 'counter';
            applyBlock.dataset.widgetLabel = applyBlock.dataset.widgetLabel || applyDef.label || '';
            applyBlock.dataset.widgetIcon = applyDef.icon || '';
            applyBlock.dataset.widgetParams = JSON.stringify(Object.assign({}, applyDef.params, { entityClass: entityClass, entityId: entityId }));

            applyCard.querySelector('[data-counter-settings-panel]').hidden = true;
            var applyToggle = applyBlock.querySelector('[data-counter-settings-toggle]');
            if (applyToggle) applyToggle.classList.remove('is-active');
        });

        // "+ Add widget" palette: fetches the registered type list once
        // (lazily, on first open - reuses the SAME generic [data-dropdown]
        // open/close handler already wired above for the topbar's theme/
        // language menus, nothing new there), then GETs a fresh instance's
        // rendered markup and inserts it directly - no separate JSON
        // contract to keep in sync, the fragment already carries its own
        // data-sortable-key/data-block-name/etc (see _block.html.twig).
        // Reachable only from inside an already-active customize session,
        // so the inserted node is immediately draggable/resizable/
        // removable for free: StickySortable binds on the CONTAINER, not
        // per-item, and the resize/hide/remove handlers above are all
        // document-delegated - nothing here needs to re-init anything.
        // Live-updates the grid's own custom property + data attribute the
        // instant the value changes - the resize control (currentColumns())
        // and the eventual "Done" save (saveScope() reads this same data
        // attribute) both pick it up with no separate state to sync.
        var columnsSelect = document.querySelector('[data-columns-select]');
        if (columnsSelect) {
            columnsSelect.addEventListener('change', function () {
                var grid = document.querySelector('[data-sortable="dashboard"]');
                if (!grid) return;
                grid.dataset.widgetColumns = columnsSelect.value;
                grid.style.setProperty('--widget-columns', columnsSelect.value);
            });
        }

        var paletteTypes = null;
        var paletteTrigger = document.getElementById('admin-add-widget-trigger');
        var paletteMenu = document.querySelector('[data-widget-palette-menu]');
        if (paletteTrigger && paletteMenu) {
            function loadPaletteTypes() {
                if (paletteTypes) return;
                fetch('{{ path("admin_dashboard_widget_types") }}')
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        paletteTypes = data.types || [];
                        paletteMenu.innerHTML = paletteTypes.map(function (t) {
                            return '<button type="button" data-add-widget-type="' + t.name + '">'
                                + (t.icon ? '<i class="' + t.icon + '"></i> ' : '') + t.label + '</button>';
                        }).join('');
                    });
            }
            // Fetched as soon as customize mode's own toolbar exists, not
            // lazily on the trigger's first click - the dropdown itself
            // opens INSTANTLY either way (the generic [data-dropdown]
            // handler just toggles a CSS class), but its content used to
            // stay genuinely blank for however long the request took
            // (~0.7s here, reported as ~4s live) - a blank white dropdown
            // box reads as "did my click even register?", not "still
            // loading". Firing this early means the list is very likely
            // already in hand by the time anyone actually clicks.
            loadPaletteTypes();
            paletteTrigger.addEventListener('click', loadPaletteTypes);
        }
        document.addEventListener('click', function (e) {
            var button = e.target.closest('[data-add-widget-type]');
            if (!button) return;
            var grid = document.querySelector('[data-sortable="dashboard"]');
            if (!grid) return;

            var label = window.prompt('{{ 'customize.add_widget'|trans({}, 'admin')|e('js') }}', button.textContent.trim());
            if (null === label) return; // cancelled

            var url = '{{ path("admin_dashboard_widget_new", {blockName: "__BLOCK__"}) }}'.replace('__BLOCK__', encodeURIComponent(button.dataset.addWidgetType))
                + '?label=' + encodeURIComponent(label);
            fetch(url)
                .then(function (r) { return r.text(); })
                .then(function (html) {
                    grid.insertAdjacentHTML('beforeend', html);
                    // Neither the 'load'-driven init nor the SPA-swap path
                    // in admin-charts.js ever sees a plain DOM insertion
                    // like this one - the new canvas needs an explicit push.
                    if (window.AdminCharts && window.AdminCharts.init) window.AdminCharts.init();
                    refreshTitleEditability();
                });
        });

        // Restoring a deleted code-defined widget (see dashboard.html.twig's
        // "restore" picker) writes straight to the stored LayoutConfig -
        // unlike every other customize-mode change, it can't wait for the
        // batched "Done" save (deleted_widgets is itself read from that
        // same stored config on every page load, see
        // AbstractDashboardController::index()) - so this reloads on
        // success rather than patching the DOM: the restored widget has no
        // code-defined MenuItem available client-side to render from.
        document.addEventListener('click', function (e) {
            var button = e.target.closest('[data-restore-widget-key]');
            if (!button || !doneBtn) return;

            fetch('{{ path("admin_dashboard_widget_restore") }}', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-CSRF-Token': doneBtn.dataset.csrfToken },
                body: 'key=' + encodeURIComponent(button.dataset.restoreWidgetKey),
            }).then(function (r) {
                if (r.ok) window.location.reload();
            });
        });

        function captureLevel(container) {
            var items = [];
            container.querySelectorAll(':scope > [data-sortable-item]').forEach(function (el) {
                var childContainer = el.querySelector(':scope > [data-sortable]');
                var entry = {
                    key: el.dataset.sortableKey,
                    visible: !el.classList.contains('is-hidden'),
                    // Same generic, always-present shape as visible above
                    // - see MenuItem::$background's own docblock.
                    background: !el.classList.contains('no-card-bg'),
                    size: parseInt(el.dataset.widgetSize || '1', 10),
                    // null (not omitted) when never explicitly resized -
                    // matches LayoutConfig's own "height: ?int" shape, and
                    // lets a later save correctly CLEAR a previously-set
                    // height back to auto if that's ever wired up client-
                    // side, rather than the key just silently vanishing.
                    height: el.dataset.widgetHeight ? parseInt(el.dataset.widgetHeight, 10) : null,
                    // Only ever true once [data-remove-item] has marked
                    // this node (see that handler's own comment) - a
                    // code-defined widget needs this to actually stay
                    // gone (LayoutArranger re-offers it every request
                    // otherwise); an ad-hoc one doesn't strictly need it
                    // (omitting the key already works) but gets it too,
                    // for free, since this walk doesn't distinguish them.
                    deleted: el.dataset.deleted === '1',
                    children: childContainer ? captureLevel(childContainer) : [],
                };
                // Ad-hoc/palette-added widgets carry their own definition in
                // data-* attributes (see _block.html.twig) - an ordinary
                // code-tracked node never has data-block-name, so this stays
                // a no-op and every existing widget's captured shape is
                // unaffected.
                if (el.dataset.blockName) {
                    entry.blockName = el.dataset.blockName;
                    entry.label = el.dataset.widgetLabel || '';
                    entry.icon = el.dataset.widgetIcon || null;
                    try { entry.params = JSON.parse(el.dataset.widgetParams || '{}'); } catch (err) { entry.params = {}; }
                } else if (el.dataset.widgetLabel !== undefined) {
                    // A code-defined SECTION widget (Blog/Photos/
                    // Destinations/...) whose title got edited in place -
                    // no blockName/params to carry (section widgets are
                    // never blockName-dispatched, see _group.html.twig),
                    // just the new label - see LayoutArranger::applyLevel()'s
                    // own matching half of this (label applies to any
                    // matched code-defined item now, not just a
                    // blockName-carrying one).
                    entry.label = el.dataset.widgetLabel;
                }
                items.push(entry);
            });
            return items;
        }

        // path() validates route requirements (scope: sidebar|dashboard) at
        // render time - a placeholder value wouldn't match the pattern and
        // would throw, so both real URLs are generated server-side and
        // looked up by scope name client-side, rather than building one
        // templated URL string and substituting into it.
        var LAYOUT_SAVE_URLS = {
            sidebar: '{{ path("admin_layout_save", {scope: "sidebar"}) }}',
            dashboard: '{{ path("admin_layout_save", {scope: "dashboard"}) }}',
        };

        function saveScope(scope, container) {
            var payload = { version: 1, items: captureLevel(container) };
            // columns only means anything for the dashboard grid - reads
            // the CURRENT value straight off the grid's own data attribute
            // (kept live-in-sync by the columns-select handler below), not
            // a separate piece of state to keep consistent by hand.
            if ('dashboard' === scope) {
                payload.columns = parseInt(container.dataset.widgetColumns, 10) || 5;
            }
            return fetch(LAYOUT_SAVE_URLS[scope], {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': layoutCsrfToken() },
                body: JSON.stringify(payload),
            });
        }

        // Delegated for the same SPA-swap-survival reason as the customize
        // toggle above.
        document.addEventListener('click', function (e) {
            if (!e.target.closest('#admin-customize-done')) return;
            var saves = [];
            document.querySelectorAll('[data-sortable="sidebar"]').forEach(function (el) { saves.push(saveScope('sidebar', el)); });
            document.querySelectorAll('[data-sortable="dashboard"]').forEach(function (el) { saves.push(saveScope('dashboard', el)); });

            Promise.all(saves).then(function () {
                setCustomizing(false);
                window.location.reload();
            }).catch(function () {
                // leave customize mode open so nothing is silently lost
            });
        });

        var wasCustomizing = false;
        try { wasCustomizing = localStorage.getItem(STORAGE_KEY) === '1'; } catch (e) {}
        if (wasCustomizing) setCustomizing(true);

        // transparentJS re-dispatches a synthetic 'load' on every in-admin
        // navigation (see Transparent.ready()'s own {once:true} comment in
        // the <head>) - the swapped-in #page subtree is brand new DOM:
        // sortables aren't initialized on it, contenteditable flags are
        // gone, and the fresh toggle button renders without its active
        // state. Re-apply the CLIENT-side customize state to it. NOT
        // {once:true}, deliberately - re-running on every swap is the
        // whole point here.
        window.addEventListener('load', function () {
            sortablesInitialized = false;
            var on = body.classList.contains('is-customizing');
            if (on) initSortables();
            var toggleBtn = getToggleBtn();
            if (toggleBtn) { toggleBtn.classList.toggle('is-active', on); toggleBtn.setAttribute('aria-pressed', on ? 'true' : 'false'); }
            refreshTitleEditability();
        });
    })();
</script>
{% endif %}
{% block body_javascript %}{% endblock %}
{# NOT calling parent.Transparent.notifyNestReady() here (tried it,
   reverted - see git history / transparent.js's mount()). A plain
   inline <script> this close to </body> still runs during HTML
   PARSING, roughly DOMContentLoaded timing, well before images/
   stylesheets/deferred scripts have actually finished loading and
   applied. Measured directly against the real admin dashboard: firing
   it unconditionally here revealed the overlay while this document's
   readyState was still "interactive", 668ms before it reached
   "complete" - the exact "page goes white, nested site hasn't finished
   loading" bug. Gating it on this document's OWN 'load' event instead
   just re-races the parent's identical 'load'-driven reveal with no
   guaranteed ordering between the two, for no proven benefit - this
   app's actual asset loading (form-defer included, all real <script>
   tags) is already fully covered by the parent's load+settle fallback
   in Transparent.nest's mount(). Reconsider notifyNestReady() only if a
   future page here has real async work that genuinely continues after
   its own 'load' event. #}
</html>
