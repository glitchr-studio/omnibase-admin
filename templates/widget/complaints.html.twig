{# The reports that wait (Base\Admin\Widget\ComplaintsWidgetType): the ones the signed-in staff member may read. #}
<div class="analytics-card card admin-complaints">
    <div class="analytics-card-header">
        <h2 class="analytics-card-title">{{ widget.label|trans({}, 'admin') }}</h2>
    </div>
    <div class="admin-complaints-body">
        <a class="admin-complaints-count{{ open > 0 ? ' is-waiting' }}" href="{{ path('admin_crud_complaints_index', {filters: {status: 'open'}}) }}">
            <strong>{{ open }}</strong>
            <span>{{ 'complaint.widget.open'|trans({'%count%': open}, 'admin') }}</span>
        </a>
        {% if complaints %}
        <ul class="admin-complaints-list">
            {% for complaint in complaints %}
            <li><a href="{{ path('admin_crud_complaints_detail', {entityId: complaint.id}) }}"><b>{{ complaint.complainantName }}</b>{% if complaint.targetName %} → {{ complaint.targetName }}{% endif %}{% if complaint.source %} · {{ complaint.source }}{% endif %}<br><small>{{ complaint.text|length > 90 ? complaint.text|slice(0, 90) ~ '…' : complaint.text }}</small></a></li>
            {% endfor %}
        </ul>
        {% else %}
        <p class="admin-complaints-empty">{{ 'complaint.widget.none'|trans({}, 'admin') }}</p>
        {% endif %}
    </div>
</div>
<style>
    .admin-complaints-body { display: grid; gap: .75rem; padding: 0 1rem 1rem; }
    .admin-complaints-count { display: grid; gap: .2rem; padding: .9rem 1rem; border-radius: .75rem; background: rgba(127,127,127,.08); color: inherit; text-decoration: none; }
    .admin-complaints-count strong { font-size: 1.6rem; line-height: 1.1; }
    .admin-complaints-count span { font-size: .8rem; opacity: .75; }
    .admin-complaints-count.is-waiting { background: rgba(252,104,117,.16); }
    .admin-complaints-count.is-waiting strong { color: #d9404e; }
    .admin-complaints-list { margin: 0; padding: 0; list-style: none; display: grid; gap: .4rem; font-size: .85rem; }
    .admin-complaints-list a { color: inherit; text-decoration: none; }
    .admin-complaints-empty { margin: 0; font-size: .85rem; opacity: .7; }
</style>
