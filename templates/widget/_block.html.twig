{# Block-type widgets (e.g. analytics_card) render themselves inside their
   own .card via a registered DashboardWidgetTypeInterface - see
   Base\Admin\Widget\DashboardWidgetTypeRegistry and the
   dashboard_widget_type() Twig function. Unknown/unregistered blockNames
   render an empty shell, same as before.

   Extracted from dashboard.html.twig's widget loop so
   DashboardWidgetController::newInstance() (the "+ Add widget" palette)
   can render one widget's markup standalone, exactly matching what the
   dashboard's own loop produces - same wrapper, same controls, same
   dispatch, no duplicated logic between the two render paths. #}
{# data-merge-def carries this widget's own full definition (independent
   of the adHoc-only data-block-name/... attributes above, which only
   exist so an ad-hoc widget's STORAGE shape round-trips through
   LayoutConfig - a code-defined widget like analytics_card deliberately
   stays out of storage, matched by key against configureWidgetItems()
   again on every request). Merging needs a code-defined widget's
   definition too (you can drag the built-in analytics_card onto another
   card), so it's rendered unconditionally here rather than reusing the
   adHoc-gated attributes. Omitted for the composite type itself - a
   composite can still be a merge TARGET (dropping a third/fourth card
   onto it grows its own panes, see layout.html.twig's isMergeTarget), but
   it can't be DRAGGED to merge further into something else - one level of
   fusion is the practical ceiling, so this is what keeps it out of the
   "can this be dragged to start a merge" side of that check. #}
<div class="widget-block {{ widget.hidden ? 'is-hidden' }} {{ widget.background is defined and not widget.background ? 'no-card-bg' }}" style="--widget-span: {{ widget.size }}{% if widget.height %}; min-height: {{ widget.height }}px; --widget-height: {{ widget.height }}px{% endif %}" data-sortable-item data-sortable-key="{{ widget.key }}" data-widget-size="{{ widget.size }}"{% if widget.height %} data-widget-height="{{ widget.height }}"{% endif %}{% if widget.adHoc %} data-block-name="{{ widget.blockName }}" data-widget-label="{{ widget.label }}" data-widget-icon="{{ widget.icon }}" data-widget-params="{{ widget.params|json_encode }}"{% endif %}{% if widget.blockName and widget.blockName != 'composite' %} data-merge-def="{{ {blockName: widget.blockName, label: (widget.label ? widget.label|trans({}, 'admin') : ''), icon: widget.icon, params: widget.params}|json_encode|e('html_attr') }}"{% endif %}>
    {% if customize_enabled is defined and customize_enabled %}
        <div class="item-controls widget-controls">
            <button type="button" class="item-handle" data-sortable-handle title="{{ 'customize.reorder'|trans({}, 'admin') }}"><i class="fa-solid fa-grip-vertical"></i></button>
            <button type="button" class="item-toggle" data-toggle-hidden title="{{ 'customize.toggle_visibility'|trans({}, 'admin') }}"><i class="fa-solid fa-eye{{ widget.hidden ? '-slash' }}"></i></button>
            {# Same generic mechanism as the hide/show toggle right above -
               see MenuItem::$background's own docblock. Works on every
               widget type (block or section alike, see _group.html.twig's
               own copy of this button), not scoped to any one of them. #}
            <button type="button" class="item-background {{ widget.background is defined and not widget.background ? 'is-active' }}" data-toggle-background title="{{ 'customize.toggle_background'|trans({}, 'admin') }}"><i class="fa-solid fa-square{{ (widget.background is defined and not widget.background) ? '' : '-full' }}"></i></button>
            {# analytics_card's own settings gear (series checkboxes) and
               article_views' (article picker) both live INSIDE their own
               widget content (analytics-card-header), not in this shared
               controls row - each needs its OWN card-scoped markup right
               next to what it's editing, not a generic slot here. #}
            {% if widget.blockName == 'composite' %}
                {# Rebuilds each pane as its own standalone card again (see
                   layout.html.twig's [data-split-item] handler +
                   DashboardWidgetController::split()) - reads this
                   widget's OWN data-widget-params (its 'panes' array),
                   already present unconditionally below since a composite
                   is always adHoc. #}
                {# fa-scissors, not fa-object-ungroup - reported live as
                   visually too detailed/busy (fine connector-dot linework)
                   next to its siblings here, all simple bold shapes (grip
                   dots, eye, solid square, trash can). Scissors reads as
                   the same "split apart" concept at a glance, with the
                   same visual weight as the rest of the row. #}
                <button type="button" class="item-split" data-split-item title="{{ 'customize.split'|trans({}, 'admin') }}"><i class="fa-solid fa-scissors"></i></button>
            {% endif %}
            {# Every widget gets a remove button now, code-defined or
               ad-hoc alike (see LayoutConfig's own 'deleted' flag +
               LayoutArranger's own comment on why a code-defined item
               needed one at all - it's re-offered by code every request
               regardless of storage, so omitting its key was never
               enough on its own). No confirmation dialog, immediate
               (visual) removal either way (see layout.html.twig's
               [data-remove-item] handler) - nothing is actually
               persisted until "Terminé", so the safety net is the same
               one every other customize-mode edit already has: just
               don't save. #}
            <button type="button" class="item-remove" data-remove-item title="{{ 'customize.remove'|trans({}, 'admin') }}"><i class="fa-solid fa-trash"></i></button>
        </div>
        {# A standalone sibling of .item-controls, NOT nested inside it:
           .widget-controls is itself position:absolute, so an absolutely-
           positioned CHILD of it resolves bottom/right against ITS small
           icon-row box, not the whole card - landing back up near the top
           regardless of a bottom-right CSS rule. Being a direct child of
           .widget-block (also position:relative) instead is what actually
           anchors it to the card's own corner. #}
        <button type="button" class="item-resize-handle" data-resize-handle title="{{ 'customize.resize'|trans({}, 'admin') }}"><i class="fa-solid fa-up-right-and-down-left-from-center"></i></button>
    {% endif %}
    {% set widgetType = widget.blockName ? dashboard_widget_type(widget.blockName) : null %}
    {% if widgetType %}
        {{ include(widgetType.getTemplate(), widgetType.getTemplateVars(widget)|merge({widget: widget})) }}
    {% endif %}
</div>
