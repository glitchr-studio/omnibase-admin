{# Rendered via Base\Admin\Widget\AnalyticsCardWidgetType - 'series'/'change'/
   'palette'/'visibleSeries' arrive as template vars (getTemplateVars()),
   not fetched here, so this template stays agnostic of the data source and
   reusable across multiple analytics_card instances with different params
   (see MenuItem::block()'s $instanceKey/$params).

   One shared-axis chart, series togglable per instance (params.series,
   edited via the widget's own settings panel - see the edit-mode markup
   below) rather than a fixed small-multiples split: human-scale traffic
   and bot/AI-scale traffic DO flatten each other on one linear axis when
   plotted together, but that's now something the admin curates by turning
   a series off (e.g. hide Human to actually see Bot/AI's shape) instead of
   something this template forces on every instance unconditionally.

   'embedded' (set by composite.html.twig when this renders as one pane of
   a CompositeWidgetType, unset/false at the top level) drops the .card
   class - the outer composite already supplies ONE shared border/
   background for every pane, so a pane keeping its own .card would nest
   a card inside a card, which this codebase's dashboard loop explicitly
   never allows ("nothing is ever a card nested inside another card").
   .analytics-card's own padding is kept either way. #}
{% set totalPageViews = series|reduce((carry, day) => carry + day.pageViews, 0) %}
<div class="analytics-card {{ (embedded is not defined or not embedded) ? 'card' }}" data-analytics-card>
    <div class="analytics-card-header">
        <h2 class="analytics-card-title" data-analytics-title>{{ widget.label|trans({}, 'admin') }}</h2>
        <div class="analytics-stat-row">
            <div class="analytics-stat">
                <span class="analytics-stat-value">
                    {{ totalPageViews }}
                    {%- if change.pageViews is not null %}
                        <span class="analytics-stat-change {{ change.pageViews >= 0 ? 'is-up' : 'is-down' }}">
                            {{ change.pageViews >= 0 ? '+' : '' }}{{ change.pageViews }}%
                        </span>
                    {% endif %}
                </span>
                <span class="analytics-stat-label">{{ 'analytics.label.page_views'|trans({}, 'admin') }}</span>
            </div>
            {% for key in ['uniqueVisitors', 'uniqueUsers'] %}
                <div class="analytics-stat">
                    <span class="analytics-stat-value">
                        {{ series|reduce((carry, day) => carry + day[key], 0) }}
                        {%- if change[key] is not null %}
                            <span class="analytics-stat-change {{ change[key] >= 0 ? 'is-up' : 'is-down' }}">
                                {{ change[key] >= 0 ? '+' : '' }}{{ change[key] }}%
                            </span>
                        {% endif %}
                    </span>
                    <span class="analytics-stat-label">{{ palette[key].label }}</span>
                </div>
            {% endfor %}
        </div>
        {% if embedded is not defined or not embedded %}
            {# Customize-mode only (CSS-gated, same as .item-controls/.item-
               resize-handle) - opens .analytics-settings-panel below. Lives
               inside this widget-type's own template rather than the generic
               _block.html.twig controls row, since title/series only ever
               make sense for THIS widget type - a future widget type with
               its own instance settings would get its own panel the same
               way, not a shared one every widget type has to opt out of.
               Not offered for a composite PANE (embedded:true): the JS side
               would need to write into params.panes[n] instead of the
               widget-block's own top-level params, and this app's merge
               feature is explicitly "one level of fusion is the practical
               ceiling" already - not extending that ceiling to per-pane
               settings too, at least for now. #}
            <button type="button" class="analytics-settings-toggle" data-analytics-settings-toggle title="{{ 'analytics.settings.title'|trans({}, 'admin') }}"><i class="fa-solid fa-gear"></i></button>
        {% endif %}
    </div>
    {% if embedded is not defined or not embedded %}
        {# Pre-filled from this instance's CURRENT label/params on open, not
           server-rendered into the form itself - data-merge-def already
           carries {blockName, label (translated), icon, params} for any
           widget with a blockName (code-defined or ad-hoc alike, see
           _block.html.twig), so this panel doesn't need its own copy of
           that data baked in twice. #}
        <div class="analytics-settings-panel" data-analytics-settings-panel hidden>
            <label class="analytics-settings-field">
                <span>{{ 'analytics.settings.title_label'|trans({}, 'admin') }}</span>
                <input type="text" data-analytics-settings-title maxlength="200">
            </label>
            <div class="analytics-settings-field">
                <span>{{ 'analytics.settings.series_label'|trans({}, 'admin') }}</span>
                <div class="analytics-settings-series">
                    {% for key, meta in palette %}
                        <label class="analytics-settings-series-item">
                            <input type="checkbox" value="{{ key }}" data-analytics-settings-series checked>
                            <span class="analytics-source-dot" style="--chip-color: {{ meta.color }}; --chip-color-dark: {{ meta.colorDark }}"></span>
                            {{ meta.label }}
                        </label>
                    {% endfor %}
                </div>
            </div>
            <div class="analytics-settings-actions">
                <button type="button" class="analytics-range-btn" data-analytics-settings-cancel>{{ 'analytics.settings.cancel'|trans({}, 'admin') }}</button>
                <button type="button" class="analytics-range-btn is-active" data-analytics-settings-apply>{{ 'analytics.settings.apply'|trans({}, 'admin') }}</button>
            </div>
        </div>
    {% endif %}
    {# Range picker only swaps the chart below - the stat row above stays
       a fixed "this week vs last week" summary regardless of which window
       the chart is showing, so the two never contradict each other. #}
    <div class="analytics-range-picker" data-analytics-range-picker data-analytics-endpoints="{{ {
        today: path('admin_analytics_breakdown', {range: 'today'}),
        '7d': path('admin_analytics_breakdown', {range: '7d'}),
        '14d': path('admin_analytics_breakdown', {range: '14d'}),
        '30d': path('admin_analytics_breakdown', {range: '30d'}),
        all: path('admin_analytics_breakdown', {range: 'all'}),
    }|json_encode }}">
        {% for range in ['today', '7d', '14d', '30d', 'all'] %}
            <button type="button" class="analytics-range-btn {{ range == '14d' ? 'is-active' }}" data-range="{{ range }}" {% if range == 'all' %}data-since-prefix="{{ 'analytics.range.since_prefix'|trans({}, 'admin') }}"{% endif %}>{{ ('analytics.range.' ~ range)|trans({}, 'admin') }}</button>
        {% endfor %}
    </div>
    <div class="analytics-chart-wrap">
        <canvas data-admin-chart="{{ {
            labels: series|map(day => day.date|date('d/m')),
            datasets: visibleSeries|map(key => {
                key: key,
                label: palette[key].label,
                data: series|map(day => day[key]),
                color: palette[key].color,
                colorDark: palette[key].colorDark,
            }),
            events: events|default([]),
        }|json_encode }}"></canvas>
    </div>
</div>
