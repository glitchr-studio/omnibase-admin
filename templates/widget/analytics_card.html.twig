{# Rendered via Base\Admin\Widget\AnalyticsCardWidgetType - 'series'/'change'/
   'palette' arrive as template vars (getTemplateVars()), not fetched here,
   so this template stays agnostic of the data source and reusable across
   multiple analytics_card instances with different params (see MenuItem::
   block()'s $instanceKey/$params).

   Small multiples, not one shared-axis chart: Human page views (hundreds)
   and Bot/AI/Visitors/Users (single digits to low tens) on the same linear
   y-axis flattens every series but the biggest one into an invisible line
   along the bottom - the exact "two measures of different scale on one
   axis" case the dataviz skill's anti-pattern list calls out (real example
   there: Users 0-30k plotted against Sessions 0-800k looked "hallucinated"
   to a reviewer). Each source gets its own canvas, its own auto-scaled
   axis, and its own total/delta in its header - so a handful of AI-bot
   hits are exactly as readable as hundreds of human ones.

   'embedded' (set by composite.html.twig when this renders as one pane of
   a CompositeWidgetType, unset/false at the top level) drops the .card
   class - the outer composite already supplies ONE shared border/
   background for every pane, so a pane keeping its own .card would nest
   a card inside a card, which this codebase's dashboard loop explicitly
   never allows ("nothing is ever a card nested inside another card").
   .analytics-card's own padding is kept either way. #}
{% set totalPageViews = series|reduce((carry, day) => carry + day.pageViews, 0) %}
<div class="analytics-card {{ (embedded is not defined or not embedded) ? 'card' }}">
    <div class="analytics-card-header">
        <h2>{{ widget.label|trans({}, 'admin') }}</h2>
        <div class="analytics-stat-row">
            <div class="analytics-stat">
                <span class="analytics-stat-value">
                    {{ totalPageViews }}
                    {%- if change.pageViews is not null %}
                        <span class="analytics-stat-change {{ change.pageViews >= 0 ? 'is-up' : 'is-down' }}">
                            {{ change.pageViews >= 0 ? '+' : '' }}{{ change.pageViews }}%
                        </span>
                    {% endif %}
                </span>
                <span class="analytics-stat-label">{{ 'analytics.label.page_views'|trans({}, 'admin') }}</span>
            </div>
        </div>
    </div>
    {# Range picker swaps every mini-chart below at once - the stat row above
       stays a fixed "this week vs last week" summary regardless of which
       window the charts are showing, so the two never contradict each
       other. #}
    <div class="analytics-range-picker" data-analytics-range-picker data-analytics-endpoints="{{ {
        today: path('admin_analytics_breakdown', {range: 'today'}),
        '7d': path('admin_analytics_breakdown', {range: '7d'}),
        '14d': path('admin_analytics_breakdown', {range: '14d'}),
        '30d': path('admin_analytics_breakdown', {range: '30d'}),
        all: path('admin_analytics_breakdown', {range: 'all'}),
    }|json_encode }}">
        {% for range in ['today', '7d', '14d', '30d', 'all'] %}
            <button type="button" class="analytics-range-btn {{ range == '14d' ? 'is-active' }}" data-range="{{ range }}" {% if range == 'all' %}data-since-prefix="{{ 'analytics.range.since_prefix'|trans({}, 'admin') }}"{% endif %}>{{ ('analytics.range.' ~ range)|trans({}, 'admin') }}</button>
        {% endfor %}
    </div>
    <div class="analytics-chart-grid">
        {% for key, meta in palette %}
            {% set total = series|reduce((carry, day) => carry + day[key], 0) %}
            <div class="analytics-mini-chart">
                <div class="analytics-mini-chart-header">
                    <span class="analytics-source-dot" style="--chip-color: {{ meta.color }}; --chip-color-dark: {{ meta.colorDark }}"></span>
                    <span class="analytics-mini-chart-title">{{ meta.label }}</span>
                    <span class="analytics-mini-chart-value">
                        {{ total }}
                        {%- if change[key] is not null %}
                            <span class="analytics-stat-change {{ change[key] >= 0 ? 'is-up' : 'is-down' }}">{{ change[key] >= 0 ? '+' : '' }}{{ change[key] }}%</span>
                        {% endif %}
                    </span>
                </div>
                <div class="analytics-mini-chart-wrap">
                    <canvas data-source-key="{{ key }}" data-admin-chart="{{ {
                        labels: series|map(day => day.date|date('d/m')),
                        datasets: [{
                            label: meta.label,
                            data: series|map(day => day[key]),
                            color: meta.color,
                            colorDark: meta.colorDark,
                        }],
                        events: events|default([]),
                    }|json_encode }}"></canvas>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
