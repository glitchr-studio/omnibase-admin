{# One .card, N panes side by side - each pane resolves+includes its own
   child widget type via the SAME dashboard_widget_type() dispatch the
   top-level dashboard loop already uses. Safe to nest: Twig's include()
   FUNCTION form (not the {% include %} tag) merges ambient context then
   overlays the explicit variables argument, so each child template gets
   its own correct 'widget' variable with no leakage between panes or
   from this composite's own outer widget - the exact mechanism already
   proven live for two independent top-level analytics_card instances,
   which generalizes unchanged to nested panes.

   'widget' here is the OUTER composite MenuItem (from _block.html.twig's
   own include) - not shadowed by 'pane' below. #}
<div class="card composite-card" data-composite-card>
    {# Proportional widths (each pane's own .size, see CompositeWidgetType -
       reused from MenuItem's normal grid-column-span meaning, just applied
       to THIS inner grid instead of the dashboard's own) only for exactly
       2 panes - a 1-wide + 2-wide merge becomes a 1fr/2fr split instead of
       forced 50/50, adjustable directly via the drag divider between them
       (see layout.html.twig's own [data-composite-pane-divider] handler -
       no separate settings form, dragging IS the control). 3-4 panes keep
       the CSS default repeat(2, 1fr) 2x2 wrap (see layout.html.twig)
       unchanged: "proportion" stops having one obvious meaning once panes
       wrap across two rows, so that case isn't covered here - no divider
       either, same condition as the ratio control it replaced. #}
    {# 6px track, matching .composite-pane-divider's own CSS width exactly
       (layout.html.twig) - kept in sync there, not computed from one
       shared source, since this is plain server-rendered Twig with no CSS
       variable plumbing between the two files. #}
    <div class="composite-panes" data-composite-panes{% if panes|length == 2 %} style="grid-template-columns: {{ panes[0].size }}fr 6px {{ panes[1].size }}fr"{% endif %}>
        {% for pane in panes %}
            {# data-pane-index - lets layout.html.twig's generic
               [data-analytics-title] input handler tell a pane's OWN title
               apart from the composite's outer widgetBlock: without this,
               closest('[data-sortable-item]') from inside a pane's title
               only ever finds the composite as a whole (no
               data-sortable-item on .composite-pane itself), so an edit
               was silently written onto the wrong target - see that
               handler's own comment for the params.panes[i].label branch
               this enables. #}
            <div class="composite-pane" data-pane-index="{{ loop.index0 }}">
                {% set paneType = pane.blockName ? dashboard_widget_type(pane.blockName) : null %}
                {% if paneType %}
                    {# embedded:true - see analytics_card.html.twig's own comment
                       on why this drops its normally-own .card class here.
                       Its own heading already carries data-analytics-title
                       (analytics_card.html.twig/entity_views.html.twig),
                       so this branch needed no title markup change - only
                       the data-pane-index wrapper above was missing. #}
                    {{ include(paneType.getTemplate(), paneType.getTemplateVars(pane)|merge({widget: pane, embedded: true})) }}
                {% elseif pane.subItems is defined and pane.subItems is not empty %}
                    {# A link-list pane (CompositeWidgetType's 'subItems'
                       branch) - same inner markup as dashboard.html.twig's
                       own top-level widget-group branch, just without its
                       outer .widget-group.card wrapper: .composite-pane
                       (styled below) is this pane's own container, same
                       "never nest a card in a card" rule the block branch
                       above already follows via embedded:true. #}
                    {% if pane.icon %}<div class="widget-icon"><i class="{{ pane.icon }}"></i></div>{% endif %}
                    {# data-analytics-title - was a plain, permanently
                       static <h2> (found live: reported as "can't modify
                       title" on a merged card) - _group.html.twig's own
                       top-level title already gets this treatment, this
                       branch was simply missed when composite panes were
                       introduced. #}
                    <h2 class="widget-group-title" data-analytics-title>{{ pane.label|trans({}, 'admin') }}</h2>
                    <ul>
                        {% for item in pane.subItems %}
                            {% if item.linkUrl %}
                                <li>
                                    {# Leaving the back office says so - see _group.html.twig. #}
                                    {% set _leaves = not (item.linkUrl starts with path('admin')) %}
                                    <a href="{{ item.linkUrl }}"{% if _leaves %} data-leaves-admin title="{{ item.label|trans({}, 'admin') }} - {{ 'menu.leaves_admin'|trans({}, 'admin') }}"{% endif %}>
                                        {%- if item.icon -%}<i class="{{ item.icon }}"></i>{%- endif -%}
                                        {{ item.label|trans({}, 'admin') }}
                                        {%- if _leaves %} <i class="fa-solid fa-arrow-up-right-from-square" style="width: auto; font-size: .7em; opacity: .55" aria-hidden="true"></i>{% endif -%}
                                    </a>
                                </li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
            {% if panes|length == 2 and not loop.last %}
                {# Sits in DOM order between the two panes, which combined
                   with the 3-track grid-template-columns above (left pane
                   fr / this 6px / right pane fr) is what actually lands
                   it visually between them - a real grid item, not an
                   absolutely-positioned overlay, so it never needs to
                   track the panes' own size independently. #}
                <div class="composite-pane-divider" data-composite-pane-divider data-pane-sizes="{{ panes[0].size }},{{ panes[1].size }}"
                     role="separator" aria-orientation="vertical" tabindex="0" title="{{ 'composite.settings.ratio_label'|trans({}, 'admin') }}"></div>
            {% endif %}
        {% endfor %}
    </div>
</div>
