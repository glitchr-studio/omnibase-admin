{% extends '@Admin/layout.html.twig' %}

{# base-bundle's widget blocks (select2 markup, editor textareas, pickers…)
   render the DOM markers its form-defer JS bundles initialise from #}
{% form_theme form with ['@Admin/crud/form_theme.html.twig'] %}

{% block content_header %}
<div class="admin-header">
    <h1>{% block form_title %}{% endblock %}</h1>
</div>
{% endblock %}

{% block content %}
<div class="card">
    {{ form_start(form, {attr: {class: 'admin-form', novalidate: 'novalidate'}}) }}
        {{ form_errors(form) }}
        <div class="form-grid">
        {% for child in form %}
            {# ->setColumns(N) on the field descriptor becomes a 12-column
               CSS grid span here - no explicit value spans the full width,
               matching how most fields are already declared. Values are
               historically Bootstrap-style ("col-md-6") as well as bare
               integers ("6") - splitting on '-' and taking the last chunk
               normalizes both to just the trailing number. #}
            {% set columns = child.vars.row_attr['data-columns']|default(null) %}
            <div class="form-row" style="--col-span: {{ columns is null ? 12 : (columns|split('-')|last) }};">
                {{ form_label(child) }}
                {{ form_widget(child) }}
                <div class="form-errors">{{ form_errors(child) }}</div>
                {{ form_help(child) }}
            </div>
        {% endfor %}
        </div>
        <div class="form-footer">
            {% for action in actions.getAll(crud.currentPage) %}
                {% if action.htmlElement == 'button' %}
                    <button class="btn {{ 'action-save' in action.cssClass ? 'btn-primary' : '' }}" type="submit"
                            name="{{ action.htmlAttributes.name|default('submit_action') }}" value="{{ action.htmlAttributes.value|default(action.name) }}">
                        {{ action.label|trans }}
                    </button>
                {% elseif action.crudActionName == 'index' %}
                    <a class="btn" href="{{ admin_url(controller_fqcn, 'index') }}">{{ action.label|trans }}</a>
                {% endif %}
            {% endfor %}
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
