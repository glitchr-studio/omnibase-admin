{% extends '@Admin/layout.html.twig' %}

{# base-bundle's widget blocks (select2 markup, editor textareas, pickers…)
   render the DOM markers its form-defer JS bundles initialise from #}
{% form_theme form with ['@Admin/crud/form_theme.html.twig'] %}

{# Save/save-and-continue/etc. buttons live in the header (see below), not
   the form footer - form="admin-form" targets them at the form by id
   regardless of where they sit in the document. #}
{% block content_header %}
{% set _entityLabel = crud.entityLabelInSingular ?? crud.entityFqcn|split('\\')|last %}
{# The same editable heading index/detail use, rather than a plain <h1>:
   the form pages were the only ones without the entity icon or an editable
   title. On NEW there is no record yet, so the heading is just the entity -
   "Article", not "Nouveau Article", which was wrong French anyway (nouvel
   before a vowel) and reported as such. On EDIT the record names itself and
   the entity drops to the subtitle, exactly as on detail. #}
{% set _record = entity is defined and entity is not null and entity.id
    ? (admin_display(entity)|trim ?: null) : null %}
{% set _record = _record and _record != _entityLabel ? _record : null %}
<div class="admin-header">
    {% include '@Admin/crud/_page_heading.html.twig' with {
        entityFqcn: crud.entityFqcn,
        editable: customize_enabled is defined and customize_enabled and crud_page_key is defined,
        pageKey: crud_page_key ?? null,
        stored: crud_page ?? null,
        fallbackTitle: crud.pageTitle(crud.currentPage) ?? _entityLabel,
        suffix: entity is defined and entity is not null and entity.id ? '#' ~ entity.id : null,
        recordTitle: _record,
        note: record_note ?? null,
    } only %}
{#- Same customization contract as index/detail: the row is a sortable
    action row and every action inside it is both a drag target and an icon
    target. new/edit were simply never wired for it, so the one place you
    most often want to reorder buttons was the one place you could not. -#}
{% set _editable = customize_enabled is defined and customize_enabled and crud_page_key is defined %}
{% set _order = admin_action_order(actions.getAll(crud.currentPage), crud_action_order|default({})) %}
{% set _icons = crud_action_icons|default({}) %}
{#- Per-page hidden buttons (customize mode's eye toggle) - see
    crud/detail.html.twig's twin for the render contract. -#}
{% set _hiddenActions = crud_action_hidden|default({}) %}
    <div class="global-actions"{% if _editable %} data-action-row data-page-key="{{ crud_page_key }}"{% endif %}>
        {#- Code order with the superadmin's stored order applied on top -
            see AdminTwigExtension::adminActionOrder(). -#}
        {% for action in actions.getAll(crud.currentPage)|sort((a, b) => _order[a.name] <=> _order[b.name]) %}
            {% set _icon = _icons[action.name] ?? action.icon %}
            {% set _isHidden = _hiddenActions[action.name]|default(false) %}
            {% set _edit = _editable ? ' data-action-key="' ~ action.name ~ '" data-action-page="' ~ crud_page_key ~ '" data-page-icon data-page-icon-value="' ~ _icon ~ '" data-action-hidden="' ~ (_isHidden ? '1' : '0') ~ '"' : '' %}
            {% if _isHidden and not _editable %}
            {% elseif entity is defined and entity and entity.id and not action.isDisplayed(entity) %}
            {% elseif action.htmlElement == 'button' %}
                {% set isMainSave = 'action-saveAndReturn' in action.cssClass %}
                {#- Any data-* the action declares travels to the button: a
                    data-confirm question (asked by the layout's confirm dialog),
                    a data-confirm-check checkbox to tick on yes, ... -#}
                <button class="btn {{ isMainSave ? 'btn-success' : 'btn-primary' }} {{ _isHidden ? 'is-hidden' }}"{% if isMainSave %} data-primary-action{% endif %} type="submit" form="admin-form"
                        name="{{ action.htmlAttributes.name|default('submit_action') }}" value="{{ action.htmlAttributes.value|default(action.name) }}"
                        {%- for _k, _v in action.htmlAttributes %}{% if _k starts with 'data-' %} {{ _k }}="{{ _v }}"{% endif %}{% endfor %}{{ _edit|raw }}>
                    {% if _icon %}<i class="{{ _icon }}"></i> {% endif %}{{ action.label|trans }}
                </button>
            {% elseif action.crudActionName == 'index' %}
                <a class="btn {{ _isHidden ? 'is-hidden' }}" href="{{ admin_url(controller_fqcn, 'index') }}"{{ _edit|raw }}>
                    {% if _icon %}<i class="{{ _icon }}"></i> {% endif %}{{ action.label|trans }}
                </a>
            {% elseif action.name == 'delete' and entity is defined and entity.id %}
                {# a real <form> as a flex child of .global-actions, exactly
                   like detail.html.twig's own delete action - can't reuse
                   admin-form (different destination URL, and nesting a
                   <form> inside another is invalid HTML). #}
                <form method="post" action="{{ admin_url(controller_fqcn, 'delete', entity.id) }}" style="display:contents"
                      data-confirm="{{ 'action.delete_confirm'|trans({}, 'admin') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin-batch-' ~ crud.entityFqcn) }}">
                    <button class="btn btn-icon text-danger {{ _isHidden ? 'is-hidden' }}" title="{{ action.label|trans }}"{{ _edit|raw }}><i class="{{ _icons[action.name] ?? 'fa-solid fa-trash' }}"></i></button>
                </form>
            {% elseif entity is defined and entity.id %}
                {% set href = admin_action_url(action, entity, controller_fqcn) %}
                {% if href %}
                    {% set isIconOnly = action.htmlAttributes['tooltip'] is defined %}
                    <a class="btn {{ isIconOnly ? 'btn-icon' }} {{ action.cssClass }} {{ _isHidden ? 'is-hidden' }}" href="{{ href }}"
                       {%- if action.htmlAttributes['target'] is defined %} target="{{ action.htmlAttributes['target'] }}"{% endif %}
                       {%- if isIconOnly %} title="{{ action.label|trans }}"{% endif %}{{ _edit|raw }}>
                        {%- if _icon -%}<i class="{{ _icon }}"></i>{%- endif -%}
                        {%- if not isIconOnly %} {{ action.label|trans }}{% endif -%}
                    </a>
                {% endif %}
            {% endif %}
        {% endfor %}
    </div>
</div>
{% endblock %}

{% block content %}
<div class="card">
    {# action set explicitly - see page/system.html.twig: a form with none
       posts to the document URL, which is "about:srcdoc" inside the nest
       overlay. #}
    {{ form_start(form, {action: app.request.pathInfo, attr: {id: 'admin-form', class: 'admin-form', novalidate: 'novalidate'}}) }}
        {{ form_errors(form) }}
        <div class="form-grid">
        {% for child in form %}
            {% if 'hidden' in child.vars.block_prefixes %}
                {# The CSRF field (and any other HiddenType, e.g. a plain
                   entity id) has no Symfony core hidden_label block to fall
                   back to - lookup falls through to this theme's own
                   form2_label (form_div_layout.html.twig), which always
                   renders a real label-wrapper + debug badge. Every single
                   create/edit form on this admin was showing a visible
                   "Csrf token" label above its own hidden input, found live
                   comparing against production (which renders it as a bare
                   input, no label at all). Skipping the whole .form-row
                   wrapper too, not just the label - its own margin-bottom
                   would otherwise leave a blank gap in the grid for content
                   that's never visible either way. #}
                {{ form_widget(child) }}
            {% else %}
            {# ->setColumns(N) on the field descriptor becomes a 12-column
               CSS grid span here - no explicit value spans the full width,
               matching how most fields are already declared. Values are
               historically Bootstrap-style ("col-md-6") as well as bare
               integers ("6") - splitting on '-' and taking the last chunk
               normalizes both to just the trailing number. #}
            {% set columns = child.vars.row_attr['data-columns']|default(null) %}
            <div class="form-row" style="--col-span: {{ columns is null ? 12 : (columns|split('-')|last) }};">
                {{ form_label(child) }}
                {{ form_widget(child) }}
                <div class="form-errors">{{ form_errors(child) }}</div>
                {{ form_help(child) }}
            </div>
            {% endif %}
        {% endfor %}
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
