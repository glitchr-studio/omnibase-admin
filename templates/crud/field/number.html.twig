{%- set raw = field.value -%}
{%- if raw is null -%}
    <span class="badge-muted">—</span>
{%- else -%}
    {%- set divisor = field.customOption('divisor') ?? 1 -%}
    {%- set decimals = field.customOption('numDecimals') ?? 0 -%}
    {%- set amount = divisor != 1 ? raw / divisor : raw -%}
    <span class="field-number">{{ field.customOption('prefix') }}{{ amount|number_format(decimals) }}{{ field.customOption('suffix') }}</span>
{%- endif -%}
