{%- set raw = field.value -%}
{%- set count = raw is iterable ? raw|length : 0 -%}
{%- if count == 0 -%}
    <span class="badge-muted">—</span>
{%- else -%}
    <span class="badge">{{ count }} {{ count != 1 ? 'field.items'|trans({}, 'admin') : 'field.item'|trans({}, 'admin') }}</span>
{%- endif -%}
