{%- set raw = field.value -%}
{#- An explicit crudControllerFqcn still wins; without one the target's own
    CRUD is resolved from its class (admin_entity_crud), so association
    chips link to the related record's admin page by default instead of
    rendering as dead text. Resolution is per-VALUE, not per-field: a
    polymorphic association (Thread -> Article/Comment/...) can hold
    several concrete types in one collection. A CRUD the user may not open
    (admin_crud_granted) leaves the chip as text. -#}
{%- set crudFqcnOption = field.customOption('crudControllerFqcn') -%}
{#- Optional display mode (username | fullname | avatar); unset keeps the
    historical admin_display() label. See SelectField::OPTION_ENTITY_DISPLAY. -#}
{%- set entityDisplay = field.customOption('entityDisplay') -%}
{%- if raw is null -%}
    <span class="badge-muted">—</span>
{%- elseif raw is iterable -%}
    {%- set items = raw|default([]) -%}
    {%- set limit = field.customOption('displayLimit') ?? 2 -%}
    {%- set total = items|length -%}
    {#- displayLimit(0) means "just say how many": the admin being replaced renders
        a to-many whose labels carry no useful summary (a Comment stringifies to
        "<article title> - <author> - <timestamp>") as a bare count badge. Printing
        two of those labels made the Comments column 1350px wide on its own and
        pushed the whole datagrid nearly 2000px past its container. -#}
    {%- if limit == 0 -%}
        <span class="badge{{ total == 0 ? ' badge-muted' }}">{{ total }}</span>
    {%- else -%}
    {#- showFirst()/show() record NO_SHOW=0, SHOW_NAME_ONLY=1, SHOW_ICON_ONLY=2,
        SHOW_ALL=3 - but nothing read them, so a field asking for icon-only chips
        still rendered full labels. Tags does exactly that, and printing the names
        made its column 286px against production's 84px of icon chips.
        `showFirst` applies to the first chip, `show` to the rest. -#}
    {%- set showFirstMode = field.customOption('showFirst') -%}
    {%- set showRestMode = field.customOption('show') ?? showFirstMode -%}
    <span class="badge-list">
        {#- Chips are summaries, not the record. Long labels are elided so one
            verbose association can't dictate the table's width. -#}
        {%- set maxLength = field.customOption('maxLength') ?? 28 -%}
        {%- for item in items|slice(0, limit) -%}
            {%- set itemCrud = crudFqcnOption ?? admin_entity_crud(item) -%}
            {%- set itemLabel = entityDisplay ? admin_entity_label(item, entityDisplay) : admin_display(item) -%}
            {%- set itemLabel = '' ~ itemLabel -%}
            {%- set shortLabel = itemLabel|length > maxLength ? itemLabel|slice(0, maxLength) ~ '…' : itemLabel -%}
            {%- set mode = loop.first ? showFirstMode : showRestMode -%}
            {%- set itemIcon = mode in [2, 3] ? admin_entity_icon(item) : null -%}
            {#- A record that HAS a picture shows it instead of the generic
                glyph: a column of twelve identical camera icons says nothing,
                twelve thumbnails say which photos are in the gallery. Same
                cached pipeline as the front (|thumbnail), so these are 96px
                webp tiles, not originals. Only where an icon would have been
                drawn anyway - a name-only chip stays name-only. -#}
            {%- set itemImage = itemIcon ? admin_entity_image(item) : null -%}
            {%- set itemThumb = itemImage ? itemImage|thumbnail(96, 96) : null -%}
            {#- Icon-only only holds when there IS an icon; otherwise keep the
                label rather than emit an empty chip. -#}
            {%- set withName = mode is null or mode in [1, 3] or (mode == 2 and not itemIcon) -%}
            {%- set chipBody -%}
                {%- if itemThumb %}<img class="badge-thumb" src="{{ itemThumb }}" alt="" loading="lazy">
                {%- elseif itemIcon %}<i class="{{ itemIcon }}"></i>{% endif -%}
                {%- if withName %}<span class="badge-label">{{ shortLabel }}</span>{% endif -%}
            {%- endset -%}
            {%- if itemCrud and item.id is defined and admin_crud_granted(itemCrud) -%}
                <a class="badge{{ itemIcon and not withName ? ' badge-icon' }}" href="{{ admin_url(itemCrud, 'detail', admin_entity_id(item)) }}" title="{{ itemLabel }}">{{ chipBody }}</a>
            {%- else -%}
                <span class="badge{{ itemIcon and not withName ? ' badge-icon' }}" title="{{ itemLabel }}">{{ chipBody }}</span>
            {%- endif -%}
        {%- endfor -%}
        {%- if total > limit -%}
            <span class="badge badge-muted">+{{ total - limit }}</span>
        {%- endif -%}
        {%- if total == 0 -%}
            <span class="badge-muted">—</span>
        {%- endif -%}
    </span>
    {%- endif -%}
{%- elseif admin_entity_image(raw) -%}
    {#- A to-one IMAGE (a Photo's `image`, a page's cover): the cell used to be
        the obfuscated URL as dead text - unreadable, unopenable, and the one
        thing anybody wants from it (the link) had to be selected by hand.
        Now: a thumbnail that opens the photo in the viewer (fetched on click,
        never with the page), the path, and a copy button for the absolute
        URL. -#}
    {%- set rawImage = admin_entity_image(raw) -%}
    {%- set fullUrl = image(rawImage) -%}
    {%- set rawLabel = '' ~ admin_display(raw) -%}
    {%- set maxLength = field.customOption('maxLength') ?? 40 -%}
    {%- set shortRaw = rawLabel|length > maxLength ? rawLabel|slice(0, maxLength) ~ '…' : rawLabel -%}
    <span class="field-image">
        <button type="button" class="field-image-thumb" data-image-view="{{ rawImage|thumbnail(1600, 1600) }}" data-image-full="{{ fullUrl }}" title="{{ 'field.viewImage'|trans({}, 'admin') }}">
            <img src="{{ rawImage|thumbnail(96, 96) }}" alt="" loading="lazy">
        </button>
        <button type="button" class="field-image-path" data-image-view="{{ rawImage|thumbnail(1600, 1600) }}" data-image-full="{{ fullUrl }}" title="{{ rawLabel }}">{{ shortRaw }}</button>
        <button type="button" class="admin-copy-btn" data-copy="{{ fullUrl }}" title="{{ 'field.copyLink'|trans({}, 'admin') }}" aria-label="{{ 'field.copyLink'|trans({}, 'admin') }}"><i class="fa-regular fa-copy"></i></button>
    </span>
{%- else -%}
    {#- Same elision as the chips above: a to-ONE association had none, so a
        Comment's parent article title made the "Parent" column 504px on its own
        and pushed the grid ~700px past its container. -#}
    {%- set rawCrud = crudFqcnOption ?? admin_entity_crud(raw) -%}
    {%- set maxLength = field.customOption('maxLength') ?? 40 -%}
    {%- set rawLabel = '' ~ (entityDisplay ? admin_entity_label(raw, entityDisplay) : admin_display(raw)) -%}
    {%- set shortRaw = rawLabel|length > maxLength ? rawLabel|slice(0, maxLength) ~ '…' : rawLabel -%}
    {%- if rawCrud and raw.id is defined and admin_crud_granted(rawCrud) -%}
        <span class="field-association"><a href="{{ admin_url(rawCrud, 'detail', admin_entity_id(raw)) }}" title="{{ rawLabel }}">{{ shortRaw }}</a></span>
    {%- else -%}
        <span title="{{ rawLabel }}">{{ shortRaw }}</span>
    {%- endif -%}
{%- endif -%}
