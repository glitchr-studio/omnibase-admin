{%- set choices = field.customOption('choices') ?? {} -%}
{%- set enumClass = field.customOption('enumClass') -%}
{%- set entityDisplay = field.customOption('entityDisplay') -%}
{#- Explicit option wins; otherwise resolved per value from its own class
    so a SelectField over a real association links itself. See
    association.html.twig for the same fallback. -#}
{%- set crudFqcn = field.customOption('crudControllerFqcn') -%}
{#- Renders ONE related entity: avatar or text per entityDisplay, wrapped in
    a link to its CRUD detail page when the field names a controller. Falls
    back to the plain badge for anything that isn't an object (a scalar
    choice/enum value), which is what keeps this macro safe to use for
    every iterable case rather than only associations. -#}
{#- `mode` mirrors AssociationField's showFirst()/show() contract:
    0 NO_SHOW, 1 SHOW_NAME_ONLY, 2 SHOW_ICON_ONLY, 3 SHOW_ALL, null = name only
    (the historical default). Those options were recorded by the field and read
    by nothing, so a column asking for icon-only chips still printed full names -
    Tags did, at 286px against production's 84px of icon chips. -#}
{%- macro entity(item, choices, enumClass, entityDisplay, crudFqcn, mode) -%}
    {%- if not entityDisplay and not crudFqcn and not admin_entity_crud(item) -%}
        {#- Neither option configured: the historical path, untouched. A
            plain choice/enum SelectField must keep its icon+colour badge. -#}
        {{- _self.badge(admin_display(item), choices, enumClass) -}}
    {%- else -%}
        {%- set label = admin_entity_label(item, entityDisplay ?: 'username') -%}
        {%- set crudFqcn = crudFqcn ?? admin_entity_crud(item) -%}
        {%- set avatar = 'avatar' == entityDisplay ? admin_entity_avatar(item) : null -%}
        {%- set icon = mode in [2, 3] ? admin_entity_icon(item) : null -%}
        {#- Icon-only is a request, not a guarantee: an entity with no icon of its
            own (Tag has none) would render a completely empty chip. Fall back to
            the name so the chip always says something. -#}
        {%- set withName = mode is null or mode in [1, 3] or (mode == 2 and not icon) -%}
        {%- set body -%}
            {%- if avatar -%}<img class="badge-avatar" src="{{ avatar }}" alt="{{ label }}">
            {%- else -%}
                {%- if icon %}<i class="{{ icon }}"></i>{% endif -%}
                {%- if withName %}<span class="badge-label">{{ label }}</span>{% endif -%}
            {%- endif -%}
        {%- endset -%}
        {%- set chipClass = 'badge badge-accent badge-entity' ~ (icon and not withName ? ' badge-icon' : '') -%}
        {%- if crudFqcn and item is not null and item.id is defined -%}
            <a class="{{ chipClass }}" href="{{ admin_url(crudFqcn, 'detail', admin_entity_id(item)) }}" title="{{ label }}">{{ body }}</a>
        {%- else -%}
            <span class="{{ chipClass }}" title="{{ label }}">{{ body }}</span>
        {%- endif -%}
    {%- endif -%}
{%- endmacro -%}
{%- macro badge(raw, choices, enumClass) -%}
    {%- set label = choices[raw] ?? null -%}
    {%- set enumLabel = enumClass ? raw|trans_enum(enumClass) : null -%}
    {#- EnumType::getIcon()/getColor() (IconizeInterface/ColorizeInterface) -
       same per-value icon+color maps ThreadState/ConnectionState/etc already
       declare and that the OLD EasyAdmin dashboard rendered; the enum()
       twig function returns a live instance so its static methods are
       callable directly from the template. #}
    {%- set icon = enumClass ? enum(enumClass).getIcon(raw) : null -%}
    {%- set color = enumClass ? enum(enumClass).getColor(raw) : null -%}
    <span class="badge badge-accent"{% if color %} style="background:{{ color }}22; color:{{ color }}; border-color:{{ color }}55;"{% endif %}>
        {%- if icon -%}<i class="{{ icon }}"></i> {%- endif -%}
        <span class="badge-label">
        {%- if label is not null -%}
            {{- label|trans -}}
        {%- elseif enumLabel is not null -%}
            {{- enumLabel -}}
        {%- else -%}
            {{- raw|lower|replace({'_': ' '})|capitalize -}}
        {%- endif -%}
        </span>
    {#- -#}
    </span>
{%- endmacro -%}
{%- set raw = field.value -%}
{%- if raw is null or raw == '' or (raw is iterable and raw|length == 0) -%}
    <span class="badge-muted">—</span>
{%- elseif raw is iterable -%}
    {%- set showFirstMode = field.customOption('showFirst') -%}
    {%- set showRestMode = field.customOption('show') ?? showFirstMode -%}
    <span class="badge-list">
        {%- for item in raw -%}
            {#- a to-many association's raw value is a collection of real
               entity objects (not scalar ids/strings) - admin_display()
               turns each into the same safe string FieldValueResolver
               already produces for a scalar field (__toString(), or
               "ClassName #id" when there is none), so choices[] lookup
               below never tries to use an object as an array key.

               entityDisplay/crudControllerFqcn (both optional) let a field
               over a real association render the related entity as its
               full name or avatar instead of __toString(), and link to its
               own CRUD page - reported live: Comment "Owners" showed bare
               usernames ("NN") with no way to click through. Neither is
               set by default, so a plain choice/enum SelectField renders
               exactly as before. #}
            {{ _self.entity(item, choices, enumClass, entityDisplay, crudFqcn ?? admin_entity_crud(item), loop.first ? showFirstMode : showRestMode) }}
        {%- endfor -%}
    </span>
{%- elseif raw is not iterable and raw.id is defined -%}
    {#- A to-ONE association (SelectField over a single related entity, e.g.
        an Article's Destination parent). This branch used to fall through to
        the scalar badge below and render formattedValue as dead text, so a
        single-valued association was the one shape that never linked while
        every to-many one did. Same macro as the collection above, so the two
        cannot drift. -#}
    {{ _self.entity(raw, choices, enumClass, entityDisplay, crudFqcn ?? admin_entity_crud(raw), field.customOption('showFirst')) }}
{%- else -%}
    {{ _self.badge(field.formattedValue, choices, enumClass) }}
{%- endif -%}
