{# Editable heading for a CRUD page (index + detail share it so the two can
   never drift apart).

   Customization is stored in LayoutScope::CRUD keyed by `pageKey` - the
   CRUD's URL slug - rather than on a sidebar menu item, because most CRUD
   pages have no menu entry to hang it on. `stored` is that raw entry (or
   null when nothing has been customized yet); an editable heading renders
   either way, since the key is what the in-place editor posts back.

   Params: editable (bool), pageKey (string), stored (array|null),
           fallbackTitle (string), suffix (string|null),
           recordTitle (string|null).

   recordTitle switches the heading into DETAIL shape: the record's own name
   becomes the <h1> and the CRUD's (editable) page title drops to a small
   line beneath it - "Petit cours de prononciation..." over "Article #1147"
   rather than "Article" over nothing. On a page about one record, the
   record is the subject; the entity class is context. Index pages pass no
   recordTitle and keep the original shape.
#}
{% set _loc = app.localizer.locale %}
{% set _def = app.localizer.defaultLocale %}
{# Default locale reads the plain label/description; every other locale
   reads its own entry in the 'intl' map. Same contract as LayoutArranger -
   an untouched locale deliberately falls through to the code-defined title
   rather than showing another language's custom text. #}
{% set _localized = stored ? (_loc == _def ? stored : (stored.intl[_loc] ?? {})) : {} %}
{% set _title = _localized.label is defined and _localized.label ? _localized.label : null %}
{% set _desc = _localized.description is defined and _localized.description ? _localized.description : null %}

{% set _pageTitle = _title ?? fallbackTitle %}
{% set _record = recordTitle is defined and recordTitle ? recordTitle : null %}

{# The editable attributes travel with the CRUD's page title wherever it
   lands, so customization works identically in both shapes. #}
{%- set _editAttrs -%}
    {%- if editable %} data-page-title data-menu-key="{{ pageKey }}" data-layout-scope="crud"{% endif -%}
{%- endset -%}

{# Leading icon, the way production and page/system.html.twig both lead.
   Resolved from the selected menu item rather than passed in, so index,
   detail and edit cannot drift and none of them repeats the walk - see
   AdminTwigExtension::adminMenuCurrent(). Rendered only when that item
   actually carries an icon: a question-mark placeholder on every CRUD
   would be worse than no box at all. Sits OUTSIDE .admin-header-titles,
   as a sibling, because .admin-header is the flex row it lines up in. #}
{% set _menuItem = admin_menu_current() %}
{% set _menuIcon = _menuItem ? _menuItem.icon : null %}
{% set _storedIcon = stored ? (stored.icon ?? null) : null %}
{% set _icon = _storedIcon ?: _menuIcon ?: (entityFqcn is defined ? admin_entity_icon(entityFqcn) : null) %}
{#- While customising, the icon can be changed here with the same picker as
    the sidebar and the action buttons (data-page-icon). It is saved on the
    CRUD page's own entry (field 'icon', LayoutScope::CRUD, keyed like the
    title), NOT on a sidebar item: most CRUDs have none, and the one
    place is what keeps index, detail and edit showing the same icon. -#}
{% set _iconEdit = editable ? ' data-page-icon data-page-icon-value="' ~ (_storedIcon ?? '') ~ '" data-menu-key="' ~ pageKey ~ '" data-layout-scope="crud" data-page-icon-default="' ~ (_menuIcon ?: (entityFqcn is defined ? admin_entity_icon(entityFqcn) : '') ?: 'fa-solid fa-circle-question') ~ '" title="' ~ 'customize.page_icon_hint'|trans({}, 'admin') ~ '"' : '' %}
{% if _icon or _iconEdit %}<span class="admin-header-icon"{{ _iconEdit|raw }}><i class="{{ _icon ?: 'fa-solid fa-circle-question' }}"></i></span>{% endif %}

{# Wrapper is what makes the heading a STACK. .admin-header is a flex row,
   so without it the title, the id line, the description and the locale
   badges all became columns of one row - the CRUD pages were the only ones
   missing it (page/system.html.twig and crud/_form.html.twig both wrap),
   which is why their description never sat under the title. #}
<div class="admin-header-titles">
{% if _record %}
    {# Deliberately the same shape crud/_form.html.twig already uses on the
       edit screen - record name as the heading, "Article ID #1147" beneath
       it - so detail and edit read alike instead of each inventing one. #}
    <h1 class="admin-header-record" title="{{ _record }}">{{ _record }}</h1>
    <div class="admin-header-subtitle">
        <span{{ _editAttrs|raw }}>{{ _pageTitle }}</span>
        {#- The per-entity part ("#1147") stays OUTSIDE the editable element:
            the stored title belongs to the CRUD page as a whole, so letting
            an entity id inside the contenteditable would save that one row's
            number as every row's title. -#}
        {#- "ID" is wrapped rather than left as a bare text node, and that span
            is load-bearing: layout.html.twig gives every DIRECT SPAN CHILD of
            .admin-header-subtitle `vertical-align: middle` (so the rest of the
            line lines up with the taller dashed description slot customize
            mode shows when the description is empty). A bare text node is not
            a span, so it kept the parent's baseline instead and sat ~0.4px -
            one device pixel at 2x - above everything around it. Visible, and
            reported. -#}
        {%- if suffix is defined and suffix %} <span class="admin-header-id">ID</span> <span class="admin-header-suffix">{{ suffix }}</span>{% endif -%}
        {#- No description here, deliberately. There is ONE stored entry per
            CRUD (LayoutScope::CRUD, keyed by the URL slug), so the text
            written on the index - a blurb about the listing, "Interdit aux
            affreux !" - is the same text that would be appended here. On a
            page about one record it reads as an annotation OF THAT RECORD,
            which it is not: "Covid ou Silver Week ? / Mon tableau de bord
            secret ID #1381 - Interdit aux affreux !" was reported as exactly
            that kind of confusing. Reported by the user 2026-09-21.

            The TITLE still travels (it names the section the record belongs
            to, which is context worth having); only the blurb stops here.
            It stays editable from the index, where it describes what it is
            actually about. -#}
    </div>
{% else %}
    <h1{{ _editAttrs|raw }}>{{ _pageTitle }}</h1>
    {%- if suffix is defined and suffix %} <span class="admin-header-suffix">{{ suffix }}</span>{% endif -%}
{% endif %}

{# Description is optional: shown when set, and when customizing it always
   renders (empty, with a placeholder) so there is something to click. On a
   record page it already joined the id line above, so this standalone row is
   for the index/new shape only. #}
{% if not _record and (_desc or editable) %}
    <div class="admin-header-subtitle"{% if editable %} data-page-desc data-menu-key="{{ pageKey }}" data-layout-scope="crud" data-placeholder="{{ 'customize.description_hint'|trans({}, 'admin') }}"{% endif %}>
        {{- _desc -}}
    </div>
{% endif %}

{# Which language the two edits above are saved under - same row as
   page/system.html.twig's, below the text it annotates. Indicative only:
   it names the dashboard's current language, it does not switch it. The
   other flags used to be _switch_locale links, and a stray click flipped
   the whole back-office into a language whose catalogues are partial. #}
{% if editable and app.localizer.availableLocales|length > 1 %}
    {#- The stored custom title/description of every language, so the flags
        can swap the editable text client-side without leaving the page (the
        default language lives in the plain keys, the others under intl). -#}
    {% set _perLocale = {} %}
    {% for _locale in app.localizer.availableLocales %}
        {% set _entry = stored ? (_locale == _def ? stored : (stored.intl[_locale] ?? {})) : {} %}
        {% set _perLocale = _perLocale|merge({ (_locale): { label: _entry.label|default(''), description: _entry.description|default('') } }) %}
    {% endfor %}
    <span class="page-locale-badges" data-page-locales="{{ _perLocale|json_encode }}" data-page-fallback-title="{{ fallbackTitle }}" data-edit-locale="{{ _loc }}" title="{{ 'customize.locale_hint'|trans({'%locale%': _loc|lang_name|capitalize}, 'admin') }}">
        {% for _locale in app.localizer.availableLocales %}
            <button type="button" class="page-locale-badge {{ _locale == _loc ? 'is-active' }}" data-page-locale="{{ _locale }}" title="{{ _locale|lang_name|capitalize }}"><img alt="{{ _locale }}" src="{{ asset('bundles/base/images/flags/' ~ (_locale|country) ~ '.svg') }}"></button>
        {% endfor %}
    </span>
{% endif %}
</div>
