{% extends '@Admin/layout.html.twig' %}

{% block page_title %}{{ crud.entityLabelInPlural ?? crud.entityFqcn|split('\\')|last }}{% endblock %}

{% block content_header %}
{# Same selected-menu-item resolution as page/system.html.twig's own
   content_header (see the comment there): a customized label replaces the
   code-defined title, and customize mode gets the data-menu-key hook that
   keeps the sidebar entry in sync with an in-place title edit. #}
{# _section, NOT _parent: '_parent' is Twig's own internal for-loop scope
   key - see page/system.html.twig's comment. #}
{% set _current = null %}
{% set _section = null %}
{% if admin_context is defined %}
    {% for item in admin_context.mainMenu %}
        {% if item.selected %}{% set _current = item %}{% set _section = null %}{% endif %}
        {% for subItem in item.subItems %}
            {% if subItem.selected %}{% set _current = subItem %}{% set _section = item %}{% endif %}
        {% endfor %}
    {% endfor %}
{% endif %}
{# The customization is keyed by the CRUD SLUG, not by the selected menu
   item, and so is NOT gated on _current: most CRUD pages have no sidebar
   entry at all (the menu only lists Settings, API keys and a few filtered
   Users links), so gating on _current left every CRUD title permanently
   uneditable - reported live. _current is still consulted below purely to
   prefer a customized sidebar LABEL where one does happen to exist. #}
{% set _editable = customize_enabled is defined and customize_enabled and crud_page_key is defined %}
<div class="admin-header">
    {% include '@Admin/crud/_page_heading.html.twig' with {
        editable: _editable,
        pageKey: crud_page_key ?? null,
        stored: crud_page ?? null,
        fallbackTitle: (_current and _current.labelCustomized)
            ? _current.label|trans({}, 'admin')
            : (crud.pageTitle('index') ?? crud.entityLabelInPlural ?? crud.entityFqcn|split('\\')|last),
    } only %}
    {# data-action-row marks this as reorderable in customize mode (see
       layout.html.twig's drag handler); the stored order is applied below.
       The search form and the filter button are deliberately OUTSIDE the
       sortable set - they are page controls, not entity actions, and the
       stored order only ever names real action keys. #}
    <div class="global-actions"{% if _editable %} data-action-row data-page-key="{{ crud_page_key }}"{% endif %}>
        <form class="search-form" method="get" action="{{ admin_url(controller_fqcn, 'index') }}">
            <input type="search" name="query" value="{{ query ?? '' }}" placeholder="{{ 'datagrid.search_placeholder'|trans({}, 'admin') }}">
        </form>
        {# Opens the filter panel below. Sits before the create action so the
           row reads search / filter / create, matching production. The count
           badge is what makes a collapsed panel honest: with the old always-
           open bar you could see at a glance that something was filtering the
           list, and hiding it behind a button would otherwise lose that. #}
        {% if filters is defined and not filters.isEmpty %}
            {# Count filters that actually constrain the list, not every key
               present. A submitted form posts EVERY field, so filter_values
               always carries an entry per filter - counting those showed "3"
               on a list narrowed by a single term. A composite filter's
               'comparison' is excluded because an operator with no value
               beside it filters nothing.
               Written with |filter rather than a loop with a counter on
               purpose: a {% set %} inside a Twig {% for %} does not survive
               the loop, so the obvious counter version silently yields 0. #}
            {% set active_filter_count = (filter_values|default({}))|filter(v =>
                v is iterable
                    ? (v|filter((sv, sk) => sk != 'comparison' and sv is not empty)|length > 0)
                    : v is not empty
            )|length %}
            <button type="button" class="btn" id="filter-toggle" aria-expanded="false" aria-controls="filter-modal">
                <i class="fa-solid fa-filter"></i> {{ 'filters.open'|trans({}, 'admin') }}
                {% if active_filter_count %}<span class="filter-count">{{ active_filter_count }}</span>{% endif %}
            </button>
        {% endif %}
        {# Apply the superadmin's stored button order. An action with no
           stored position gets 999 so it lands after the ordered ones -
           adding a new action to a CRUD must not make it disappear just
           because an old saved order predates it. #}
        {% set _order = crud_action_order|default({}) %}
        {% for action in actions.globalActions('index')|sort((a, b) => (_order[a.name] ?? 999) <=> (_order[b.name] ?? 999)) %}
            {% if action.crudActionName == 'new' and new_variants is defined and new_variants|length > 1 %}
                {# inheritance-tree entity: creating means choosing WHICH
                   concrete subclass - the historical discriminator dropdown #}
                <details class="new-dropdown"{% if _editable %} data-action-key="{{ action.name }}"{% endif %}>
                    <summary class="btn btn-primary">{% if action.icon %}<i class="{{ action.icon }}"></i> {% endif %}{{ action.label|trans }} <i class="fa-solid fa-caret-down"></i></summary>
                    <div class="new-dropdown-menu">
                        {% for variant in new_variants %}
                            <a href="{{ variant.url }}">{{ variant.label }}</a>
                        {% endfor %}
                    </div>
                </details>
            {% else %}
                {# action.cssClass already carries its own "btn btn-X" variant
                   (see Actions::configureNewAction()/etc - e.g. "action-new
                   btn btn-primary"), so hardcoding "btn btn-primary" here
                   too just duplicated it verbatim on every rendered button
                   (found live: class="btn btn-primary action-new btn btn-
                   primary" on every list page's own create button). #}
                <a class="{{ action.cssClass }}" href="{{ admin_url(controller_fqcn, action.crudActionName ?? 'new') }}"{% if _editable %} data-action-key="{{ action.name }}"{% endif %}>
                    {% if action.icon %}<i class="{{ action.icon }}"></i> {% endif %}{{ action.label|trans }}
                </a>
            {% endif %}
        {% endfor %}
    </div>
</div>
{% endblock %}

{% block content %}
{% if filters is defined and not filters.isEmpty %}
{# Collapsed into a dialog behind the "Filtres" button above, instead of the
   always-visible inline bar this used to be - the bar put every filter of
   every type on one wrapped row, so the controls never lined up and the
   page header shifted down on entities with many filters.

   The FORM itself is unchanged (same GET, same filters[...] field names), so
   filtering semantics, bookmarkable URLs and the sidebar's pre-filtered
   links all keep working exactly as before - this is presentation only.

   One behavioural change on purpose: the selects no longer carry the
   autosubmit hook. Applying on every change made sense for a bar that was
   always on screen; inside a dialog with its own Appliquer button it would
   submit and close the dialog halfway through setting up a filter. #}
<div class="filter-modal" id="filter-modal" hidden>
    <div class="filter-modal-backdrop" data-filter-close></div>
    <form class="filter-modal-panel" method="get" action="{{ admin_url(controller_fqcn, 'index') }}" role="dialog" aria-modal="true" aria-label="{{ 'filters.title'|trans({}, 'admin') }}">
    <div class="filter-modal-header">
        <a class="btn" href="{{ admin_url(controller_fqcn, 'index') }}"><i class="fa-solid fa-xmark"></i> {{ 'filters.reset'|trans({}, 'admin') }}</a>
        <span class="filter-modal-title"><i class="fa-solid fa-filter"></i> {{ 'filters.title'|trans({}, 'admin') }}</span>
        <button class="btn btn-primary" type="submit"><i class="fa-solid fa-check"></i> {{ 'filters.apply'|trans({}, 'admin') }}</button>
    </div>
    <div class="filter-modal-body">
    {% if query %}<input type="hidden" name="query" value="{{ query }}">{% endif %}
    {% for property, filter in filters.all %}
        {% set value = filter_values[property]|default(null) %}
        <label>
            <span>{{ filter.label ?? property|humanize }}</span>
            {% if filter.type == 'boolean' %}
                <select name="filters[{{ property }}]">
                    <option value=""></option>
                    <option value="1" {{ value == '1' ? 'selected' }}>✓</option>
                    <option value="0" {{ value == '0' ? 'selected' }}>✕</option>
                </select>
            {% elseif filter.type == 'choice' %}
                <select name="filters[{{ property }}]">
                    <option value=""></option>
                    {% for choiceValue, choiceLabel in filter.choices %}
                        <option value="{{ choiceValue }}" {{ value == choiceValue ? 'selected' }}>{{ choiceLabel|trans }}</option>
                    {% endfor %}
                </select>
            {% elseif filter.type == 'association' %}
                {# choices here are real entity labels (Destination/Author/Tag
                   names, ...), not translation keys - |trans would be a
                   silent no-op most of the time, but skip it entirely to
                   rule out a real entity happening to collide with an
                   actual translation key #}
                <select name="filters[{{ property }}]">
                    <option value=""></option>
                    {% for choiceValue, choiceLabel in filter.choices %}
                        <option value="{{ choiceValue }}" {{ value == choiceValue ? 'selected' }}>{{ choiceLabel }}</option>
                    {% endfor %}
                </select>
            {% elseif filter.type == 'date' %}
                <span class="filter-range">
                    <input type="date" name="filters[{{ property }}][from]" value="{{ value.from|default('') }}">
                    <input type="date" name="filters[{{ property }}][to]" value="{{ value.to|default('') }}">
                </span>
            {% elseif filter.type == 'numeric' or filter.type == 'text' %}
                {# comparison + value pair (filters[x][comparison]=gt&filters[x][value]=3,
                   the historical URL shape); a bare scalar submitted by an
                   external link still works and means the default operator #}
                {% set rawValue = value is iterable ? (value.value ?? '') : (value ?? '') %}
                {% set rawComparison = value is iterable ? (value.comparison ?? null) : null %}
                <span class="filter-comparison">
                    <select name="filters[{{ property }}][comparison]">
                        {% for op, symbol in filter.comparisons %}
                            <option value="{{ op }}" {{ rawComparison == op ? 'selected' }}>{{ symbol }}</option>
                        {% endfor %}
                    </select>
                    <input type="{{ filter.type == 'numeric' ? 'number' : 'text' }}" {{ filter.type == 'numeric' ? 'step="any"' }}
                           name="filters[{{ property }}][value]" value="{{ rawValue }}">
                </span>
            {% else %}
                <input type="text" name="filters[{{ property }}]" value="{{ value ?? '' }}">
            {% endif %}
        </label>
    {% endfor %}
    </div>
    </form>
</div>
{% endif %}
<div class="card">
    {% if rows is empty %}
        <div class="empty-state">{{ 'datagrid.empty'|trans({}, 'admin') }}</div>
    {% else %}
    <form method="post" action="{{ admin_url(controller_fqcn, 'batchDelete') }}" class="batch-form"
          data-confirm="{{ 'action.delete_confirm'|trans({}, 'admin') }}">
    <input type="hidden" name="_token" value="{{ csrf_token('admin-batch-' ~ crud.entityFqcn) }}">
    <div class="table-responsive">
    <table class="datagrid">
        <thead>
        <tr>
            <th class="batch"><input type="checkbox" onclick="this.closest('table').querySelectorAll('tbody input[type=checkbox]').forEach(c => c.checked = this.checked); this.closest('form').querySelector('.batch-toolbar').hidden = !this.checked;"></th>
            {% for field in fields|filter(f => f.isDisplayedOn('index')) %}
                {% set direction = sort[field.property]|default(null) %}
                <th style="{{ field.textAlign ? 'text-align:' ~ field.textAlign }}">
                    {% if field.isSortable is not defined or field.isSortable != false %}
                        <a href="{{ admin_url(controller_fqcn, 'index', null, {'sort': {(field.property): direction == 'ASC' ? 'DESC' : 'ASC'}}) }}">
                            {{ field.label ?? field.property|humanize }}
                            {%- if direction %} {{ direction == 'ASC' ? '▲' : '▼' }}{% endif %}
                        </a>
                    {% else %}
                        {{ field.label ?? field.property|humanize }}
                    {% endif %}
                </th>
            {% endfor %}
            <th class="actions"></th>
        </tr>
        </thead>
        <tbody>
        {% for row in rows %}
            <tr>
                <td class="batch"><input type="checkbox" name="batchIds[]" value="{{ row.entity.id }}"
                    onclick="this.closest('form').querySelector('.batch-toolbar').hidden = !this.closest('table').querySelector('tbody input:checked');"></td>
                {% for field in row.fields %}
                    <td class="{{ field.cssClass }}" style="{{ field.textAlign ? 'text-align:' ~ field.textAlign }}">
                        {{ include(['@Admin/' ~ field.templateName ~ '.html.twig', '@Admin/crud/field/text.html.twig'], {field: field, entity: row.entity}) }}
                    </td>
                {% endfor %}
                <td class="actions">
                    {% for action in actions.entityActions('index') %}
                        {% if action.isDisplayed(row.entity) %}
                            {% if action.name == 'delete' %}
                                {# submits the surrounding batch form to the row's delete URL (same CSRF token) #}
                                <button class="btn btn-icon text-danger" title="{{ action.label|trans }}"
                                        formaction="{{ admin_url(controller_fqcn, 'delete', row.entity.id) }}"><i class="fa-solid fa-trash"></i></button>
                            {% else %}
                                {% set isIconOnly = action.name in ['edit', 'detail', 'goto'] %}
                                <a class="btn {{ isIconOnly ? 'btn-icon' }} {{ action.cssClass }}"
                                   href="{{ admin_action_url(action, row.entity, controller_fqcn) }}"
                                   title="{{ action.label|trans }}"
                                   {%- if action.htmlAttributes['target'] is defined %} target="{{ action.htmlAttributes['target'] }}"{% endif %}>
                                    {%- if action.name == 'edit' -%}
                                        <i class="fa-solid fa-pen"></i>
                                    {%- elseif action.name == 'detail' -%}
                                        <i class="fa-solid fa-eye"></i>
                                    {%- elseif action.name == 'goto' -%}
                                        <i class="fa-solid fa-plug"></i>
                                    {%- else -%}
                                        {{ action.label|trans }}
                                    {%- endif -%}
                                </a>
                            {% endif %}
                        {% endif %}
                    {% endfor %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
    <div class="batch-toolbar" hidden>
        <button class="btn text-danger" type="submit">{{ 'action.delete'|trans({}, 'admin') }}</button>
    </div>
    </form>
    <div class="paginator">
        <span>{{ paginator.total }} {{ 'datagrid.results'|trans({}, 'admin') }}</span>
        <div class="pages">
            {% if paginator.hasPreviousPage %}
                <a class="btn" href="{{ admin_url(controller_fqcn, 'index', null, {'page': paginator.previousPage, 'sort': sort}) }}">‹</a>
            {% endif %}
            {# numbered pages with an ellipsis window (1 … n-1 n n+1 … last),
               matching the production paginator instead of a bare "n / total" #}
            {% set shown = [] %}
            {% for p in 1..paginator.pageCount %}
                {% if p == 1 or p == paginator.pageCount or (p >= paginator.page - 1 and p <= paginator.page + 1) %}
                    {% if shown is not empty and p > shown|last + 1 %}
                        <span class="btn pages-ellipsis">…</span>
                    {% endif %}
                    {% if p == paginator.page %}
                        <span class="btn page-current">{{ p }}</span>
                    {% else %}
                        <a class="btn" href="{{ admin_url(controller_fqcn, 'index', null, {'page': p, 'sort': sort}) }}">{{ p }}</a>
                    {% endif %}
                    {% set shown = shown|merge([p]) %}
                {% endif %}
            {% endfor %}
            {% if paginator.hasNextPage %}
                <a class="btn" href="{{ admin_url(controller_fqcn, 'index', null, {'page': paginator.nextPage, 'sort': sort}) }}">›</a>
            {% endif %}
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
