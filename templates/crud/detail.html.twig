{% extends '@Admin/layout.html.twig' %}

{% block page_title %}{{ crud.entityLabelInSingular ?? crud.entityFqcn|split('\\')|last }} #{{ entityId }}{% endblock %}

{% block content_header %}
<div class="admin-header">
    <h1>{{ crud.pageTitle('detail') ?? block('page_title') }}</h1>
    <div class="global-actions">
        {% for action in actions.getAll('detail') %}
            {% if action.name == 'delete' %}
                <form method="post" action="{{ admin_url(controller_fqcn, 'delete', entityId) }}" style="display:contents"
                      data-confirm="{{ 'action.delete_confirm'|trans({}, 'admin') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin-batch-' ~ crud.entityFqcn) }}">
                    <button class="btn btn-icon text-danger" title="{{ action.label|trans }}"><i class="fa-solid fa-trash"></i></button>
                </form>
            {% elseif action.name != 'separator' %}
                {% set href = admin_action_url(action, entity, controller_fqcn) %}
                {% if href %}
                    {% set isIconOnly = action.htmlAttributes['tooltip'] is defined %}
                    <a class="btn {{ isIconOnly ? 'btn-icon' }} {{ action.name == 'edit' ? 'btn-primary' }}" href="{{ href }}"
                       {%- if action.htmlAttributes['target'] is defined %} target="{{ action.htmlAttributes['target'] }}"{% endif %}
                       {%- if isIconOnly %} title="{{ action.label|trans }}"{% endif %}>
                        {%- if action.icon -%}<i class="{{ action.icon }}"></i>{%- endif -%}
                        {%- if not isIconOnly %} {{ action.label|trans }}{% endif -%}
                    </a>
                {% endif %}
            {% endif %}
        {% endfor %}
    </div>
</div>
{% endblock %}

{% block content %}
<div class="card">
    <dl class="detail">
        {% for field in fields %}
            <dt>{{ field.label ?? field.property|humanize }}</dt>
            <dd>{{ include(['@Admin/' ~ field.templateName ~ '.html.twig', '@Admin/crud/field/text.html.twig'], {field: field, entity: entity}) }}</dd>
        {% endfor %}
    </dl>
</div>
{% endblock %}
