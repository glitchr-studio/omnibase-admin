{% extends '@Admin/crud/_form.html.twig' %}

{# No form_title override either: the shared heading names the record and
   drops the entity + "#id" to the subtitle, the same shape detail uses.
   page.edit_named / page.edit are still used for the browser tab. #}
{% block page_title %}
    {%- set _entityLabel = crud.entityLabelInSingular ?? admin_entity_name(crud.entityFqcn) -%}
    {%- set _record = admin_display(entity)|trim -%}
    {{- _record and _record != _entityLabel
        ? 'page.edit_named'|trans({'%name%': _record}, 'admin')
        : 'page.edit'|trans({'%entity%': _entityLabel, '%id%': entity.id}, 'admin') -}}
{% endblock %}
